{
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/((?!robots\\.txt|sitemap)[^/]*[^/])",
      "destination": "/$1/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
