---
// src/pages/tools/phone-comparison.astro
import Layout from "@/layouts/Layout.astro";

const title = "Phone Comparison Tool — ReviByte Tools";
const description = "Compare any two phones side by side — display, chipset, RAM, storage, battery, camera, and price. Free, instant, works entirely in your browser.";
const canonicalURL = "https://www.revibyte.blog/tools/phone-comparison/";
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>

  <main class="pc-wrap">
    <header class="pc-head">
      <a href="/tools/" class="pc-back">← ReviByte Tools</a>
      <p class="pc-eyebrow">ReviByte Tools</p>
      <h1 class="pc-title">Phone Comparison Tool</h1>
      <p class="pc-sub">
        Enter the specs for any two phones and compare them side by side.
        Works for any phone, any brand — nothing is looked up online, so
        it's only as accurate as what you enter.
      </p>
    </header>

    <section class="input-grid">
      <div class="input-col">
        <h2 class="col-title col-a">Phone A</h2>
        <div class="field">
          <label for="nameA">Name</label>
          <input type="text" id="nameA" placeholder="e.g. Tecno Camon 30" />
        </div>
        <div class="field">
          <label for="displayA">Display</label>
          <input type="text" id="displayA" placeholder="e.g. 6.78&quot; AMOLED, 120Hz" />
        </div>
        <div class="field">
          <label for="chipsetA">Chipset</label>
          <input type="text" id="chipsetA" placeholder="e.g. MediaTek Helio G100" />
        </div>
        <div class="field">
          <label for="ramA">RAM (GB)</label>
          <input type="number" id="ramA" placeholder="8" min="0" />
        </div>
        <div class="field">
          <label for="storageA">Storage (GB)</label>
          <input type="number" id="storageA" placeholder="256" min="0" />
        </div>
        <div class="field">
          <label for="batteryA">Battery (mAh)</label>
          <input type="number" id="batteryA" placeholder="5000" min="0" />
        </div>
        <div class="field">
          <label for="cameraA">Rear Camera</label>
          <input type="text" id="cameraA" placeholder="e.g. 108MP + 2MP" />
        </div>
        <div class="field">
          <label for="priceA">Price (₦)</label>
          <input type="number" id="priceA" placeholder="350000" min="0" />
        </div>
      </div>

      <div class="input-col">
        <h2 class="col-title col-b">Phone B</h2>
        <div class="field">
          <label for="nameB">Name</label>
          <input type="text" id="nameB" placeholder="e.g. Infinix Note 40" />
        </div>
        <div class="field">
          <label for="displayB">Display</label>
          <input type="text" id="displayB" placeholder="e.g. 6.78&quot; AMOLED, 120Hz" />
        </div>
        <div class="field">
          <label for="chipsetB">Chipset</label>
          <input type="text" id="chipsetB" placeholder="e.g. MediaTek Helio G99" />
        </div>
        <div class="field">
          <label for="ramB">RAM (GB)</label>
          <input type="number" id="ramB" placeholder="8" min="0" />
        </div>
        <div class="field">
          <label for="storageB">Storage (GB)</label>
          <input type="number" id="storageB" placeholder="256" min="0" />
        </div>
        <div class="field">
          <label for="batteryB">Battery (mAh)</label>
          <input type="number" id="batteryB" placeholder="5000" min="0" />
        </div>
        <div class="field">
          <label for="cameraB">Rear Camera</label>
          <input type="text" id="cameraB" placeholder="e.g. 108MP + 2MP" />
        </div>
        <div class="field">
          <label for="priceB">Price (₦)</label>
          <input type="number" id="priceB" placeholder="280000" min="0" />
        </div>
      </div>
    </section>

    <button id="compareBtn" class="compare-btn">Compare</button>

    <section class="result" id="resultSection" hidden>
      <table class="compare-table" id="compareTable">
        <thead>
          <tr>
            <th class="row-label-col"></th>
            <th id="colHeadA"></th>
            <th id="colHeadB"></th>
          </tr>
        </thead>
        <tbody id="compareBody"></tbody>
      </table>
    </section>

    <section class="info-block">
      <h2 class="info-title">How to use this tool</h2>
      <ol class="info-list">
        <li>Type in the specs for the first phone — display, chipset, RAM, storage, battery, camera, and price.</li>
        <li>Do the same for the second phone.</li>
        <li>Tap <strong>Compare</strong> to see them side by side. Numeric specs (RAM, storage, battery, price) are highlighted to show which phone wins each category — for price, lower is highlighted as the win.</li>
      </ol>
    </section>

    <section class="info-block">
      <h2 class="info-title">FAQ</h2>
      <div class="faq-item">
        <h3 class="faq-q">Why do I have to type in the specs myself?</h3>
        <p class="faq-a">This tool works for any phone, from any brand, including ones that just launched — so it doesn't rely on a fixed database that could go outdated or miss a phone. You get accurate results as long as the specs you enter are accurate.</p>
      </div>
      <div class="faq-item">
        <h3 class="faq-q">Where do I find accurate specs for a phone?</h3>
        <p class="faq-a">Check the phone's official product page, or a ReviByte review if we've covered it.</p>
      </div>
      <div class="faq-item">
        <h3 class="faq-q">Does this tool store or send my data anywhere?</h3>
        <p class="faq-a">No. Everything happens locally in your browser — nothing you type is sent to ReviByte's servers or anywhere else.</p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .pc-wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
    font-family: "Inter", system-ui, sans-serif;
    color: #1a1d23;
  }

  .pc-head { margin-bottom: 1.75rem; }
  .pc-back {
    display: inline-block;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.85rem;
    font-weight: 800;
    color: #e11d1d;
    text-decoration: none;
    margin-bottom: 0.9rem;
  }
  .pc-back:hover { text-decoration: underline; }
  .pc-eyebrow {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #e11d1d;
    margin: 0 0 0.5rem;
  }
  .pc-title {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 2.3rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 0.6rem;
    color: #0f1115;
  }
  .pc-sub {
    color: #3f4450;
    font-weight: 500;
    font-size: 0.98rem;
    line-height: 1.55;
    margin: 0;
    max-width: 56ch;
  }

  .input-grid {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .input-col {
    background: #f7f8fa;
    border: 1px solid #e3e6eb;
    border-radius: 10px;
    padding: 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .col-title {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.2rem;
  }
  .col-a { color: #e11d1d; }
  .col-b { color: #0f1115; }

  .field { display: flex; flex-direction: column; gap: 0.3rem; }
  .field label {
    font-size: 0.75rem;
    color: #565c68;
    font-family: "JetBrains Mono", monospace;
  }
  .field input {
    background: #ffffff;
    border: 1px solid #d3d7de;
    color: #0f1115;
    padding: 0.5rem 0.6rem;
    border-radius: 6px;
    font-size: 0.88rem;
  }

  .compare-btn {
    margin-top: 1.25rem;
    width: 100%;
    background: #e11d1d;
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 0.98rem;
    padding: 0.75rem 1rem;
    border-radius: 7px;
    cursor: pointer;
    transition: filter 0.15s ease;
  }
  .compare-btn:hover { filter: brightness(1.08); }

  .result { margin-top: 1.75rem; overflow-x: auto; }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    background: #f7f8fa;
    border: 1px solid #e3e6eb;
    border-radius: 10px;
    overflow: hidden;
  }
  .compare-table th,
  .compare-table td {
    padding: 0.7rem 0.9rem;
    text-align: left;
    font-size: 0.9rem;
    border-bottom: 1px solid #e3e6eb;
  }
  .compare-table th {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #565c68;
    background: #eef0f3;
  }
  .row-label-col {
    font-weight: 700;
    color: #0f1115;
    width: 30%;
  }
  .compare-table tbody tr:last-child td { border-bottom: none; }
  .win-cell {
    font-weight: 700;
    color: #15803d;
    background: rgba(21, 128, 61, 0.08);
  }

  .info-block {
    margin-top: 2.25rem;
    padding-top: 2rem;
    border-top: 1px solid #e3e6eb;
  }
  .info-title {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: #0f1115;
    margin: 0 0 0.9rem;
  }
  .info-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .info-list li {
    color: #2a2d34;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .faq-item { margin-bottom: 1.1rem; }
  .faq-item:last-child { margin-bottom: 0; }
  .faq-q {
    font-size: 0.98rem;
    font-weight: 700;
    color: #0f1115;
    margin: 0 0 0.3rem;
  }
  .faq-a {
    font-size: 0.93rem;
    line-height: 1.55;
    color: #3f4450;
    margin: 0;
  }

  @media (max-width: 560px) {
    .pc-title { font-size: 1.7rem; }
    .input-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const compareBtn = document.getElementById("compareBtn") as HTMLButtonElement;
  const resultSection = document.getElementById("resultSection") as HTMLElement;
  const compareBody = document.getElementById("compareBody") as HTMLElement;
  const colHeadA = document.getElementById("colHeadA") as HTMLElement;
  const colHeadB = document.getElementById("colHeadB") as HTMLElement;

  function val(id: string): string {
    const el = document.getElementById(id) as HTMLInputElement;
    return el ? el.value.trim() : "";
  }

  function addRow(label: string, valA: string, valB: string, numA?: number, numB?: number, lowerIsBetter = false) {
    const tr = document.createElement("tr");

    let aClass = "";
    let bClass = "";
    if (numA !== undefined && numB !== undefined && !isNaN(numA) && !isNaN(numB) && numA !== numB) {
      const aWins = lowerIsBetter ? numA < numB : numA > numB;
      aClass = aWins ? "win-cell" : "";
      bClass = aWins ? "" : "win-cell";
    }

    tr.innerHTML = `
      <td class="row-label-col">${label}</td>
      <td class="${aClass}">${valA || "—"}</td>
      <td class="${bClass}">${valB || "—"}</td>
    `;
    compareBody.appendChild(tr);
  }

  compareBtn.addEventListener("click", () => {
    const nameA = val("nameA") || "Phone A";
    const nameB = val("nameB") || "Phone B";

    colHeadA.textContent = nameA;
    colHeadB.textContent = nameB;
    compareBody.innerHTML = "";

    addRow("Display", val("displayA"), val("displayB"));
    addRow("Chipset", val("chipsetA"), val("chipsetB"));

    const ramA = val("ramA"), ramB = val("ramB");
    addRow("RAM", ramA ? `${ramA} GB` : "", ramB ? `${ramB} GB` : "", parseFloat(ramA), parseFloat(ramB));

    const storageA = val("storageA"), storageB = val("storageB");
    addRow("Storage", storageA ? `${storageA} GB` : "", storageB ? `${storageB} GB` : "", parseFloat(storageA), parseFloat(storageB));

    const batteryA = val("batteryA"), batteryB = val("batteryB");
    addRow("Battery", batteryA ? `${batteryA} mAh` : "", batteryB ? `${batteryB} mAh` : "", parseFloat(batteryA), parseFloat(batteryB));

    addRow("Rear Camera", val("cameraA"), val("cameraB"));

    const priceA = val("priceA"), priceB = val("priceB");
    addRow(
      "Price",
      priceA ? `₦${Number(priceA).toLocaleString()}` : "",
      priceB ? `₦${Number(priceB).toLocaleString()}` : "",
      parseFloat(priceA),
      parseFloat(priceB),
      true
    );

    resultSection.hidden = false;
    resultSection.scrollIntoView({ behavior: "smooth", block: "start" });
  });
</script>
