---
import Layout from "@/layouts/Layout.astro";
import BackButton from "@/components/BackButton.astro";

const title = "Terms and Conditions | ReviByte Opinion";
const description = "Terms and Conditions for using ReviByte Opinion – a personal tech, Android, and mobile gaming blog.";
const lastUpdated = "May 16, 2026";
---

<Layout title={title} description={description}>
  <div style="max-width:56rem; margin: 1rem auto; padding: 0 1rem;">
    <BackButton />
  </div>

  <article class="prose prose-lg mx-auto max-w-4xl px-6 py-16 dark:prose-invert">
    <header class="text-center">
      <h1 class="mb-4 text-4xl font-bold">Terms and Conditions</h1>
      <p class="lead text-xl text-gray-600 dark:text-gray-300">
        ReviByte Opinion – A Personal Tech, Android & Mobile Gaming Blog
      </p>
      <p class="mt-4 text-lg font-medium text-gray-500 dark:text-gray-400">
        Last updated: {lastUpdated}
      </p>
      <p class="mt-2">
        Questions? Email us at
        <a href="mailto:revibyte20@gmail.com" class="font-semibold text-blue-600 hover:underline">
          revibyte20@gmail.com
        </a>
      </p>
    </header>

    <div class="my-12 rounded-xl bg-blue-50 p-8 dark:bg-blue-950/30">
      <p class="text-lg font-medium">
        By using ReviByte Opinion, you agree to these Terms and our
        <a href="/privacy-policy" class="text-blue-600 hover:underline font-semibold">Privacy Policy</a>.
        If you do not agree, please stop using the website.
      </p>
    </div>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">1. Acceptance of Terms</h2>
      <p>By accessing ReviByte Opinion ("Site," "we," "us"), you agree to these Terms. These Terms apply to all visitors, readers, and users of the Site.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">2. Eligibility</h2>
      <p>You must be at least <strong>13 years old</strong> to use this Site. Users under 18 must have parental or guardian consent. Gaming content on this site (COD Mobile, eFootball guides) is intended for general audiences.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">3. Use Restrictions</h2>
      <p>You may use this site to read content, share links, and interact respectfully. You agree NOT to:</p>
      <ul class="mt-4">
        <li>Use the site for illegal or harmful purposes</li>
        <li>Post harassment, hate speech, spam, or misleading content</li>
        <li>Use bots or automated scraping tools against this site</li>
        <li>Upload malware or interfere with site security</li>
        <li>Republish content commercially without written permission</li>
        <li>Artificially click on advertisements displayed on this site</li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">4. Intellectual Property</h2>
      <p>All original content on ReviByte Opinion — including articles, guides, reviews, text, visuals, design, and branding — belongs to ReviByte Opinion unless otherwise stated. You may share links to our content freely, but reproduction or republishing of full articles without permission is not allowed.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">5. Gaming Content & Affiliations</h2>
      <p>ReviByte Opinion publishes guides, loadouts, tips, and opinions for mobile games including COD Mobile and eFootball 2026. Please note:</p>
      <ul class="mt-4">
        <li>ReviByte Opinion is <strong>not affiliated with Activision, TiMi Studio, Konami, or any game developer</strong> mentioned on this site.</li>
        <li>Game names, logos, and trademarks belong to their respective owners.</li>
        <li>All game guides and loadout recommendations are based on personal experience and opinion — they do not guarantee any in-game results, rank, or performance.</li>
        <li>Game meta and features change frequently — always verify tips against the current season or patch.</li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">6. Advertising Disclosure</h2>
      <p>ReviByte Opinion displays advertisements via <strong>Google AdSense</strong>. These ads help support the site and keep content free. Please note:</p>
      <ul class="mt-4">
        <li>Ads are served automatically by Google based on your interests and browsing history.</li>
        <li>ReviByte Opinion does not control which specific ads appear.</li>
        <li>Clicking ads artificially or encouraging others to do so is strictly prohibited and violates Google's policies.</li>
        <li>You can manage your ad preferences at <a href="https://adssettings.google.com" target="_blank" rel="noopener" class="text-blue-600 hover:underline">adssettings.google.com</a>.</li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">7. Affiliate Links Disclosure</h2>
      <p>ReviByte Opinion is a participant in the <strong>Amazon Associates Program</strong>, an affiliate advertising program designed to provide a means for sites to earn advertising fees by linking to Amazon.com. Please note:</p>
      <ul class="mt-4">
        <li>Some posts and banners on this site contain affiliate links marked with <strong>"Sponsored"</strong> or disclosed inline.</li>
        <li>If you click an affiliate link and make a purchase, we may earn a small commission — at <strong>no extra cost to you</strong>.</li>
        <li>Affiliate relationships never influence our editorial opinions, reviews, or recommendations.</li>
        <li>We only link to products we genuinely consider relevant to our readers.</li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">8. Third-Party Links & Services</h2>
      <p>This site may include links to external websites or use third-party services (Google Analytics, OneSignal, Supabase, Vercel, Amazon). We are not responsible for the content, privacy practices, or policies of those external sites. Links are provided for convenience only.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">9. Push Notifications</h2>
      <p>ReviByte Opinion offers optional push notifications via OneSignal to alert you when new posts are published. By clicking "Allow" on the notification prompt, you consent to receiving these alerts. You can unsubscribe at any time through your browser settings. We will never use push notifications to send spam or promotional offers.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">10. Disclaimer of Warranties</h2>
      <div class="rounded-xl bg-yellow-50 dark:bg-yellow-950/30 p-6 border-l-4 border-yellow-400 mt-4">
        <p>This website is provided "AS IS" without warranties of any kind. We do not guarantee accuracy, completeness, availability, or error-free operation. All content represents personal opinions and is not formal technical, legal, financial, or professional advice. Tech specs, prices, and game information may change — always verify independently before making purchasing or gameplay decisions.</p>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">11. Limitation of Liability</h2>
      <div class="rounded-xl bg-yellow-50 dark:bg-yellow-950/30 p-6 border-l-4 border-yellow-400 mt-4">
        <p>To the maximum extent permitted by law, ReviByte Opinion is not liable for any damages — direct, indirect, incidental, or consequential — resulting from your use of this site or reliance on its content. Total liability is limited to <strong>$100 USD</strong>.</p>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">12. Indemnification</h2>
      <p>You agree to defend and indemnify ReviByte Opinion against any claims, damages, or expenses arising from your misuse of the site or violation of these Terms.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">13. Modifications</h2>
      <p>We may update these Terms at any time. The "Last updated" date at the top reflects the latest version. Continued use of the site after updates means you accept the revised Terms.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">14. Governing Law</h2>
      <p>These Terms are governed by applicable international digital commerce standards. In the event of a dispute, please contact us first at <a href="mailto:revibyte20@gmail.com" class="text-blue-600 hover:underline">revibyte20@gmail.com</a> to resolve issues informally before pursuing any formal action.</p>
    </section>

    <p class="mt-16 text-center text-lg italic text-gray-600 dark:text-gray-400">
      © 2026 ReviByte Opinion. All rights reserved.<br><br>
      — <strong>Oke "iSamuel"</strong>, Founder
    </p>
  </article>
</Layout>

<style>
  /* Light mode text */
  article.prose p,
  article.prose li,
  article.prose dd,
  article.prose dt,
  article.prose h1,
  article.prose h2,
  article.prose h3,
  article.prose blockquote,
  article.prose strong {
    color: #1a1a1a !important;
    opacity: 1 !important;
  }

  article.prose a {
    color: #006cac !important;
  }

  /* Dark mode text */
  html[data-theme="dark"] article.prose p,
  html[data-theme="dark"] article.prose li,
  html[data-theme="dark"] article.prose dd,
  html[data-theme="dark"] article.prose dt,
  html[data-theme="dark"] article.prose h1,
  html[data-theme="dark"] article.prose h2,
  html[data-theme="dark"] article.prose h3,
  html[data-theme="dark"] article.prose blockquote,
  html[data-theme="dark"] article.prose strong {
    color: #eaedf3 !important;
    opacity: 1 !important;
  }

  html[data-theme="dark"] article.prose a {
    color: #ff6b01 !important;
  }
</style>
