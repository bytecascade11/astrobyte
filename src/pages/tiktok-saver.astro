---
import Layout from "../layouts/Layout.astro";

const title = "TikTok Video Downloader — Download Without Watermark | ReviByte";
const description = "Download TikTok videos without watermark for free. Save TikTok videos and audio (MP3) instantly — no app, no login, no watermark. Works on Android, iPhone & PC.";
const canonicalURL = "https://revibyte.blog/tiktok-saver/";
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "ReviByte TikTok Downloader",
      "url": canonicalURL,
      "description": description,
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web, Android, iOS",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "author": { "@type": "Person", "name": "iSamuel", "url": "https://revibyte.blog" }
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I download a TikTok video without watermark?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Paste the TikTok video link into the box on this page and click Download. Choose 'Video (No Watermark)' to save without the TikTok logo."
          }
        },
        {
          "@type": "Question",
          "name": "Can I download TikTok audio as MP3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. After pasting your TikTok link, click the 'Download Audio (MP3)' button to save just the audio from the video."
          }
        },
        {
          "@type": "Question",
          "name": "Is this TikTok downloader free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, ReviByte's TikTok downloader is completely free. No login, no app install, no hidden charges."
          }
        },
        {
          "@type": "Question",
          "name": "Does this work on Android and iPhone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, it works on any device with a browser — Android, iPhone, tablet, or PC."
          }
        }
      ]
    })} />
  </Fragment>

  <main class="tt-page">

    <!-- Hero -->
    <section class="tt-hero">
      <div class="tt-badge">Free Tool</div>
      <h1 class="tt-title">TikTok Video <span class="tt-accent">Downloader</span></h1>
      <p class="tt-subtitle">Download TikTok videos without watermark — or save as MP3. Free, fast, no login needed.</p>
    </section>

    <!-- Tool -->
    <section class="tt-tool">
      <div class="tt-input-wrap">
        <input
          id="tt-url"
          type="url"
          placeholder="Paste TikTok link here... (e.g. https://www.tiktok.com/@user/video/...)"
          autocomplete="off"
          spellcheck="false"
        />
        <button id="tt-fetch-btn">
          <span id="tt-btn-text">Download</span>
          <span id="tt-btn-spinner" style="display:none">
            <svg class="tt-spin" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
            </svg>
          </span>
        </button>
      </div>

      <p class="tt-hint">
        Copy a TikTok link from the app → tap <strong>Share</strong> → <strong>Copy link</strong> → paste above
      </p>

      <!-- Error -->
      <div id="tt-error" class="tt-error" style="display:none"></div>

      <!-- Result card -->
      <div id="tt-result" class="tt-result" style="display:none">
        <div class="tt-video-meta">
          <img id="tt-cover" src="" alt="TikTok video thumbnail" class="tt-cover" />
          <div class="tt-meta-info">
            <div id="tt-author" class="tt-author"></div>
            <div id="tt-video-title" class="tt-video-title"></div>
            <div id="tt-stats" class="tt-stats"></div>
          </div>
        </div>

        <div class="tt-download-btns">
          <a id="tt-dl-hd" href="#" target="_blank" class="tt-dl-btn tt-dl-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download Video (No Watermark)
          </a>
          <a id="tt-dl-audio" href="#" target="_blank" class="tt-dl-btn tt-dl-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
            </svg>
            Download Audio (MP3)
          </a>
        </div>
      </div>
    </section>

    <!-- How to use -->
    <section class="tt-how">
      <h2>How to Download TikTok Videos</h2>
      <div class="tt-steps">
        <div class="tt-step">
          <div class="tt-step-num">1</div>
          <div>
            <strong>Copy the TikTok link</strong>
            <p>Open TikTok, find the video, tap Share → Copy Link</p>
          </div>
        </div>
        <div class="tt-step">
          <div class="tt-step-num">2</div>
          <div>
            <strong>Paste it above</strong>
            <p>Paste the link into the box at the top of this page</p>
          </div>
        </div>
        <div class="tt-step">
          <div class="tt-step-num">3</div>
          <div>
            <strong>Choose your download</strong>
            <p>Pick video without watermark or audio-only MP3</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="tt-faq">
      <h2>Frequently Asked Questions</h2>

      <details class="tt-faq-item">
        <summary>Does this remove the TikTok watermark?</summary>
        <p>Yes. The "No Watermark" download option gives you a clean video without the TikTok logo or username overlay.</p>
      </details>

      <details class="tt-faq-item">
        <summary>Can I download private TikTok videos?</summary>
        <p>No — only public TikTok videos can be downloaded. Private videos are not accessible.</p>
      </details>

      <details class="tt-faq-item">
        <summary>Does it work on Android and iPhone?</summary>
        <p>Yes. This tool works on any browser — Android, iPhone, tablet, or desktop PC.</p>
      </details>

      <details class="tt-faq-item">
        <summary>Is there a limit on downloads?</summary>
        <p>No limit. Download as many TikTok videos as you need, completely free.</p>
      </details>

      <details class="tt-faq-item">
        <summary>Can I download TikTok audio as MP3?</summary>
        <p>Yes — click "Download Audio (MP3)" after pasting your link to save just the music or sound from the video.</p>
      </details>
    </section>

  </main>
</Layout>

<style>
  .tt-page {
    max-width: 780px;
    margin: 0 auto;
    padding: 2rem 1.25rem 5rem;
  }

  /* Hero */
  .tt-hero {
    text-align: center;
    padding: 2.5rem 0 2rem;
  }

  .tt-badge {
    display: inline-block;
    background: rgba(255, 0, 80, 0.1);
    color: #ff0050;
    border: 1px solid rgba(255, 0, 80, 0.25);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.28rem 0.85rem;
    margin-bottom: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tt-title {
    font-size: clamp(1.8rem, 5.5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
  }

  .tt-accent {
    background: linear-gradient(135deg, #ff0050, #ff6b00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tt-subtitle {
    font-size: 1.05rem;
    line-height: 1.65;
    opacity: 0.75;
    max-width: 520px;
    margin: 0 auto;
  }

  /* Tool */
  .tt-tool {
    background: rgba(255, 0, 80, 0.04);
    border: 1px solid rgba(255, 0, 80, 0.15);
    border-radius: 20px;
    padding: 2rem 1.5rem;
    margin: 2rem 0;
  }

  .tt-input-wrap {
    display: flex;
    gap: 10px;
    margin-bottom: 0.75rem;
  }

  #tt-url {
    flex: 1;
    background: #111;
    border: 1px solid #333;
    border-radius: 12px;
    padding: 0.85rem 1rem;
    color: #fff;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
    min-width: 0;
  }

  #tt-url::placeholder { color: #555; }
  #tt-url:focus { border-color: #ff0050; }

  #tt-fetch-btn {
    background: linear-gradient(135deg, #ff0050, #ff6b00);
    color: #fff;
    border: none;
    border-radius: 12px;
    padding: 0.85rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    transition: opacity 0.2s, transform 0.15s;
    flex-shrink: 0;
  }

  #tt-fetch-btn:hover { opacity: 0.9; transform: scale(1.02); }
  #tt-fetch-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

  .tt-spin {
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .tt-hint {
    font-size: 0.82rem;
    opacity: 0.55;
    text-align: center;
    margin-bottom: 0;
  }

  /* Error */
  .tt-error {
    background: rgba(255, 0, 80, 0.08);
    border: 1px solid rgba(255, 0, 80, 0.3);
    border-radius: 10px;
    color: #ff6b8a;
    padding: 0.85rem 1rem;
    font-size: 0.9rem;
    margin-top: 1rem;
  }

  /* Result */
  .tt-result {
    margin-top: 1.5rem;
    border-top: 1px solid #222;
    padding-top: 1.5rem;
  }

  .tt-video-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.25rem;
    align-items: flex-start;
  }

  .tt-cover {
    width: 90px;
    height: 120px;
    object-fit: cover;
    border-radius: 10px;
    flex-shrink: 0;
    background: #1a1a1a;
  }

  .tt-meta-info {
    flex: 1;
    min-width: 0;
  }

  .tt-author {
    font-size: 0.82rem;
    color: #ff0050;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .tt-video-title {
    font-size: 0.9rem;
    line-height: 1.5;
    opacity: 0.85;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .tt-stats {
    font-size: 0.78rem;
    opacity: 0.5;
  }

  .tt-download-btns {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tt-dl-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.85rem 1.25rem;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s;
    cursor: pointer;
  }

  .tt-dl-btn:hover { opacity: 0.9; transform: translateY(-1px); }

  .tt-dl-primary {
    background: linear-gradient(135deg, #ff0050, #ff6b00);
    color: #fff !important;
  }

  .tt-dl-secondary {
    background: #1a1a1a;
    border: 1px solid #333;
    color: #fff !important;
  }

  /* How to */
  .tt-how {
    margin: 2.5rem 0;
  }

  .tt-how h2 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .tt-steps {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tt-step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .tt-step-num {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff0050, #ff6b00);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .tt-step strong {
    display: block;
    font-size: 0.95rem;
    margin-bottom: 0.2rem;
  }

  .tt-step p {
    font-size: 0.875rem;
    opacity: 0.7;
    margin: 0;
    line-height: 1.5;
  }

  /* FAQ */
  .tt-faq {
    margin: 2.5rem 0;
  }

  .tt-faq h2 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .tt-faq-item {
    border: 1px solid #222;
    border-radius: 12px;
    margin-bottom: 0.6rem;
    overflow: hidden;
  }

  .tt-faq-item summary {
    padding: 1rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.15s;
  }

  .tt-faq-item summary:hover { background: rgba(255,255,255,0.03); }

  .tt-faq-item summary::after {
    content: "+";
    font-size: 1.2rem;
    opacity: 0.5;
    flex-shrink: 0;
  }

  .tt-faq-item[open] summary::after { content: "−"; }

  .tt-faq-item p {
    padding: 0 1.25rem 1rem;
    font-size: 0.875rem;
    line-height: 1.65;
    opacity: 0.75;
    margin: 0;
  }

  @media (max-width: 480px) {
    .tt-input-wrap { flex-direction: column; }
    #tt-fetch-btn { width: 100%; justify-content: center; }
  }
</style>

<script>
  const urlInput = document.getElementById('tt-url') as HTMLInputElement;
  const fetchBtn = document.getElementById('tt-fetch-btn') as HTMLButtonElement;
  const btnText = document.getElementById('tt-btn-text')!;
  const btnSpinner = document.getElementById('tt-btn-spinner')!;
  const errorEl = document.getElementById('tt-error')!;
  const resultEl = document.getElementById('tt-result')!;

  const coverEl = document.getElementById('tt-cover') as HTMLImageElement;
  const authorEl = document.getElementById('tt-author')!;
  const titleEl = document.getElementById('tt-video-title')!;
  const statsEl = document.getElementById('tt-stats')!;
  const dlHd = document.getElementById('tt-dl-hd') as HTMLAnchorElement;
  const dlAudio = document.getElementById('tt-dl-audio') as HTMLAnchorElement;

  function setLoading(loading: boolean) {
    fetchBtn.disabled = loading;
    btnText.style.display = loading ? 'none' : 'inline';
    btnSpinner.style.display = loading ? 'inline-flex' : 'none';
  }

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.style.display = 'block';
    resultEl.style.display = 'none';
  }

  function formatNumber(n: number): string {
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
    if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';
    return String(n);
  }

  async function fetchVideo() {
    const url = urlInput.value.trim();
    if (!url) { showError('Please paste a TikTok link first.'); return; }

    errorEl.style.display = 'none';
    resultEl.style.display = 'none';
    setLoading(true);

    try {
      const res = await fetch('/api/tiktok-save/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      });

      const data = await res.json();

      if (!res.ok || data.error) {
        showError(data.error || 'Could not fetch video. Try again.');
        return;
      }

      // Populate result
      coverEl.src = data.cover || '';
      coverEl.alt = data.title || 'TikTok video';
      authorEl.textContent = '@' + data.author;
      titleEl.textContent = data.title;
      statsEl.textContent = `▶ ${formatNumber(data.plays)} plays · ♥ ${formatNumber(data.likes)} likes`;

      dlHd.href = data.videoNoWatermark || data.videoSD || '#';
      dlAudio.href = data.audio || '#';

      if (!data.audio) {
        dlAudio.style.opacity = '0.4';
        dlAudio.style.pointerEvents = 'none';
        dlAudio.textContent = 'Audio not available';
      } else {
        dlAudio.style.opacity = '1';
        dlAudio.style.pointerEvents = 'auto';
      }

      resultEl.style.display = 'block';

    } catch {
      showError('Network error. Check your connection and try again.');
    } finally {
      setLoading(false);
    }
  }

  fetchBtn.addEventListener('click', fetchVideo);

  urlInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') fetchVideo();
  });

  // Auto-paste on focus if clipboard has tiktok link
  urlInput.addEventListener('focus', async () => {
    if (urlInput.value) return;
    try {
      const text = await navigator.clipboard.readText();
      if (text.includes('tiktok.com')) {
        urlInput.value = text;
      }
    } catch { /* clipboard permission denied */ }
  });
</script>
