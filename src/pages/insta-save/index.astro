---
// Instagram Reels Downloader — ReviByte Tool
// Drop this file into your src/pages/ directory as: src/pages/insta-save/index.astro
// Or use it as a component inside an existing page layout
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Instagram Video Downloader — ReviByte Save</title>
  <meta name="description" content="Download Instagram Reels, videos and stories for free — no watermark, no login. By ReviByte." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;800&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #080c14;
      --surface: #0d1322;
      --border: #1a2540;
      --accent: #e8365d;
      --accent2: #ff7043;
      --text: #e8edf5;
      --muted: #6b7a99;
      --mono: 'Space Mono', monospace;
      --sans: 'Syne', sans-serif;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Background grid */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(232,54,93,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(232,54,93,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    .page {
      position: relative;
      z-index: 1;
      max-width: 700px;
      margin: 0 auto;
      padding: 60px 20px 80px;
    }

    /* Header */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--mono);
      font-size: 11px;
      color: var(--accent);
      border: 1px solid rgba(232,54,93,0.3);
      padding: 5px 12px;
      border-radius: 2px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 28px;
    }

    .badge::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    h1 {
      font-size: clamp(2rem, 7vw, 3.2rem);
      font-weight: 800;
      line-height: 1.05;
      letter-spacing: -0.03em;
      margin-bottom: 14px;
    }

    h1 span {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .subtitle {
      color: var(--muted);
      font-size: 15px;
      line-height: 1.6;
      margin-bottom: 48px;
      font-family: var(--mono);
    }

    /* Tool card */
    .tool-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 32px;
      position: relative;
      overflow: hidden;
    }

    .tool-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
    }

    .input-label {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--muted);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 10px;
      display: block;
    }

    .input-row {
      display: flex;
      gap: 10px;
      margin-bottom: 24px;
    }

    #url-input {
      flex: 1;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 14px 16px;
      color: var(--text);
      font-family: var(--mono);
      font-size: 13px;
      outline: none;
      transition: border-color 0.2s;
    }

    #url-input:focus {
      border-color: var(--accent);
    }

    #url-input::placeholder {
      color: var(--muted);
    }

    .btn-fetch {
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 3px;
      padding: 14px 24px;
      font-family: var(--sans);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: opacity 0.2s, transform 0.1s;
      letter-spacing: 0.02em;
    }

    .btn-fetch:hover { opacity: 0.88; }
    .btn-fetch:active { transform: scale(0.98); }
    .btn-fetch:disabled { opacity: 0.4; cursor: not-allowed; }

    /* Status / result area */
    #result {
      display: none;
      margin-top: 4px;
    }

    .result-inner {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 20px;
    }

    .result-meta {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 18px;
    }

    #thumb {
      width: 72px;
      height: 72px;
      object-fit: cover;
      border-radius: 3px;
      border: 1px solid var(--border);
      flex-shrink: 0;
      display: none;
    }

    .result-info {
      flex: 1;
      min-width: 0;
    }

    #result-title {
      font-weight: 600;
      font-size: 14px;
      margin-bottom: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    #result-author {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--muted);
    }

    .download-options {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .dl-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      border: 1px solid var(--border);
      border-radius: 3px;
      background: var(--surface);
      color: var(--text);
      text-decoration: none;
      font-size: 13px;
      font-family: var(--mono);
      transition: border-color 0.2s, background 0.2s;
      cursor: pointer;
    }

    .dl-btn:hover {
      border-color: var(--accent);
      background: rgba(232,54,93,0.05);
    }

    .dl-btn .dl-label { font-weight: 700; }
    .dl-btn .dl-size { color: var(--muted); font-size: 11px; }
    .dl-btn .dl-arrow { color: var(--accent); font-size: 16px; }

    /* Error / loading */
    .status-msg {
      font-family: var(--mono);
      font-size: 12px;
      padding: 14px 16px;
      border-radius: 3px;
      margin-top: 4px;
    }

    .status-msg.error {
      background: rgba(232,54,93,0.08);
      border: 1px solid rgba(232,54,93,0.3);
      color: #ff6b8a;
    }

    .status-msg.loading {
      background: rgba(255,112,67,0.06);
      border: 1px solid rgba(255,112,67,0.2);
      color: var(--accent2);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .spinner {
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255,112,67,0.3);
      border-top-color: var(--accent2);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      flex-shrink: 0;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    /* How it works */
    .how {
      margin-top: 52px;
    }

    .how-title {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--muted);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    @media (max-width: 500px) {
      .steps { grid-template-columns: 1fr; }
      .input-row { flex-direction: column; }
      .btn-fetch { width: 100%; }
    }

    .step {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 18px;
    }

    .step-num {
      font-family: var(--mono);
      font-size: 22px;
      font-weight: 700;
      color: rgba(232,54,93,0.25);
      margin-bottom: 8px;
    }

    .step-text {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.5;
    }

    /* Supported formats */
    .formats {
      margin-top: 16px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .tag {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 4px 10px;
      border: 1px solid var(--border);
      border-radius: 2px;
      color: var(--muted);
    }

    /* Notice */
    .notice {
      margin-top: 32px;
      font-family: var(--mono);
      font-size: 11px;
      color: var(--muted);
      line-height: 1.7;
      border-left: 2px solid var(--border);
      padding-left: 14px;
    }

    /* ReviByte footer link */
    .rb-link {
      margin-top: 48px;
      text-align: center;
      font-family: var(--mono);
      font-size: 11px;
      color: var(--muted);
    }

    .rb-link a {
      color: var(--accent);
      text-decoration: none;
    }
  </style>
</head>

<body>
  <div class="page">

    <div class="badge">ReviByte Save · Tools</div>

    <h1>Download Instagram<br /><span>Videos & Reels</span></h1>
    <p class="subtitle">// Paste any Instagram link. No login. No watermark. Free.</p>

    <div class="tool-card">
      <span class="input-label">// paste instagram url</span>
      <div class="input-row">
        <input
          type="text"
          id="url-input"
          placeholder="https://www.instagram.com/reel/..."
          autocomplete="off"
          spellcheck="false"
        />
        <button class="btn-fetch" id="fetch-btn" onclick="handleFetch()">Download</button>
      </div>

      <div id="status"></div>
      <div id="result"></div>
    </div>

    <div class="formats">
      <span class="tag">Reels</span>
      <span class="tag">Videos</span>
      <span class="tag">Stories</span>
      <span class="tag">IGTV</span>
      <span class="tag">MP4</span>
      <span class="tag">No Watermark</span>
    </div>

    <div class="how">
      <p class="how-title">// how it works</p>
      <div class="steps">
        <div class="step">
          <div class="step-num">01</div>
          <div class="step-text">Copy the Instagram video or Reel link from the app or browser</div>
        </div>
        <div class="step">
          <div class="step-num">02</div>
          <div class="step-text">Paste the URL above and tap Download — we fetch it instantly</div>
        </div>
        <div class="step">
          <div class="step-num">03</div>
          <div class="step-text">Choose your quality and save the MP4 directly to your device</div>
        </div>
      </div>
    </div>

    <p class="notice">
      ⚠ Only download content you have permission to save.<br />
      ReviByte does not store, host, or redistribute any downloaded media.<br />
      This tool is for personal, offline use only.
    </p>

    <p class="rb-link">
      Part of <a href="https://www.revibyte.blog">ReviByte</a> Tools ·
      <a href="https://www.revibyte.blog/save-tok/">TikTok Downloader</a>
    </p>

  </div>

  <script>
    // ─── CONFIG ────────────────────────────────────────────────
    // ReviByte uses RapidAPI for media downloaders.
    // Sign up at rapidapi.com and subscribe to:
    //   "Instagram Downloader" by "ytjar" or "social-media-video-downloader"
    // Then replace the values below with your own key + host.
    const RAPIDAPI_KEY  = 'YOUR_RAPIDAPI_KEY_HERE';
    const RAPIDAPI_HOST = 'instagram-downloader-download-instagram-videos-stories.p.rapidapi.com';

    // ─── HELPERS ───────────────────────────────────────────────
    function setStatus(html, type = '') {
      const el = document.getElementById('status');
      el.innerHTML = html ? `<div class="status-msg ${type}">${html}</div>` : '';
    }

    function showResult(data) {
      const result = document.getElementById('result');
      const { title, author, thumb, links } = data;

      // Thumb
      let thumbHTML = '';
      if (thumb) {
        thumbHTML = `<img id="thumb" src="${thumb}" alt="thumbnail" style="display:block" />`;
      }

      // Download buttons
      const btns = links.map((l, i) =>
        `<a class="dl-btn" href="${l.url}" target="_blank" rel="noopener noreferrer" download>
          <span class="dl-label">${l.label || `Video ${i + 1}`}</span>
          <span class="dl-size">${l.quality || 'MP4'}</span>
          <span class="dl-arrow">↓</span>
        </a>`
      ).join('');

      result.style.display = 'block';
      result.innerHTML = `
        <div class="result-inner">
          <div class="result-meta">
            ${thumbHTML}
            <div class="result-info">
              <div id="result-title">${title || 'Instagram Video'}</div>
              <div id="result-author">${author ? '@ ' + author : ''}</div>
            </div>
          </div>
          <div class="download-options">${btns}</div>
        </div>
      `;
    }

    function hideResult() {
      const result = document.getElementById('result');
      result.style.display = 'none';
      result.innerHTML = '';
    }

    function isValidInstagramURL(url) {
      return /instagram\.com\/(reel|p|tv|stories)\//.test(url);
    }

    // ─── MAIN FETCH ────────────────────────────────────────────
    async function handleFetch() {
      const input = document.getElementById('url-input');
      const btn   = document.getElementById('fetch-btn');
      const url   = input.value.trim();

      hideResult();
      setStatus('');

      if (!url) {
        setStatus('Paste an Instagram URL first.', 'error');
        return;
      }

      if (!isValidInstagramURL(url)) {
        setStatus('That doesn\'t look like an Instagram video link. Try a Reel, post, or story URL.', 'error');
        return;
      }

      // Check API key configured
      if (RAPIDAPI_KEY === 'YOUR_RAPIDAPI_KEY_HERE') {
        // Demo mode — show a mock result so you can test the UI
        setStatus(`<div class="spinner"></div> Fetching...`, 'loading');
        await new Promise(r => setTimeout(r, 1400));
        setStatus('');
        showResult({
          title: 'Instagram Reel',
          author: 'username',
          thumb: null,
          links: [
            { url: '#', label: 'Download HD', quality: '1080p · MP4' },
            { url: '#', label: 'Download SD', quality: '480p · MP4' },
          ]
        });
        return;
      }

      // Real API call
      btn.disabled = true;
      setStatus(`<div class="spinner"></div> Fetching video info...`, 'loading');

      try {
        const apiUrl = `https://${RAPIDAPI_HOST}/index?url=${encodeURIComponent(url)}`;
        const res = await fetch(apiUrl, {
          method: 'GET',
          headers: {
            'x-rapidapi-key': RAPIDAPI_KEY,
            'x-rapidapi-host': RAPIDAPI_HOST,
          }
        });

        if (!res.ok) throw new Error(`API error: ${res.status}`);
        const data = await res.json();

        // Normalize response — adjust keys to match your chosen API's response shape
        const media = data?.media || data?.result || data;
        const links = [];

        if (Array.isArray(media?.links)) {
          media.links.forEach(l => links.push({ url: l.link || l.url, label: l.type || 'Download', quality: l.quality || 'MP4' }));
        } else if (media?.video) {
          links.push({ url: media.video, label: 'Download Video', quality: 'MP4' });
        } else if (data?.url) {
          links.push({ url: data.url, label: 'Download Video', quality: 'MP4' });
        }

        if (!links.length) throw new Error('No downloadable links found.');

        setStatus('');
        showResult({
          title: media?.title || media?.caption || 'Instagram Video',
          author: media?.owner?.username || media?.username || '',
          thumb: media?.thumbnail || media?.thumbnail_url || '',
          links,
        });

      } catch (err) {
        setStatus(`Could not fetch that video. Make sure the account is public and the URL is correct.<br><span style="opacity:0.5">${err.message}</span>`, 'error');
      } finally {
        btn.disabled = false;
      }
    }

    // Allow Enter key
    document.getElementById('url-input').addEventListener('keydown', e => {
      if (e.key === 'Enter') handleFetch();
    });
  </script>
</body>
</html>
