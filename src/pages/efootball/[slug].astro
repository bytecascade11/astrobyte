---
// src/pages/efootball/[slug].astro
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";

export async function getStaticPaths() {
  const guides = await getCollection("efootball", ({ data }) => !data.draft);

  return guides.map(guide => ({
    params: { slug: guide.data.slug ?? guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

let relatedGuides: CollectionEntry<"efootball">[] = [];
if (guide.data.relatedSlugs?.length) {
  const all = await getCollection("efootball", ({ data }) => !data.draft);
  relatedGuides = all.filter(g =>
    guide.data.relatedSlugs!.includes(g.data.slug ?? g.id)
  );
}

const pageTitle = `${guide.data.title} | ${SITE.title}`;
const pageDesc = guide.data.description;

const typeLabels: Record<string, string> = {
  formation: "Formation Guide",
  guide: "Guide",
  "tier-list": "Tier List",
  "player-review": "Player Review",
  news: "News",
};
const typeLabel = typeLabels[guide.data.type] ?? "Guide";
---

<Layout title={pageTitle} description={pageDesc}>
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-16">

    <!-- Breadcrumb -->
    <nav class="pt-6 pb-2 text-sm flex items-center gap-1.5 breadcrumb-nav">
      <a href="/" class="hover:text-skin-accent transition-colors">Home</a>
      <span>/</span>
      <a href="/efootball/" class="hover:text-skin-accent transition-colors">eFootball</a>
      <span>/</span>
      <span>{typeLabel}</span>
    </nav>

    <!-- Cover Image -->
    {guide.data.coverImage && (
      <div class="mb-6 mt-2 overflow-hidden rounded-xl">
        <img
          src={guide.data.coverImage}
          alt={guide.data.coverImageAlt ?? guide.data.title}
          class="w-full object-cover max-h-72"
          loading="eager"
        />
      </div>
    )}

    <!-- Header -->
    <header class="mb-8">
      <div class="flex flex-wrap gap-2 mb-3">
        <span class="badge badge--accent">⚽ eFootball 2026</span>
        <span class="badge">{typeLabel}</span>
        {guide.data.formation && (
          <span class="badge">{guide.data.formation}</span>
        )}
        {guide.data.division && (
          <span class="badge">{guide.data.division}</span>
        )}
        {guide.data.version && (
          <span class="badge">📅 {guide.data.version}</span>
        )}
      </div>

      <h1 class="text-3xl font-bold leading-tight mb-3">
        {guide.data.title}
      </h1>

      <p class="post-desc text-lg leading-relaxed">
        {guide.data.description}
      </p>

      <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm post-meta">
        <span>By {guide.data.author}</span>
        <span>
          {new Date(guide.data.pubDatetime).toLocaleDateString("en-NG", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </span>
        {guide.data.lastUpdated && (
          <span>🔄 Updated: {guide.data.lastUpdated}</span>
        )}
      </div>
    </header>

    <!-- Main Content -->
    <article class="prose prose-revibyte max-w-none">
      <Content />
    </article>

    <!-- Related Guides -->
    {relatedGuides.length > 0 && (
      <section class="mt-12 border-t border-skin-line pt-8">
        <h2 class="text-lg font-semibold mb-4">📎 Related Guides</h2>
        <ul class="space-y-3">
          {relatedGuides.map(related => (
            <li>
              <a
                href={`/efootball/${related.data.slug ?? related.id}/`}
                class="group flex items-start gap-3 rounded-lg border border-skin-line p-3 hover:border-skin-accent transition-colors"
              >
                <span class="text-xl shrink-0">⚽</span>
                <div>
                  <p class="font-medium text-sm group-hover:text-skin-accent transition-colors">
                    {related.data.title}
                  </p>
                  <p class="text-xs post-meta mt-0.5">
                    {related.data.description}
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Back link -->
    <div class="mt-10">
      <a
        href="/efootball/"
        class="text-sm text-skin-accent hover:underline flex items-center gap-1"
      >
        ← Back to eFootball Hub
      </a>
    </div>

  </main>
</Layout>


@import "tailwindcss";
@import "./typography.css";

/* ========================= */
/* THEME REGISTRATION        */
/* ========================= */
@theme {
  --color-foreground: var(--foreground);
  --color-accent: var(--accent);
  --color-background-dark: var(--background-dark);
  --color-background-light: var(--background-light);
  --color-border: var(--border);
  --color-muted: var(--muted);
}

/* ========================= */
/* THEME VARIABLES           */
/* ========================= */
:root,
html[data-theme="light"] {
  --foreground: #282728;
  --accent: #006cac;
  --background-dark: #ffffff;
  --background-light: #e2e8f0;
  --border: #e2e8f0;
  --muted: rgba(107, 114, 128, 1);
}

html[data-theme="dark"] {
  --foreground: #eaedf3;
  --accent: #ff6b01;
  --background-dark: #020617;
  --background-light: #1e293b;
  --border: #334155;
  --muted: rgba(156, 163, 175, 1);
}

/* ========================= */
/* BODY BASE                 */
/* ========================= */
html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  width: 100%;
  font-family: monospace;
  font-size: 1.0625rem;
  overflow-x: hidden;
}

body {
  display: flex;
  flex-direction: column;
  min-height: 100svh;
  color: var(--foreground);
  position: relative;
  background: linear-gradient(-45deg, var(--background-dark), #0f172a, var(--background-light), var(--background-dark));
  background-size: 400% 400%;
  animation: gradientMove 15s ease infinite;
}

html[data-theme="light"] body {
  background: linear-gradient(-45deg, #e2e8f0, #f1f5f9, #dbeafe, #e2e8f0);
  background-size: 400% 400%;
  animation: gradientMove 15s ease infinite;
}

/* ========================= */
/* BACKGROUND TEXT — REVIBYTE */
/* ========================= */
body::before {
  content: "REVIBYTE";
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-20deg);
  font-size: clamp(5rem, 20vw, 16rem);
  font-weight: 900;
  letter-spacing: 0.4rem;
  text-transform: uppercase;
  white-space: nowrap;
  pointer-events: none;
  z-index: 0;
  color: rgba(255, 255, 255, 0.04);
  animation: pulseText 5s ease-in-out infinite;
}

html[data-theme="light"] body::before {
  color: rgba(0, 108, 172, 0.05);
  animation: pulseText 5s ease-in-out infinite;
}

/* ========================= */
/* GLOW BLOBS                */
/* ========================= */
body::after {
  content: "";
  position: fixed;
  inset: 0;
  background:
    radial-gradient(circle at 20% 30%, rgba(0,108,172,0.08), transparent 40%),
    radial-gradient(circle at 80% 70%, rgba(255,107,1,0.08), transparent 40%);
  filter: blur(80px);
  opacity: 0.3;
  pointer-events: none;
  z-index: 0;
}

html[data-theme="light"] body::after {
  background:
    radial-gradient(circle at 20% 30%, rgba(0,108,172,0.05), transparent 40%),
    radial-gradient(circle at 80% 70%, rgba(255,107,1,0.05), transparent 40%);
  opacity: 0.3;
}

/* ========================= */
/* FIX: CONTENT ABOVE BLOBS  */
/* ========================= */
header, main, footer, section {
  position: relative;
  z-index: 1;
}

/* ========================= */
/* LINKS AND BUTTONS         */
/* ========================= */
a, button {
  outline-offset: 1px;
  outline: 2px dashed var(--accent);
  text-decoration: none;
}

button:not(:disabled),
[role="button"]:not(:disabled) {
  cursor: pointer;
}

/* ========================= */
/* CONTAINER / MAX WIDTH     */
/* ========================= */
section, footer, main {
  max-width: 48rem;
  margin-left: auto;
  margin-right: auto;
  padding-left: 1rem;
  padding-right: 1rem;
}

/* ========================= */
/* SCROLL MARGIN FOR ANCHORS */
/* ========================= */
:target {
  scroll-margin-block: 1rem;
}

/* ========================= */
/* ANIMATIONS                */
/* ========================= */
@keyframes gradientMove {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes pulseText {
  0%, 100% { opacity: 1; transform: translate(-50%, -50%) rotate(-20deg) scale(1); }
  50% { opacity: 0.4; transform: translate(-50%, -50%) rotate(-20deg) scale(1.03); }
}

/* ========================= */
/* PWA — HIDE SITE HEADER    */
/* ========================= */
@media (display-mode: standalone) {
  header,
  header * {
    display: none !important;
    visibility: hidden !important;
    height: 0 !important;
    min-height: 0 !important;
    max-height: 0 !important;
    overflow: hidden !important;
    padding: 0 !important;
    margin: 0 !important;
    border: none !important;
    pointer-events: none !important;
    opacity: 0 !important;
  }

  body {
    padding-top: 56px !important;
    padding-bottom: 64px !important;
  }
}

@media (display-mode: standalone) and (min-width: 768px) {
  header,
  header * {
    display: revert !important;
    visibility: visible !important;
    height: auto !important;
    min-height: revert !important;
    max-height: revert !important;
    overflow: revert !important;
    padding: revert !important;
    margin: revert !important;
    border: revert !important;
    pointer-events: auto !important;
    opacity: 1 !important;
  }

  body {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }
}

/* ========================= */
/* DARK MODE TEXT FIX        */
/* ========================= */

/* Article card text */
[data-theme="dark"] .article-card {
  color: var(--foreground);
}

[data-theme="dark"] .article-card p,
[data-theme="dark"] .article-card h1,
[data-theme="dark"] .article-card h2,
[data-theme="dark"] .article-card h3,
[data-theme="dark"] .article-card h4,
[data-theme="dark"] .article-card li,
[data-theme="dark"] .article-card strong,
[data-theme="dark"] .article-card blockquote,
[data-theme="dark"] .article-card span,
[data-theme="dark"] .article-card td,
[data-theme="dark"] .article-card th {
  color: var(--foreground);
}

[data-theme="dark"] .article-card a {
  color: var(--accent);
}

[data-theme="dark"] .article-card code {
  background: var(--background-light);
  color: var(--foreground);
}

[data-theme="dark"] .article-card h3 {
  color: #818cf8;
}

/* Author card text */
[data-theme="dark"] .author-card {
  color: var(--foreground);
}

[data-theme="dark"] .author-name,
[data-theme="dark"] .author-bio {
  color: var(--foreground);
}

[data-theme="dark"] .author-link {
  color: var(--accent);
}

/* Prev/Next text */
[data-theme="dark"] .prevnext-title {
  color: var(--foreground);
    }
/* ========================= */
/* GAMING PAGES DARK MODE    */
/* ========================= */

/* Breadcrumb */
.breadcrumb-nav {
  color: var(--foreground);
  opacity: 0.6;
}
.breadcrumb-nav a {
  color: var(--foreground);
  opacity: 1;
}
.breadcrumb-nav a:hover {
  color: var(--accent);
  opacity: 1;
}

/* Description and meta */
.post-desc {
  color: var(--foreground);
  opacity: 0.75;
}
.post-meta {
  color: var(--foreground);
  opacity: 0.6;
}

/* Badges */
.badge {
  font-size: 0.72rem;
  font-weight: 600;
  padding: 0.2rem 0.65rem;
  border-radius: 9999px;
  background: var(--background-light);
  color: var(--foreground);
  border: 1px solid var(--border);
}
.badge--accent {
  color: var(--accent);
  border-color: var(--accent);
}

/* Hub index pages — card titles and descriptions */
[data-theme="dark"] .codm-hub a,
[data-theme="dark"] .efootball-hub a {
  color: var(--foreground);
}

[data-theme="dark"] .codm-hub h3,
[data-theme="dark"] .efootball-hub h3 {
  color: var(--foreground);
}

[data-theme="dark"] .codm-hub p,
[data-theme="dark"] .efootball-hub p {
  color: var(--foreground);
}
