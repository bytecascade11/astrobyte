---
// src/pages/efootball/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";

const allGuides = await getCollection("efootball", ({ data }) => !data.draft);

const sorted = allGuides.sort(
  (a, b) =>
    new Date(b.data.pubDatetime).getTime() -
    new Date(a.data.pubDatetime).getTime()
);

// Group by type
const formations = sorted.filter(g => g.data.type === "formation");
const tierLists = sorted.filter(g => g.data.type === "tier-list");
const guides = sorted.filter(g => g.data.type === "guide");
const playerReviews = sorted.filter(g => g.data.type === "player-review");
const news = sorted.filter(g => g.data.type === "news");

const pageTitle = "eFootball 2026 Guides, Formations & Player Reviews";
const pageDesc =
  "Your complete eFootball 2026 resource — best formations, top players per division, squad-building tips, and event guides updated with every patch.";
---

<Layout title={`${pageTitle} | ${SITE.title}`} description={pageDesc}>
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">

    <!-- Hero Header -->
    <section class="mb-10 pt-8">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-3xl">⚽</span>
        <h1 class="text-3xl font-bold tracking-tight">eFootball 2026 Hub</h1>
      </div>
      <p class="text-skin-base/70 text-lg">
        {pageDesc}
      </p>
    </section>

    <!-- Formations Section -->
    {formations.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 border-b border-skin-line pb-2">
          🧩 Formation Guides
        </h2>
        <ul class="space-y-4">
          {formations.map(guide => (
            <li>
              <a
                href={`/efootball/${guide.data.slug ?? guide.id}/`}
                class="group block rounded-lg border border-skin-line p-4 hover:border-skin-accent transition-colors"
              >
                <div class="flex items-start justify-between gap-2">
                  <h3 class="font-medium group-hover:text-skin-accent transition-colors">
                    {guide.data.title}
                  </h3>
                  {guide.data.formation && (
                    <span class="shrink-0 text-xs bg-skin-card px-2 py-0.5 rounded-full text-skin-base/60">
                      {guide.data.formation}
                    </span>
                  )}
                </div>
                <p class="text-sm text-skin-base/60 mt-1">{guide.data.description}</p>
                {guide.data.division && (
                  <span class="mt-2 inline-block text-xs text-skin-accent">
                    {guide.data.division}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Tier Lists -->
    {tierLists.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 border-b border-skin-line pb-2">
          📊 Tier Lists
        </h2>
        <ul class="space-y-4">
          {tierLists.map(guide => (
            <li>
              <a
                href={`/efootball/${guide.data.slug ?? guide.id}/`}
                class="group block rounded-lg border border-skin-line p-4 hover:border-skin-accent transition-colors"
              >
                <div class="flex items-start justify-between gap-2">
                  <h3 class="font-medium group-hover:text-skin-accent transition-colors">
                    {guide.data.title}
                  </h3>
                  {guide.data.version && (
                    <span class="shrink-0 text-xs bg-skin-card px-2 py-0.5 rounded-full text-skin-base/60">
                      {guide.data.version}
                    </span>
                  )}
                </div>
                <p class="text-sm text-skin-base/60 mt-1">{guide.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Player Reviews -->
    {playerReviews.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 border-b border-skin-line pb-2">
          ⭐ Player Reviews
        </h2>
        <ul class="space-y-4">
          {playerReviews.map(guide => (
            <li>
              <a
                href={`/efootball/${guide.data.slug ?? guide.id}/`}
                class="group block rounded-lg border border-skin-line p-4 hover:border-skin-accent transition-colors"
              >
                <h3 class="font-medium group-hover:text-skin-accent transition-colors">
                  {guide.data.title}
                </h3>
                <p class="text-sm text-skin-base/60 mt-1">{guide.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- General Guides -->
    {guides.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 border-b border-skin-line pb-2">
          📖 Guides & Tips
        </h2>
        <ul class="space-y-4">
          {guides.map(guide => (
            <li>
              <a
                href={`/efootball/${guide.data.slug ?? guide.id}/`}
                class="group block rounded-lg border border-skin-line p-4 hover:border-skin-accent transition-colors"
              >
                <h3 class="font-medium group-hover:text-skin-accent transition-colors">
                  {guide.data.title}
                </h3>
                <p class="text-sm text-skin-base/60 mt-1">{guide.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- News -->
    {news.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 border-b border-skin-line pb-2">
          📰 Latest News
        </h2>
        <ul class="space-y-4">
          {news.map(guide => (
            <li>
              <a
                href={`/efootball/${guide.data.slug ?? guide.id}/`}
                class="group block rounded-lg border border-skin-line p-4 hover:border-skin-accent transition-colors"
              >
                <h3 class="font-medium group-hover:text-skin-accent transition-colors">
                  {guide.data.title}
                </h3>
                <p class="text-sm text-skin-base/60 mt-1">{guide.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Empty State -->
    {sorted.length === 0 && (
      <p class="text-center text-skin-base/50 py-20">
        Guides coming soon. Check back shortly.
      </p>
    )}

  </main>
</Layout>
