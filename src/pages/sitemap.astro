---
import BaseLayout from '../layouts/BaseLayout.astro';

// Glob all blog post Markdown files (adjust path if your posts are in src/content/blog/ or src/content/posts/)
const posts = await Astro.glob('../content/blog/**/*.md');  // Common path in AstroPaper forks; change if needed (e.g., '../content/posts/**/*.md')

// Sort by newest first (using pubDatetime from frontmatter)
posts.sort((a, b) => new Date(b.frontmatter.pubDatetime).getTime() - new Date(a.frontmatter.pubDatetime).getTime());
---

<BaseLayout title="Sitemap" description="Complete list of all pages and posts on the site">
  <main class="max-w-4xl mx-auto px-6 py-12 prose prose-lg dark:prose-invert">
    <h1 class="text-4xl font-bold mb-8">Sitemap</h1>
    <p class="mb-12">A complete overview of all content on the site.</p>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Main Pages</h2>
      <ul class="list-disc pl-6 space-y-2">
        <li><a href="/">Home</a></li>
        <li><a href="/blog">Blog</a></li> <!-- Or /posts if your blog index is there -->
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/tags">Tags</a></li>
        <!-- Add more static pages as needed -->
      </ul>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">All Blog Posts</h2>
      <ul class="list-disc pl-6 space-y-2">
        {posts.map((post) => (
          <li>
            <a href={post.url}>
              {post.frontmatter.title}
            </a>
            <small class="text-gray-600 dark:text-gray-400">
              — {new Date(post.frontmatter.pubDatetime).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </small>
          </li>
        ))}
      </ul>
      {posts.length === 0 && <p>No posts found. Check the glob path.</p>}
    </section>
  </main>
</BaseLayout>
