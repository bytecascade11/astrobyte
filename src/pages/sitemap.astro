---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import BackButton from "@/components/BackButton.astro";

const title = "Sitemap – ReviByte Opinions";
const description = "Complete clickable sitemap of all blog posts and pages on ReviByte Opinions.";

const posts = await getCollection("blog");

const sortedPosts = posts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());

// Content hubs: each is its own Astro content collection, living at /<hub>/<slug>/
const hubs = [
  { name: "codm", label: "COD Mobile" },
  { name: "efootball", label: "eFootball" },
  { name: "pubgmobile", label: "PUBG Mobile" },
  { name: "mlbb", label: "MLBB" },
  { name: "itel", label: "Itel" },
  { name: "samsung", label: "Samsung" },
  { name: "xiaomi", label: "Xiaomi" },
  { name: "tecno", label: "Tecno" },
  { name: "motorola", label: "Motorola" },
  { name: "huawei", label: "Huawei" },
  { name: "honor", label: "Honor" },
  { name: "oneplus", label: "OnePlus" },
  { name: "pixel", label: "Pixel" },
  { name: "nothing", label: "Nothing" },
  { name: "apple", label: "Apple" },
];

const hubData = await Promise.all(
  hubs.map(async (hub) => {
    let entries = [];
    try {
      entries = await getCollection(hub.name);
    } catch {
      entries = [];
    }

    const sorted = entries
      .filter((entry) => !entry.data.draft)
      .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());

    return { ...hub, posts: sorted };
  })
);
---

<Layout title={title} description={description}>
  <div style="max-width:56rem; margin: 1rem auto; padding: 0 1rem;">
    <BackButton />
  </div>
  <article class="prose prose-lg mx-auto max-w-4xl px-6 py-12 dark:prose-invert">
    <h1 class="text-4xl font-bold mb-8">Sitemap</h1>
    <p class="mb-12 text-lg">Click any title to read the full post.</p>

    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6">Main Pages</h2>
      <ul class="list-disc pl-8 space-y-3 text-lg">
        <li><a href="/">Home</a></li>
        <li><a href="/posts/">All Posts</a></li>
        <li><a href="/tools/">ReviByte Tools</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/tags/">Tags</a></li>
      </ul>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6">All Blog Posts ({sortedPosts.length})</h2>

      {sortedPosts.length === 0 ? (
        <p>No posts found.</p>
      ) : (
        <ul class="list-disc pl-8 space-y-4">
          {sortedPosts.map((post) => (
            <li class="leading-relaxed">
              <a href={`/posts/${post.id}/`} class="font-medium text-lg">
                {post.data.title}
              </a>
              <br />
              <small>
                {post.data.pubDatetime.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </small>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6">Content Hubs</h2>

      {hubData.map((hub) => (
        <div class="mb-12">
          <h3 class="text-xl font-semibold mb-4">
            <a href={`/${hub.name}/`}>{hub.label} Hub</a> ({hub.posts.length})
          </h3>

          {hub.posts.length === 0 ? (
            <p class="text-sm italic">No posts yet.</p>
          ) : (
            <ul class="list-disc pl-8 space-y-3">
              {hub.posts.map((entry) => (
                <li class="leading-relaxed">
                  <a href={`/${hub.name}/${entry.id}/`} class="font-medium">
                    {entry.data.title}
                  </a>
                  <br />
                  <small>
                    {entry.data.pubDatetime.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </small>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </section>
  </article>
</Layout>
<style>
  /* Light mode text */
  article.prose p,
  article.prose li,
  article.prose dd,
  article.prose dt,
  article.prose h1,
  article.prose h2,
  article.prose h3,
  article.prose blockquote,
  article.prose strong {
    color: #1a1a1a !important;
    opacity: 1 !important;
  }

  article.prose a {
    color: #006cac !important;
  }

  /* Dark mode text */
  html[data-theme="dark"] article.prose p,
  html[data-theme="dark"] article.prose li,
  html[data-theme="dark"] article.prose dd,
  html[data-theme="dark"] article.prose dt,
  html[data-theme="dark"] article.prose h1,
  html[data-theme="dark"] article.prose h2,
  html[data-theme="dark"] article.prose h3,
  html[data-theme="dark"] article.prose blockquote,
  html[data-theme="dark"] article.prose strong {
    color: #eaedf3 !important;
    opacity: 1 !important;
  }

  html[data-theme="dark"] article.prose a {
    color: #ff6b01 !important;
  }
</style>
