---
// src/pages/sitemap.astro

import type { MarkdownInstance } from 'astro';

// Define your post frontmatter structure
interface Frontmatter {
  title: string;
  pubDatetime: string | Date;
  // Add more fields if needed (description, tags, etc.)
}

// Load posts — adjust path if your posts are elsewhere
const rawPosts = await Astro.glob<Frontmatter>('../data/blog/**/*.md');

// Keep only posts that Astro can generate a URL for (excludes drafts, etc.)
const posts = rawPosts
  .filter((post): post is MarkdownInstance<Frontmatter> & { url: string } => !!post.url)
  // Sort newest first
  .sort((a, b) => 
    new Date(b.frontmatter.pubDatetime).getTime() - 
    new Date(a.frontmatter.pubDatetime).getTime()
  );
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sitemap - ReviByte Opinions</title>
    <meta name="description" content="Complete clickable sitemap of all blog posts and pages" />
    <link rel="stylesheet" href="/global.css" />
  </head>
  <body class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 min-h-screen">
    <main class="max-w-4xl mx-auto px-6 py-12 prose prose-lg dark:prose-invert">
      <h1 class="text-4xl font-bold mb-8">Sitemap</h1>
      <p class="mb-12 text-lg text-slate-600 dark:text-slate-400">
        Click any title or date to read the full post.
      </p>

      <section class="mb-16">
        <h2 class="text-2xl font-semibold mb-6">Main Pages</h2>
        <ul class="list-disc pl-8 space-y-3 text-lg">
          <li><a href="/" class="text-blue-600 dark:text-blue-400 hover:underline">Home</a></li>
          <li><a href="/posts" class="text-blue-600 dark:text-blue-400 hover:underline">All Posts</a></li>
          <li><a href="/about" class="text-blue-600 dark:text-blue-400 hover:underline">About</a></li>
          <li><a href="/contact" class="text-blue-600 dark:text-blue-400 hover:underline">Contact</a></li>
          <li><a href="/tags" class="text-blue-600 dark:text-blue-400 hover:underline">Tags</a></li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-semibold mb-6">All Blog Posts ({posts.length})</h2>

        {posts.length === 0 ? (
          <p class="text-red-600 dark:text-red-400">
            No posts found. Check that your posts are in <code>../data/blog/</code> 
            and have valid frontmatter with <code>pubDatetime</code>.
          </p>
        ) : (
          <ul class="list-disc pl-8 space-y-5">
            {posts.map((post) => {
              const formattedDate = new Date(post.frontmatter.pubDatetime).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              });

              return (
                <li class="leading-relaxed">
                  <div class="flex flex-col sm:flex-row sm:items-baseline gap-2">
                    <!-- Clickable Title -->
                    <a 
                      href={post.url}
                      class="text-blue-600 dark:text-blue-400 hover:underline font-medium text-lg"
                    >
                      {post.frontmatter.title}
                    </a>

                    <!-- Clickable Date -->
                    <a 
                      href={post.url}
                      class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 hover:underline text-sm transition"
                    >
                      {formattedDate}
                    </a>
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    </main>
  </body>
</html>
