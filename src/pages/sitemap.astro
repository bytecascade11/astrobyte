---
const posts = await Astro.glob('../content/blog/**/*.md');  // Change to '../data/blog/**/*.md' if your posts are there

posts.sort((a, b) => new Date(b.frontmatter.pubDatetime).getTime() - new Date(a.frontmatter.pubDatetime).getTime());
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sitemap - Your Site Name</title>
    <meta name="description" content="Complete list of all pages and posts" />
    <link rel="stylesheet" href="/global.css" /> <!-- AstroPaper's global styles -->
    <link rel="stylesheet" href="/theme.css" /> <!-- If you have theme.css -->
  </head>
  <body class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100">
    <main class="max-w-4xl mx-auto px-6 py-12 prose prose-lg dark:prose-invert">
      <h1 class="text-4xl font-bold mb-8">Sitemap</h1>
      <p class="mb-12">A complete overview of all content on the site.</p>

      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-4">Main Pages</h2>
        <ul class="list-disc pl-6 space-y-2">
          <li><a href="/">Home</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/tags">Tags</a></li>
        </ul>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-4">All Blog Posts</h2>
        <ul class="list-disc pl-6 space-y-2">
          {posts.length === 0 && <p>No posts found — check the glob path.</p>}
          {posts.map((post) => (
            <li>
              <a href={post.url}>
                {post.frontmatter.title}
              </a>
              <small class="text-gray-600 dark:text-gray-400">
                — {new Date(post.frontmatter.pubDatetime).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </small>
            </li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>
