---
import type { MarkdownInstance } from 'astro';

interface Frontmatter {
  title: string;
  pubDatetime: string | Date;
}

// Try multiple common paths — change or comment out as needed
let rawPosts: MarkdownInstance<Frontmatter>[] = [];

// Primary: Current AstroPaper default
rawPosts = await Astro.glob<Frontmatter>('../data/blog/**/*.md');

// Fallback 1: Older AstroPaper or custom setups
if (rawPosts.length === 0) {
  rawPosts = await Astro.glob<Frontmatter>('../content/blog/**/*.md');
}

// Fallback 2: Content collections
if (rawPosts.length === 0) {
  rawPosts = await Astro.glob<Frontmatter>('../../src/content/blog/**/*.md');
}

const posts = rawPosts
  .filter((post): post is MarkdownInstance<Frontmatter> & { url: string } => !!post.url)
  .sort((a, b) => 
    new Date(b.frontmatter.pubDatetime).getTime() - 
    new Date(a.frontmatter.pubDatetime).getTime()
  );
---
