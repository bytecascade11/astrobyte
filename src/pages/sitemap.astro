---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Get all blog posts and sort by newest first
const posts = await getCollection('blog');
posts.sort((a, b) => 
  new Date(b.data.pubDatetime).getTime() - new Date(a.data.pubDatetime).getTime()
);
---

<BaseLayout title="Sitemap" description="Complete list of all pages and posts on the site">
  <main class="max-w-4xl mx-auto px-6 py-12 prose prose-lg dark:prose-invert">
    <h1 class="text-4xl font-bold mb-8">Sitemap</h1>
    <p class="mb-12">A complete overview of all content on the site.</p>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Main Pages</h2>
      <ul class="list-disc pl-6 space-y-2">
        <li><a href="/">Home</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/tags">Tags</a></li>
        <!-- Add or remove based on your actual pages -->
      </ul>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">All Blog Posts</h2>
      <ul class="list-disc pl-6 space-y-2">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>
              {post.data.title}
            </a>
            <small class="text-gray-600 dark:text-gray-400">
              — {new Date(post.data.pubDatetime).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </small>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>
