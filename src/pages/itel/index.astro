---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";

const allPosts = await getCollection("itel", ({ data }) => !data.draft);
const sorted = allPosts.sort(
  (a, b) => new Date(b.data.pubDatetime).getTime() - new Date(a.data.pubDatetime).getTime()
);

const reviews      = sorted.filter(g => g.data.type === "review");
const comparisons  = sorted.filter(g => g.data.type === "comparison");
const buyingGuides = sorted.filter(g => g.data.type === "buying-guide");
const news         = sorted.filter(g => g.data.type === "news");

const pageTitle = "itel Phone Reviews, Prices & Buying Guides";
const pageDesc  = "Your complete itel resource — hands-on reviews, price comparisons in naira, and buying guides for the Nigerian market.";
---

<Layout title={`${pageTitle} | ${SITE.title}`} description={pageDesc}>
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">

    <div class="pt-5 pb-1">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-skin-accent hover:underline">
        <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Go to Home
      </a>
    </div>

    <section class="mb-10 pt-4">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-3xl">📱</span>
        <h1 class="text-3xl font-bold tracking-tight">itel Phone Hub</h1>
      </div>
      <p class="text-skin-base/70 text-lg">{pageDesc}</p>
    </section>

    {reviews.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 border-b border-skin-line pb-2">📝 Reviews</h2>
        <ul class="space-y-4">
          {reviews.map(post => (
            <li>
              <a href={`/itel/${post.data.slug ?? post.id}/`}
                class="group flex gap-3 rounded-lg border border-skin-line p-3 hover:border-skin-accent transition-colors">
                {post.data.coverImage && (
                  <img src={post.data.coverImage} alt={post.data.coverImageAlt ?? post.data.title}
                    class="hub-thumb" loading="lazy" width="1200" height="630" />
                )}
                <div class="flex-1 min-w-0">
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="font-medium group-hover:text-skin-accent transition-colors line-clamp-2">{post.data.title}</h3>
                    {post.data.model && (
                      <span class="shrink-0 text-xs bg-skin-card px-2 py-0.5 rounded-full text-skin-base/60">{post.data.model}</span>
                    )}
                  </div>
                  <p class="text-sm text-skin-base/60 mt-1 line-clamp-2">{post.data.description}</p>
                  {post.data.priceNGN && (
                    <span class="mt-2 inline-block text-xs text-skin-accent">₦{post.data.priceNGN.toLocaleString()}</span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {comparisons.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 border-b border-skin-line pb-2">⚖️ Comparisons</h2>
        <ul class="space-y-4">
          {comparisons.map(post => (
            <li>
              <a href={`/itel/${post.data.slug ?? post.id}/`}
                class="group flex gap-3 rounded-lg border border-skin-line p-3 hover:border-skin-accent transition-colors">
                {post.data.coverImage && (
                  <img src={post.data.coverImage} alt={post.data.coverImageAlt ?? post.data.title}
                    class="hub-thumb" loading="lazy" width="1200" height="630" />
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="font-medium group-hover:text-skin-accent transition-colors line-clamp-2">{post.data.title}</h3>
                  <p class="text-sm text-skin-base/60 mt-1 line-clamp-2">{post.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {buyingGuides.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 border-b border-skin-line pb-2">🛒 Buying Guides</h2>
        <ul class="space-y-4">
          {buyingGuides.map(post => (
            <li>
              <a href={`/itel/${post.data.slug ?? post.id}/`}
                class="group flex gap-3 rounded-lg border border-skin-line p-3 hover:border-skin-accent transition-colors">
                {post.data.coverImage && (
                  <img src={post.data.coverImage} alt={post.data.coverImageAlt ?? post.data.title}
                    class="hub-thumb" loading="lazy" width="1200" height="630" />
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="font-medium group-hover:text-skin-accent transition-colors line-clamp-2">{post.data.title}</h3>
                  <p class="text-sm text-skin-base/60 mt-1 line-clamp-2">{post.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {news.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 border-b border-skin-line pb-2">📰 Latest News</h2>
        <ul class="space-y-4">
          {news.map(post => (
            <li>
              <a href={`/itel/${post.data.slug ?? post.id}/`}
                class="group flex gap-3 rounded-lg border border-skin-line p-3 hover:border-skin-accent transition-colors">
                {post.data.coverImage && (
                  <img src={post.data.coverImage} alt={post.data.coverImageAlt ?? post.data.title}
                    class="hub-thumb" loading="lazy" width="1200" height="630" />
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="font-medium group-hover:text-skin-accent transition-colors line-clamp-2">{post.data.title}</h3>
                  <p class="text-sm text-skin-base/60 mt-1 line-clamp-2">{post.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {sorted.length === 0 && (
      <p class="text-center text-skin-base/50 py-20">Reviews coming soon. Check back shortly.</p>
    )}

    <section class="mt-4 mb-2">
      <a
        href="https://whatsapp.com/channel/0029VbBCXzRKAwEdcyip8841"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-4 rounded-xl border border-[#25D366]/40 bg-[#25D366]/8 px-4 py-4 hover:border-[#25D366]/70 hover:bg-[#25D366]/15 transition-all"
      >
        <span class="shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[#25D366]/20">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="#25D366">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
        </span>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-sm leading-tight">Join the ReviByte WhatsApp Channel</p>
          <p class="text-xs text-skin-base/60 mt-0.5">Get notified when new itel reviews drop</p>
        </div>
        <svg viewBox="0 0 24 24" width="16" height="16" class="shrink-0 text-skin-base/40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </a>
    </section>

  </main>
</Layout>

<style is:global>
  .hub-thumb {
    width: 120px; min-width: 120px; height: 72px;
    object-fit: cover; border-radius: 8px;
    background: var(--background-light); flex-shrink: 0;
  }
  @media (max-width: 400px) {
    .hub-thumb { width: 88px; min-width: 88px; height: 56px; }
  }
</style>
