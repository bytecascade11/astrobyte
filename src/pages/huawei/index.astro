---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";

const allPosts = await getCollection("huawei", ({ data }) => !data.draft);
const sorted = allPosts.sort(
  (a, b) => new Date(b.data.pubDatetime).getTime() - new Date(a.data.pubDatetime).getTime()
);

// Spotlight: single most recent post, not a carousel — same reasoning as
// Motorola. Huawei's traffic clusters around individual Mate/Pura/nova
// drops rather than a steady release cadence.
const spotlight = sorted[0];
const rest = sorted.slice(1);

const budget   = rest.filter(p => (p.data.priceNGN ?? 0) > 0 && p.data.priceNGN < 150000);
const midRange = rest.filter(p => p.data.priceNGN >= 150000 && p.data.priceNGN < 350000);
const flagship = rest.filter(p => p.data.priceNGN >= 350000);
const unpriced = rest.filter(p => !p.data.priceNGN);

// This is the actual search intent behind almost every Huawei query in
// this market: "does it have Google Play Store" comes before RAM,
// storage, or price. No other brand hub on the site needs this — it's
// the differentiator field for Huawei the way chargingSpeed was for
// Motorola.
const gmsLabels: Record<string, string> = {
  full: "✅ Full Google Play",
  appgallery: "⚠️ No Google Play (AppGallery)",
  partial: "🔧 Google via workaround",
};

const pageTitle = "Huawei Phone Reviews: Prices, Cameras & Google Play Status";
const pageDesc  = "Huawei reviews with naira pricing for the Nigerian market — plus the one thing every listing skips: whether each phone ships with Google Play Store or AppGallery only.";

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": pageTitle,
  "description": pageDesc,
  "itemListElement": sorted.map((post, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${SITE.url}/huawei/${post.data.slug ?? post.id}/`,
    "name": post.data.title,
  })),
};

// FAQ schema targets the exact question people type into Google before
// buying a Huawei phone in Nigeria. This is the unique-value section —
// worth capturing as structured data for a featured snippet, not just
// prose on the page.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do Huawei phones have Google Play Store?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on the model and when it launched. Huawei phones released before the 2019 US trade restrictions (older Mate and P series) still run full Google Mobile Services. Phones released after that, including most HarmonyOS devices, ship with Huawei AppGallery instead and don't come with Google Play preinstalled. Check the Google Play badge on each review below for the specific model.",
      },
    },
    {
      "@type": "Question",
      "name": "Can I install Google Play on a newer Huawei phone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On HarmonyOS-based Huawei phones, no reliable official method exists — HarmonyOS Next dropped Android app compatibility entirely. On older EMUI-based Huawei phones without GMS, some workarounds exist but are unofficial and can be unstable. It's safest to buy based on what ships out of the box.",
      },
    },
  ],
};

const gmsFilterCounts = {
  full: sorted.filter(p => p.data.gmsStatus === "full").length,
  appgallery: sorted.filter(p => p.data.gmsStatus === "appgallery").length,
};
---

<Layout title={`${pageTitle} | ${SITE.title}`} description={pageDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">

    <div class="pt-5 pb-1">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-skin-accent hover:underline">
        <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Go to Home
      </a>
    </div>

    <section class="mb-6 pt-4">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-3xl">🔴</span>
        <h1 class="text-3xl font-bold tracking-tight">Huawei Hub</h1>
      </div>
      <p class="text-skin-base/70 text-lg">{pageDesc}</p>
    </section>

    <!-- GMS explainer callout: the whole reason this hub structure exists.
         Sits above the fold so it's the first thing both users and
         crawlers see, and doubles as the visible answer backing the
         FAQ schema above. -->
    <section class="gms-explainer mb-8">
      <p class="gms-explainer-title">📶 Before you buy: check the Google Play status</p>
      <p class="gms-explainer-body">
        Huawei phones split into two groups since 2019 — some still ship with full Google Play Store,
        others run Huawei AppGallery only. Every review below is tagged so you know before you buy.
      </p>
      <div class="gms-explainer-counts">
        <span class="gms-count-pill">{gmsLabels.full} · {gmsFilterCounts.full}</span>
        <span class="gms-count-pill">{gmsLabels.appgallery} · {gmsFilterCounts.appgallery}</span>
      </div>
    </section>

    {spotlight && (
      <section class="mb-10">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-skin-base/50 mb-3">Latest release</h2>
        <a href={`/huawei/${spotlight.data.slug ?? spotlight.id}/`}
          class="spotlight-card">
          {spotlight.data.coverImage && (
            <img src={spotlight.data.coverImage} alt={spotlight.data.coverImageAlt ?? spotlight.data.title}
              class="spotlight-img" loading="eager" width="1200" height="630" />
          )}
          <div class="spotlight-body">
            <h3 class="spotlight-title">{spotlight.data.title}</h3>
            <p class="spotlight-desc">{spotlight.data.description}</p>
            <div class="flex flex-wrap gap-1.5 mt-2">
              {spotlight.data.gmsStatus && (
                <span class={`spec-pill ${spotlight.data.gmsStatus === "full" ? "spec-pill-good" : "spec-pill-warn"}`}>
                  {gmsLabels[spotlight.data.gmsStatus]}
                </span>
              )}
              {spotlight.data.cameraHighlight && <span class="spec-pill">📷 {spotlight.data.cameraHighlight}</span>}
              {spotlight.data.ram && <span class="spec-pill">{spotlight.data.ram} RAM</span>}
              {spotlight.data.priceNGN && <span class="spec-pill spec-pill-accent">₦{spotlight.data.priceNGN.toLocaleString()}</span>}
            </div>
          </div>
        </a>
      </section>
    )}

    {[
      { label: "Budget", emoji: "💰", note: "Under ₦150,000", items: budget },
      { label: "Mid-range", emoji: "⚖️", note: "₦150,000 – ₦349,999", items: midRange },
      { label: "Flagship", emoji: "🚀", note: "₦350,000 and up", items: flagship },
    ].map(tier => tier.items.length > 0 && (
      <section class="mb-10">
        <div class="flex items-baseline justify-between border-b border-skin-line pb-2 mb-4">
          <h2 class="text-xl font-semibold">{tier.emoji} {tier.label}</h2>
          <span class="text-xs text-skin-base/50">{tier.note}</span>
        </div>
        <ul class="space-y-4">
          {tier.items.map(post => (
            <li>
              <a href={`/huawei/${post.data.slug ?? post.id}/`}
                class="group flex gap-3 rounded-lg border border-skin-line p-3 hover:border-skin-accent transition-colors">
                {post.data.coverImage && (
                  <img src={post.data.coverImage} alt={post.data.coverImageAlt ?? post.data.title}
                    class="hub-thumb" loading="lazy" width="1200" height="630" />
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="font-medium group-hover:text-skin-accent transition-colors line-clamp-2">{post.data.title}</h3>
                  <p class="text-sm text-skin-base/60 mt-1 line-clamp-2">{post.data.description}</p>
                  <div class="flex flex-wrap gap-1.5 mt-2">
                    {post.data.gmsStatus && (
                      <span class={`spec-pill ${post.data.gmsStatus === "full" ? "spec-pill-good" : "spec-pill-warn"}`}>
                        {gmsLabels[post.data.gmsStatus]}
                      </span>
                    )}
                    {post.data.ram && <span class="spec-pill">{post.data.ram} RAM</span>}
                    {post.data.storage && <span class="spec-pill">{post.data.storage}</span>}
                    {post.data.priceNGN && <span class="spec-pill spec-pill-accent">₦{post.data.priceNGN.toLocaleString()}</span>}
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {unpriced.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 border-b border-skin-line pb-2">📰 More</h2>
        <ul class="space-y-4">
          {unpriced.map(post => (
            <li>
              <a href={`/huawei/${post.data.slug ?? post.id}/`}
                class="group flex gap-3 rounded-lg border border-skin-line p-3 hover:border-skin-accent transition-colors">
                {post.data.coverImage && (
                  <img src={post.data.coverImage} alt={post.data.coverImageAlt ?? post.data.title}
                    class="hub-thumb" loading="lazy" width="1200" height="630" />
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="font-medium group-hover:text-skin-accent transition-colors line-clamp-2">{post.data.title}</h3>
                  <p class="text-sm text-skin-base/60 mt-1 line-clamp-2">{post.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {sorted.length === 0 && (
      <p class="text-center text-skin-base/50 py-20">Reviews coming soon. Check back shortly.</p>
    )}

    <section class="mt-4 mb-2">
      <a
        href="https://whatsapp.com/channel/0029VbBCXzRKAwEdcyip8841"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-4 rounded-xl border border-[#25D366]/40 bg-[#25D366]/8 px-4 py-4 hover:border-[#25D366]/70 hover:bg-[#25D366]/15 transition-all"
      >
        <span class="shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[#25D366]/20">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="#25D366">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
        </span>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-sm leading-tight">Join the ReviByte WhatsApp Channel</p>
          <p class="text-xs text-skin-base/60 mt-0.5">Get notified when new Huawei reviews drop</p>
        </div>
        <svg viewBox="0 0 24 24" width="16" height="16" class="shrink-0 text-skin-base/40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </a>
    </section>

  </main>
</Layout>

<style is:global>
  .hub-thumb {
    width: 120px; min-width: 120px; height: 72px;
    object-fit: cover; border-radius: 8px;
    background: var(--background-light); flex-shrink: 0;
  }
  .spec-pill {
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--background-light);
    color: rgb(var(--color-base) / 0.65);
    border: 1px solid var(--tw-border-opacity, var(--color-border, transparent));
  }
  .spec-pill-accent {
    background: rgb(var(--color-accent) / 0.12);
    color: rgb(var(--color-accent));
    border-color: rgb(var(--color-accent) / 0.3);
  }
  .spec-pill-good {
    background: rgba(34, 197, 94, 0.12);
    color: rgb(21, 128, 61);
    border-color: rgba(34, 197, 94, 0.35);
  }
  .spec-pill-warn {
    background: rgba(234, 179, 8, 0.12);
    color: rgb(161, 98, 7);
    border-color: rgba(234, 179, 8, 0.35);
  }
  .spotlight-card {
    display: block;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border, rgb(var(--color-border)));
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .spotlight-card:hover {
    border-color: rgb(var(--color-accent));
  }
  .spotlight-img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
  }
  .spotlight-body {
    padding: 14px 16px 16px;
  }
  .spotlight-title {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .spotlight-desc {
    font-size: 0.85rem;
    opacity: 0.65;
    margin-top: 4px;
  }
  .gms-explainer {
    border-radius: 14px;
    border: 1px solid var(--border, rgba(99,102,241,0.2));
    background: var(--background-light, rgba(99,102,241,0.05));
    padding: 16px 18px;
  }
  .gms-explainer-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .gms-explainer-body {
    font-size: 0.85rem;
    opacity: 0.75;
    line-height: 1.5;
  }
  .gms-explainer-counts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
  .gms-count-pill {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--background, #fff);
    border: 1px solid var(--border, rgba(0,0,0,0.1));
  }
  @media (max-width: 400px) {
    .hub-thumb { width: 88px; min-width: 88px; height: 56px; }
  }
</style>
