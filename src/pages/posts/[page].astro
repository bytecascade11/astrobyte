---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("blog");
  
  const sortedPosts = posts
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());

  return paginate(sortedPosts, { pageSize: 9 });
};

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;
import { SITE } from "@/config";
import LinkButton from "@/components/LinkButton.astro";
---

<Layout title={`All Posts - Page ${page.currentPage} | ${SITE.title}`}>
  <Header />
  <main class="mx-auto w-full max-w-app px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold mb-8">All Posts</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 mb-12">
      {page.data.map((post) => (
        <article
          class="overflow-hidden rounded-2xl shadow-lg bg-card hover:shadow-xl transition-shadow duration-300"
        >
          <a href={`/posts/${post.id}`}>
            <img
              src={post.data.coverImage || "/og.png"}
              alt={post.data.coverImageAlt || post.data.title}
              class="w-full object-cover aspect-video"
              loading="lazy"
              width="600"
              height="400"
            />
          </a>

          <div class="p-6">
            <h2 class="text-xl font-semibold mb-2 line-clamp-2">
              <a
                href={`/posts/${post.id}`}
                class="hover:text-accent transition-colors"
              >
                {post.data.title}
              </a>
            </h2>

            <time class="text-sm text-muted-foreground block mb-3">
              {post.data.pubDatetime.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>

            {post.data.description && (
              <p class="text-muted-foreground line-clamp-3 mb-4">
                {post.data.description}
              </p>
            )}

            <LinkButton href={`/posts/${post.id}`} class="mt-2 inline-block">
              Read more →
            </LinkButton>
          </div>
        </article>
      ))}
    </div>

    <!-- Pagination -->
    {page.lastPage > 1 && (
      <nav class="flex justify-center items-center gap-4" aria-label="Pagination">
        {page.url.prev && (
          <a
            href={page.url.prev}
            class="px-4 py-2 rounded-lg bg-card hover:bg-accent hover:text-white transition-colors"
          >
            ← Previous
          </a>
        )}

        <div class="flex gap-2">
          {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => (
            <a
              href={num === 1 ? "/posts" : `/posts/${num}`}
              class:list={[
                "px-4 py-2 rounded-lg transition-colors",
                {
                  "bg-accent text-white": page.currentPage === num,
                  "bg-card hover:bg-accent hover:text-white": page.currentPage !== num,
                }
              ]}
              aria-current={page.currentPage === num ? "page" : undefined}
            >
              {num}
            </a>
          ))}
        </div>

        {page.url.next && (
          <a
            href={page.url.next}
            class="px-4 py-2 rounded-lg bg-card hover:bg-accent hover:text-white transition-colors"
          >
            Next →
          </a>
        )}
      </nav>
    )}
  </main>
  <Footer />
</Layout>
