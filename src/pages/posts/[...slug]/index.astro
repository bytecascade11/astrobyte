---
// File: src/pages/posts/[...slug].astro
// Recommendation: Keep [...slug] for future flexibility (categories, years, etc.)

import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import PostLayout from '@/layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map(post => ({
    params: {
      // Option A: Most common & safe (recommended right now)
      slug: post.id.replace(/\.mdx?$/, ''),   // removes .md/.mdx extension

      // Option B: If you defined slug in frontmatter or schema
      // slug: post.slug || post.id.replace(/\.mdx?$/, '')
    },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<PostLayout post={post} />
