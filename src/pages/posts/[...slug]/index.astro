---
// File: src/pages/posts/[...slug].astro
// Use [...slug] for maximum flexibility (nested folders, categories, etc. in future)
// If you prefer flat URLs only → you can rename to [slug].astro

import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import PostLayout from '@/layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map(post => ({
    params: {
      slug: post.slug,          // ← correct and preferred way
    },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<PostLayout post={post} />
