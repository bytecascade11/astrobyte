---
import Layout from "@/layouts/Layout.astro";
import BackButton from "@/components/BackButton.astro";

const title = "Disclaimer | ReviByte Opinion";
const description = "Disclaimer for ReviByte Opinions – personal tech and mobile gaming blog. No professional advice, affiliate and AdSense disclosures, liability limits.";
const lastUpdated = "June 29, 2026";
---

<Layout title={title} description={description}>
  <div style="max-width:56rem; margin: 1rem auto; padding: 0 1rem;">
    <BackButton />
  </div>

  <article class="prose prose-lg mx-auto max-w-4xl px-6 py-16 dark:prose-invert">
    <header class="text-center">
      <h1 class="mb-4 text-4xl font-bold">Disclaimer</h1>
      <p class="lead text-xl text-gray-600 dark:text-gray-300">
        ReviByte Opinions – Personal Tech & Mobile Gaming Blog
      </p>
      <p class="mt-4 text-lg font-medium text-gray-500 dark:text-gray-400">
        Last updated: {lastUpdated}
      </p>
      <p class="mt-2">
        Questions? Email us at
        <a href="mailto:revibyte20@gmail.com" class="font-semibold text-blue-600 hover:underline">
          revibyte20@gmail.com
        </a>
      </p>
    </header>

    <div class="my-12 rounded-xl bg-yellow-50 dark:bg-yellow-950/30 p-8 border-l-4 border-yellow-400">
      <p class="text-lg font-semibold">
        ReviByte Opinions is a personal blog. Nothing here — including Heliara AI responses and ReviByte Save — constitutes professional, legal, financial, medical, or technical advice. Use at your own risk.
      </p>
    </div>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">1. General Information Only</h2>
      <p>All content on ReviByte Opinions — articles, reviews, tutorials, opinions, game guides, loadout recommendations, and AI-generated responses from Heliara AI — is published for <strong>informational and entertainment purposes only</strong>. It is <strong>not</strong> professional advice of any kind. Always consult qualified experts before making decisions based on anything you read here or anything Heliara AI tells you.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">2. No Guarantees of Accuracy</h2>
      <p>We do our best to keep information accurate and current, but we make <strong>no warranties</strong> of any kind about completeness, accuracy, reliability, or suitability. Tech specs, prices, and availability change frequently — always verify independently before making purchasing decisions. You rely on the content entirely at your own risk.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">3. Heliara AI Disclaimer</h2>
      <p>Heliara AI is a free AI assistant powered by Groq and Llama 3.3 70B. Please note:</p>
      <ul class="mt-4">
        <li>Heliara AI responses are <strong>AI-generated</strong> and may be inaccurate, incomplete, or outdated.</li>
        <li>Heliara AI is <strong>not a substitute</strong> for professional advice — medical, legal, financial, technical, or otherwise.</li>
        <li>ReviByte Opinions is <strong>not responsible</strong> for any decisions made based on Heliara AI responses.</li>
        <li>Heliara AI reads ReviByte content to inform its answers, but this does not guarantee accuracy at all times.</li>
        <li>Heliara AI is <strong>not affiliated with Groq or Meta</strong> (creators of Llama). It is an independent product built by ReviByte.</li>
        <li>Do not share sensitive personal information (passwords, financial details, ID numbers) with Heliara AI.</li>
        <li>ReviByte reserves the right to modify or discontinue Heliara AI at any time.</li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">4. ReviByte Save Disclaimer</h2>
      <p>ReviByte Save is a free media downloader tool suite. Please note:</p>
      <ul class="mt-4">
        <li>ReviByte Save is <strong>not affiliated with TikTok, ByteDance, Instagram, or Meta</strong>, or any other platform it supports.</li>
        <li>ReviByte Save is intended for <strong>personal use only</strong>. You are solely responsible for ensuring you have the right to download any content you access through this tool.</li>
        <li>Downloading copyrighted content without permission may violate the terms of service of the originating platform and applicable copyright laws. ReviByte Opinions is not responsible for how you use downloaded content.</li>
        <li>ReviByte Save relies on RapidAPI and third-party services. We do not guarantee availability, speed, or continued access to any media.</li>
        <li>ReviByte does not store, host, or redistribute any media accessed through ReviByte Save.</li>
        <li>ReviByte reserves the right to modify, limit, or discontinue ReviByte Save at any time without notice.</li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">5. Gaming Content Disclaimer</h2>
      <p>ReviByte Opinions publishes guides, loadouts, formations, and tips for mobile games including COD Mobile, eFootball 2026, PUBG Mobile, and Mobile Legends Bang Bang. Please note:</p>
      <ul class="mt-4">
        <li>ReviByte Opinions is <strong>not affiliated with Activision, TiMi Studio, Konami, Moonton, PUBG Corporation, or any other game developer</strong> mentioned on this site.</li>
        <li>All game names, logos, and trademarks are the property of their respective owners.</li>
        <li>Game guides and loadout recommendations are based on personal experience and opinion — they <strong>do not guarantee any in-game results</strong>, rank improvements, or performance outcomes.</li>
        <li>Game meta, weapon stats, and features change with every season or patch. Always verify tips against the current version of the game.</li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">6. Advertisements & Affiliate Disclosure</h2>
      <p>This site is monetized through:</p>
      <ul class="mt-4">
        <li><strong>Google AdSense</strong> — display advertising served automatically by Google</li>
        <li>
          <strong>Amazon Associates Program</strong> — ReviByte Opinions is a participant in the Amazon Associates Program, an affiliate advertising program designed to provide a means for sites to earn advertising fees by linking to Amazon.com. Some posts and banners contain affiliate links. If you click one and make a qualifying purchase, we earn a small commission at <strong>no extra cost to you</strong>.
        </li>
        <li><strong>Other affiliate links</strong> — where applicable, affiliate relationships are always disclosed inline or marked as "Sponsored."</li>
        <li><strong>Sponsored posts</strong> — always clearly marked as "Sponsored" when applicable</li>
      </ul>
      <p class="mt-4">These relationships do not influence editorial content. All recommendations are based on honest personal opinions and real-world testing. Artificially clicking ads on this site is strictly prohibited and violates Google AdSense policies.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">7. Device & Price Information</h2>
      <p>Smartphone prices, specs, and availability mentioned on ReviByte Opinions — including Nigerian Naira (&#8358;) pricing — are correct at the time of writing but may change. Always confirm current prices with retailers before purchasing. ReviByte Opinions is not responsible for price discrepancies.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">8. External Links & Downloads</h2>
      <p>We often link to third-party tools, software, apps, and websites. We are <strong>not responsible</strong> for their content, availability, privacy practices, or any damage that may result from visiting them or downloading files from them. Links are provided for convenience only.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">9. Push Notifications</h2>
      <p>ReviByte Opinions offers optional push notifications via OneSignal. By clicking "Allow," you consent to receiving new post alerts. We will never use push notifications to send spam, promotions, or misleading content. You can unsubscribe at any time through your browser settings.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">10. User Comments</h2>
      <p>Comments reflect the views of their authors only and do not represent the views of ReviByte Opinion. We may moderate or remove comments that violate our <a href="/terms" class="text-blue-600 hover:underline">Terms &amp; Conditions</a>.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">11. Limitation of Liability</h2>
      <div class="rounded-xl bg-yellow-50 dark:bg-yellow-950/30 p-6 border-l-4 border-yellow-400 mt-4">
        <p>To the maximum extent permitted by law, ReviByte Opinion and its owner shall not be liable for any indirect, incidental, special, consequential, or punitive damages, or any loss of profits or data, arising from your use of this site, Heliara AI, ReviByte Save, or reliance on its content. <strong>Total liability is capped at US $100.</strong></p>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">12. Indemnification</h2>
      <p>You agree to indemnify and hold harmless ReviByte Opinion and its owner from any claims, damages, or expenses arising from your violation of these terms, your use of the site, Heliara AI, or ReviByte Save.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">13. Children's Privacy</h2>
      <p>This site is not directed at children under 13. We do not knowingly collect data from children under 13 (COPPA compliant). Gaming content on this site is intended for general audiences and does not specifically target minors. Heliara AI and ReviByte Save are also not intended for users under 13.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">14. Changes to This Disclaimer</h2>
      <p>We may update this disclaimer at any time. The "Last updated" date at the top will always reflect the latest version. Continued use of the site means you accept any changes.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">15. Governing Law</h2>
      <p>This disclaimer is governed by applicable international digital commerce standards. For any disputes, please contact us first at <a href="mailto:revibyte20@gmail.com" class="text-blue-600 hover:underline">revibyte20@gmail.com</a> to resolve issues informally.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">16. Contact</h2>
      <p>
        Email: <a href="mailto:revibyte20@gmail.com" class="text-blue-600 hover:underline">revibyte20@gmail.com</a><br />
        See also our <a href="/privacy-policy" class="text-blue-600 hover:underline">Privacy Policy</a> and <a href="/terms" class="text-blue-600 hover:underline">Terms &amp; Conditions</a>.
      </p>
    </section>

    <p class="mt-16 text-center text-lg italic text-gray-600 dark:text-gray-400">
      &copy; 2026 ReviByte Opinions. All rights reserved.<br /><br />
      — <strong>Oke "iSamuel"</strong>, Founder
    </p>
  </article>
</Layout>

<style>
  article.prose p,
  article.prose li,
  article.prose dd,
  article.prose dt,
  article.prose h1,
  article.prose h2,
  article.prose h3,
  article.prose blockquote,
  article.prose strong {
    color: #1a1a1a !important;
    opacity: 1 !important;
  }

  article.prose a {
    color: #006cac !important;
  }

  html[data-theme="dark"] article.prose p,
  html[data-theme="dark"] article.prose li,
  html[data-theme="dark"] article.prose dd,
  html[data-theme="dark"] article.prose dt,
  html[data-theme="dark"] article.prose h1,
  html[data-theme="dark"] article.prose h2,
  html[data-theme="dark"] article.prose h3,
  html[data-theme="dark"] article.prose blockquote,
  html[data-theme="dark"] article.prose strong {
    color: #eaedf3 !important;
    opacity: 1 !important;
  }

  html[data-theme="dark"] article.prose a {
    color: #ff6b01 !important;
  }
</style>
