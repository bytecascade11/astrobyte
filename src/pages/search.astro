---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const searchData = posts
  .filter(post => !post.data.draft)
  .map(post => ({
    title: post.data.title,
    description: post.data.description ?? "",
    tags: post.data.tags ?? [],
    url: `/posts/${post.id}/`,
    date: post.data.pubDatetime.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    }),
    coverImage: post.data.coverImage ?? "",
  }));
---

<Layout title={`Search | ${SITE.title}`}>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pt-8 pb-16">
    <h1 class="rb-search__heading">Search</h1>
    <p class="rb-search__desc">Search any article...</p>

    <div class="rb-search__box">
      <input
        id="search-input"
        type="text"
        placeholder="Type to search..."
        class="rb-search__input"
        autofocus
      />
      <button id="search-clear" class="rb-search__clear" aria-label="Clear">✕</button>
    </div>

    <div id="search-results" class="rb-results"></div>
    <p id="search-empty" class="rb-search__empty" style="display:none">No results found.</p>
    <p id="search-hint" class="rb-search__hint">Start typing to search posts...</p>
  </main>

  <Footer />
</Layout>

<script define:vars={{ searchData }}>
  const input = document.getElementById("search-input");
  const clearBtn = document.getElementById("search-clear");
  const resultsEl = document.getElementById("search-results");
  const emptyEl = document.getElementById("search-empty");
  const hintEl = document.getElementById("search-hint");

  const params = new URLSearchParams(window.location.search);
  if (params.get("q")) {
    input.value = params.get("q");
    doSearch(params.get("q"));
  }

  input.addEventListener("input", () => {
    const q = input.value.trim();
    if (q) {
      params.set("q", q);
    } else {
      params.delete("q");
    }
    history.replaceState({}, "", q ? "?" + params.toString() : window.location.pathname);
    doSearch(q);
  });

  clearBtn.addEventListener("click", () => {
    input.value = "";
    history.replaceState({}, "", window.location.pathname);
    doSearch("");
    input.focus();
  });

  function doSearch(q) {
    if (!q) {
      resultsEl.innerHTML = "";
      emptyEl.style.display = "none";
      hintEl.style.display = "block";
      return;
    }

    hintEl.style.display = "none";
    const term = q.toLowerCase();

    const results = searchData.filter(post => {
      return (
        post.title.toLowerCase().includes(term) ||
        post.description.toLowerCase().includes(term) ||
        post.tags.some(tag => tag.toLowerCase().includes(term))
      );
    });

    if (results.length === 0) {
      resultsEl.innerHTML = "";
      emptyEl.style.display = "block";
      return;
    }

    emptyEl.style.display = "none";
    resultsEl.innerHTML = results.map(post => `
      <article class="rb-result-card">
        ${post.coverImage ? `
          <a href="${post.url}" class="rb-result-card__img-wrap">
            <img src="${post.coverImage}" alt="${post.title}" class="rb-result-card__img" loading="lazy" />
          </a>` : ""}
        <div class="rb-result-card__body">
          ${post.tags.length ? `
            <div class="rb-result-card__tags">
              ${post.tags.slice(0, 2).map(tag => `<span class="rb-result-tag">${tag}</span>`).join("")}
            </div>` : ""}
          <a href="${post.url}" class="rb-result-card__title">${post.title}</a>
          ${post.description ? `<p class="rb-result-card__desc">${post.description}</p>` : ""}
          <time class="rb-result-card__date">${post.date}</time>
        </div>
      </article>
    `).join("");
  }
</script>

<style>
  .rb-search__heading {
    font-size: 1.8rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
    color: var(--color-foreground);
  }

  .rb-search__desc {
    font-size: 0.9rem;
    color: var(--color-foreground);
    opacity: 0.6;
    margin-bottom: 1.5rem;
  }

  .rb-search__box {
    position: relative;
    margin-bottom: 2rem;
  }

  .rb-search__input {
    width: 100%;
    padding: 0.75rem 2.5rem 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-card);
    color: var(--color-foreground);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .rb-search__input:focus {
    border-color: var(--color-accent);
  }

  .rb-search__clear {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--color-foreground);
    opacity: 0.4;
    cursor: pointer;
    font-size: 0.9rem;
    padding: 0.25rem;
  }

  .rb-search__clear:hover { opacity: 1; }

  .rb-search__empty,
  .rb-search__hint {
    font-size: 0.9rem;
    color: var(--color-foreground);
    opacity: 0.5;
    text-align: center;
    margin-top: 2rem;
  }

  .rb-results {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .rb-result-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .rb-result-card:last-child { border-bottom: none; }

  .rb-result-card__img-wrap {
    flex-shrink: 0;
    width: 120px;
    height: 78px;
    border-radius: 8px;
    overflow: hidden;
    display: block;
    background: var(--color-card);
    border: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .rb-result-card__img-wrap {
      width: 165px;
      height: 102px;
    }
  }

  .rb-result-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .rb-result-card__body {
    flex: 1;
    min-width: 0;
  }

  .rb-result-card__tags {
    display: flex;
    gap: 0.35rem;
    margin-bottom: 0.35rem;
  }

  .rb-result-tag {
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: var(--color-border);
    color: var(--color-foreground);
    opacity: 0.8;
  }

  .rb-result-card__title {
    display: block;
    font-size: 0.97rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-foreground);
    text-decoration: none;
    margin-bottom: 0.3rem;
    transition: color 0.2s;
  }

  .rb-result-card__title:hover { color: var(--color-accent); }

  .rb-result-card__desc {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--color-foreground);
    opacity: 0.65;
    margin-bottom: 0.35rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rb-result-card__date {
    font-size: 0.75rem;
    color: var(--color-foreground);
    opacity: 0.5;
  }
</style>
