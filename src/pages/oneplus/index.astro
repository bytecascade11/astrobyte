---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";

const allPosts = await getCollection("oneplus", ({ data }) => !data.draft);
const sorted = allPosts.sort(
  (a, b) => new Date(b.data.pubDatetime).getTime() - new Date(a.data.pubDatetime).getTime()
);

const latest = sorted.slice(0, 3);

// Unique to this hub: grouped by series, not price. OnePlus's own naming
// (Nord / numbered flagship / R-series) is more meaningful to shoppers here
// than a naira price band, and keeps this hub structurally distinct from
// the Tecno/Motorola price-tier pattern.
const nord     = sorted.filter(p => p.data.series === "Nord");
const flagship = sorted.filter(p => p.data.series === "Numbered");
const rSeries  = sorted.filter(p => p.data.series === "R");

const pageTitle = "OnePlus Phone Reviews, Prices & Buying Guides";
const pageDesc  = "Hands-on OnePlus reviews and naira pricing for the Nigerian market — Nord, numbered flagships, and R-series, with Hasselblad camera and SuperVOOC charging specs called out.";

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": pageTitle,
  "description": pageDesc,
  "itemListElement": sorted.map((post, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${SITE.url}/oneplus/${post.data.slug ?? post.id}/`,
    "name": post.data.title,
  })),
};
---

<Layout title={`${pageTitle} | ${SITE.title}`} description={pageDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">

    <div class="pt-5 pb-1">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-skin-accent hover:underline">
        <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Go to Home
      </a>
    </div>

    <section class="mb-8 pt-4">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-3xl">🔴</span>
        <h1 class="text-3xl font-bold tracking-tight">OnePlus Hub</h1>
      </div>
      <p class="text-skin-base/70 text-lg">{pageDesc}</p>
    </section>

    {latest.length > 0 && (
      <section class="mb-10 -mx-4 px-4 overflow-x-auto">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-skin-base/50 mb-3">Just published</h2>
        <div class="flex gap-3 pb-1" style="width:max-content;">
          {latest.map(post => (
            <a href={`/oneplus/${post.data.slug ?? post.id}/`}
              class="block w-52 shrink-0 rounded-lg border border-skin-line overflow-hidden hover:border-skin-accent transition-colors">
              {post.data.coverImage && (
                <img src={post.data.coverImage} alt={post.data.coverImageAlt ?? post.data.title}
                  class="w-full h-28 object-cover" loading="lazy" width="400" height="225" />
              )}
              <div class="p-3">
                <h3 class="text-sm font-medium line-clamp-2">{post.data.title}</h3>
                {post.data.hasselblad && (
                  <span class="mt-1 inline-flex items-center gap-1 text-xs text-skin-accent">📷 Hasselblad</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {[
      { key: "nord", label: "Nord Series", emoji: "🟠", note: "Value-focused mid-range", items: nord },
      { key: "flagship", label: "Numbered Flagships", emoji: "🚀", note: "Flagship-tier, top specs", items: flagship },
      { key: "r", label: "R-Series", emoji: "⚡", note: "Fast-follow flagship, sharper price", items: rSeries },
    ].map(tier => tier.items.length > 0 && (
      <section class="mb-10">
        <div class="flex items-baseline justify-between border-b border-skin-line pb-2 mb-4">
          <h2 class="text-xl font-semibold">{tier.emoji} {tier.label}</h2>
          <span class="text-xs text-skin-base/50">{tier.note}</span>
        </div>
        <div class="oneplus-grid">
          {tier.items.map(post => (
            <a href={`/oneplus/${post.data.slug ?? post.id}/`} class="oneplus-card group">
              {post.data.coverImage && (
                <img src={post.data.coverImage} alt={post.data.coverImageAlt ?? post.data.title}
                  class="oneplus-card-img" loading="lazy" width="800" height="450" />
              )}
              <div class="oneplus-card-body">
                <h3 class="font-medium group-hover:text-skin-accent transition-colors line-clamp-2">{post.data.title}</h3>
                <p class="text-sm text-skin-base/60 mt-1 line-clamp-2">{post.data.description}</p>
                <div class="flex flex-wrap gap-1.5 mt-2">
                  {post.data.hasselblad && <span class="spec-pill spec-pill-accent">📷 Hasselblad</span>}
                  {post.data.fastCharging && <span class="spec-pill">⚡ {post.data.fastCharging}</span>}
                  {post.data.priceNGN && <span class="spec-pill">₦{post.data.priceNGN.toLocaleString()}</span>}
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    {sorted.length === 0 && (
      <p class="text-center text-skin-base/50 py-20">Reviews coming soon. Check back shortly.</p>
    )}

    <section class="mt-4 mb-2">
      <a
        href="https://whatsapp.com/channel/0029VbBCXzRKAwEdcyip8841"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-4 rounded-xl border border-[#25D366]/40 bg-[#25D366]/8 px-4 py-4 hover:border-[#25D366]/70 hover:bg-[#25D366]/15 transition-all"
      >
        <span class="shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[#25D366]/20">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="#25D366">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
        </span>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-sm leading-tight">Join the ReviByte WhatsApp Channel</p>
          <p class="text-xs text-skin-base/60 mt-0.5">Get notified when new OnePlus reviews drop</p>
        </div>
        <svg viewBox="0 0 24 24" width="16" height="16" class="shrink-0 text-skin-base/40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </a>
    </section>

  </main>
</Layout>

<style is:global>
  /* Grid card layout — deliberately different from Tecno's horizontal-list
     rows, since template similarity is one of the variables being isolated
     across these device hubs. */
  .oneplus-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (max-width: 480px) {
    .oneplus-grid { grid-template-columns: 1fr; }
  }
  .oneplus-card {
    display: block;
    border-radius: 12px;
    border: 1px solid var(--border, rgb(0 0 0 / 0.1));
    overflow: hidden;
    transition: border-color 0.15s;
  }
  .oneplus-card:hover { border-color: rgb(var(--color-accent)); }
  .oneplus-card-img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    background: var(--background-light);
  }
  .oneplus-card-body { padding: 10px 12px 14px; }

  .spec-pill {
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--background-light);
    color: rgb(var(--color-base) / 0.65);
    border: 1px solid var(--tw-border-opacity, var(--color-border, transparent));
  }
  .spec-pill-accent {
    background: rgb(var(--color-accent) / 0.12);
    color: rgb(var(--color-accent));
    border-color: rgb(var(--color-accent) / 0.3);
  }
</style>
