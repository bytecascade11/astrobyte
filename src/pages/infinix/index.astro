---
// src/pages/infinix/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
import {
  INFINIX_SERIES,
  SERIES_NOTE,
  getInfinixSeries,
} from "@/utils/infinixSeries";

const allPosts = await getCollection("infinix", ({ data }) => !data.draft);
const sorted = allPosts.sort(
  (a, b) =>
    new Date(b.data.pubDatetime).getTime() -
    new Date(a.data.pubDatetime).getTime()
);

// Unlike the Tecno hub (grouped by price), Infinix is grouped by series,
// because Infinix buyers shop by line: Hot, Note, Zero, GT, Smart.
const groups = INFINIX_SERIES.map(name => ({
  name,
  note: SERIES_NOTE[name],
  items: sorted.filter(p => getInfinixSeries(p.data) === name),
})).filter(g => g.items.length > 0);

const other = sorted.filter(p => getInfinixSeries(p.data) === null);
const latest = sorted[0];

const pageTitle = "Infinix Phone Reviews, Prices & Buying Guides";
const pageDesc =
  "Hands-on Infinix reviews and naira pricing for Nigeria. Browse by series: Hot, Note, Zero, GT and Smart.";

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: pageTitle,
  description: pageDesc,
  itemListElement: sorted.map((post, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `${SITE.url}/infinix/${post.data.slug ?? post.id}/`,
    name: post.data.title,
  })),
};
---

<Layout title={`${pageTitle} | ${SITE.title}`} description={pageDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">

    <div class="pt-5 pb-1">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-skin-accent hover:underline">
        <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Go to Home
      </a>
    </div>

    <section class="ix-hero">
      <h1 class="ix-hero-title">Infinix</h1>
      <p class="ix-hero-sub">{pageDesc}</p>
      <p class="ix-hero-count">
        <strong>{sorted.length}</strong> {sorted.length === 1 ? "review" : "reviews"} across
        <strong>{groups.length}</strong> {groups.length === 1 ? "series" : "series"}
      </p>
    </section>

    {groups.length > 1 && (
      <nav class="ix-chips" aria-label="Jump to a series">
        {groups.map(g => (
          <a href={`#${g.name.toLowerCase()}`} class="ix-chip">
            {g.name}
            <span class="ix-chip-count">{g.items.length}</span>
          </a>
        ))}
      </nav>
    )}

    {latest && (
      <a href={`/infinix/${latest.data.slug ?? latest.id}/`} class="ix-latest">
        {latest.data.coverImage && (
          <img src={latest.data.coverImage} alt={latest.data.coverImageAlt ?? latest.data.title}
            class="ix-latest-img" loading="eager" width="1200" height="630" />
        )}
        <div class="ix-latest-body">
          <span class="ix-tag">Latest review</span>
          <h2 class="ix-latest-title">{latest.data.title}</h2>
          <p class="ix-latest-desc">{latest.data.description}</p>
          {latest.data.priceNGN && (
            <p class="ix-latest-price">₦{latest.data.priceNGN.toLocaleString()}</p>
          )}
        </div>
      </a>
    )}

    {groups.map(g => (
      <section id={g.name.toLowerCase()} class="ix-series">
        <header class="ix-series-head">
          <h2 class="ix-series-name">{g.name} series</h2>
          <p class="ix-series-note">{g.note}</p>
        </header>
        <ul class="ix-list">
          {g.items.map(post => (
            <li>
              <a href={`/infinix/${post.data.slug ?? post.id}/`} class="ix-row">
                {post.data.coverImage && (
                  <img src={post.data.coverImage} alt={post.data.coverImageAlt ?? post.data.title}
                    class="ix-thumb" loading="lazy" width="1200" height="630" />
                )}
                <div class="ix-row-main">
                  <h3 class="ix-row-title">{post.data.title}</h3>
                  {(post.data.ram || post.data.storage) && (
                    <p class="ix-row-specs">
                      {post.data.ram && <span>{post.data.ram} RAM</span>}
                      {post.data.storage && <span>{post.data.storage}</span>}
                      {post.data.battery && <span>{post.data.battery}</span>}
                    </p>
                  )}
                </div>
                <div class="ix-row-side">
                  {post.data.priceNGN && (
                    <span class="ix-price">₦{post.data.priceNGN.toLocaleString()}</span>
                  )}
                  {post.data.rating && (
                    <span class="ix-rating">{post.data.rating}/5</span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {other.length > 0 && (
      <section id="more" class="ix-series">
        <header class="ix-series-head">
          <h2 class="ix-series-name">More from Infinix</h2>
          <p class="ix-series-note">Comparisons, guides and news</p>
        </header>
        <ul class="ix-list">
          {other.map(post => (
            <li>
              <a href={`/infinix/${post.data.slug ?? post.id}/`} class="ix-row">
                {post.data.coverImage && (
                  <img src={post.data.coverImage} alt={post.data.coverImageAlt ?? post.data.title}
                    class="ix-thumb" loading="lazy" width="1200" height="630" />
                )}
                <div class="ix-row-main">
                  <h3 class="ix-row-title">{post.data.title}</h3>
                  <p class="ix-row-desc">{post.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {sorted.length === 0 && (
      <p class="text-center text-skin-base/50 py-20">Infinix reviews are coming soon. Check back shortly.</p>
    )}

    <section class="mt-4 mb-2">
      <a
        href="https://whatsapp.com/channel/0029VbBCXzRKAwEdcyip8841"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-4 rounded-xl border border-[#25D366]/40 bg-[#25D366]/8 px-4 py-4 hover:border-[#25D366]/70 hover:bg-[#25D366]/15 transition-all"
      >
        <span class="shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[#25D366]/20">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="#25D366">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
        </span>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-sm leading-tight">Join the ReviByte WhatsApp Channel</p>
          <p class="text-xs text-skin-base/60 mt-0.5">Get notified when new Infinix reviews drop</p>
        </div>
        <svg viewBox="0 0 24 24" width="16" height="16" class="shrink-0 text-skin-base/40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </a>
    </section>

  </main>
</Layout>

<style is:global>
  :root {
    --ix-lime: #c6f21b;
    --ix-ink: #10190a;
  }

  /* Hero: one big word, no emoji */
  .ix-hero { padding: 1.25rem 0 1rem; }
  .ix-hero-title {
    font-size: clamp(3rem, 16vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .ix-hero-sub { margin-top: 0.75rem; font-size: 1.05rem; opacity: 0.7; max-width: 34rem; }
  .ix-hero-count { margin-top: 0.5rem; font-size: 0.85rem; opacity: 0.55; }

  /* Series jump chips (pure CSS/HTML, no JS) */
  .ix-chips {
    position: sticky; top: 0; z-index: 10;
    display: flex; gap: 8px; overflow-x: auto;
    margin: 0 -1rem 1.5rem; padding: 10px 1rem;
    background: var(--background, #fff);
    border-bottom: 1px solid var(--border, rgba(128,128,128,0.25));
    scrollbar-width: none;
  }
  .ix-chips::-webkit-scrollbar { display: none; }
  .ix-chip {
    flex-shrink: 0; display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 14px; border-radius: 999px;
    font-size: 0.85rem; font-weight: 700;
    border: 1px solid var(--border, rgba(128,128,128,0.35));
    color: var(--foreground); text-decoration: none;
  }
  .ix-chip:hover, .ix-chip:focus-visible {
    background: var(--ix-lime); color: var(--ix-ink); border-color: var(--ix-lime);
  }
  .ix-chip-count { font-size: 0.72rem; opacity: 0.6; font-weight: 600; }

  /* Latest review feature */
  .ix-latest {
    display: block; margin-bottom: 2.5rem; overflow: hidden;
    border-radius: 18px; text-decoration: none; color: inherit;
    border: 1px solid var(--border, rgba(128,128,128,0.3));
  }
  .ix-latest-img { width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; display: block; }
  .ix-latest-body { padding: 1rem 1.1rem 1.2rem; }
  .ix-tag {
    display: inline-block; padding: 2px 10px; border-radius: 6px;
    background: var(--ix-lime); color: var(--ix-ink);
    font-size: 0.75rem; font-weight: 800;
  }
  .ix-latest-title { margin-top: 0.6rem; font-size: 1.3rem; font-weight: 700; line-height: 1.25; }
  .ix-latest-desc {
    margin-top: 0.4rem; font-size: 0.9rem; opacity: 0.7;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .ix-latest-price { margin-top: 0.6rem; font-weight: 800; }

  /* Series sections */
  .ix-series { margin-bottom: 2.5rem; scroll-margin-top: 4rem; }
  .ix-series-head {
    margin-bottom: 0.9rem; padding-left: 0.8rem;
    border-left: 5px solid var(--ix-lime);
  }
  .ix-series-name { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
  .ix-series-note { font-size: 0.82rem; opacity: 0.6; margin-top: 2px; }

  /* Compact rows: price sits on the right, like a spec sheet */
  .ix-list { display: flex; flex-direction: column; }
  .ix-row {
    display: flex; align-items: center; gap: 12px; padding: 12px 0;
    text-decoration: none; color: inherit;
    border-bottom: 1px solid var(--border, rgba(128,128,128,0.2));
  }
  .ix-row:hover .ix-row-title, .ix-row:focus-visible .ix-row-title { text-decoration: underline; }
  .ix-thumb {
    width: 96px; min-width: 96px; height: 60px;
    object-fit: cover; border-radius: 8px;
    background: var(--background-light); flex-shrink: 0;
  }
  .ix-row-main { flex: 1; min-width: 0; }
  .ix-row-title {
    font-size: 0.95rem; font-weight: 600; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .ix-row-specs { margin-top: 4px; display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: 0.75rem; opacity: 0.6; }
  .ix-row-desc {
    margin-top: 4px; font-size: 0.8rem; opacity: 0.6;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .ix-row-side { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; flex-shrink: 0; }
  .ix-price { font-size: 0.9rem; font-weight: 800; white-space: nowrap; }
  .ix-rating {
    font-size: 0.7rem; font-weight: 700; padding: 1px 7px; border-radius: 6px;
    background: var(--ix-lime); color: var(--ix-ink);
  }

  @media (max-width: 400px) {
    .ix-thumb { width: 72px; min-width: 72px; height: 48px; }
    .ix-row-specs span:nth-child(3) { display: none; }
  }
</style>
