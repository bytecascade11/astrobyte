---
// src/pages/infinix/[slug].astro
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import { SITE } from "@/config";
import AffiliateCarousel from "@/components/AffiliateCarousel.astro";
import Comments from "@/components/Comments.astro";
import Header from "@/components/Header.astro";
import { getWatermarkedOgImage } from "@/utils/getWatermarkedOgImage";
import { getInfinixSeries } from "@/utils/infinixSeries";

export async function getStaticPaths() {
  const posts = await getCollection("infinix", ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.data.slug ?? post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const postSlug = post.data.slug ?? post.id;

const series = getInfinixSeries(post.data);

// Related: use relatedSlugs if set. Otherwise fall back to other phones in the
// same series, so every review links to its neighbours automatically.
const all = await getCollection("infinix", ({ data }) => !data.draft);
let relatedPosts: CollectionEntry<"infinix">[] = [];
if (post.data.relatedSlugs?.length) {
  relatedPosts = all.filter(p =>
    post.data.relatedSlugs!.includes(p.data.slug ?? p.id)
  );
} else if (series) {
  relatedPosts = all
    .filter(
      p => (p.data.slug ?? p.id) !== postSlug && getInfinixSeries(p.data) === series
    )
    .slice(0, 3);
}
const relatedHeading = post.data.relatedSlugs?.length
  ? "Related reviews"
  : `More from the ${series} series`;

const pageTitle = `${post.data.title} | ${SITE.title}`;
const pageDesc = post.data.description;
const ogImage = getWatermarkedOgImage("infinix", postSlug, !!post.data.coverImage);

const websiteBase = SITE.website.endsWith("/") ? SITE.website : `${SITE.website}/`;
const coverImageAbs = post.data.coverImage
  ? new URL(
      post.data.coverImage.startsWith("/")
        ? post.data.coverImage.slice(1)
        : post.data.coverImage,
      websiteBase
    ).toString()
  : undefined;

const postUrl = `${websiteBase}infinix/${postSlug}/`;
const hubUrl = `${websiteBase}infinix/`;
const seriesUrl = series ? `${hubUrl}#${series.toLowerCase()}` : hubUrl;
const seriesLabel = series ? `${series} series` : "Reviews";

const price = post.data.priceNGN ?? 0;

const typeLabels: Record<string, string> = {
  review: "Review",
  comparison: "Comparison",
  "buying-guide": "Buying Guide",
  news: "News",
};
const typeLabel = typeLabels[post.data.type] ?? "Review";
const shareURL = postUrl;
const shareTitle = post.data.title;

const ratingNum = post.data.rating ? Number(post.data.rating) : 0;
const ratingFilled = Math.round(ratingNum);

const productSchema = post.data.rating
  ? {
      "@context": "https://schema.org",
      "@type": "Product",
      name: post.data.title.replace(/ Review$/i, ""),
      image: coverImageAbs,
      description: post.data.description,
      brand: { "@type": "Brand", name: "Infinix" },
      ...(price > 0 && {
        offers: {
          "@type": "Offer",
          priceCurrency: "NGN",
          price: price,
          availability: "https://schema.org/InStock",
        },
      }),
      review: {
        "@type": "Review",
        reviewRating: {
          "@type": "Rating",
          ratingValue: post.data.rating,
          bestRating: "5",
        },
        author: { "@type": "Person", name: post.data.author },
      },
    }
  : null;

// Spec sheet rows. `chipset` and `camera` are optional frontmatter fields.
const specs = [
  post.data.chipset && { label: "Chipset", value: post.data.chipset },
  post.data.ram && { label: "RAM", value: post.data.ram },
  post.data.storage && { label: "Storage", value: post.data.storage },
  post.data.display && { label: "Display", value: post.data.display },
  post.data.camera && { label: "Camera", value: post.data.camera },
  post.data.battery && { label: "Battery", value: post.data.battery },
  price > 0 && { label: "Price in Nigeria", value: `₦${price.toLocaleString()}` },
].filter(Boolean) as { label: string; value: string }[];
---

<Layout title={pageTitle} description={pageDesc} ogImage={ogImage}>
<Header slot="header" />

  <SchemaMarkup
    type="breadcrumb"
    breadcrumbs={[
      { name: "Home", url: websiteBase },
      { name: "Infinix", url: hubUrl },
      { name: seriesLabel, url: seriesUrl },
      { name: post.data.title, url: postUrl },
    ]}
  />

  <SchemaMarkup
    type="article"
    title={post.data.title}
    description={post.data.description}
    url={postUrl}
    image={coverImageAbs}
    datePublished={new Date(post.data.pubDatetime)}
    dateModified={post.data.lastUpdated ? new Date(post.data.lastUpdated) : null}
  />

  {productSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  )}

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-16">

    <nav class="pt-6 pb-2 text-sm flex flex-wrap items-center gap-1.5 ix-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/infinix/">Infinix</a>
      <span>/</span>
      <a href={series ? `/infinix/#${series.toLowerCase()}` : "/infinix/"}>{seriesLabel}</a>
    </nav>

    {coverImageAbs && (
      <div class="ix-cover-block">
        <div class="ix-ad ix-ad--top">
          <ins class="adsbygoogle"
               style="display:block"
               data-ad-format="fluid"
               data-ad-layout-key="-gf-2b-2i-8t+14w"
               data-ad-client="ca-pub-4896561037705299"
               data-ad-slot="2743091672"></ins>
        </div>

        <div class="ix-cover">
          <img src={coverImageAbs} alt={post.data.coverImageAlt ?? post.data.title}
            class="ix-cover-img" loading="eager" fetchpriority="high" width="1200" height="630" />
        </div>

        <div class="ix-ad ix-ad--bottom">
          <div id="container-100c0408033e7aba877563ba9293a45d"></div>
        </div>
      </div>
    )}

    <header class="ix-head">
      <div class="ix-badges">
        {series && <span class="ix-badge ix-badge--lime">{series} series</span>}
        <span class="ix-badge">{typeLabel}</span>
        {post.data.model && <span class="ix-badge">{post.data.model}</span>}
      </div>

      <h1 class="ix-title">{post.data.title}</h1>
      <p class="ix-desc">{post.data.description}</p>

      {post.data.rating && (
        <div class="ix-score" aria-label={`Rated ${post.data.rating} out of 5`}>
          <div class="ix-score-bar" aria-hidden="true">
            {[1, 2, 3, 4, 5].map(n => (
              <span class:list={["ix-score-seg", { "is-on": n <= ratingFilled }]}></span>
            ))}
          </div>
          <span class="ix-score-num">{post.data.rating}<small>/5</small></span>
        </div>
      )}

      <p class="ix-meta">
        <span>By {post.data.author}</span>
        <span>
          {new Date(post.data.pubDatetime).toLocaleDateString("en-NG", {
            year: "numeric", month: "long", day: "numeric",
          })}
        </span>
        {post.data.lastUpdated && <span>Updated {post.data.lastUpdated}</span>}
      </p>
    </header>

    {specs.length > 0 && (
      <section class="ix-sheet" aria-label="Key specifications">
        <h2 class="ix-sheet-title">Spec sheet</h2>
        <dl class="ix-sheet-list">
          {specs.map(s => (
            <div class="ix-sheet-row">
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {post.data.comparedTo && (
      <a href={`/infinix/${post.data.comparedToSlug ?? ""}/`} class="ix-vs">
        How does it compare to the {post.data.comparedTo}? See the head-to-head
      </a>
    )}

    <div class="ix-share">
      <span class="ix-share-label">Share this review</span>
      <div class="ix-share-buttons">
        <button class="ix-share-btn ix-share-btn--native" id="nativeShareBtn" aria-label="Share" style="display:none">
          <svg viewBox="0 0 24 24"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
          Share
        </button>
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareTitle)}&url=${encodeURIComponent(shareURL)}`} target="_blank" rel="noopener noreferrer" class="ix-share-btn ix-share-btn--x">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.261 5.632 5.903-5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          X
        </a>
        <a href={`https://wa.me/?text=${encodeURIComponent(shareTitle + " " + shareURL)}`} target="_blank" rel="noopener noreferrer" class="ix-share-btn ix-share-btn--wa">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.118.554 4.103 1.522 5.828L.057 23.012a.75.75 0 0 0 .931.931l5.184-1.465A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.724 9.724 0 0 1-4.96-1.355l-.355-.213-3.676 1.04 1.04-3.574-.234-.368A9.725 9.725 0 0 1 2.25 12C2.25 6.615 6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"/></svg>
          WhatsApp
        </a>
        <button class="ix-share-btn ix-share-btn--copy" id="copyLinkBtn" data-url={shareURL}>
          <svg viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span id="copyBtnText">Copy</span>
        </button>
      </div>
    </div>

    <article class="prose prose-revibyte max-w-none">
      <Content />
    </article>

    {relatedPosts.length > 0 && (
      <section class="ix-related">
        <h2 class="ix-related-title">{relatedHeading}</h2>
        <ul class="ix-related-list">
          {relatedPosts.map(related => (
            <li>
              <a href={`/infinix/${related.data.slug ?? related.id}/`} class="ix-related-item">
                {related.data.coverImage && (
                  <img src={related.data.coverImage} alt={related.data.coverImageAlt ?? related.data.title}
                    class="ix-related-thumb" loading="lazy" width="64" height="48" />
                )}
                <div class="min-w-0">
                  <p class="ix-related-name">{related.data.title}</p>
                  <p class="ix-related-desc">{related.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Author card -->
    <div class="ix-author">
      <img src="/assets/isamuel.jpg" alt={SITE.author || "iSamuel"} class="ix-author-avatar" />
      <div class="ix-author-info">
        <p class="ix-author-name">{SITE.author || "iSamuel"}</p>
        <p class="ix-author-bio">
          Founder and lead technology analyst behind ReviByte Opinions.
          Writes practical tech analysis for everyday users in Nigeria and beyond —
          focusing on honest real-world explanations of phones, gadgets, AI and
          how technology works in daily life.
        </p>
        <a href="/about" class="ix-author-link">
          Learn more about iSamuel and ReviByte
        </a>
      </div>
    </div>

    <a href="https://whatsapp.com/channel/0029VbBCXzRKAwEdcyip8841" target="_blank" rel="noopener noreferrer" class="ix-wa">
      <span class="ix-wa-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="#25D366">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
        </svg>
      </span>
      <div class="ix-wa-text">
        <p class="ix-wa-title">Get Infinix reviews on WhatsApp</p>
        <p class="ix-wa-sub">Join the ReviByte channel for instant updates</p>
      </div>
    </a>

    <AffiliateCarousel />

    <div style="margin: 1.5rem 0; min-height: 50px; display:flex; justify-content:center; contain: layout;">
      <script is:inline>
        atOptions = { 'key' : '2b0c33ae294502978b9bfb23cc9b43f0', 'format' : 'iframe', 'height' : 50, 'width' : 320, 'params' : {} };
      </script>
      <script is:inline src="https://www.highperformanceformat.com/2b0c33ae294502978b9bfb23cc9b43f0/invoke.js"></script>
    </div>

    <!-- AdSense + Adsterra libraries for the cover-image ad slots above, loaded after main content so they don't compete with early taps (INP) -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4896561037705299"
         crossorigin="anonymous"></script>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>

    <script async data-cfasync="false" src="https://pl28410703.effectivecpmnetwork.com/100c0408033e7aba877563ba9293a45d/invoke.js"></script>

    <Comments slug={postSlug} />

    <div class="mt-10 flex items-center gap-4">
      <a href="/" class="text-sm text-skin-accent hover:underline">← Home</a>
      <span class="text-skin-base/30">|</span>
      <a href="/infinix/" class="text-sm text-skin-accent hover:underline">Infinix Hub</a>
    </div>

    <div style="margin: 1.5rem 0; min-height: 250px; display:flex; justify-content:center; contain: layout;">
      <script is:inline>
        atOptions = { 'key' : '3de9102309ceb722a1529e96b401e327', 'format' : 'iframe', 'height' : 250, 'width' : 300, 'params' : {} };
      </script>
      <script is:inline src="https://www.highperformanceformat.com/3de9102309ceb722a1529e96b401e327/invoke.js"></script>
    </div>

  </main>
</Layout>

<script is:inline>
  function updateGiscusTheme() {
    const theme = document.firstElementChild?.getAttribute("data-theme") || "light";
    const iframe = document.querySelector("iframe.giscus-frame");
    if (iframe) {
      iframe.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: theme === "dark" ? "dark" : "light" } } },
        "https://giscus.app"
      );
    }
  }
  document.addEventListener("astro:after-swap", updateGiscusTheme);
  window.addEventListener("load", updateGiscusTheme);
  new MutationObserver(updateGiscusTheme).observe(document.documentElement, {
    attributes: true, attributeFilter: ["data-theme"]
  });

  if (navigator.share) {
    const btn = document.getElementById('nativeShareBtn');
    if (btn) {
      btn.style.display = 'flex';
      btn.addEventListener('click', () => {
        navigator.share({ title: document.title, url: window.location.href }).catch(() => {});
      });
    }
  }

  const copyBtn = document.getElementById('copyLinkBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const url = copyBtn.dataset.url || window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        const label = document.getElementById('copyBtnText');
        if (label) { label.textContent = 'Copied!'; setTimeout(() => { label.textContent = 'Copy'; }, 2000); }
      }).catch(() => {});
    });
  }
</script>

<style is:global>
  :root {
    --ix-lime: #c6f21b;
    --ix-ink: #10190a;
  }

  /* Breadcrumb */
  .ix-crumbs { color: var(--foreground); opacity: 0.6; }
  .ix-crumbs a { color: var(--foreground); }
  .ix-crumbs a:hover { color: var(--accent); }

  /* Cover + ad slots (heights reserved to prevent layout shift) */
  .ix-cover-block { display: flex; flex-direction: column; width: 100%; }
  .ix-ad { display: block; width: 100%; max-width: 768px; margin-left: auto; margin-right: auto; contain: layout; }
  .ix-ad--top { margin-bottom: 0.5rem; min-height: 280px; }
  .ix-ad--bottom { margin: 0.5rem auto; min-height: 250px; }
  .ix-cover { width: 100%; border-radius: 16px; overflow: hidden; margin: 0.5rem 0 1.5rem; background: var(--background-light); }
  .ix-cover-img { width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; display: block; }
  @media (min-width: 768px) { .ix-cover-img { aspect-ratio: 21/9; } }

  /* Header */
  .ix-head { margin-bottom: 1.5rem; }
  .ix-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 0.9rem; }
  .ix-badge {
    font-size: 0.75rem; font-weight: 600; padding: 3px 10px; border-radius: 6px;
    border: 1px solid var(--border); color: var(--foreground);
  }
  .ix-badge--lime { background: var(--ix-lime); color: var(--ix-ink); border-color: var(--ix-lime); font-weight: 800; }
  .ix-title { font-size: 2rem; font-weight: 800; line-height: 1.12; letter-spacing: -0.025em; }
  .ix-desc { margin-top: 0.75rem; font-size: 1.05rem; line-height: 1.6; color: var(--foreground); opacity: 0.75; }
  .prose h1 { display: none; }

  /* Rating as five segments */
  .ix-score { display: flex; align-items: center; gap: 12px; margin-top: 1rem; }
  .ix-score-bar { display: flex; gap: 4px; }
  .ix-score-seg { width: 26px; height: 8px; border-radius: 4px; background: var(--border, rgba(128,128,128,0.3)); }
  .ix-score-seg.is-on { background: var(--ix-lime); box-shadow: inset 0 0 0 1px rgba(16,25,10,0.25); }
  .ix-score-num { font-size: 1.15rem; font-weight: 800; }
  .ix-score-num small { font-size: 0.75rem; font-weight: 600; opacity: 0.55; }

  .ix-meta { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 0.85rem; color: var(--foreground); opacity: 0.6; }

  /* Spec sheet: label left, value right */
  .ix-sheet { margin: 1.5rem 0; border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
  .ix-sheet-title {
    padding: 10px 16px; font-size: 0.9rem; font-weight: 800;
    background: var(--ix-lime); color: var(--ix-ink);
  }
  .ix-sheet-row {
    display: flex; justify-content: space-between; gap: 16px; padding: 10px 16px;
    border-top: 1px solid var(--border); font-size: 0.9rem;
  }
  .ix-sheet-row:first-child { border-top: none; }
  .ix-sheet-row dt { opacity: 0.6; flex-shrink: 0; }
  .ix-sheet-row dd { font-weight: 700; text-align: right; }

  .ix-vs {
    display: block; margin-top: 1.25rem; padding: 12px 16px; border-radius: 10px;
    font-size: 0.85rem; font-weight: 700; text-decoration: none;
    border: 1px solid var(--ix-lime); color: var(--foreground);
    background: rgba(198, 242, 27, 0.14);
  }
  .ix-vs:hover { background: rgba(198, 242, 27, 0.26); }

  /* Share */
  .ix-share {
    display: flex; align-items: center; flex-wrap: wrap; gap: 10px;
    margin: 1.5rem 0 2rem; padding: 12px 16px; border-radius: 12px;
    background: var(--background-light); border: 1px solid var(--border);
  }
  .ix-share-label { font-size: 0.8rem; font-weight: 600; opacity: 0.6; white-space: nowrap; }
  .ix-share-buttons { display: flex; flex-wrap: wrap; gap: 8px; margin-left: auto; }
  .ix-share-btn {
    display: flex; align-items: center; gap: 5px; padding: 6px 14px;
    border-radius: 8px; font-size: 0.78rem; font-weight: 600; cursor: pointer;
    border: 1px solid transparent; text-decoration: none; white-space: nowrap;
  }
  .ix-share-btn:hover { opacity: 0.85; }
  .ix-share-btn svg { width: 15px; height: 15px; flex-shrink: 0; }
  .ix-share-btn--native { background: var(--ix-lime); color: var(--ix-ink); }
  .ix-share-btn--x { background: #000; color: #fff; }
  .ix-share-btn--wa { background: #25D366; color: #fff; }
  .ix-share-btn--copy { background: var(--background-light); color: var(--foreground); border-color: var(--border); }
  @media (max-width: 480px) {
    .ix-share { flex-direction: column; align-items: flex-start; }
    .ix-share-buttons { margin-left: 0; }
  }

