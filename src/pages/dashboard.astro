---
// src/pages/dashboard.astro
import { createClient } from "@supabase/supabase-js";

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

// Fetch raw visits
const { data } = await supabase
  .from("daily_visitors")
  .select("visit_date");

const rows = data ?? [];

// GROUP BY DATE (FIX FOR YOUR COUNT ISSUE)
const map = new Map();

for (const row of rows) {
  const date = row.visit_date;
  map.set(date, (map.get(date) || 0) + 1);
}

const totals = Array.from(map.entries())
  .map(([visit_date, total_visitors]) => ({
    visit_date,
    total_visitors,
  }))
  .sort((a, b) => a.visit_date.localeCompare(b.visit_date));

// Summary stats
const today = new Date().toISOString().slice(0, 10);
const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10);

const todayCount =
  totals.find((r) => r.visit_date === today)?.total_visitors ?? 0;

const yesterdayCount =
  totals.find((r) => r.visit_date === yesterday)?.total_visitors ?? 0;

const totalLast30 = totals.reduce((s, r) => s + r.total_visitors, 0);

const avgDaily = totals.length
  ? Math.round(totalLast30 / totals.length)
  : 0;

const peak = totals.reduce(
  (m, r) =>
    r.total_visitors > m.count
      ? { date: r.visit_date, count: r.total_visitors }
      : m,
  { date: "-", count: 0 }
);

const trend =
  yesterdayCount > 0
    ? (((todayCount - yesterdayCount) / yesterdayCount) * 100).toFixed(1)
    : null;

const chartLabels = JSON.stringify(totals.map((r) => r.visit_date.slice(5)));
const chartValues = JSON.stringify(totals.map((r) => r.total_visitors));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ReviByte · Visitor Dashboard</title>
  <meta name="robots" content="noindex, nofollow" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

  <!-- (your existing CSS stays EXACTLY the same — no changes needed) -->
</head>

<body>
  <div class="wrap">
    <header>
      <div class="logo">Revi<span>Byte</span></div>
      <h1>Visitor Dashboard</h1>
    </header>

    <div class="stats">
      <div class="card today">
        <div class="card-label">Today</div>
        <div class="card-value">{todayCount}</div>
        <div class="card-sub">
          {trend !== null
            ? trend >= "0"
              ? <span class="trend-up">▲ {trend}% vs yesterday</span>
              : <span class="trend-down">▼ {Math.abs(Number(trend))}% vs yesterday</span>
            : "no data yet"}
        </div>
      </div>

      <div class="card avg">
        <div class="card-label">Daily Avg</div>
        <div class="card-value">{avgDaily}</div>
        <div class="card-sub">last {totals.length} days</div>
      </div>

      <div class="card peak">
        <div class="card-label">Peak Day</div>
        <div class="card-value">{peak.count}</div>
        <div class="card-sub">{peak.date !== "-" ? peak.date.slice(5) : "—"}</div>
      </div>

      <div class="card total">
        <div class="card-label">Total</div>
        <div class="card-value">{totalLast30}</div>
        <div class="card-sub">all visits</div>
      </div>
    </div>

    <div class="chart-box">
      <div class="chart-header">
        <span class="chart-title">Daily Visitors</span>
      </div>

      {totals.length === 0 ? (
        <div class="empty">No data yet. Visit your site to generate stats.</div>
      ) : (
        <canvas id="visitChart"></canvas>
      )}
    </div>

    <footer>
      revibyte.blog · {today}
    </footer>
  </div>

  {totals.length > 0 && (
    <script define:vars={{ chartLabels, chartValues }}>
      const labels = JSON.parse(chartLabels);
      const values = JSON.parse(chartValues);

      const ctx = document.getElementById("visitChart").getContext("2d");

      new Chart(ctx, {
        type: "line",
        data: {
          labels,
          datasets: [{
            label: "Visitors",
            data: values,
            borderColor: "#e8ff47",
            borderWidth: 2,
            fill: true,
            tension: 0.3,
          }]
        }
      });
    </script>
  )}
</body>
</html>
