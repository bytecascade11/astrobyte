---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

const pageTitle = "Work With Us | ReviByte";
const pageDesc =
  "Partner with ReviByte for sponsored posts, banner placements, and product reviews reaching a growing global tech and mobile gaming audience.";
---

<Layout title={pageTitle} description={pageDesc}>
  <Header />
  <main id="main-content" class="mx-auto max-w-3xl px-4 pb-16 pt-8">
    <article class="prose">
      <h1 class="text-3xl font-bold mb-4">Work With Us</h1>

      <p class="mb-6 text-lg">
        ReviByte is a fast-growing tech and mobile gaming blog covering
        smartphone reviews, Android optimization, and mobile gaming hubs like
        COD Mobile, eFootball, PUBG Mobile, and MLBB. We work with brands who
        want to reach an engaged, global audience — with strong representation
        across Nigeria, the US, and Indonesia.
      </p>

      <section class="mb-8">
        <h2 class="text-2xl font-semibold mb-3">Why Partner With ReviByte</h2>
        <ul class="list-disc list-inside space-y-2">
          <li>
            500–700 daily visitors, with the majority coming from organic
            Google Search
          </li>
          <li>Growing visibility across Google Search and AI-powered search experiences</li>
          <li>Trusted, fact-checked reviews with real editorial standards</li>
          <li>
            Dedicated hubs for top mobile games and phone brands, giving
            sponsors targeted placement options
          </li>
          <li>Growing newsletter and push notification subscriber base</li>
        </ul>
      </section>

      <section class="mb-8">
        <h2 class="text-2xl font-semibold mb-3">Ways to Partner</h2>
        <div class="space-y-4">
          <div>
            <h3 class="text-xl font-medium">Sponsored Posts</h3>
            <p>
              A dedicated review or feature article about your product, written
              with the same editorial care as our regular content.
            </p>
          </div>
          <div>
            <h3 class="text-xl font-medium">Banner & Display Ads</h3>
            <p>
              Placements across posts, gaming hubs, and device hubs, including
              high-visibility spots above the fold.
            </p>
          </div>
          <div>
            <h3 class="text-xl font-medium">Product Reviews</h3>
            <p>
              Honest, hands-on reviews of your device or app, published to our
              dedicated review hubs. We accept review units, but receiving a
              product does not guarantee a positive review.
            </p>
          </div>
          <div>
            <h3 class="text-xl font-medium">Newsletter & Push Mentions</h3>
            <p>
              Feature your brand to subscribers via our email newsletter or
              push notifications.
            </p>
          </div>
        </div>
      </section>

      <section class="mb-8">
        <h2 class="text-2xl font-semibold mb-3">Editorial Independence</h2>
        <p>
          Sponsored content is clearly disclosed, and paid partnerships do not
          guarantee positive editorial coverage. Our reviews reflect our honest
          assessment, regardless of any commercial relationship.
        </p>
      </section>

      <section class="mb-8">
        <h2 class="text-2xl font-semibold mb-3">Rates</h2>
        <p>
          Pricing depends on placement type and duration. Reach out with your
          goals and budget, and we'll put together a package that fits.
        </p>
      </section>

      <section class="mb-8">
        <h2 class="text-2xl font-semibold mb-3">Get in Touch</h2>
        <p>
          Ready to work together? Email us at
          <a
            href="mailto:revibyte20@gmail.com">revibyte20@gmail.com</a
          >
          with the following details so we can get back to you quickly:
        </p>
        <ul class="list-disc list-inside space-y-2">
          <li>Brand/company</li>
          <li>Product or service</li>
          <li>Campaign type</li>
          <li>Desired publication date</li>
          <li>Budget (optional)</li>
        </ul>
      </section>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  /* Light mode text */
  article.prose p,
  article.prose li,
  article.prose dd,
  article.prose dt,
  article.prose h1,
  article.prose h2,
  article.prose h3,
  article.prose blockquote,
  article.prose strong {
    color: #1a1a1a !important;
    opacity: 1 !important;
  }

  article.prose a {
    color: #006cac !important;
  }

  /* Dark mode text */
  html[data-theme="dark"] article.prose p,
  html[data-theme="dark"] article.prose li,
  html[data-theme="dark"] article.prose dd,
  html[data-theme="dark"] article.prose dt,
  html[data-theme="dark"] article.prose h1,
  html[data-theme="dark"] article.prose h2,
  html[data-theme="dark"] article.prose h3,
  html[data-theme="dark"] article.prose blockquote,
  html[data-theme="dark"] article.prose strong {
    color: #eaedf3 !important;
    opacity: 1 !important;
  }

  html[data-theme="dark"] article.prose a {
    color: #ff6b01 !important;
  }
</style>
