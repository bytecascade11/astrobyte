<script>
  const urlInput = document.getElementById('tt-url') as HTMLInputElement;
  const fetchBtn = document.getElementById('tt-fetch-btn') as HTMLButtonElement;
  const btnText = document.getElementById('tt-btn-text')!;
  const btnSpinner = document.getElementById('tt-btn-spinner')!;
  const errorEl = document.getElementById('tt-error')!;
  const resultEl = document.getElementById('tt-result')!;

  const coverEl = document.getElementById('tt-cover') as HTMLImageElement;
  const coverFallback = document.getElementById('tt-cover-fallback') as HTMLDivElement;
  const authorEl = document.getElementById('tt-author')!;
  const titleEl = document.getElementById('tt-video-title')!;
  const statsEl = document.getElementById('tt-stats')!;
  const dlHd = document.getElementById('tt-dl-hd') as HTMLAnchorElement;
  const dlAudio = document.getElementById('tt-dl-audio') as HTMLAnchorElement;

  function setLoading(loading: boolean) {
    fetchBtn.disabled = loading;
    btnText.style.display = loading ? 'none' : 'inline';
    btnSpinner.style.display = loading ? 'inline-flex' : 'none';
  }

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.style.display = 'block';
    resultEl.style.display = 'none';
  }

  function formatNumber(n: number): string {
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
    if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';
    return String(n);
  }

  function setCover(src: string | null | undefined) {
    const imageUrl = src || '';
    
    if (!imageUrl) {
      coverEl.style.display = 'none';
      coverFallback.style.display = 'flex';
      return;
    }

    coverEl.style.display = 'block';
    coverFallback.style.display = 'none';
    coverEl.src = imageUrl;
    
    coverEl.onerror = () => {
      coverEl.style.display = 'none';
      coverFallback.style.display = 'flex';
    };
    
    coverEl.onload = () => {
      coverEl.style.display = 'block';
      coverFallback.style.display = 'none';
    };
  }

  // Extract audio URL from various API response formats
  function extractAudioUrl(data: any): string | null {
    // Direct fields
    if (data.audio && typeof data.audio === 'string') return data.audio;
    if (data.audio_url && typeof data.audio_url === 'string') return data.audio_url;
    if (data.music_url && typeof data.music_url === 'string') return data.music_url;
    if (data.mp3 && typeof data.mp3 === 'string') return data.mp3;
    if (data.music && typeof data.music === 'string') return data.music;
    
    // Array of audio URLs
    if (data.audio && Array.isArray(data.audio) && data.audio.length > 0) return data.audio[0];
    
    // Nested: result.music.playUrl (TobyG74 v1/v2)
    if (data.result?.music?.playUrl) {
      const playUrl = data.result.music.playUrl;
      if (Array.isArray(playUrl) && playUrl.length > 0) return playUrl[0];
      if (typeof playUrl === 'string') return playUrl;
    }
    
    // Nested: result.music (TobyG74 v3 - string)
    if (data.result?.music && typeof data.result.music === 'string') return data.result.music;
    
    // Nested in download array (Mahmoud Sayed API)
    if (data.download && Array.isArray(data.download)) {
      const audioItem = data.download.find((item: any) => 
        item.extension === 'mp3' || item.quality?.includes('kbps') || item.audioAvailable === true
      );
      if (audioItem?.url) return audioItem.url;
    }
    
    // music.playUrl from top level
    if (data.music?.playUrl) {
      const playUrl = data.music.playUrl;
      if (Array.isArray(playUrl) && playUrl.length > 0) return playUrl[0];
      if (typeof playUrl === 'string') return playUrl;
    }
    
    // music.url
    if (data.music?.url && typeof data.music.url === 'string') return data.music.url;
    
    return null;
  }

  // Extract video URL (no watermark) from various API response formats
  function extractVideoUrl(data: any): string | null {
    // Direct fields
    if (data.videoNoWatermark && typeof data.videoNoWatermark === 'string') return data.videoNoWatermark;
    if (data.videoSD && typeof data.videoSD === 'string') return data.videoSD;
    if (data.download_url && typeof data.download_url === 'string') return data.download_url;
    if (data.video && typeof data.video === 'string') return data.video;
    
    // Array of video URLs
    if (data.video && Array.isArray(data.video) && data.video.length > 0) return data.video[0];
    
    // Nested: result.video.playAddr (TobyG74)
    if (data.result?.video?.playAddr) {
      const playAddr = data.result.video.playAddr;
      if (Array.isArray(playAddr) && playAddr.length > 0) return playAddr[0];
      if (typeof playAddr === 'string') return playAddr;
    }
    
    // Nested in download array (Mahmoud Sayed API) - prefer HD/no watermark
    if (data.download && Array.isArray(data.download)) {
      const hdItem = data.download.find((item: any) => 
        item.quality === 'hd' && item.videoAvailable === true
      );
      if (hdItem?.url) return hdItem.url;
      
      const sdItem = data.download.find((item: any) => 
        item.quality === 'sd' && item.videoAvailable === true
      );
      if (sdItem?.url) return sdItem.url;
      
      // Any available video
      const anyVideo = data.download.find((item: any) => item.videoAvailable === true);
      if (anyVideo?.url) return anyVideo.url;
    }
    
    return null;
  }

  // Extract thumbnail from various API response formats
  function extractThumbnail(data: any): string | null {
    if (data.cover && typeof data.cover === 'string') return data.cover;
    if (data.cover_image_url && typeof data.cover_image_url === 'string') return data.cover_image_url;
    if (data.thumbnail && typeof data.thumbnail === 'string') return data.thumbnail;
    if (data.thumb && typeof data.thumb === 'string') return data.thumb;
    if (data.image_src && typeof data.image_src === 'string') return data.image_src;
    
    // Nested: result.cover (TobyG74)
    if (data.result?.cover) {
      const cover = data.result.cover;
      if (Array.isArray(cover) && cover.length > 0) return cover[0];
      if (typeof cover === 'string') return cover;
    }
    
    // Nested: result.video.cover
    if (data.result?.video?.cover) {
      const cover = data.result.video.cover;
      if (Array.isArray(cover) && cover.length > 0) return cover[0];
      if (typeof cover === 'string') return cover;
    }
    
    // metadata.thumbnail (Mahmoud Sayed)
    if (data.metadata?.thumbnail && typeof data.metadata.thumbnail === 'string') return data.metadata.thumbnail;
    
    // author.avatar as fallback
    if (data.author?.avatar && typeof data.author.avatar === 'string') return data.author.avatar;
    if (data.result?.author?.avatar && typeof data.result.author.avatar === 'string') return data.result.author.avatar;
    
    return null;
  }

  // Extract author name from various API response formats
  function extractAuthor(data: any): string {
    if (data.author?.username) return data.author.username;
    if (data.author?.unique_id) return data.author.unique_id;
    if (data.author?.nickname) return data.author.nickname;
    if (data.result?.author?.username) return data.result.author.username;
    if (data.result?.author?.nickname) return data.result.author.nickname;
    if (typeof data.author === 'string') return data.author;
    return 'unknown';
  }

  // Extract title/description from various API response formats
  function extractTitle(data: any): string {
    if (data.title && typeof data.title === 'string') return data.title;
    if (data.desc && typeof data.desc === 'string') return data.desc;
    if (data.result?.desc && typeof data.result.desc === 'string') return data.result.desc;
    if (data.metadata?.title && typeof data.metadata.title === 'string') return data.metadata.title;
    return '';
  }

  // Extract play count from various API response formats
  function extractPlays(data: any): number {
    return data.plays || data.view_count || data.views || data.result?.statistics?.playCount || 
           data.metadata?.plays || data.statistics?.playCount || 0;
  }

  // Extract like count from various API response formats
  function extractLikes(data: any): number {
    return data.likes || data.like_count || data.result?.statistics?.likeCount || 
           data.metadata?.likes || data.statistics?.likeCount || 0;
  }

  async function fetchVideo() {
    const url = urlInput.value.trim();
    if (!url) { showError('Please paste a TikTok link first.'); return; }

    errorEl.style.display = 'none';
    resultEl.style.display = 'none';
    setLoading(true);

    try {
      const res = await fetch('/api/tiktok-save/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      });

      const data = await res.json();

      if (!res.ok || data.error) {
        showError(data.error || 'Could not fetch video. Try again.');
        return;
      }

      // Debug: log the full response to see what fields your API returns
      console.log('=== API Response ===');
      console.log(JSON.stringify(data, null, 2));

      // Extract data using helper functions that handle multiple API formats
      const thumbnailUrl = extractThumbnail(data);
      const videoUrl = extractVideoUrl(data);
      const audioUrl = extractAudioUrl(data);
      const authorName = extractAuthor(data);
      const videoTitle = extractTitle(data);
      const plays = extractPlays(data);
      const likes = extractLikes(data);

      console.log('Extracted:', { thumbnailUrl, videoUrl, audioUrl, authorName, videoTitle, plays, likes });

      // Populate result
      setCover(thumbnailUrl);
      coverEl.alt = videoTitle || 'TikTok video';
      authorEl.textContent = '@' + authorName;
      titleEl.textContent = videoTitle;
      statsEl.textContent = `▶ ${formatNumber(plays)} plays · ♥ ${formatNumber(likes)} likes`;

      dlHd.href = videoUrl || '#';

      if (!audioUrl) {
        dlAudio.classList.add('tt-dl-disabled');
        dlAudio.href = '#';
        dlAudio.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
          </svg>
          Audio not available`;
      } else {
        dlAudio.classList.remove('tt-dl-disabled');
        dlAudio.href = audioUrl;
        dlAudio.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
          </svg>
          Download Audio (MP3)`;
      }

      resultEl.style.display = 'block';

    } catch (err) {
      console.error('Fetch error:', err);
      showError('Network error. Check your connection and try again.');
    } finally {
      setLoading(false);
    }
  }

  // --- Ad Gate Logic ---
  const adGate = document.getElementById('tt-ad-gate')!;
  const gateDlBtn = document.getElementById('tt-gate-dl-btn') as HTMLButtonElement;
  const gateSecsEl = document.getElementById('tt-gate-secs')!;
  const gateClose = document.getElementById('tt-gate-close')!;
  let pendingDownloadUrl = '';
  let gateTimer: ReturnType<typeof setInterval> | null = null;

  function openAdGate(downloadUrl: string) {
    pendingDownloadUrl = downloadUrl;
    adGate.style.display = 'flex';
    try {
      ((window as any).adsbygoogle = (window as any).adsbygoogle || []).push({});
    } catch(e) {}
    gateDlBtn.disabled = true;
    gateDlBtn.style.opacity = '0.4';
    gateDlBtn.style.cursor = 'not-allowed';
    gateSecsEl.textContent = '5';
    let secs = 5;
    if (gateTimer) clearInterval(gateTimer);
    gateTimer = setInterval(() => {
      secs--;
      gateSecsEl.textContent = String(secs);
      if (secs <= 0) {
        clearInterval(gateTimer!);
        gateDlBtn.disabled = false;
        gateDlBtn.style.opacity = '1';
        gateDlBtn.style.cursor = 'pointer';
        document.getElementById('tt-gate-countdown')!.textContent = '✅ Your download is ready!';
      }
    }, 1000);
  }

  gateDlBtn.addEventListener('click', () => {
    if (pendingDownloadUrl) {
      window.open(pendingDownloadUrl, '_blank');
      adGate.style.display = 'none';
    }
  });

  gateClose.addEventListener('click', () => {
    adGate.style.display = 'none';
    if (gateTimer) clearInterval(gateTimer);
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('#tt-dl-hd, #tt-dl-audio') as HTMLAnchorElement | null;
    if (!btn || btn.classList.contains('tt-dl-disabled')) return;
    const href = btn.getAttribute('href');
    if (!href || href === '#') return;
    e.preventDefault();
    openAdGate(href);
  });

  fetchBtn.addEventListener('click', fetchVideo);
  urlInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') fetchVideo();
  });
  urlInput.addEventListener('focus', async () => {
    if (urlInput.value) return;
    try {
      const text = await navigator.clipboard.readText();
      if (text.includes('tiktok.com')) urlInput.value = text;
    } catch { }
  });
</script>
