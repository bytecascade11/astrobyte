---
import Layout from "../../../layouts/Layout.astro";

const title = "Video Downloader for TikTok — Save Videos Online | ReviByte";
const description = "Free online downloader for short videos. Save videos and audio quickly on Android, iPhone, and PC. Not affiliated with TikTok.";
const canonicalURL = "https://www.revibyte.blog/save/tok/";
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "ReviByte Save Tok Downloader",
      "url": canonicalURL,
      "description": description,
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web, Android, iOS",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "author": { "@type": "Person", "name": "iSamuel", "url": "https://revibyte.blog" }
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I download a TikTok video without watermark?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Paste the TikTok video link into the box on this page and click Download. Choose 'Video (No Watermark)' to save without the TikTok logo."
          }
        },
        {
          "@type": "Question",
          "name": "Can I download TikTok audio as MP3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. After pasting your TikTok link, click the 'Download Audio (MP3)' button to save just the audio from the video."
          }
        },
        {
          "@type": "Question",
          "name": "Is this TikTok downloader free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, ReviByte's TikTok downloader is completely free. No login, no app install, no hidden charges."
          }
        },
        {
          "@type": "Question",
          "name": "Does this work on Android and iPhone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, it works on any device with a browser — Android, iPhone, tablet, or PC."
          }
        }
      ]
    })} />
  </Fragment>

  <main class="tt-page">
<!-- Nav -->
<nav class="tt-nav">
  <a href="/" class="tt-nav-back">← ReviByte Blog</a>
</nav>
    <!-- Hero -->
    <section class="tt-hero">
      <div class="tt-badge">Free Tool</div>
      <h1 class="tt-title">TikTok Video <span class="tt-accent">Downloader</span></h1>
      <p class="tt-subtitle">Download TikTok videos without watermark — or save as MP3. Free, fast, no login needed.</p>
    </section>

    <!-- Tool -->
    <section class="tt-tool">
      <div class="tt-input-wrap">
        <input
          id="tt-url"
          type="url"
          placeholder="Paste TikTok link here... (e.g. https://www.tiktok.com/@user/video/...)"
          autocomplete="off"
          spellcheck="false"
        />
        <button id="tt-fetch-btn">
          <span id="tt-btn-text">Download</span>
          <span id="tt-btn-spinner" style="display:none">
            <svg class="tt-spin" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
            </svg>
          </span>
        </button>
      </div>

      <p class="tt-hint">
        Copy a TikTok link from the app → tap <strong>Share</strong> → <strong>Copy link</strong> → paste above
      </p>

      <!-- Error -->
      <div id="tt-error" class="tt-error" style="display:none"></div>

      <!-- Result card -->
      <div id="tt-result" class="tt-result" style="display:none">
        <div class="tt-video-meta">
          <div class="tt-cover-wrap">
            <img id="tt-cover" src="" alt="TikTok video thumbnail" class="tt-cover" />
            <div id="tt-cover-fallback" class="tt-cover-fallback" style="display:none">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          </div>
          <div class="tt-meta-info">
            <div id="tt-author" class="tt-author"></div>
            <div id="tt-video-title" class="tt-video-title"></div>
            <div id="tt-stats" class="tt-stats"></div>
          </div>
        </div>

        <div class="tt-download-btns">
          <a id="tt-dl-hd" href="#" target="_blank" class="tt-dl-btn tt-dl-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download Video (No Watermark)
          </a>
          <a id="tt-dl-audio" href="#" target="_blank" class="tt-dl-btn tt-dl-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
            </svg>
            Download Audio (MP3)
          </a>
        </div>
      </div>
    </section>
<!-- Ad Gate Overlay -->
<div id="tt-ad-gate" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.88); z-index:9999; align-items:center; justify-content:center; padding:1rem;">
  <div style="background:#111; border:1px solid #333; border-radius:16px; padding:1.75rem 1.5rem; max-width:460px; width:100%; text-align:center;">
    <p style="font-size:0.8rem; opacity:0.5; margin-bottom:1rem; text-transform:uppercase; letter-spacing:0.06em;">Preparing your download...</p>

    <!-- AdSense unit -->
    <ins class="adsbygoogle"
      style="display:block; min-height:100px;"
      data-ad-client="ca-pub-4896561037705299"
      data-ad-slot="4282672192"
      data-ad-format="auto"
      data-full-width-responsive="true">
    </ins>

    <div id="tt-gate-countdown" style="margin-top:1.25rem; font-size:0.9rem; opacity:0.6;">
      Download unlocks in <strong id="tt-gate-secs">5</strong>s...
    </div>

    <button id="tt-gate-dl-btn" disabled style="margin-top:1rem; width:100%; padding:0.85rem; border-radius:12px; border:none; background:linear-gradient(135deg,#ff0050,#ff6b00); color:#fff; font-size:1rem; font-weight:700; cursor:not-allowed; opacity:0.4; transition:opacity 0.2s;">
      ⬇ Download Now
    </button>

    <button id="tt-gate-close" style="margin-top:0.75rem; background:none; border:none; color:inherit; opacity:0.35; font-size:0.8rem; cursor:pointer;">Cancel</button>
  </div>
</div>
    <!-- How to use -->
    <section class="tt-how">
      <h2>How to Download TikTok Videos</h2>
      <div class="tt-steps">
        <div class="tt-step">
          <div class="tt-step-num">1</div>
          <div>
            <strong>Copy the TikTok link</strong>
            <p>Open TikTok, find the video, tap Share → Copy Link</p>
          </div>
        </div>
        <div class="tt-step">
          <div class="tt-step-num">2</div>
          <div>
            <strong>Paste it above</strong>
            <p>Paste the link into the box at the top of this page</p>
          </div>
        </div>
        <div class="tt-step">
          <div class="tt-step-num">3</div>
          <div>
            <strong>Choose your download</strong>
            <p>Pick video without watermark or audio-only MP3</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="tt-faq">
      <h2>Frequently Asked Questions</h2>

      <details class="tt-faq-item">
        <summary>Does this remove the TikTok watermark?</summary>
        <p>Yes. The "No Watermark" download option gives you a clean video without the TikTok logo or username overlay.</p>
      </details>

      <details class="tt-faq-item">
        <summary>Can I download private TikTok videos?</summary>
        <p>No — only public TikTok videos can be downloaded. Private videos are not accessible.</p>
      </details>

      <details class="tt-faq-item">
        <summary>Does it work on Android and iPhone?</summary>
        <p>Yes. This tool works on any browser — Android, iPhone, tablet, or desktop PC.</p>
      </details>

      <details class="tt-faq-item">
        <summary>Is there a limit on downloads?</summary>
        <p>No limit. Download as many TikTok videos as you need, completely free.</p>
      </details>

      <details class="tt-faq-item">
        <summary>Can I download TikTok audio as MP3?</summary>
        <p>Yes — click "Download Audio (MP3)" after pasting your link to save just the music or sound from the video.</p>
      </details>
    </section>

  </main>
</Layout>

<style>
/* Nav */
.tt-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 0 1.5rem;
}

.tt-nav-back {
  font-size: 0.85rem;
  font-weight: 700;
  color: inherit !important;
  text-decoration: none;
  opacity: 0.6;
  transition: opacity 0.15s;
}

.tt-nav-back:hover { opacity: 1; }

.tt-nav-save {
  font-size: 0.78rem;
  font-weight: 700;
  color: #ff0050 !important;
  text-decoration: none;
  border: 1px solid rgba(255, 0, 80, 0.3);
  border-radius: 999px;
  padding: 0.3rem 0.85rem;
  transition: background 0.15s;
}

.tt-nav-save:hover {
  background: rgba(255, 0, 80, 0.08);
}
  .tt-page {
    max-width: 780px;
    margin: 0 auto;
    padding: 2rem 1.25rem 5rem;
  }

  /* Hero */
  .tt-hero {
    text-align: center;
    padding: 2.5rem 0 2rem;
  }

  .tt-badge {
    display: inline-block;
    background: rgba(255, 0, 80, 0.1);
