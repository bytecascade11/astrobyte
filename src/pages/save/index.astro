---
import Layout from "../../layouts/Layout.astro";

const title = "ReviByte Tools — Free Online Tools";
const description = "Free online tools from ReviByte. More tools launching soon — check back for updates.";
const canonicalURL = "https://www.revibyte.blog/save/";
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>

  <main class="save-page">
    <nav class="save-nav">
      <a href="/" class="save-nav-back">← ReviByte Blog</a>
    </nav>

    <section class="save-hero">
      <div class="save-badge">Free Tools</div>
      <h1 class="save-title">ReviByte <span class="save-accent">Tools</span></h1>
      <p class="save-subtitle">We're building a set of free tools for you. More things are coming soon — check back here for updates.</p>
    </section>

    <section class="save-empty">
      <div class="save-empty-icon">🛠️</div>
      <p class="save-empty-text">Nothing live here yet, but new tools are on the way.</p>
    </section>
  </main>
</Layout>

<style>
  .save-page {
    max-width: 780px;
    margin: 0 auto;
    padding: 2rem 1.25rem 5rem;
  }

  .save-nav {
    padding: 0.75rem 0 1.5rem;
  }

  .save-nav-back {
    font-size: 0.85rem;
    font-weight: 700;
    color: inherit !important;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.15s;
  }

  .save-nav-back:hover { opacity: 1; }

  .save-hero {
    text-align: center;
    padding: 2.5rem 0 2.5rem;
  }

  .save-badge {
    display: inline-block;
    background: rgba(255, 0, 80, 0.1);
    color: #ff0050;
    border: 1px solid rgba(255, 0, 80, 0.25);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.28rem 0.85rem;
    margin-bottom: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .save-title {
    font-size: clamp(2rem, 6vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
  }

  .save-accent {
    background: linear-gradient(135deg, #ff0050, #ff6b00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .save-subtitle {
    font-size: 1.05rem;
    line-height: 1.65;
    opacity: 0.7;
    max-width: 480px;
    margin: 0 auto;
    color: inherit !important;
  }

  .save-empty {
    text-align: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px dashed #333;
    border-radius: 16px;
    padding: 3rem 1.5rem;
  }

  .save-empty-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .save-empty-text {
    font-size: 0.95rem;
    opacity: 0.6;
    margin: 0;
    color: inherit !important;
  }
</style>
