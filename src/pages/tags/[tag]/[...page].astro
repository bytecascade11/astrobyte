---
// src/pages/tags/[tag]/[page].astro
// Generates: /tags/offline-games, /tags/offline-games/2, etc.

import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";

// If you still have these utils, keep them; otherwise, inline logic below
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

interface Props {
  page: {
    data: CollectionEntry<"blog">[];
    /** Current page number */
    currentPage: number;
    /** Total number of pages */
    lastPage: number;
    /** URL for the next page */
    url: {
      next: string | undefined;
      prev: string | undefined;
    };
  };
  tag: string;  // normalized lowercase tag
  tagName: string; // display name (capitalized)
}

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const sortedPosts = getSortedPosts(allPosts);

  // Collect unique tags
  const tagMap = new Map<string, string>(); // lowercase -> display name
  sortedPosts.forEach((post) => {
    post.data.tags?.forEach((tag) => {
      const lower = tag.toLowerCase();
      if (!tagMap.has(lower)) {
        tagMap.set(lower, tag); // store original casing
      }
    });
  });

  return Array.from(tagMap).flatMap(([lowerTag, displayTag]) => {
    const tagPosts = sortedPosts.filter((post) =>
      post.data.tags?.some((t) => t.toLowerCase() === lowerTag)
    );

    if (tagPosts.length === 0) return [];

    return paginate(tagPosts, {
      params: { tag: lowerTag },
      props: { tag: lowerTag, tagName: displayTag },
      pageSize: SITE.postPerPage || 10,
    });
  });
};

const { page, tagName } = Astro.props;
---

<Layout title={`Tag: ${tagName} | ${SITE.title}`}>
  <Header />

  <main class="wrapper mt-10">
    <h1 class="text-3xl font-bold capitalize mb-4">
      Posts tagged "#{tagName}"
    </h1>
    <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
      {page.data.length} post{page.data.length === 1 ? "" : "s"} found.
    </p>

    {page.data.length > 0 ? (
      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {page.data.map((post) => (
          <li>
            <!-- Replace with your preferred card style -->
            <!-- Option 1: Use your existing Card component if it accepts full post -->
            <!-- <Card post={post} /> -->

            <!-- Option 2: Manual card (safe and matches your /posts page) -->
            <article class="overflow-hidden rounded-2xl shadow-lg bg-card hover:shadow-xl transition">
              {post.data.coverImage && (
                <a href={`/posts/${post.id}`}>
                  <img
                    src={post.data.coverImage}
                    alt={post.data.coverImageAlt || post.data.title}
                    class="w-full object-cover aspect-video"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="p-6">
                <h2 class="text-xl font-semibold mb-2">
                  <a href={`/posts/${post.id}`} class="hover:text-accent transition">
                    {post.data.title}
                  </a>
                </h2>
                <time class="text-sm text-muted-foreground block mb-3">
                  {post.data.pubDatetime.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                {post.data.description && (
                  <p class="text-muted-foreground line-clamp-3">
                    {post.data.description}
                  </p>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-center py-12 text-lg">No posts found for this tag.</p>
    )}

    {/* Pagination */}
    {page.lastPage > 1 && <Pagination page={page} />}
  </main>

  <Footer noMarginTop={page.lastPage <= 1} />
</Layout>
