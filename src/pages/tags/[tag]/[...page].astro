---
import type { GetStaticPaths, Page } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

// ✅ Use your existing tagMetadata
import { tagMetadata } from "@/data/tagMetadata";

type BlogPost = CollectionEntry<"blog">;

// --- Generate static paths ---
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const sortedPosts = getSortedPosts(allPosts);

  const tagMap = new Map<string, string>();
  sortedPosts.forEach((post) => {
    post.data.tags?.forEach((tag) => {
      const lower = String(tag).toLowerCase();
      if (!tagMap.has(lower)) tagMap.set(lower, String(tag));
    });
  });

  return Array.from(tagMap).flatMap(([lowerTag, displayTag]) => {
    const tagPosts = sortedPosts.filter((post) =>
      post.data.tags?.some((t) => String(t).toLowerCase() === lowerTag)
    );

    if (!tagPosts.length) return [];

    return paginate(tagPosts, {
      params: { tag: lowerTag }, // lowercase URL
      props: { tagName: displayTag },
      pageSize: SITE.postPerPage ?? 10,
    });
  });
};

// --- Props typing ---
const { page, tagName } = Astro.props as {
  page: Page<BlogPost>;
  tagName: string;
};

// ✅ Redirect uppercase URLs to lowercase
const requestedTag = Astro.params.tag;
if (typeof requestedTag === "string" && requestedTag !== requestedTag.toLowerCase()) {
  return Astro.redirect(`/tags/${requestedTag.toLowerCase()}/`, 301);
}

// --- Use SEO metadata from tagMetadata ---
const meta = tagMetadata[tagName.toLowerCase()] || {
  title: `${tagName} – ReviByte Opinions`,
  description: `All posts about ${tagName} on ReviByte.`,
};
---

<Layout title={meta.title} description={meta.description}>
  <Header />

  <main class="wrapper mt-10">
    <h1 class="text-3xl font-bold capitalize mb-4">
      {meta.title}
    </h1>

    <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
      {page.data.length} post{page.data.length === 1 ? "" : "s"} found.
    </p>

    {page.data.length > 0 ? (
      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {page.data.map((post) => (
          <li>
            <article class="overflow-hidden rounded-2xl shadow-lg bg-card hover:shadow-xl transition">
              {post.data.coverImage && (
                <a href={`/posts/${post.id}`}>
                  <img
                    src={post.data.coverImage}
                    alt={post.data.coverImageAlt ?? post.data.title}
                    class="w-full object-cover aspect-video"
                    loading="lazy"
                  />
                </a>
              )}

              <div class="p-6">
                <h2 class="text-xl font-semibold mb-2">
                  <a
                    href={`/posts/${post.id}`}
                    class="hover:text-accent transition"
                  >
                    {post.data.title}
                  </a>
                </h2>

                <time class="text-sm text-muted-foreground block mb-3">
                  {post.data.pubDatetime.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>

                {post.data.description && (
                  <p class="text-muted-foreground line-clamp-3">
                    {post.data.description}
                  </p>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-center py-12 text-lg">No posts found for this tag.</p>
    )}

    {page.lastPage > 1 && <Pagination page={page} />}
  </main>

  <Footer noMarginTop={page.lastPage <= 1} />
</Layout>
