---
import type { GetStaticPaths, Page } from "astro";
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Pagination from "@/components/Pagination.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

import { tagMetadata } from "@/data/tagMetadata";

type TaggablePost = {
  id: string;
  hubPath: string;
  data: any;
};

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const blogPosts = await getCollection("blog", ({ data }) => !data.draft);
  const samsungPosts = await getCollection("samsung", ({ data }) => !data.draft);
  const xiaomiPosts = await getCollection("xiaomi", ({ data }) => !data.draft);
  const tecnoPosts = await getCollection("tecno", ({ data }) => !data.draft);
  const motorolaPosts = await getCollection("motorola", ({ data }) => !data.draft);
  const huaweiPosts = await getCollection("huawei", ({ data }) => !data.draft);
  const honorPosts = await getCollection("honor", ({ data }) => !data.draft);
  const oneplusPosts = await getCollection("oneplus", ({ data }) => !data.draft);
  const pixelPosts = await getCollection("pixel", ({ data }) => !data.draft);


  const allPosts: TaggablePost[] = [
    ...blogPosts.map(p => ({ ...p, hubPath: "posts" })),
    ...samsungPosts.map(p => ({ ...p, hubPath: "samsung" })),
    ...xiaomiPosts.map(p => ({ ...p, hubPath: "xiaomi" })),
    ...tecnoPosts.map(p => ({ ...p, hubPath: "tecno" })),
    ...motorolaPosts.map(p => ({ ...p, hubPath: "motorola" })),
    ...huaweiPosts.map(p => ({ ...p, hubPath: "huawei" })),
    ...honorPosts.map(p => ({ ...p, hubPath: "honor" })),
    ...oneplusPosts.map(p => ({ ...p, hubPath: "oneplus" })),
    ...pixelPosts.map(p => ({ ...p, hubPath: "pixel" })),
  ];

  const sortedPosts = getSortedPosts(allPosts as any);

  const tagMap = new Map<string, string>();
  sortedPosts.forEach((post: any) => {
    post.data.tags?.forEach((tag: string) => {
      const lower = String(tag).toLowerCase();
      if (!tagMap.has(lower)) tagMap.set(lower, String(tag));
    });
  });

  return Array.from(tagMap).flatMap(([lowerTag, displayTag]) => {
    const tagPosts = sortedPosts.filter((post: any) =>
      post.data.tags?.some((t: string) => String(t).toLowerCase() === lowerTag)
    );

    if (!tagPosts.length) return [];

    return paginate(tagPosts, {
      params: { tag: lowerTag },
      props: { tagName: displayTag },
      pageSize: SITE.postPerPage ?? 10,
    });
  });
};

const { page, tagName } = Astro.props as {
  page: Page<TaggablePost>;
  tagName: string;
};

const requestedTag = Astro.params.tag;
if (typeof requestedTag === "string" && requestedTag !== requestedTag.toLowerCase()) {
  return Astro.redirect(`/tags/${requestedTag.toLowerCase()}/`, 301);
}

const meta = tagMetadata[tagName.toLowerCase()] || {
  title: `${tagName} | ${SITE.title}`,
  description: `All posts tagged with ${tagName} on ${SITE.title}.`,
};
---

<Layout
  title={meta.title}
  description={meta.description}
  canonicalURL={Astro.url.href}
>
  <Header />

  <main class="wrapper mt-10">
    <h1 class="text-3xl font-bold capitalize mb-4">
      {tagName}
    </h1>

    <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
      {page.data.length} post{page.data.length === 1 ? "" : "s"} found.
    </p>

    {page.data.length > 0 ? (
      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {page.data.map((post: any) => (
          <li>
            <article class="overflow-hidden rounded-2xl shadow-lg bg-card hover:shadow-xl transition duration-200">
              {post.data.coverImage && (
                <a href={`/${post.hubPath}/${post.id}/`}>
                  <img
                    src={post.data.coverImage}
                    alt={post.data.coverImageAlt ?? post.data.title}
                    class="w-full aspect-video object-cover"
                    loading="lazy"
                    width="600"
                    height="400"
                  />
                </a>
              )}

              <div class="p-6">
                <h2 class="text-xl font-semibold mb-2">
                  <a
                    href={`/${post.hubPath}/${post.id}/`}
                    class="hover:text-accent transition-colors"
                  >
                    {post.data.title}
                  </a>
                </h2>

                <time
                  class="text-sm text-muted-foreground block mb-3"
                  datetime={post.data.pubDatetime.toISOString()}
                >
                  {post.data.pubDatetime.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>

                {post.data.description && (
                  <p class="text-muted-foreground line-clamp-3">
                    {post.data.description}
                  </p>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-center py-12 text-lg text-gray-500 dark:text-gray-400">
        No posts found for this tag.
      </p>
    )}

    {page.lastPage > 1 && <Pagination page={page} />}
  </main>
</Layout>
