---
// src/pages/tags/[tag]/[page].astro
// Correct file name for nested pagination: generates /tags/astro, /tags/astro/2, etc.

import { getCollection } from "astro:content";
import type { GetStaticPathsOptions, Page } from "astro";
import type { CollectionEntry } from "astro:content";

import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";

import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

interface Props {
  page: Page<CollectionEntry<"blog">>;
  tagName: string;
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const sortedPosts = getSortedPosts(allPosts);
  const tags = getUniqueTags(sortedPosts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(sortedPosts, tag);

    if (tagPosts.length === 0) return [];

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage || 10,
    });
  });
}

const { page, tagName } = Astro.props;
---

<Layout title={`Tag: ${tagName} | ${SITE.title}`}>
  <Header />

  <!-- Fixed: Assuming Main accepts string for pageTitle (most common pattern) -->
  <!-- If your Main.astro uses different props, adjust accordingly -->
  <Main
    pageTitle={`Tag: ${tagName}`}
    pageDesc={`All the articles tagged with "${tagName}".`}
  >
    <!-- Optional: Custom title in slot if Main supports it -->
    <h1 slot="title" transition:name={tagName}>
      Tag: {tagName}
    </h1>

    {page.data.length > 0 ? (
      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {page.data.map((post) => (
          <li>
            <Card {...post} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-center py-12">No posts found for this tag.</p>
    )}
  </Main>

  {page.lastPage > 1 && <Pagination page={page} />}

  <Footer noMarginTop={page.lastPage <= 1} />
</Layout>
