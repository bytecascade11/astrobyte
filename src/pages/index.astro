---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import LinkButton from "@/components/LinkButton.astro";
import Hr from "@/components/Hr.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import imageManifest from '@/data/image-manifest.json';

const blogPosts = await getCollection("blog");
const samsungPosts = await getCollection("samsung");

const taggedBlog = blogPosts
  .filter(post => !post.data.draft)
  .map(post => ({ ...post, hubPath: "posts" }));

const taggedSamsung = samsungPosts
  .filter(post => !post.data.draft)
  .map(post => ({ ...post, hubPath: "samsung" }));

const sortedPosts = [...taggedBlog, ...taggedSamsung]
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());

const heroPost = sortedPosts[0];
const sidebarPosts = sortedPosts.filter(p => p.id !== heroPost?.id).slice(0, 6);
const listPosts = sortedPosts.filter(p => p.id !== heroPost?.id).slice(6, 14);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

function getOptimizedSrc(src: string, width: number = 800): string {
  const normalize = (s: string) => s.replace(/^\/images\//, '').replace(/^\/assets\//, '').replace(/^\//, '');
  const key = normalize(src);
  const entry = imageManifest[key];
  return entry?.optimized?.[width] || src;
}

function getSrcset(src: string): string {
  const normalize = (s: string) => s.replace(/^\/images\//, '').replace(/^\/assets\//, '').replace(/^\//, '');
  const key = normalize(src);
  const entry = imageManifest[key];
  const webp = entry?.optimized;
  if (!webp) return src;
  return `${webp[480]} 480w, ${webp[800]} 800w, ${webp[1200]} 1200w`;
}
---

<Layout title={`Home | ${SITE.title}`}>
  <Header />

  <main id="main-content" class="rb-home mx-auto w-full max-w-app px-4 pt-8 pb-16">

    <!-- ── HERO + SIDEBAR ── -->
    {heroPost && (
      <section class="rb-top-grid mb-10">

        <article class="rb-hero">
          <a href={`/${heroPost.hubPath}/${heroPost.id}/`} class="rb-hero__img-wrap">
            {heroPost.data.coverImage && (
              <img
                src={getOptimizedSrc(heroPost.data.coverImage, 800)}
                srcset={getSrcset(heroPost.data.coverImage)}
                alt={heroPost.data.coverImageAlt ?? heroPost.data.title}
                class="rb-hero__img"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="900"
                height="500"
                sizes="(max-width: 640px) 100vw, (max-width: 900px) 100vw, 60vw"
              />
            )}
          </a>
          <div class="rb-hero__body">
            {heroPost.data.tags && heroPost.data.tags.length > 0 && (
              <div class="rb-tags mb-3">
                {heroPost.data.tags.slice(0, 3).map(tag => (
                  <a href={`/tags/${tag}/`} class="rb-tag rb-tag--accent">{tag}</a>
                ))}
              </div>
            )}

            <h1 class="rb-hero__title">
              <a href={`/${heroPost.hubPath}/${heroPost.id}/`}>{heroPost.data.title}</a>
            </h1>

            {heroPost.data.description && (
              <p class="rb-hero__desc">{heroPost.data.description}</p>
            )}

            <div class="rb-hero__meta">
              <span class="rb-byline">By {heroPost.data.author ?? SITE.author}</span>
              <span class="rb-dot">·</span>
              <time>{formatDate(heroPost.data.pubDatetime)}</time>
            </div>

            <a href={`/${heroPost.hubPath}/${heroPost.id}/`} class="rb-read-btn">
              Read Article <span>→</span>
            </a>
          </div>
        </article>

        <aside class="rb-sidebar">
          <h2 class="rb-sidebar__heading">Latest</h2>
          <ul class="rb-sidebar__list">
            {sidebarPosts.map((post, i) => (
              <li class="rb-sidebar__item">
                <span class="rb-sidebar__num">{String(i + 1).padStart(2, "0")}</span>
                <div class="rb-sidebar__content">
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="rb-tags rb-tags--sm mb-1">
                      <span class="rb-tag">{post.data.tags[0]}</span>
                    </div>
                  )}
                  <a href={`/${post.hubPath}/${post.id}/`} class="rb-sidebar__title">
                    {post.data.title}
                  </a>
                  <time class="rb-sidebar__date">{formatDate(post.data.pubDatetime)}</time>
                </div>
              </li>
            ))}
          </ul>
        </aside>

      </section>
    )}

    <Hr class="my-10" />

    <!-- ── GAMES HUB — LIST STYLE ── -->
    <section class="rb-games-hub mb-10">
      <div class="rb-section-header">
        <h2 class="rb-section-heading">🎮 Game Guides</h2>
        <p class="rb-section-sub">In-depth guides, tips & tier lists</p>
      </div>

      <ul class="rb-list-cards">
        <li class="rb-list-card-item">
          <a href="/codm/" class="rb-list-card-link">
            <span class="rb-list-card-icon">🎯</span>
            <div class="rb-list-card-info">
              <h3 class="rb-list-card-title">COD Mobile</h3>
              <p class="rb-list-card-desc">Best loadouts, weapon tier lists, sensitivity settings and ranked guides — updated every season.</p>
            </div>
            <span class="rb-list-card-arrow">→</span>
          </a>
        </li>

        <li class="rb-list-card-item">
          <a href="/efootball/" class="rb-list-card-link">
            <span class="rb-list-card-icon">⚽</span>
            <div class="rb-list-card-info">
              <h3 class="rb-list-card-title">eFootball 2026</h3>
              <p class="rb-list-card-desc">Top formations, Division 1 tactics, player reviews and squad-building tips for every patch.</p>
            </div>
            <span class="rb-list-card-arrow">→</span>
          </a>
        </li>

        <li class="rb-list-card-item">
          <a href="/pubgmobile/" class="rb-list-card-link">
            <span class="rb-list-card-icon">🔫</span>
            <div class="rb-list-card-info">
              <h3 class="rb-list-card-title">PUBG Mobile</h3>
              <p class="rb-list-card-desc">Best weapon loadouts, tier lists, sensitivity settings and ranked guides updated every season.</p>
            </div>
            <span class="rb-list-card-arrow">→</span>
          </a>
        </li>

        <li class="rb-list-card-item">
          <a href="/mlbb/" class="rb-list-card-link">
            <span class="rb-list-card-icon">⚔️</span>
            <div class="rb-list-card-info">
              <h3 class="rb-list-card-title">Mobile Legends</h3>
              <p class="rb-list-card-desc">Best hero guides, tier lists, emblem builds, and ranked tips updated every season.</p>
            </div>
            <span class="rb-list-card-arrow">→</span>
          </a>
        </li>
      </ul>
    </section>

    <Hr class="my-10" />

    <!-- ── TOOLS HUB — LIST STYLE ── -->
    <section class="rb-tools-hub mb-10">
      <div class="rb-section-header">
        <h2 class="rb-section-heading">🛠️ ReviByte Tools</h2>
        <p class="rb-section-sub">Free tools built for everyday use — no login.</p>
      </div>

      <ul class="rb-list-cards">
        <li class="rb-list-card-item">
          <a href="/heliara/" class="rb-list-card-link">
            <span class="rb-list-card-icon">✨</span>
            <div class="rb-list-card-info">
              <h3 class="rb-list-card-title">Heliara AI</h3>
              <p class="rb-list-card-desc">Ask anything about phones, Android, COD Mobile, eFootball, or general tech. Instant answers powered by AI.</p>
            </div>
            <span class="rb-list-card-arrow">→</span>
          </a>
        </li>

        <li class="rb-list-card-item">
          <a href="/tools/" class="rb-list-card-link">
            <span class="rb-list-card-icon">⬇️</span>
            <div class="rb-list-card-info">
              <h3 class="rb-list-card-title">ReviByte Tools</h3>
              <p class="rb-list-card-desc">Download TikTok videos without watermark, save audio as MP3, and more. Free media downloader tools.</p>
            </div>
            <span class="rb-list-card-arrow">→</span>
          </a>
        </li>
      </ul>
    </section>

    <Hr class="my-10" />

    {listPosts.length > 0 && (
      <section class="rb-list-section">
        <h2 class="rb-section-heading">More Posts</h2>
        <div class="rb-list">
          {listPosts.map((post) => (
            <article class="rb-list-card">
              <a href={`/${post.hubPath}/${post.id}/`} class="rb-list-card__img-wrap">
                {post.data.coverImage && (
                  <img
                    src={getOptimizedSrc(post.data.coverImage, 480)}
                    srcset={getSrcset(post.data.coverImage)}
                    alt={post.data.coverImageAlt ?? post.data.title}
                    class="rb-list-card__img"
                    loading="lazy"
                    decoding="async"
                    width="200"
                    height="130"
                    sizes="(max-width: 640px) 120px, 165px"
                  />
                )}
              </a>
              <div class="rb-list-card__body">
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="rb-tags rb-tags--sm mb-2">
                    {post.data.tags.slice(0, 2).map(tag => (
                      <a href={`/tags/${tag}/`} class="rb-tag">{tag}</a>
                    ))}
                  </div>
                )}
                <h3 class="rb-list-card__title">
                  <a href={`/${post.hubPath}/${post.id}/`}>{post.data.title}</a>
                </h3>
                {post.data.description && (
                  <p class="rb-list-card__desc">{post.data.description}</p>
                )}
                <div class="rb-list-card__meta">
                  <span class="rb-byline">By {post.data.author ?? SITE.author}</span>
                  <span class="rb-dot">·</span>
                  <time>{formatDate(post.data.pubDatetime)}</time>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <div class="rb-cta-wrap">
      <LinkButton href="/posts/">
        View All Posts
        <IconArrowRight class="inline-block ml-2 w-5 h-5" />
      </LinkButton>
    </div>

  </main>
  <Footer />
</Layout>
<style>
  /* ── Layout ── */
  .rb-home {
    max-width: 1200px;
  }

  /* ── Top grid ── */
  .rb-top-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .rb-top-grid {
      grid-template-columns: 1.6fr 1fr;
      gap: 2rem;
    }
  }

  /* ── Hero ── */
  .rb-hero {
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-card, transparent);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .rb-hero:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
  }

  .rb-hero__img-wrap {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-background-light);
  }
  .rb-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .rb-hero:hover .rb-hero__img {
    transform: scale(1.03);
  }

  .rb-hero__body {
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .rb-hero__title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.6rem;
    letter-spacing: -0.3px;
  }
  .rb-hero__title a {
    color: var(--color-foreground);
    text-decoration: none;
    transition: color 0.2s;
  }
  .rb-hero__title a:hover {
    color: var(--color-accent);
  }

  .rb-hero__desc {
    font-size: 0.9rem;
    color: var(--color-foreground);
    opacity: 0.65;
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rb-hero__meta {
    font-size: 0.78rem;
    color: var(--color-foreground);
    opacity: 0.5;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
  }

  .rb-read-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.1rem;
    background: var(--color-accent);
    color: white;
    font-size: 0.82rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }
  .rb-read-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }
  .rb-read-btn span {
    transition: transform 0.2s;
  }
  .rb-read-btn:hover span {
    transform: translateX(3px);
  }

  /* ── Sidebar ── */
  .rb-sidebar {
    display: flex;
    flex-direction: column;
  }
  .rb-sidebar__heading {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 0.4;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }

  .rb-sidebar__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rb-sidebar__item {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
  }

  .rb-sidebar__num {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-foreground);
    opacity: 0.08;
    flex-shrink: 0;
    min-width: 2rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .rb-sidebar__content {
    flex: 1;
    min-width: 0;
    padding-top: 0.15rem;
  }

  .rb-sidebar__title {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-foreground);
    text-decoration: none;
    display: block;
    margin-bottom: 0.25rem;
    transition: color 0.2s;
  }
  .rb-sidebar__title:hover {
    color: var(--color-accent);
  }

  .rb-sidebar__date {
    font-size: 0.72rem;
    color: var(--color-foreground);
    opacity: 0.4;
  }

  /* ── Tags ── */
  .rb-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .rb-tags--sm {
    gap: 0.3rem;
  }

  .rb-tag {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--color-background-light);
    color: var(--color-foreground);
    opacity: 0.7;
    text-decoration: none;
    transition: opacity 0.2s, background 0.2s;
  }
  .rb-tag:hover {
    opacity: 1;
    background: var(--color-border);
  }
  .rb-tag--accent {
    background: var(--color-accent);
    color: white;
    opacity: 0.9;
  }
  .rb-tag--accent:hover {
    opacity: 1;
  }

  /* ── Meta helpers ── */
  .rb-byline {
    font-weight: 500;
  }
  .rb-dot {
    opacity: 0.4;
  }

  /* ── Section headers ── */
  .rb-section-header {
    margin-bottom: 1.25rem;
  }
  .rb-section-heading {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.2px;
    margin-bottom: 0.25rem;
  }
  .rb-section-sub {
    font-size: 0.85rem;
    color: var(--color-foreground);
    opacity: 0.5;
  }

  /* ── LIST CARDS (Games & Tools) ── */
  .rb-list-cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .rb-list-card-item {
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-card, transparent);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    overflow: hidden;
  }
  .rb-list-card-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0,0,0,0.08);
    border-color: var(--color-accent);
  }

  .rb-list-card-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
  }

  .rb-list-card-icon {
    font-size: 1.75rem;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background-light);
    border-radius: 10px;
  }

  .rb-list-card-info {
    flex: 1;
    min-width: 0;
  }

  .rb-list-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-foreground);
    margin-bottom: 0.2rem;
    letter-spacing: -0.2px;
  }

  .rb-list-card-desc {
    font-size: 0.8rem;
    color: var(--color-foreground);
    opacity: 0.55;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rb-list-card-arrow {
    font-size: 1.2rem;
    color: var(--color-accent);
    opacity: 0.6;
    flex-shrink: 0;
    transition: transform 0.2s, opacity 0.2s;
  }
  .rb-list-card-item:hover .rb-list-card-arrow {
    transform: translateX(4px);
    opacity: 1;
  }

  /* ── Post List section ── */
  .rb-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .rb-list-card {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
    align-items: flex-start;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 640px) {
    .rb-list-card {
      grid-template-columns: 165px 1fr;
      gap: 1.25rem;
    }
  }

  .rb-list-card__img-wrap {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-background-light);
  }
  .rb-list-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .rb-list-card:hover .rb-list-card__img {
    transform: scale(1.04);
  }

  .rb-list-card__body {
    min-width: 0;
  }

  .rb-list-card__title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.4rem;
  }
  .rb-list-card__title a {
    color: var(--color-foreground);
    text-decoration: none;
    transition: color 0.2s;
  }
  .rb-list-card__title a:hover {
    color: var(--color-accent);
  }

  .rb-list-card__desc {
    font-size: 0.82rem;
    color: var(--color-foreground);
    opacity: 0.6;
    line-height: 1.55;
    margin-bottom: 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rb-list-card__meta {
    font-size: 0.75rem;
    color: var(--color-foreground);
    opacity: 0.45;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* ── CTA ── */
  .rb-cta-wrap {
    display: flex;
    justify-content: center;
    margin: 2.5rem 0;
  }
</style>
