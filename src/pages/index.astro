---
import AnchorAd from "@/components/AnchorAd.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import LinkButton from "@/components/LinkButton.astro";
import Hr from "@/components/Hr.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = posts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());

const heroPost = sortedPosts[0];
const sidebarPosts = sortedPosts.filter(p => p.id !== heroPost?.id).slice(0, 6);
const listPosts = sortedPosts.filter(p => p.id !== heroPost?.id).slice(6, 14);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<Layout title={`Home | ${SITE.title}`}>
  <script is:inline define:vars={{ heroImg: heroPost?.data.coverImage }}>
  if (heroImg) {
    var l = document.createElement('link');
    l.rel = 'preload';
    l.as = 'image';
    l.href = heroImg;
    document.head.appendChild(l);
  }
</script>
  <Header />

  <main id="main-content" class="rb-home mx-auto w-full max-w-app px-4 pt-8 pb-16">

    <!-- ── HERO + SIDEBAR ── -->
    {heroPost && (
      <section class="rb-top-grid mb-10">

        <article class="rb-hero">
          <a href={`/posts/${heroPost.id}`} class="rb-hero__img-wrap">
            {heroPost.data.coverImage && (
              <img
                src={heroPost.data.coverImage}
                alt={heroPost.data.coverImageAlt ?? heroPost.data.title}
                class="rb-hero__img"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="900"
                height="500"
                sizes="(max-width: 640px) 100vw, (max-width: 900px) 100vw, 60vw"
              />
            )}
          </a>

          <div class="rb-hero__body">
            {heroPost.data.tags && heroPost.data.tags.length > 0 && (
              <div class="rb-tags mb-3">
                {heroPost.data.tags.slice(0, 3).map(tag => (
                  <a href={`/tags/${tag}/`} class="rb-tag rb-tag--accent">{tag}</a>
                ))}
              </div>
            )}

            <h1 class="rb-hero__title">
              <a href={`/posts/${heroPost.id}`}>{heroPost.data.title}</a>
            </h1>

            {heroPost.data.description && (
              <p class="rb-hero__desc">{heroPost.data.description}</p>
            )}

            <div class="rb-hero__meta">
              <span class="rb-byline">By {heroPost.data.author ?? SITE.author}</span>
              <span class="rb-dot">·</span>
              <time>{formatDate(heroPost.data.pubDatetime)}</time>
            </div>

            <a href={`/posts/${heroPost.id}`} class="rb-read-btn">
              Read Article <span>→</span>
            </a>
          </div>
        </article>

        <aside class="rb-sidebar">
          <h2 class="rb-sidebar__heading">Latest</h2>
          <ul class="rb-sidebar__list">
            {sidebarPosts.map((post, i) => (
              <li class="rb-sidebar__item">
                <span class="rb-sidebar__num">{String(i + 1).padStart(2, "0")}</span>
                <div class="rb-sidebar__content">
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="rb-tags rb-tags--sm mb-1">
                      <span class="rb-tag">{post.data.tags[0]}</span>
                    </div>
                  )}
                  <a href={`/posts/${post.id}`} class="rb-sidebar__title">
                    {post.data.title}
                  </a>
                  <time class="rb-sidebar__date">{formatDate(post.data.pubDatetime)}</time>
                </div>
              </li>
            ))}
          </ul>
        </aside>

      </section>
    )}

    <Hr class="my-10" />

    <!-- ── AD SPOT 1: Between Hero and More Posts ── -->
    <div class="rb-ad-banner">
      <ins class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-4896561037705299"
        data-ad-slot="6421475366"
        data-ad-format="auto"
        data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>

    {listPosts.length > 0 && (
      <section class="rb-list-section">
        <h2 class="rb-section-heading">More Posts</h2>
        <div class="rb-list">
          {listPosts.map((post, index) => (
            <>
              <article class="rb-list-card">
                <a href={`/posts/${post.id}`} class="rb-list-card__img-wrap">
                  {post.data.coverImage && (
                    <img
                      src={post.data.coverImage}
                      alt={post.data.coverImageAlt ?? post.data.title}
                      class="rb-list-card__img"
                      loading="lazy"
                      decoding="async"
                      width="200"
                      height="130"
                      sizes="(max-width: 640px) 120px, 165px"
                    />
                  )}
                </a>
                <div class="rb-list-card__body">
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="rb-tags rb-tags--sm mb-2">
                      {post.data.tags.slice(0, 2).map(tag => (
                        <a href={`/tags/${tag}/`} class="rb-tag">{tag}</a>
                      ))}
                    </div>
                  )}
                  <h3 class="rb-list-card__title">
                    <a href={`/posts/${post.id}`}>{post.data.title}</a>
                  </h3>
                  {post.data.description && (
                    <p class="rb-list-card__desc">{post.data.description}</p>
                  )}
                  <div class="rb-list-card__meta">
                    <span class="rb-byline">By {post.data.author ?? SITE.author}</span>
                    <span class="rb-dot">·</span>
                    <time>{formatDate(post.data.pubDatetime)}</time>
                  </div>
                </div>
              </article>

              {/* AD SPOT 2: After the 4th list card */}
              {index === 3 && (
                <div class="rb-ad-in-list">
                  <ins class="adsbygoogle"
                    style="display:block"
                    data-ad-client="ca-pub-4896561037705299"
                    data-ad-slot="6421475366"
                    data-ad-format="auto"
                    data-full-width-responsive="true"></ins>
                  <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
                </div>
              )}
            </>
          ))}
        </div>
      </section>
    )}

    <div class="rb-cta-wrap">
      <LinkButton href="/posts/">
        View All Posts
        <IconArrowRight class="inline-block ml-2 w-5 h-5" />
      </LinkButton>
    </div>

    <!-- ── AD SPOT 3: Below View All Posts button ── -->
    <div class="rb-ad-banner rb-ad-banner--bottom">
      <ins class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-4896561037705299"
        data-ad-slot="6421475366"
        data-ad-format="auto"
        data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>

  </main>

  <Footer />
</Layout>

<style>
  .rb-top-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .rb-top-grid {
      grid-template-columns: minmax(0, 1fr) minmax(240px, 300px);
      gap: 2rem;
      align-items: start;
    }
  }

  /* Hero */
  .rb-hero {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    display: flex;
    flex-direction: column;
  }

  .rb-hero__img-wrap {
    display: block;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--color-card);
  }

  .rb-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .rb-hero:hover .rb-hero__img {
    transform: scale(1.03);
  }

  .rb-hero__body {
    padding: 1.4rem 1.5rem 1.75rem;
  }

  .rb-hero__title {
    font-size: clamp(1.2rem, 2.4vw, 1.65rem);
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 0.6rem;
    letter-spacing: -0.02em;
  }

  .rb-hero__title a {
    color: var(--color-foreground);
    text-decoration: none;
    transition: color 0.2s;
  }

  .rb-hero__title a:hover { color: var(--color-accent); }

  .rb-hero__desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-foreground);
    opacity: 0.75;
    margin-bottom: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rb-hero__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-foreground);
    opacity: 0.6;
    margin-bottom: 1.1rem;
  }

  .rb-read-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    border: 2px solid var(--color-accent);
    padding: 0.38rem 0.95rem;
    border-radius: 6px;
    transition: background 0.2s, color 0.2s;
  }

  .rb-read-btn:hover {
    background: var(--color-accent);
    color: #fff;
  }

  .rb-read-btn span { transition: transform 0.2s; }
  .rb-read-btn:hover span { transform: translateX(3px); }

  /* Sidebar */
  .rb-sidebar {
    border-radius: 12px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    padding: 1.2rem 1.2rem 0.4rem;
  }

  .rb-sidebar__heading {
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--color-accent);
  }

  .rb-sidebar__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .rb-sidebar__item {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .rb-sidebar__item:last-child { border-bottom: none; }

  .rb-sidebar__num {
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--color-foreground);
    opacity: 0.15;
    line-height: 1;
    flex-shrink: 0;
    min-width: 1.8rem;
    font-variant-numeric: tabular-nums;
  }

  .rb-sidebar__content { flex: 1; min-width: 0; }

  .rb-sidebar__title {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-foreground);
    text-decoration: none;
    margin-bottom: 0.25rem;
    transition: color 0.2s;
  }

  .rb-sidebar__title:hover { color: var(--color-accent); }

  .rb-sidebar__date {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-foreground);
    opacity: 0.55;
  }

  /* Tags */
  .rb-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .rb-tag {
    font-size: 0.63rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.17rem 0.5rem;
    border-radius: 4px;
    background: var(--color-border);
    color: var(--color-foreground);
    opacity: 0.8;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, opacity 0.2s;
  }

  .rb-tag:hover {
    background: var(--color-accent);
    color: #fff;
    opacity: 1;
  }

  .rb-tag--accent {
    background: var(--color-accent);
    color: #fff;
    opacity: 1;
  }

  .rb-tag--accent:hover { opacity: 0.85; }

  .rb-tags--sm .rb-tag {
    font-size: 0.58rem;
    padding: 0.12rem 0.42rem;
  }

  /* Section heading */
  .rb-section-heading {
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.25rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--color-accent);
  }

  /* List cards */
  .rb-list { display: flex; flex-direction: column; }

  .rb-list-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .rb-list-card:last-child { border-bottom: none; }

  .rb-list-card__img-wrap {
    flex-shrink: 0;
    width: 120px;
    height: 78px;
    border-radius: 8px;
    overflow: hidden;
    display: block;
    background: var(--color-card);
    border: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .rb-list-card__img-wrap {
      width: 165px;
      height: 102px;
    }
  }

  .rb-list-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .rb-list-card:hover .rb-list-card__img { transform: scale(1.05); }

  .rb-list-card__body { flex: 1; min-width: 0; }

  .rb-list-card__title {
    font-size: 0.97rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.32rem;
    letter-spacing: -0.01em;
  }

  .rb-list-card__title a {
    color: var(--color-foreground);
    text-decoration: none;
    transition: color 0.2s;
  }

  .rb-list-card__title a:hover { color: var(--color-accent); }

  .rb-list-card__desc {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--color-foreground);
    opacity: 0.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0.4rem;
  }

  @media (max-width: 480px) {
    .rb-list-card__desc { display: none; }
  }

  .rb-list-card__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-foreground);
    opacity: 0.6;
  }

  .rb-byline { font-weight: 600; }
  .rb-dot { opacity: 0.4; }

  .rb-cta-wrap {
    text-align: center;
    margin-top: 2.5rem;
  }

  /* ── AdSense Units ── */
  .rb-ad-banner {
    margin: 1.5rem 0;
    text-align: center;
    min-height: 90px;
  }

  .rb-ad-banner--bottom {
    margin-top: 2.5rem;
  }

  .rb-ad-in-list {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
    text-align: center;
    min-height: 90px;
  }
</style>
