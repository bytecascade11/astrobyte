---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Hr from "@/components/Hr.astro";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SOCIALS } from "@/constants";
import { getPath } from "@/utils/getPath";

const posts = await getCollection("blog");
const sortedPosts = posts.sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());

const latestPost = sortedPosts[0];
const recentPosts = sortedPosts.slice(1);
---

<Layout>
  <Header />
  <main class="mx-auto w-full max-w-app px-4 py-12">
    <!-- Hero Welcome Section -->
    <section class="text-center mb-16">
      <h1 class="my-8 text-4xl sm:text-5xl font-bold">WELCOME👋</h1>
      <a target="_blank" href="/rss.xml" class="inline-block" aria-label="RSS feed">
        <IconRss width={20} height={20} class="scale-125 stroke-accent stroke-3" />
      </a>
      <p class="mt-6 text-lg">
        ReviByte Technology Opinions delivers the latest tech news, gadget opinions, Android updates, and in-depth guides.
      </p>
      <p class="mt-4">
        Read the blog posts or check
        <LinkButton href="https://github.com/bytecascade11/astrobyte#readme" class="underline">
          README
        </LinkButton> for more info.
      </p>
      {SOCIALS.length > 0 && (
        <div class="mt-6">
          <span class="me-2">Social Links:</span>
          <Socials />
        </div>
      )}
    </section>

    <Hr />

    <!-- Featured Latest Post – Big Hero Card -->
    {latestPost && (
      <article class="mb-20 overflow-hidden rounded-2xl shadow-2xl bg-card">
        {latestPost.data.coverImage && (
          <img
            src={latestPost.data.coverImage}
            alt={latestPost.data.coverImageAlt || latestPost.data.title}
            class="w-full object-cover aspect-video md:aspect-[21/9]"
            loading="eager"
          />
        )}
        <div class="p-8 md:p-12">
          <h1 class="text-3xl md:text-5xl font-bold mb-6">
            <a href={getPath(latestPost.id, latestPost.filePath)} class="hover:text-accent transition">
              {latestPost.data.title}
            </a>
          </h1>
          <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground mb-6">
            <time>
              {latestPost.data.pubDatetime.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          </div>
          {latestPost.data.tags?.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-6">
              {latestPost.data.tags.map(tag => (
                <a
                  href={`/tags/${tag}/`}
                  class="rounded-full px-4 py-2 bg-muted/50 text-sm hover:bg-accent hover:text-background transition"
                >
                  {tag}
                </a>
              ))}
            </div>
          )}
          {latestPost.data.description && (
            <p class="text-lg text-muted-foreground line-clamp-4">
              {latestPost.data.description}
            </p>
          )}
        </div>
      </article>
    )}

    <!-- Recent Posts Grid -->
    {recentPosts.length > 0 && (
      <>
        <h2 class="text-2xl font-bold mb-8">Recent Posts</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
          {recentPosts.map(post => (
            <article class="overflow-hidden rounded-2xl shadow-lg bg-card hover:shadow-xl transition">
              {post.data.coverImage && (
                <a href={getPath(post.id, post.filePath)}>
                  <img
                    src={post.data.coverImage}
                    alt={post.data.coverImageAlt || post.data.title}
                    class="w-full object-cover aspect-video"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="p-6">
                <h3 class="text-xl font-semibold mb-2">
                  <a href={getPath(post.id, post.filePath)} class="hover:text-accent transition">
                    {post.data.title}
                  </a>
                </h3>
                <time class="text-sm text-muted-foreground block mb-3">
                  {post.data.pubDatetime.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
                {post.data.description && (
                  <p class="text-muted-foreground line-clamp-3">
                    {post.data.description}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      </>
    )}

    <!-- All Posts Button -->
    <div class="text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>
