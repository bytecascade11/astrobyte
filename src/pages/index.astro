---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import LinkButton from "@/components/LinkButton.astro";
import Hr from "@/components/Hr.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import imageManifest from '@/data/image-manifest.json';

const posts = await getCollection("blog");

const sortedPosts = posts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());

const heroPost = sortedPosts[0];
const sidebarPosts = sortedPosts.filter(p => p.id !== heroPost?.id).slice(0, 6);
const listPosts = sortedPosts.filter(p => p.id !== heroPost?.id).slice(6, 14);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

// Helper to get optimized image
function getOptimizedSrc(src: string, width: number = 800): string {
  const normalize = (s: string) => s.replace(/^\/images\//, '').replace(/^\/assets\//, '').replace(/^\//, '');
  const key = normalize(src);
  const entry = imageManifest[key];
  return entry?.optimized?.[width] || src;
}

function getSrcset(src: string): string {
  const normalize = (s: string) => s.replace(/^\/images\//, '').replace(/^\/assets\//, '').replace(/^\//, '');
  const key = normalize(src);
  const entry = imageManifest[key];
  const webp = entry?.optimized;
  if (!webp) return '';
  return `${webp[480]} 480w, ${webp[800]} 800w, ${webp[1200]} 1200w`;
}
---

<Layout title={`Home | ${SITE.title}`}>
  <Header />

  <main id="main-content" class="rb-home mx-auto w-full max-w-app px-4 pt-8 pb-16">

    <!-- ── HERO + SIDEBAR ── -->
    {heroPost && (
      <section class="rb-top-grid mb-10">

        <article class="rb-hero">
          <a href={`/posts/${heroPost.id}`} class="rb-hero__img-wrap">
            {heroPost.data.coverImage && (
              <img
                src={getOptimizedSrc(heroPost.data.coverImage, 800)}
                srcset={getSrcset(heroPost.data.coverImage)}
                alt={heroPost.data.coverImageAlt ?? heroPost.data.title}
                class="rb-hero__img"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="900"
                height="500"
                sizes="(max-width: 640px) 100vw, (max-width: 900px) 100vw, 60vw"
              />
            )}
          </a>
          <div class="rb-hero__body">
            {heroPost.data.tags && heroPost.data.tags.length > 0 && (
              <div class="rb-tags mb-3">
                {heroPost.data.tags.slice(0, 3).map(tag => (
                  <a href={`/tags/${tag}/`} class="rb-tag rb-tag--accent">{tag}</a>
                ))}
              </div>
            )}

            <h1 class="rb-hero__title">
              <a href={`/posts/${heroPost.id}`}>{heroPost.data.title}</a>
            </h1>

            {heroPost.data.description && (
              <p class="rb-hero__desc">{heroPost.data.description}</p>
            )}

            <div class="rb-hero__meta">
              <span class="rb-byline">By {heroPost.data.author ?? SITE.author}</span>
              <span class="rb-dot">·</span>
              <time>{formatDate(heroPost.data.pubDatetime)}</time>
            </div>

            <a href={`/posts/${heroPost.id}`} class="rb-read-btn">
              Read Article <span>→</span>
            </a>
          </div>
        </article>

        <aside class="rb-sidebar">
          <h2 class="rb-sidebar__heading">Latest</h2>
          <ul class="rb-sidebar__list">
            {sidebarPosts.map((post, i) => (
              <li class="rb-sidebar__item">
                <span class="rb-sidebar__num">{String(i + 1).padStart(2, "0")}</span>
                <div class="rb-sidebar__content">
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="rb-tags rb-tags--sm mb-1">
                      <span class="rb-tag">{post.data.tags[0]}</span>
                    </div>
                  )}
                  <a href={`/posts/${post.id}`} class="rb-sidebar__title">
                    {post.data.title}
                  </a>
                  <time class="rb-sidebar__date">{formatDate(post.data.pubDatetime)}</time>
                </div>
              </li>
            ))}
          </ul>
        </aside>

      </section>
    )}

    <Hr class="my-10" />

    <!-- ── GAMES HUB SECTION ── -->
    <section class="rb-games-hub mb-10">
      <h2 class="rb-section-heading">🎮 Game Guides</h2>
      <p class="rb-games-hub__sub">In-depth loadouts, formations and tier lists — updated every season.</p>

      <div class="rb-games-grid">

        <!-- COD Mobile Card -->
        <a href="/codm/" class="rb-game-card">
          <div class="rb-game-card__icon">🎯</div>
          <div class="rb-game-card__body">
            <h3 class="rb-game-card__title">COD Mobile</h3>
            <p class="rb-game-card__desc">Best loadouts, weapon tier lists, sensitivity settings and ranked guides — updated every season.</p>
            <span class="rb-game-card__cta">View Guides →</span>
          </div>
        </a>

        <!-- eFootball Card -->
<a href="/efootball/" class="rb-game-card">
  <div class="rb-game-card__icon">⚽</div>
  <div class="rb-game-card__body">
    <h3 class="rb-game-card__title">eFootball 2026</h3>
    <p class="rb-game-card__desc">Top formations, Division 1 tactics, player reviews and squad-building tips for every patch.</p>
    <span class="rb-game-card__cta">View Guides →</span>
  </div>
</a>

<!-- PUBG Mobile Card -->
<a href="/pubgmobile/" class="rb-game-card">
  <div class="rb-game-card__icon">🔫</div>
  <div class="rb-game-card__body">
    <h3 class="rb-game-card__title">PUBG Mobile</h3>
    <p class="rb-game-card__desc">Best weapon loadouts, tier lists, sensitivity settings and ranked guides updated every season.</p>
    <span class="rb-game-card__cta">View Guides →</span>
  </div>
</a>
<!-- Mobile Legends Card -->
<a href="/mlbb/" class="rb-game-card">
  <div class="rb-game-card__icon">⚔️</div>
  <div class="rb-game-card__body">
    <h3 class="rb-game-card__title">Mobile Legends</h3>
    <p class="rb-game-card__desc">Best hero guides, tier lists, emblem builds, and ranked tips updated every season.</p>
    <span class="rb-game-card__cta">View Guides →</span>
 </div>
</a>
      </div>
    </section>

    <Hr class="my-10" />

    <!-- ── TOOLS SECTION ── -->
    <section class="rb-tools-hub mb-10">
      <h2 class="rb-section-heading">🛠️ ReviByte Tools</h2>
      <p class="rb-games-hub__sub">Free tools built for everyday use — no login.</p>

      <div class="rb-games-grid">

        <!-- Heliara AI -->
        <a href="/heliara/" class="rb-game-card rb-tool-card--ai">
          <div class="rb-game-card__icon">✨</div>
          <div class="rb-game-card__body">
            <h3 class="rb-game-card__title">Heliara AI</h3>
            <p class="rb-game-card__desc">Ask anything about phones, Android, COD Mobile, eFootball, or general tech. Instant answers powered by AI.</p>
            <span class="rb-game-card__cta">Try Heliara AI →</span>
          </div>
        </a>

        <!-- ReviByte Save -->
        <a href="/save/" class="rb-game-card rb-tool-card--save">
          <div class="rb-game-card__icon">⬇️</div>
          <div class="rb-game-card__body">
            <h3 class="rb-game-card__title">ReviByte Save</h3>
            <p class="rb-game-card__desc">Download TikTok videos without watermark, save audio as MP3, and more. Free media downloader tools.</p>
            <span class="rb-game-card__cta">Open ReviByte Save →</span>
          </div>
        </a>

      </div>
    </section>

    <Hr class="my-10" />

    <!-- ── AD SPOT 1 ── -->
    <div class="rb-ad-banner" style="min-height:250px;">
      <ins class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-4896561037705299"
        data-ad-slot="6421475366"
        data-ad-format="auto"
        data-full-width-responsive="true"></ins>
    </div>

    {listPosts.length > 0 && (
      <section class="rb-list-section">
        <h2 class="rb-section-heading">More Posts</h2>
        <div class="rb-list">
          {listPosts.map((post, index) => (
            <>
              <article class="rb-list-card">
                <a href={`/posts/${post.id}`} class="rb-list-card__img-wrap">
                  {post.data.coverImage && (
                    <img
                      src={getOptimizedSrc(post.data.coverImage, 480)}
                      srcset={getSrcset(post.data.coverImage)}
                      alt={post.data.coverImageAlt ?? post.data.title}
                      class="rb-list-card__img"
                      loading="lazy"
                      decoding="async"
                      width="200"
                      height="130"
                      sizes="(max-width: 640px) 120px, 165px"
                    />
                  )}
                </a>
                <div class="rb-list-card__body">
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="rb-tags rb-tags--sm mb-2">
                      {post.data.tags.slice(0, 2).map(tag => (
                        <a href={`/tags/${tag}/`} class="rb-tag">{tag}</a>
                      ))}
                    </div>
                  )}
                  <h3 class="rb-list-card__title">
                    <a href={`/posts/${post.id}`}>{post.data.title}</a>
                  </h3>
                  {post.data.description && (
                    <p class="rb-list-card__desc">{post.data.description}</p>
                  )}
                  <div class="rb-list-card__meta">
                    <span class="rb-byline">By {post.data.author ?? SITE.author}</span>
                    <span class="rb-dot">·</span>
                    <time>{formatDate(post.data.pubDatetime)}</time>
                  </div>
                </div>
              </article>

              {index === 3 && (
                <div class="rb-ad-in-list" style="min-height:250px;">
                  <ins class="adsbygoogle"
                    style="display:block"
                    data-ad-client="ca-pub-4896561037705299"
                    data-ad-slot="6421475366"
                    data-ad-format="auto"
                    data-full-width-responsive="true"></ins>
                </div>
              )}
            </>
          ))}
        </div>
      </section>
    )}

    <div class="rb-cta-wrap">
      <LinkButton href="/posts/">
        View All Posts
        <IconArrowRight class="inline-block ml-2 w-5 h-5" />
      </LinkButton>
    </div>

    <!-- ── AD SPOT 3 ── -->
    <div class="rb-ad-banner rb-ad-banner--bottom" style="min-height:250px;">
      <ins class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-4896561037705299"
        data-ad-slot="6421475366"
        data-ad-format="auto"
        data-full-width-responsive="true"></ins>
    </div>

  </main>
  <Footer />
</Layout>

<!-- AdSense init — deferred -->
<script is:inline>
  (function() {
    function loadAds() {
      if (window.__adsLoaded) return;
      window.__adsLoaded = true;
      var ads = document.querySelectorAll('ins.adsbygoogle');
      ads.forEach(function(ad) {
        (adsbygoogle = window.adsbygoogle || []).push({});
      });
    }
    window.addEventListener('scroll', loadAds, { once: true, passive: true });
    window.addEventListener('click', loadAds, { once: true });
    setTimeout(loadAds, 3000);
  })();
</script>

<style>
  /* ── Layout ── */
  .rb-home {
    max-width: 1200px;
  }

  /* ── Top grid ── */
  .rb-top-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .rb-top-grid {
      grid-template-columns: 1.6fr 1fr;
      gap: 2rem;
    }
  }

  /* ── Hero ── */
  .rb-hero {
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-card, transparent);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .rb-hero:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
  }

  .rb-hero__img-wrap {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-background-light);
  }
  .rb-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .rb-hero:hover .rb-hero__img {
    transform: scale(1.03);
  }

  .rb-hero__body {
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .rb-hero__title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.6rem;
    letter-spacing: -0.3px;
  }
  .rb-hero__title a {
    color: var(--color-foreground);
    text-decoration: none;
    transition: color 0.2s;
  }
  .rb-hero__title a:hover {
    color: var(--color-accent);
  }

  .rb-hero__desc {
    font-size: 0.9rem;
    color: var(--color-foreground);
    opacity: 0.65;
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rb-hero__meta {
    font-size: 0.78rem;
    color: var(--color-foreground);
    opacity: 0.5;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
  }

  .rb-read-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.1rem;
    background: var(--color-accent);
    color: white;
    font-size: 0.82rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }
  .rb-read-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }
  .rb-read-btn span {
    transition: transform 0.2s;
  }
  .rb-read-btn:hover span {
    transform: translateX(3px);
  }

  /* ── Sidebar ── */
  .rb-sidebar {
    display: flex;
    flex-direction: column;
  }
  .rb-sidebar__heading {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 0.4;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }

  .rb-sidebar__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rb-sidebar__item {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
  }

  .rb-sidebar__num {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-foreground);
    opacity: 0.08;
    flex-shrink: 0;
    min-width: 2rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .rb-sidebar__content {
    flex: 1;
    min-width: 0;
    padding-top: 0.15rem;
  }

  .rb-sidebar__title {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-foreground);
    text-decoration: none;
    display: block;
    margin-bottom: 0.25rem;
    transition: color 0.2s;
  }
  .rb-sidebar__title:hover {
    color: var(--color-accent);
  }

  .rb-sidebar__date {
    font-size: 0.72rem;
    color: var(--color-foreground);
    opacity: 0.4;
  }

  /* ── Tags ── */
  .rb-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .rb-tags--sm {
    gap: 0.3rem;
  }

  .rb-tag {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--color-background-light);
    color: var(--color-foreground);
    opacity: 0.7;
    text-decoration: none;
    transition: opacity 0.2s, background 0.2s;
  }
  .rb-tag:hover {
    opacity: 1;
    background: var(--color-border);
  }
  .rb-tag--accent {
    background: var(--color-accent);
    color: white;
    opacity: 0.9;
  }
  .rb-tag--accent:hover {
    opacity: 1;
  }

  /* ── Meta helpers ── */
  .rb-byline {
    font-weight: 500;
  }
  .rb-dot {
    opacity: 0.4;
  }

  /* ── Section headers ── */
  .rb-section-header {
    margin-bottom: 1.25rem;
  }
  .rb-section-heading {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.2px;
    margin-bottom: 0.25rem;
  }
  .rb-section-sub {
    font-size: 0.85rem;
    color: var(--color-foreground);
    opacity: 0.5;
  }

  /* ── Games Hub ── */
  .rb-games-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.875rem;
  }
  @media (min-width: 640px) {
    .rb-games-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
  }

  .rb-game-card {
    display: block;
    border-radius: 14px;
    border: 1px solid var(--color-border);
    background: var(--color-card, transparent);
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    overflow: hidden;
  }
  .rb-game-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    border-color: var(--color-accent);
  }

  .rb-game-card__inner {
    padding: 1.25rem 1rem;
    text-align: center;
  }

  .rb-game-card__icon {
    font-size: 2rem;
    margin-bottom: 0.6rem;
    line-height: 1;
  }

  .rb-game-card__title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-foreground);
    margin-bottom: 0.3rem;
    letter-spacing: -0.2px;
  }

  .rb-game-card__count {
    font-size: 0.72rem;
    color: var(--color-foreground);
    opacity: 0.5;
    line-height: 1.4;
  }

  /* ── Tools ── */
  .rb-tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.875rem;
  }
  @media (min-width: 640px) {
    .rb-tools-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
  }

  .rb-tool-card {
    display: block;
    border-radius: 14px;
    border: 1px solid var(--color-border);
    background: var(--color-card, transparent);
    text-decoration: none;
    padding: 1.25rem 1rem;
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .rb-tool-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    border-color: var(--color-accent);
  }

  .rb-tool-card__icon {
    font-size: 2rem;
    margin-bottom: 0.6rem;
    line-height: 1;
  }

  .rb-tool-card__title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-foreground);
    margin-bottom: 0.3rem;
  }

  .rb-tool-card__desc {
    font-size: 0.72rem;
    color: var(--color-foreground);
    opacity: 0.5;
    line-height: 1.4;
  }

  /* ── Ad slots ── */
  .rb-ad-banner,
  .rb-ad-in-list {
    min-height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.02);
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  /* ── List section ── */
  .rb-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .rb-list-card {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
    align-items: flex-start;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 640px) {
    .rb-list-card {
      grid-template-columns: 165px 1fr;
      gap: 1.25rem;
    }
  }

  .rb-list-card__img-wrap {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-background-light);
  }
  .rb-list-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .rb-list-card:hover .rb-list-card__img {
    transform: scale(1.04);
  }

  .rb-list-card__body {
    min-width: 0;
  }

  .rb-list-card__title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.4rem;
  }
  .rb-list-card__title a {
    color: var(--color-foreground);
    text-decoration: none;
    transition: color 0.2s;
  }
  .rb-list-card__title a:hover {
    color: var(--color-accent);
  }

  .rb-list-card__desc {
    font-size: 0.82rem;
    color: var(--color-foreground);
    opacity: 0.6;
    line-height: 1.55;
    margin-bottom: 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rb-list-card__meta {
    font-size: 0.75rem;
    color: var(--color-foreground);
    opacity: 0.45;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* ── CTA ── */
  .rb-cta-wrap {
    display: flex;
    justify-content: center;
    margin: 2.5rem 0;
  }
</style>
