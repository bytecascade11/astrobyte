---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import LinkButton from "@/components/LinkButton.astro";
import Hr from "@/components/Hr.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = posts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());

// Top 3 for slideshow
const slideshowPosts = sortedPosts.slice(0, 3);
// Recent posts start after slideshow posts
const recentPosts = sortedPosts.slice(3, 11);

// Helper: estimate reading time from description (rough)
function readingTime(post: any): string {
  const words = (post.data.description || "").split(" ").length;
  // Average blog post at ~250 words/min, description is ~10% of content
  const estimated = Math.max(3, Math.round(words / 25));
  return `${estimated} min read`;
}
---

<Layout title={`Home | ${SITE.title}`}>
  <Header />
  <main class="mx-auto w-full max-w-app px-4 py-12">

    <!-- ── Hero Slideshow ── -->
    {slideshowPosts.length > 0 && (
      <div class="slideshow-wrapper mb-12" id="hero-slideshow">

        <!-- Slides -->
        <div class="slides-container">
          {slideshowPosts.map((post, i) => (
            <article
              class={`slide ${i === 0 ? "slide--active" : ""}`}
              data-index={i}
            >
              {post.data.coverImage && (
                <a href={`/posts/${post.id}`} class="slide-image-link" tabindex={i === 0 ? "0" : "-1"}>
                  <img
                    src={post.data.coverImage}
                    alt={`${post.data.title} – Featured cover | ${SITE.title}`}
                    class="slide-image"
                    loading={i === 0 ? "eager" : "lazy"}
                    width="1200"
                    height="630"
                  />
                  <!-- Gradient overlay -->
                  <div class="slide-overlay" />
                </a>
              )}

              <!-- Content overlaid on image -->
              <div class="slide-content">
                <div class="slide-badge">
                  {i === 0 ? "✦ Latest" : `#${i + 1}`}
                </div>
                <h1 class="slide-title">
                  <a href={`/posts/${post.id}`} tabindex={i === 0 ? "0" : "-1"}>
                    {post.data.title}
                  </a>
                </h1>
                <div class="slide-meta">
                  <time>
                    {post.data.pubDatetime.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                  <span class="slide-reading-time">· {readingTime(post)}</span>
                </div>
                {post.data.description && (
                  <p class="slide-desc">{post.data.description}</p>
                )}
                <a href={`/posts/${post.id}`} class="slide-cta" tabindex={i === 0 ? "0" : "-1"}>
                  Read more <span class="slide-cta-arrow">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>

        <!-- Progress bar -->
        <div class="progress-bar-track">
          <div class="progress-bar-fill" id="progress-fill" />
        </div>

        <!-- Prev / Next arrows -->
        <button class="slide-arrow slide-arrow--prev" id="slide-prev" aria-label="Previous slide">
          ‹
        </button>
        <button class="slide-arrow slide-arrow--next" id="slide-next" aria-label="Next slide">
          ›
        </button>

        <!-- Dot indicators -->
        <div class="slide-dots" role="tablist">
          {slideshowPosts.map((_, i) => (
            <button
              class={`slide-dot ${i === 0 ? "slide-dot--active" : ""}`}
              data-dot={i}
              aria-label={`Go to slide ${i + 1}`}
              role="tab"
            />
          ))}
        </div>

      </div>
    )}

    <Hr class="my-12" />

    <!-- Recent Posts Grid -->
    {recentPosts.length > 0 && (
      <>
        <h2 class="text-2xl md:text-3xl font-bold mb-8">Recent Posts</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 mb-12">
          {recentPosts.map((post) => (
            <article class="overflow-hidden rounded-2xl shadow-lg bg-card hover:shadow-xl transition-shadow duration-300">
              {post.data.coverImage && (
                <a href={`/posts/${post.id}`}>
                  <img
                    src={post.data.coverImage}
                    alt={`${post.data.title} cover image – ${SITE.title}`}
                    class="w-full object-cover aspect-video"
                    loading="lazy"
                    width="600"
                    height="400"
                  />
                </a>
              )}
              <div class="p-6">
                <h3 class="text-xl font-semibold mb-2 line-clamp-2">
                  <a href={`/posts/${post.id}`} class="hover:text-accent transition-colors">
                    {post.data.title}
                  </a>
                </h3>
                <div class="flex items-center gap-2 mb-3">
                  <time class="text-sm text-muted-foreground">
                    {post.data.pubDatetime.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                  <span class="text-sm text-muted-foreground">· {readingTime(post)}</span>
                </div>
                {post.data.description && (
                  <p class="text-muted-foreground line-clamp-3 mb-4">
                    {post.data.description}
                  </p>
                )}
                <LinkButton href={`/posts/${post.id}`} class="mt-2 inline-block">
                  Read more →
                </LinkButton>
              </div>
            </article>
          ))}
        </div>
      </>
    )}

    <!-- All Posts Button -->
    <div class="text-center mt-12">
      <LinkButton href="/posts/" size="lg">
        All Posts
        <IconArrowRight class="inline-block ml-2 w-5 h-5" />
      </LinkButton>
    </div>

  </main>
  <Footer />
</Layout>

<style>
  /* ── Slideshow Wrapper ── */
  .slideshow-wrapper {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.18);
    background: #0f172a;
    user-select: none;
  }

  /* ── Slides Container ── */
  .slides-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
  }

  @media (min-width: 768px) {
    .slides-container {
      aspect-ratio: 21/9;
    }
  }

  /* ── Individual Slide ── */
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .slide--active {
    opacity: 1;
    pointer-events: auto;
  }

  .slide-image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Gradient overlay so text is readable ── */
  .slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.45) 45%,
      rgba(0, 0, 0, 0.05) 100%
    );
  }

  /* ── Slide content pinned to bottom ── */
  .slide-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem 2.5rem 2.5rem;
    color: #fff;
    z-index: 2;
  }

  @media (max-width: 640px) {
    .slide-content {
      padding: 1.25rem 1.25rem 1.75rem;
    }
  }

  .slide-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: rgba(99, 102, 241, 0.85);
    backdrop-filter: blur(6px);
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
    border: 1px solid rgba(255,255,255,0.15);
  }

  .slide-title {
    font-size: clamp(1.2rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 0.5rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }

  .slide-title a {
    color: #fff;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .slide-title a:hover {
    opacity: 0.85;
  }

  .slide-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    opacity: 0.75;
    margin-bottom: 0.65rem;
  }

  .slide-reading-time {
    color: #a5b4fc;
    font-weight: 500;
  }

  .slide-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    opacity: 0.8;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 680px;
  }

  @media (max-width: 640px) {
    .slide-desc {
      display: none;
    }
  }

  .slide-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    background: rgba(99, 102, 241, 0.8);
    backdrop-filter: blur(8px);
    padding: 0.5rem 1.2rem;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.2);
    transition: background 0.2s, transform 0.2s;
  }

  .slide-cta:hover {
    background: rgba(99, 102, 241, 1);
    transform: translateY(-1px);
  }

  .slide-cta-arrow {
    transition: transform 0.2s;
  }

  .slide-cta:hover .slide-cta-arrow {
    transform: translateX(3px);
  }

  /* ── Progress bar ── */
  .progress-bar-track {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(255,255,255,0.15);
    z-index: 10;
  }

  .progress-bar-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #6366f1, #a5b4fc);
    transition: width 0.1s linear;
    border-radius: 999px;
  }

  /* ── Arrows ── */
  .slide-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.15);
    color: #fff;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.2s;
    padding: 0;
  }

  .slide-arrow:hover {
    background: rgba(99, 102, 241, 0.7);
    transform: translateY(-50%) scale(1.08);
  }

  .slide-arrow--prev {
    left: 1rem;
  }

  .slide-arrow--next {
    right: 1rem;
  }

  @media (max-width: 480px) {
    .slide-arrow {
      width: 32px;
      height: 32px;
      font-size: 1.1rem;
    }
  }

  /* ── Dots ── */
  .slide-dots {
    position: absolute;
    bottom: 1.1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 10;
  }

  .slide-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(255,255,255,0.35);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.25s, width 0.25s;
  }

  .slide-dot--active {
    background: #fff;
    width: 24px;
  }
</style>

<script is:inline>
  (function () {
    const INTERVAL = 3000;
    const wrapper = document.getElementById("hero-slideshow");
    if (!wrapper) return;

    const slides = Array.from(wrapper.querySelectorAll(".slide"));
    const dots = Array.from(wrapper.querySelectorAll(".slide-dot"));
    const fill = document.getElementById("progress-fill");
    const prevBtn = document.getElementById("slide-prev");
    const nextBtn = document.getElementById("slide-next");

    if (!slides.length) return;

    let current = 0;
    let paused = false;
    let startTime = null;
    let elapsed = 0;
    let rafId = null;

    function goTo(index) {
      slides[current].classList.remove("slide--active");
      // make non-active slides not tab-focusable
      slides[current].querySelectorAll("a").forEach(a => a.setAttribute("tabindex", "-1"));
      dots[current]?.classList.remove("slide-dot--active");

      current = (index + slides.length) % slides.length;

      slides[current].classList.add("slide--active");
      slides[current].querySelectorAll("a").forEach(a => a.setAttribute("tabindex", "0"));
      dots[current]?.classList.add("slide-dot--active");

      // reset progress
      elapsed = 0;
      startTime = null;
      if (fill) fill.style.width = "0%";
    }

    function tick(ts) {
      if (paused) {
        startTime = null;
        rafId = requestAnimationFrame(tick);
        return;
      }
      if (!startTime) startTime = ts - elapsed;
      elapsed = ts - startTime;

      const pct = Math.min((elapsed / INTERVAL) * 100, 100);
      if (fill) fill.style.width = pct + "%";

      if (elapsed >= INTERVAL) {
        goTo(current + 1);
      }

      rafId = requestAnimationFrame(tick);
    }

    // Start
    rafId = requestAnimationFrame(tick);

    // Pause on hover
    wrapper.addEventListener("mouseenter", () => { paused = true; });
    wrapper.addEventListener("mouseleave", () => { paused = false; startTime = null; });

    // Touch pause
    wrapper.addEventListener("touchstart", () => { paused = true; }, { passive: true });
    wrapper.addEventListener("touchend", () => {
      paused = false;
      startTime = null;
    }, { passive: true });

    // Arrows
    prevBtn?.addEventListener("click", () => goTo(current - 1));
    nextBtn?.addEventListener("click", () => goTo(current + 1));

    // Dots
    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => goTo(i));
    });
  })();
</script>
