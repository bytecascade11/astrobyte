---
// src/pages/mlbb/[slug].astro
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import Comments from "@/components/Comments.astro";
import AffiliateCarousel from "@/components/AffiliateCarousel.astro";
import { SITE } from "@/config";

export async function getStaticPaths() {
  const guides = await getCollection("mlbb", ({ data }) => !data.draft);

  return guides.map((guide) => ({
    params: { slug: guide.data.slug ?? guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

// ----------------------
// SAFE RELATED GUIDES
// ----------------------
let relatedGuides: CollectionEntry<"mlbb">[] = [];

if (
  Array.isArray(guide.data.relatedSlugs) &&
  guide.data.relatedSlugs.length > 0
) {
  const all = await getCollection("mlbb", ({ data }) => !data.draft);

  relatedGuides = all.filter((g) =>
    guide.data.relatedSlugs!.includes(g.data.slug ?? g.id)
  );
}

// ----------------------
// SEO DATA
// ----------------------
const pageTitle = `${guide.data.title} | ${SITE.title}`;
const pageDesc = guide.data.description;
const ogImage = guide.data.coverImage ?? "/og.png";

// Safe base URL
const websiteBase =
  SITE.website && SITE.website.startsWith("http")
    ? SITE.website.endsWith("/")
      ? SITE.website
      : `${SITE.website}/`
    : "https://example.com/";

// Absolute cover image
const coverImageAbs = guide.data.coverImage
  ? new URL(
      guide.data.coverImage.startsWith("/")
        ? guide.data.coverImage.slice(1)
        : guide.data.coverImage,
      websiteBase
    ).toString()
  : undefined;

const postUrl = `${websiteBase}mlbb/${guide.data.slug ?? guide.id}/`;
const postSlug = guide.data.slug ?? guide.id;

// Type labels
const typeLabels: Record<string, string> = {
  "hero-guide": "Hero Guide",
  "tier-list": "Tier List",
  guide: "Guide",
  settings: "Settings",
  news: "News",
};

const typeLabel = typeLabels[guide.data.type] ?? "Guide";
const shareURL = postUrl;
const shareTitle = guide.data.title;
---

<Layout title={pageTitle} description={pageDesc} ogImage={ogImage} coverImage={coverImageAbs}>

  <!-- Breadcrumb Schema -->
  <SchemaMarkup
    type="breadcrumb"
    breadcrumbs={[
      { name: "Home", url: websiteBase },
      { name: "Mobile Legends", url: `${websiteBase}mlbb/` },
      { name: typeLabel, url: `${websiteBase}mlbb/` },
      { name: guide.data.title, url: postUrl },
    ]}
  />

  <!-- Article Schema (SAFE like CODM) -->
  <SchemaMarkup
    type="article"
    title={guide.data.title}
    description={guide.data.description}
    url={postUrl}
    image={coverImageAbs}
    datePublished={new Date(guide.data.pubDatetime)}
    dateModified={
      guide.data.lastUpdated
        ? new Date(guide.data.lastUpdated)
        : new Date(guide.data.pubDatetime)
    }
  />

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-16">

    <!-- Breadcrumb -->
    <nav class="pt-6 pb-2 text-sm flex items-center gap-1.5 breadcrumb-nav">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/mlbb/">Mobile Legends</a>
      <span>/</span>
      <span>{typeLabel}</span>
    </nav>

    <!-- Cover Image -->
    {coverImageAbs && (
      <div class="hub-cover-wrap">
        <img
          src={coverImageAbs}
          alt={guide.data.coverImageAlt ?? guide.data.title}
          class="hub-cover-img"
          loading="eager"
          fetchpriority="high"
          width="1200"
          height="630"
        />
      </div>
    )}

    <!-- Header -->
    <div class="mb-6">
      <div class="flex flex-wrap gap-2 mb-3">
        <span class="badge badge--mlbb">Mobile Legends</span>
        <span class="badge">{typeLabel}</span>
        {guide.data.role && <span class="badge">{guide.data.role}</span>}
        {guide.data.season && <span class="badge">{guide.data.season}</span>}
      </div>

      <h1 class="text-3xl font-bold mb-3">{guide.data.title}</h1>
      <p class="post-desc text-lg">{guide.data.description}</p>

      <div class="mt-4 text-sm post-meta">
        <span>By {guide.data.author}</span>
        <span>
          {new Date(guide.data.pubDatetime).toLocaleDateString("en-NG", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </span>
        {guide.data.lastUpdated && (
          <span> • Updated: {guide.data.lastUpdated}</span>
        )}
      </div>
    </div>

    <!-- Article -->
    <article class="prose prose-revibyte max-w-none">
      <Content />
    </article>

    <!-- Related Guides -->
    {relatedGuides.length > 0 && (
      <section class="mt-12 border-t pt-8">
        <h2 class="text-lg font-semibold mb-4">Related Guides</h2>
        <ul class="space-y-3">
          {relatedGuides.map((related) => (
            <li>
              <a href={`/mlbb/${related.data.slug ?? related.id}/`}>
                {related.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Affiliate -->
    <AffiliateCarousel />

    <!-- Comments -->
    <Comments slug={postSlug} />

    <!-- Back -->
    <div class="mt-10">
      <a href="/">← Home</a> | <a href="/mlbb/">MLBB Hub</a>
    </div>

  </main>
</Layout>

<script is:inline>
  if (navigator.share) {
    const btn = document.getElementById("nativeShareBtn");
    if (btn) {
      btn.style.display = "flex";
      btn.addEventListener("click", () => {
        navigator.share({
          title: document.title,
          url: window.location.href,
        });
      });
    }
  }

  const copyBtn = document.getElementById("copyLinkBtn");
  if (copyBtn) {
    copyBtn.addEventListener("click", () => {
      navigator.clipboard.writeText(
        copyBtn.dataset.url || window.location.href
      );
    });
  }
</script>

<style is:global>
  .breadcrumb-nav { color: var(--foreground); opacity: 0.6; }
  .breadcrumb-nav a { color: var(--foreground); opacity: 1; }
  .breadcrumb-nav a:hover { color: var(--accent); opacity: 1; }
  .post-desc { color: var(--foreground); opacity: 0.75; }
  .post-meta { color: var(--foreground); opacity: 0.6; }
  .hub-cover-wrap {
    width: 100%; border-radius: 16px; overflow: hidden;
    margin-bottom: 1.75rem; margin-top: 0.5rem;
    background: var(--background-light);
  }
  .hub-cover-img {
    width: 100%; height: auto; object-fit: cover;
    aspect-ratio: 16/9; display: block;
  }
  @media (min-width: 768px) { .hub-cover-img { aspect-ratio: 21/9; } }
  .badge {
    font-size: 0.72rem; font-weight: 600; padding: 0.2rem 0.65rem;
    border-radius: 9999px; background: var(--background-light);
    color: var(--foreground); border: 1px solid var(--border);
  }
  .badge--mlbb { color: #1a73e8; border-color: #1a73e8; opacity: 0.9; }
  .prose h1 { display: none; }
  .share-bar {
    display: flex; align-items: center; flex-wrap: wrap; gap: 10px;
    padding: 12px 16px; border-radius: 12px;
    background: var(--background-light, rgba(99,102,241,0.06));
    border: 1px solid var(--border, rgba(99,102,241,0.2));
  }
  .share-label { font-size: 0.8rem; font-weight: 600; opacity: 0.6; white-space: nowrap; }
  .share-buttons { display: flex; flex-wrap: wrap; gap: 8px; margin-left: auto; }
  .share-btn {
    display: flex; align-items: center; gap: 5px; padding: 6px 14px;
    border-radius: 8px; font-size: 0.78rem; font-weight: 600; cursor: pointer;
    border: 1px solid transparent; text-decoration: none;
    transition: opacity 0.15s, transform 0.1s; white-space: nowrap;
  }
  .share-btn:hover { opacity: 0.85; transform: translateY(-1px); }
  .share-btn svg { width: 15px; height: 15px; flex-shrink: 0; }
  .share-btn--native { background: var(--accent, #6366f1); color: white; border: none; }
  .share-btn--x { background: #000; color: #fff; }
  .share-btn--wa { background: #25D366; color: #fff; }
  .share-btn--copy { background: var(--background-light); color: var(--foreground); border-color: var(--border); }
  @media (max-width: 480px) {
    .share-bar { flex-direction: column; align-items: flex-start; }
    .share-buttons { margin-left: 0; }
  }
</style>
