---
import Layout from "../layouts/Layout.astro";

const title =
  "Video Downloader for TikTok — Save Videos Online | ReviByte";

const description =
  "Free online downloader for short videos. Save videos and audio quickly on Android, iPhone, and PC. Not affiliated with TikTok.";

const canonicalURL =
  "https://www.revibyte.blog/save/tok/";
---

<Layout title={title} description={description}>

  <Fragment slot="head">

    <link
      rel="canonical"
      href={canonicalURL}
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalURL}
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

  </Fragment>

  <main class="tt-page">

    <!-- HERO -->
    <section class="tt-hero">

      <div class="tt-badge">
        Free Tool
      </div>

      <h1 class="tt-title">
        TikTok Video
        <span class="tt-accent">
          Downloader
        </span>
      </h1>

      <p class="tt-subtitle">
        Download TikTok videos without watermark
        or save audio as MP3.
        Fast, free, and works on all devices.
      </p>

    </section>

    <!-- TOOL -->
    <section class="tt-tool">

      <div class="tt-input-wrap">

        <input
          id="tt-url"
          type="url"
          placeholder="Paste TikTok link here..."
          autocomplete="off"
          spellcheck="false"
        />

        <button id="tt-fetch-btn">

          <span id="tt-btn-text">
            Download
          </span>

          <span
            id="tt-btn-spinner"
            style="display:none"
          >
            <svg
              class="tt-spin"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
            </svg>
          </span>

        </button>

      </div>

      <p class="tt-hint">
        Copy a TikTok link →
        paste it above →
        download instantly
      </p>

      <!-- ERROR -->
      <div
        id="tt-error"
        class="tt-error"
        style="display:none"
      ></div>

      <!-- RESULT -->
      <div
        id="tt-result"
        class="tt-result"
        style="display:none"
      >

        <div class="tt-video-meta">

          <img
            id="tt-cover"
            src=""
            alt="TikTok video thumbnail"
            class="tt-cover"
          />

          <div class="tt-meta-info">

            <div
              id="tt-author"
              class="tt-author"
            ></div>

            <div
              id="tt-video-title"
              class="tt-video-title"
            ></div>

            <div
              id="tt-stats"
              class="tt-stats"
            ></div>

          </div>

        </div>

        <div class="tt-download-btns">

          <a
            id="tt-dl-hd"
            href="#"
            target="_blank"
            class="tt-dl-btn tt-dl-primary"
          >
            Download Video
          </a>

          <a
            id="tt-dl-audio"
            href="#"
            target="_blank"
            class="tt-dl-btn tt-dl-secondary"
          >
            Download Audio (MP3)
          </a>

        </div>

      </div>

    </section>

  </main>

</Layout>

<style>

  .tt-page {
    max-width: 780px;
    margin: 0 auto;
    padding: 2rem 1.25rem 5rem;
  }

  /* HERO */

  .tt-hero {
    text-align: center;
    padding: 2.5rem 0 2rem;
  }

  .tt-badge {
    display: inline-block;
    background: rgba(255,0,80,0.1);
    color: #ff0050;
    border: 1px solid rgba(255,0,80,0.25);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.28rem 0.85rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .tt-title {
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 0.8rem;
  }

  .tt-accent {
    background:
      linear-gradient(
        135deg,
        #ff0050,
        #ff6b00
      );

    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .tt-subtitle {
    font-size: 1rem;
    opacity: 0.75;
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* TOOL */

  .tt-tool {
    background: rgba(255,0,80,0.04);
    border: 1px solid rgba(255,0,80,0.15);
    border-radius: 20px;
    padding: 2rem 1.5rem;
    margin-top: 2rem;
  }

  .tt-input-wrap {
    display: flex;
    gap: 10px;
    margin-bottom: 0.8rem;
  }

  #tt-url {
    flex: 1;
    min-width: 0;

    background: #111;
    border: 1px solid #333;

    border-radius: 12px;

    padding: 0.9rem 1rem;

    color: #fff;
    font-size: 0.95rem;

    outline: none;
  }

  #tt-url:focus {
    border-color: #ff0050;
  }

  #tt-url::placeholder {
    color: #666;
  }

  #tt-fetch-btn {
    background:
      linear-gradient(
        135deg,
        #ff0050,
        #ff6b00
      );

    color: #fff;

    border: none;
    border-radius: 12px;

    padding: 0.9rem 1.4rem;

    font-weight: 700;
    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 6px;

    white-space: nowrap;
  }

  #tt-fetch-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .tt-hint {
    font-size: 0.82rem;
    opacity: 0.55;
    text-align: center;
  }

  .tt-spin {
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  /* ERROR */

  .tt-error {
    background: rgba(255,0,80,0.08);
    border: 1px solid rgba(255,0,80,0.25);

    color: #ff4d7d;

    border-radius: 12px;

    padding: 0.9rem 1rem;

    margin-top: 1rem;

    font-size: 0.9rem;
  }

  /* RESULT */

  .tt-result {
    margin-top: 1.5rem;
    border-top: 1px solid #222;
    padding-top: 1.5rem;
  }

  .tt-video-meta {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1.25rem;
  }

  .tt-cover {
    width: 90px;
    height: 120px;

    object-fit: cover;

    border-radius: 12px;

    background: #f2f2f2;
    border: 1px solid #ddd;

    flex-shrink: 0;
  }

  .tt-meta-info {
    flex: 1;
    min-width: 0;
  }

  .tt-author {
    font-size: 0.82rem;
    color: #ff0050;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .tt-video-title {
    color: #000;
    font-size: 0.92rem;
    line-height: 1.5;

    margin-bottom: 0.5rem;

    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;

    overflow: hidden;
  }

  .tt-stats {
    color: #333;
    font-size: 0.8rem;
    opacity: 0.75;
  }

  /* BUTTONS */

  .tt-download-btns {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tt-dl-btn {
    display: flex;
    align-items: center;
    justify-content: center;

    text-decoration: none;

    border-radius: 12px;

    padding: 0.9rem 1.2rem;

    font-weight: 700;

    transition: 0.2s;
  }

  .tt-dl-btn:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }

  .tt-dl-primary {
    background:
      linear-gradient(
        135deg,
        #ff0050,
        #ff6b00
      );

    color: #fff;
  }

  .tt-dl-secondary {
    background: #111;
    border: 1px solid #333;
    color: #fff;
  }

  @media (max-width: 480px) {

    .tt-input-wrap {
      flex-direction: column;
    }

    #tt-fetch-btn {
      width: 100%;
    }

    .tt-cover {
      width: 82px;
      height: 110px;
    }

  }

</style>

<script>

  const urlInput =
    document.getElementById('tt-url');

  const fetchBtn =
    document.getElementById('tt-fetch-btn');

  const btnText =
    document.getElementById('tt-btn-text');

  const btnSpinner =
    document.getElementById('tt-btn-spinner');

  const errorEl =
    document.getElementById('tt-error');

  const resultEl =
    document.getElementById('tt-result');

  const coverEl =
    document.getElementById('tt-cover');

  const authorEl =
    document.getElementById('tt-author');

  const titleEl =
    document.getElementById('tt-video-title');

  const statsEl =
    document.getElementById('tt-stats');

  const dlHd =
    document.getElementById('tt-dl-hd');

  const dlAudio =
    document.getElementById('tt-dl-audio');

  function setLoading(loading) {

    fetchBtn.disabled = loading;

    btnText.style.display =
      loading ? 'none' : 'inline';

    btnSpinner.style.display =
      loading ? 'inline-flex' : 'none';
  }

  function showError(message) {

    errorEl.textContent = message;

    errorEl.style.display = 'block';

    resultEl.style.display = 'none';
  }

  function formatNumber(number) {

    if (number >= 1000000) {
      return (
        (number / 1000000).toFixed(1) + 'M'
      );
    }

    if (number >= 1000) {
      return (
        (number / 1000).toFixed(1) + 'K'
      );
    }

    return String(number);
  }

  async function fetchVideo() {

    const url =
      urlInput.value.trim();

    if (!url) {

      showError(
        'Please paste a TikTok link first.'
      );

      return;
    }

    errorEl.style.display = 'none';

    resultEl.style.display = 'none';

    setLoading(true);

    try {

      const response =
        await fetch(
          '/api/tiktok-save/',
          {
            method: 'POST',

            headers: {
              'Content-Type':
                'application/json',
            },

            body: JSON.stringify({
              url,
            }),
          }
        );

      const data =
        await response.json();

      if (
        !response.ok ||
        data.error
      ) {

        showError(
          data.error ||
          'Could not fetch video.'
        );

        return;
      }

      // Thumbnail

      if (
        data.cover &&
        data.cover.startsWith('http')
      ) {

        coverEl.src =
          data.cover;

        coverEl.style.display =
          'block';

      } else {

        coverEl.style.display =
          'none';
      }

      coverEl.onerror = () => {

        coverEl.style.display =
          'none';
      };

      // Video info

      authorEl.textContent =
        data.author
          ? '@' + data.author
          : '@unknown';

      titleEl.textContent =
        data.title ||
        'No description available';

      statsEl.textContent =
        `▶ ${formatNumber(data.plays || 0)} plays · ♥ ${formatNumber(data.likes || 0)} likes`;

      // Download links

      dlHd.href =
        data.videoNoWatermark ||
        data.videoSD ||
        '#';

      dlAudio.href =
        data.audio ||
        '#';

      if (!data.audio) {

        dlAudio.style.opacity =
          '0.4';

        dlAudio.style.pointerEvents =
          'none';

        dlAudio.textContent =
          'Audio not available';

      } else {

        dlAudio.style.opacity =
          '1';

        dlAudio.style.pointerEvents =
          'auto';

        dlAudio.textContent =
          'Download Audio (MP3)';
      }

      resultEl.style.display =
        'block';

    } catch (error) {

      console.error(error);

      showError(
        'Network error. Try again.'
      );

    } finally {

      setLoading(false);
    }
  }

  fetchBtn.addEventListener(
    'click',
    fetchVideo
  );

  urlInput.addEventListener(
    'keydown',
    (event) => {

      if (event.key === 'Enter') {
        fetchVideo();
      }
    }
  );

</script>
