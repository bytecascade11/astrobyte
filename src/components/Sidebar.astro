---
import Hr from "./Hr.astro";
import IconX from "@/assets/icons/IconX.svg";
import { SITE } from "@/config";

const { pathname } = Astro.url;

const currentPath =
  pathname !== "/" && pathname.endsWith("/") ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath === path || currentPath.startsWith(path + "/");
};

const tags = [
  { label: "News", href: "/tags/news/" },
  { label: "Samsung", href: "/tags/samsung/" },
  { label: "Apple", href: "/tags/apple/" },
  { label: "Android", href: "/tags/android/" },
  { label: "Games", href: "/tags/games/" },
  { label: "AI", href: "/tags/ai/" },
  { label: "Opinions", href: "/tags/opinions/" },
];

const categories = [
  { label: "Samsung", href: "/samsung/" },
  { label: "Xiaomi", href: "/xiaomi/" },
  { label: "Tecno", href: "/tecno/" },
  { label: "Motorola", href: "/motorola/" },
  { label: "Huawei", href: "/huawei/" },
  { label: "Honor", href: "/honor/" },
  { label: "OnePlus", href: "/oneplus/" },
  { label: "Pixel", href: "/pixel/" },
];

const tools = [
  { label: "Save Tools", href: "/save/", badge: "Free" },
  { label: "Heliara AI Chat", href: "/heliara/", badge: "AI" },
];

const gamingHub = [
  { label: "COD Mobile", href: "/codm/" },
  { label: "eFootball", href: "/efootball/" },
  { label: "PUBG Mobile", href: "/pubgmobile/" },
  { label: "MLBB", href: "/mlbb/" },
];
---

<!-- Sidebar — rendered as direct body child for highest z-index -->
<div
  id="sidebar-root"
  class="fixed inset-0 pointer-events-none"
  style="z-index: 2147483647;"
>
  <div
    id="sidebar-overlay"
    class="pointer-events-auto fixed inset-0 hidden bg-black/60"
    style="z-index: 1;"
  ></div>

  <aside
    id="app-sidebar"
    class="pointer-events-auto fixed right-0 top-0 h-full w-[85%] max-w-[340px] translate-x-full overflow-y-auto bg-background shadow-2xl transition-transform duration-300 ease-out"
    style="background-color: var(--color-background, #ffffff); z-index: 2; will-change: transform;"
    aria-hidden="true"
    inert
  >
    <div class="flex items-center justify-between p-4 bg-background">
      <span class="text-lg font-semibold">{SITE.title}</span>
      <button id="sidebar-close" aria-label="Close menu" class="p-2 hover:[&>svg]:stroke-accent">
        <IconX />
      </button>
    </div>
    <Hr />

    <nav aria-label="Sidebar navigation" class="px-4 py-3 bg-background min-h-[calc(100%-60px)]">
      <ul class="space-y-1 [&>li>a]:block [&>li>a]:rounded-lg [&>li>a]:px-3 [&>li>a]:py-2.5 [&>li>a]:font-medium [&>li>a]:hover:bg-black/5 dark:[&>li>a]:hover:bg-white/10 [&>li>a]:hover:text-accent">
        <li><a href="/" aria-current={isActive("/") ? "page" : undefined}>Home</a></li>
        <li><a href="/posts/" aria-current={isActive("/posts") ? "page" : undefined}>Posts</a></li>
        <li><a href="/stories/today/" aria-current={isActive("/stories") ? "page" : undefined}>Top Stories</a></li>
      </ul>

      <p class="mt-5 px-3 pb-1 text-xs font-semibold uppercase tracking-wider opacity-60">Tags</p>
      <ul class="grid grid-cols-2 gap-1 [&>li>a]:block [&>li>a]:rounded-lg [&>li>a]:px-3 [&>li>a]:py-2.5 [&>li>a]:text-sm [&>li>a]:font-medium [&>li>a]:hover:bg-black/5 dark:[&>li>a]:hover:bg-white/10 [&>li>a]:hover:text-accent">
        {tags.map((t) => (
          <li>
            <a href={t.href} aria-current={isActive(t.href.slice(0, -1)) ? "page" : undefined}>{t.label}</a>
          </li>
        ))}
      </ul>

      <p class="mt-5 px-3 pb-1 text-xs font-semibold uppercase tracking-wider opacity-60">Categories</p>
      <ul class="grid grid-cols-2 gap-1 [&>li>a]:block [&>li>a]:rounded-lg [&>li>a]:px-3 [&>li>a]:py-2.5 [&>li>a]:text-sm [&>li>a]:font-medium [&>li>a]:hover:bg-black/5 dark:[&>li>a]:hover:bg-white/10 [&>li>a]:hover:text-accent">
        {categories.map((c) => (
          <li>
            <a href={c.href} aria-current={isActive(c.href.slice(0, -1)) ? "page" : undefined}>{c.label}</a>
          </li>
        ))}
      </ul>

      <p class="mt-5 px-3 pb-1 text-xs font-semibold uppercase tracking-wider opacity-60">ReviByte Tools</p>
      <ul class="space-y-1">
        {tools.map((t) => (
          <li>
            <a href={t.href} class="flex items-center justify-between rounded-lg px-3 py-2.5 text-sm font-medium hover:bg-black/5 hover:text-accent dark:hover:bg-white/10">
              <span>{t.label}</span>
              <span class="rounded-full bg-accent/10 px-2 py-0.5 text-[10px] font-semibold text-accent">{t.badge}</span>
            </a>
          </li>
        ))}
      </ul>

      <button
        id="gaming-hub-toggle"
        class="mt-5 flex w-full items-center justify-between rounded-lg px-3 py-2 text-xs font-semibold uppercase tracking-wider opacity-60 hover:text-accent"
        aria-expanded="true"
        aria-controls="gaming-hub-list"
      >
        Gaming Hub
        <svg id="gaming-hub-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </button>
      <ul id="gaming-hub-list" class="space-y-1">
        {gamingHub.map((g) => (
          <li><a href={g.href} class="block rounded-lg px-3 py-2.5 text-sm font-medium hover:bg-black/5 hover:text-accent dark:hover:bg-white/10">{g.label}</a></li>
        ))}
      </ul>

      <a href="https://whatsapp.com/channel/0029VbBCXzRKAwEdcyip8841" target="_blank" rel="noopener noreferrer" class="mt-6 flex items-center justify-center rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-background">
        Join WhatsApp Channel
      </a>
    </nav>
  </aside>
</div>

<script>
  function initNav() {
    const menuBtn = document.querySelector<HTMLElement>("#menu-btn");
    const sidebar = document.querySelector<HTMLElement>("#app-sidebar");
    const overlay = document.querySelector<HTMLElement>("#sidebar-overlay");
    const closeBtn = document.querySelector<HTMLElement>("#sidebar-close");
    const gamingToggle = document.querySelector<HTMLElement>("#gaming-hub-toggle");
    const gamingList = document.querySelector<HTMLElement>("#gaming-hub-list");
    const gamingChevron = document.querySelector<HTMLElement>("#gaming-hub-chevron");

    if (!menuBtn || !sidebar || !overlay || !closeBtn) return;

    // Guard: astro:after-swap can re-run initNav on the same persisted DOM
    // nodes. Without this guard, every navigation stacks another set of
    // click/keydown listeners on the same elements, so a single tap ends up
    // firing the handler multiple times — a common cause of INP > 200ms.
    if (menuBtn.dataset.navInit === "true") return;
    menuBtn.dataset.navInit = "true";

    const openSidebar = () => {
      sidebar.classList.remove("translate-x-full");
      overlay.classList.remove("hidden");
      sidebar.setAttribute("aria-hidden", "false");
      sidebar.removeAttribute("inert");
      menuBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    };

    const closeSidebar = () => {
      sidebar.classList.add("translate-x-full");
      overlay.classList.add("hidden");
      sidebar.setAttribute("aria-hidden", "true");
      sidebar.setAttribute("inert", "");
      menuBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    };

    menuBtn.addEventListener("click", openSidebar);
    closeBtn.addEventListener("click", closeSidebar);
    overlay.addEventListener("click", closeSidebar);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeSidebar();
    });

    gamingToggle?.addEventListener("click", () => {
      const nowHidden = gamingList?.classList.toggle("hidden");
      gamingToggle.setAttribute("aria-expanded", String(!nowHidden));
      gamingChevron?.classList.toggle("rotate-180", !!nowHidden);
    });
  }

  initNav();
  document.addEventListener("astro:after-swap", initNav);
</script>
