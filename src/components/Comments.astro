---
// src/components/Comments.astro
import { createClient } from "@supabase/supabase-js";

export interface Props {
  slug: string;
}

const { slug } = Astro.props;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const { data } = await supabase
  .from("post_comments")
  .select("id, author_name, content, created_at")
  .eq("post_slug", slug)
  .order("created_at", { ascending: false });

const comments = data ?? [];
---

<section class="comments-section">

  <!-- Anonymous Comment Form -->
  <div class="rb-comments">
    <h2 class="rb-comments-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Comments <span class="rb-count">{comments.length}</span>
    </h2>

    <!-- Existing Comments -->
    <div class="rb-comment-list" id="rb-comment-list">
      {comments.length === 0 ? (
        <div class="rb-empty">Be the first to comment!</div>
      ) : (
        comments.map((c) => (
          <div class="rb-comment">
            <div class="rb-comment-header">
              <div class="rb-avatar">{c.author_name.charAt(0).toUpperCase()}</div>
              <div>
                <div class="rb-author">{c.author_name}</div>
                <div class="rb-time">
                  {new Date(c.created_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                </div>
              </div>
            </div>
            <div class="rb-comment-body">{c.content}</div>
          </div>
        ))
      )}
    </div>

    <!-- Comment Form -->
    <div class="rb-form-wrap">
      <h3 class="rb-form-title">Leave a comment</h3>
      <div class="rb-form" id="rb-form">
        <input
          type="text"
          id="rb-name"
          placeholder="Your name"
          maxlength="50"
          autocomplete="off"
        />
        <textarea
          id="rb-content"
          placeholder="Share your thoughts..."
          rows="4"
          maxlength="1000"
        ></textarea>
        <div class="rb-form-footer">
          <span class="rb-char-count" id="rb-char-count">0 / 1000</span>
          <button id="rb-submit">Post Comment</button>
        </div>
        <div class="rb-feedback" id="rb-feedback"></div>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="rb-divider">
    <span>Also on GitHub via Giscus</span>
  </div>

  <!-- Giscus -->
  <div class="giscus"></div>
</section>

<script
  src="https://giscus.app/client.js"
  data-repo="bytecascade11/astrobyte"
  data-repo-id="R_kgDOQobjBQ"
  data-category="Announcements"
  data-category-id="DIC_kwDOQobjBc4C0Dd4"
  data-mapping="pathname"
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="bottom"
  data-theme="preferred_color_scheme"
  data-lang="en"
  data-loading="lazy"
  crossorigin="anonymous"
  async
  is:inline
></script>

<script is:inline>
  function updateGiscusTheme() {
    const theme = document.firstElementChild?.getAttribute("data-theme") || "light";
    const iframe = document.querySelector("iframe.giscus-frame");
    if (iframe) {
      iframe.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: theme === "dark" ? "dark" : "light" } } },
        "https://giscus.app"
      );
    }
  }
  document.addEventListener("astro:after-swap", updateGiscusTheme);
  window.addEventListener("load", updateGiscusTheme);
  const observer = new MutationObserver(updateGiscusTheme);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
</script>

<script define:vars={{ slug }}>
  const nameInput    = document.getElementById("rb-name");
  const contentInput = document.getElementById("rb-content");
  const submitBtn    = document.getElementById("rb-submit");
  const feedback     = document.getElementById("rb-feedback");
  const charCount    = document.getElementById("rb-char-count");
  const list         = document.getElementById("rb-comment-list");

  contentInput.addEventListener("input", () => {
    charCount.textContent = `${contentInput.value.length} / 1000`;
  });

  submitBtn.addEventListener("click", async () => {
    const name    = nameInput.value.trim();
    const content = contentInput.value.trim();

    if (!name) return showFeedback("Please enter your name.", "error");
    if (name.length < 2) return showFeedback("Name must be at least 2 characters.", "error");
    if (!content) return showFeedback("Please write a comment.", "error");
    if (content.length < 3) return showFeedback("Comment is too short.", "error");

    submitBtn.disabled = true;
    submitBtn.textContent = "Posting...";

    try {
      const res = await fetch("/api/add-comment/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slug, author_name: name, content }),
      });

      const json = await res.json();

      if (!res.ok || !json.ok) throw new Error(json.error || "Failed to post comment");

      const empty = list.querySelector(".rb-empty");
      if (empty) empty.remove();

      const now = new Date();
      const dateStr = now.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
      const initial = name.charAt(0).toUpperCase();

      const el = document.createElement("div");
      el.className = "rb-comment rb-comment--new";
      el.innerHTML = `
        <div class="rb-comment-header">
          <div class="rb-avatar">${initial}</div>
          <div>
            <div class="rb-author">${name}</div>
            <div class="rb-time">${dateStr}</div>
          </div>
        </div>
        <div class="rb-comment-body">${content}</div>
      `;
      list.prepend(el);

      const countEl = document.querySelector(".rb-count");
      if (countEl) countEl.textContent = String((parseInt(countEl.textContent) || 0) + 1);

      nameInput.value = "";
      contentInput.value = "";
      charCount.textContent = "0 / 1000";
      showFeedback("Comment posted!", "success");

    } catch (err) {
      showFeedback(err.message || "Something went wrong. Try again.", "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Post Comment";
    }
  });

  function showFeedback(msg, type) {
    feedback.textContent = msg;
    feedback.className = `rb-feedback rb-feedback--${type}`;
    setTimeout(() => { feedback.textContent = ""; feedback.className = "rb-feedback"; }, 4000);
  }
</script>

<style>
  .comments-section { margin-top: 3rem; }

  .rb-comments {
    background: var(--color-fill, #fff);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .rb-comments-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--color-text-base, #111);
  }

  .rb-count {
    background: var(--color-accent, #6366f1);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
    margin-left: 0.25rem;
  }

  .rb-comment-list { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem; }

  .rb-empty {
    text-align: center;
    padding: 2rem;
    color: var(--color-text-muted, #888);
    font-size: 0.9rem;
    border: 1px dashed var(--color-border, #e5e7eb);
    border-radius: 10px;
  }

  .rb-comment {
    padding: 1rem;
    background: var(--color-card, #f9fafb);
    border-radius: 10px;
    border: 1px solid var(--color-border, #e5e7eb);
  }

  .rb-comment--new {
    animation: rbSlideIn 0.3s ease;
    border-color: var(--color-accent, #6366f1);
  }

  @keyframes rbSlideIn {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .rb-comment-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .rb-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-accent, #6366f1);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .rb-author { font-weight: 600; font-size: 0.9rem; color: var(--color-text-base, #111); }
  .rb-time   { font-size: 0.75rem; color: var(--color-text-muted, #888); margin-top: 1px; }
  .rb-comment-body { font-size: 0.9rem; line-height: 1.6; color: var(--color-text-base, #111); white-space: pre-wrap; word-break: break-word; }

  .rb-form-title { font-size: 0.95rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--color-text-base, #111); }
  .rb-form { display: flex; flex-direction: column; gap: 0.75rem; }

  .rb-form input,
  .rb-form textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 8px;
    background: var(--color-fill, #fff);
    color: var(--color-text-base, #111);
    font-size: 0.9rem;
    font-family: inherit;
    resize: vertical;
    transition: border-color 0.2s;
    outline: none;
  }

  .rb-form input:focus,
  .rb-form textarea:focus { border-color: var(--color-accent, #6366f1); }

  .rb-form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .rb-char-count { font-size: 0.7rem; color: var(--color-text-muted, #888); }

  .rb-form button {
    background: var(--color-accent, #6366f1);
    color: #fff;
    border: none;
    padding: 0.6rem 1.4rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
    font-family: inherit;
  }

  .rb-form button:hover   { opacity: 0.85; }
  .rb-form button:disabled { opacity: 0.5; cursor: not-allowed; }

  .rb-feedback { font-size: 0.8rem; min-height: 1.2rem; }
  .rb-feedback--success { color: #22c55e; }
  .rb-feedback--error   { color: #ef4444; }

  .rb-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-muted, #888);
    font-size: 0.75rem;
  }
  .rb-divider::before,
  .rb-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border, #e5e7eb);
  }
</style>
