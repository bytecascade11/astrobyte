---
// src/components/LinkButton.astro

import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  id?: string;
  class?: string;
  ariaLabel?: string;
  title?: string;
  disabled?: boolean;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg'; // ✅ add size
}

const {
  href,
  id,
  class: className = '',
  ariaLabel,
  title,
  disabled = false,
  variant = 'primary', // default variant
  size = 'md',         // default size
  ...rest
} = Astro.props;

// Map size prop to Tailwind padding/text classes
const sizeClasses = {
  sm: 'px-3 py-1 text-sm',
  md: 'px-4 py-2 text-base',
  lg: 'px-6 py-3 text-lg',
}[size];

// Map variant prop to Tailwind colors
const variantClasses = {
  primary: 'bg-accent text-white hover:bg-accent-dark',
  secondary: 'bg-gray-200 text-gray-800 hover:bg-gray-300',
  outline: 'border border-accent text-accent hover:bg-accent hover:text-white',
}[variant];
---

{
  disabled ? (
    <span
      id={id}
      class:list={["inline-block cursor-not-allowed opacity-60", sizeClasses, className]}
      title={title}
      aria-disabled="true"
      role="link"
      {...rest}
    >
      <slot />
    </span>
  ) : (
    <a
      id={id}
      href={href}
      class:list={[
        "inline-block transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2",
        sizeClasses,
        variantClasses,
        className
      ]}
      aria-label={ariaLabel}
      title={title}
      {...rest}
    >
      <slot />
    </a>
  )
}
