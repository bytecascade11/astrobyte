---
// src/components/AnchorAd.astro
---

<div id="anchor-ad-bar" class="anchor-ad collapsed">
  <button id="anchor-toggle" aria-label="Toggle ad">
    <span id="anchor-label">▲ Ad</span>
  </button>

  <div id="anchor-ad-content">
    <p class="anchor-ad__disclaimer">Advertisement</p>
    <ins class="adsbygoogle"
      style="display:block"
      data-ad-client="ca-pub-4896561037705299"
      data-ad-slot="6421475366"
      data-ad-format="horizontal"
      data-full-width-responsive="true">
    </ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
</div>

<style>
  .anchor-ad {
    position: fixed;
    bottom: 0;
    top: unset;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: rgba(15, 15, 25, 0.72);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: none;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.45);
  }

  #anchor-ad-content {
    overflow: hidden;
    max-height: 280px;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.25s ease;
    opacity: 1;
    padding: 0.5rem 1rem 0.75rem;
    text-align: center;
  }

  .anchor-ad.collapsed #anchor-ad-content {
    max-height: 0;
    opacity: 0;
    padding: 0;
  }

  .anchor-ad__disclaimer {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.25);
    margin: 0 0 4px;
  }

  #anchor-toggle {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 5px 0;
    background: transparent;
    border: none;
    cursor: pointer;
    outline: none;
  }

  #anchor-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 3px 10px;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }

  #anchor-toggle:hover #anchor-label {
    color: var(--color-accent);
    background: rgba(124, 106, 255, 0.1);
    border-color: rgba(124, 106, 255, 0.3);
  }

  @media (display-mode: standalone) {
    .anchor-ad {
      display: none;
    }
  }
</style>

<script>
  const bar = document.getElementById('anchor-ad-bar');
  const btn = document.getElementById('anchor-toggle');
  const label = document.getElementById('anchor-label');

  if (btn && bar && label) {
    btn.addEventListener('click', () => {
      bar.classList.toggle('collapsed');
      label.textContent = bar.classList.contains('collapsed')
        ? '▲ Ad'
        : '▼ Close';
    });
  }
</script>
