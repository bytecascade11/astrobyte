---
// src/components/NewMonthBanner.astro
// A dismissible welcome popup that greets visitors with "Happy New Month".
// Shows once per visitor per calendar month (via localStorage), then stays hidden
// until the next month rolls around — no manual editing needed each month.
---

<div id="rb-new-month-banner" class="rb-banner" role="dialog" aria-live="polite">
  <div class="rb-banner-inner">
    <div class="rb-icon">RB</div>
    <div class="rb-text">
      <p class="rb-title">Welcome to ReviByte 👋</p>
      <p class="rb-sub">Happy New Month — <span id="rb-month"></span>! Fresh reviews, fresh drops.</p>
    </div>
    <button id="rb-close" class="rb-close" aria-label="Dismiss">✕</button>
  </div>
</div>

<style>
  .rb-banner {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%) translateY(-140%);
    z-index: 9999;
    width: min(92vw, 440px);
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    pointer-events: none;
  }

  .rb-banner.rb-show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .rb-banner-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 14px;
    border-radius: 16px;
    background: linear-gradient(135deg, #2b1650 0%, #3d1f5c 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    color: #f5f0ff;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  .rb-icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: linear-gradient(135deg, #ffb347, #ff6b6b);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
    color: #1a1030;
  }

  .rb-text { flex: 1; min-width: 0; }

  .rb-title {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: #f5f0ff;
  }

  .rb-sub {
    margin: 2px 0 0 0;
    font-size: 13px;
    color: rgba(245, 240, 255, 0.75);
    line-height: 1.4;
  }

  .rb-close {
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.08);
    border: none;
    color: rgba(245, 240, 255, 0.8);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 13px;
    line-height: 1;
  }

  .rb-close:hover { background: rgba(255, 255, 255, 0.18); }

  @media (prefers-reduced-motion: reduce) {
    .rb-banner { transition: opacity 0.3s ease; }
  }
</style>

<script>
  (function () {
    const STORAGE_PREFIX = "rb-new-month-dismissed-";
    const now = new Date();
    const monthKey = now.getFullYear() + "-" + now.getMonth(); // e.g. 2026-6
    const monthName = now.toLocaleString("en-US", { month: "long" });

    const banner = document.getElementById("rb-new-month-banner");
    const monthSpan = document.getElementById("rb-month");
    const closeBtn = document.getElementById("rb-close");

    if (!banner) return;
    if (monthSpan) monthSpan.textContent = monthName;

    const alreadyDismissed = localStorage.getItem(STORAGE_PREFIX + monthKey);

    if (!alreadyDismissed) {
      // slight delay so it "pops in" after page settles
      setTimeout(() => banner.classList.add("rb-show"), 600);
    }

    function dismiss() {
      banner.classList.remove("rb-show");
      localStorage.setItem(STORAGE_PREFIX + monthKey, "1");
    }

    closeBtn?.addEventListener("click", dismiss);

    // auto-dismiss after 8s if the visitor doesn't interact
    setTimeout(() => {
      if (banner.classList.contains("rb-show")) dismiss();
    }, 8000);
  })();
</script>
