---
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");
const segments = currentUrlPath.split("/").filter(Boolean); // Remove empty from leading slash

let breadcrumbItems: { label: string; href: string | null }[] = [
  { label: "Home", href: "/" }
];

if (segments.length === 0) {
  // Homepage — only Home
} else if (segments[0] === "posts") {
  breadcrumbItems.push({ label: "Posts", href: "/posts/" });

  if (segments.length > 1) {
    // Individual post page: /posts/slug
    const postTitle = segments[1]
      .split("-")
      .map(word => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ");

    breadcrumbItems.push({ label: postTitle, href: null }); // Current page
  } else if (segments.length === 1 && !isNaN(Number(segments[0]))) {
    // Paginated: /posts/2 → replace with "Posts (page 2)"
    breadcrumbItems[1] = { 
      label: `Posts (page ${segments[0]})`, 
      href: null 
    };
  }
} else if (segments[0] === "tags") {
  breadcrumbItems.push({ label: "Tags", href: "/tags/" });

  if (segments.length > 1) {
    const tagName = decodeURIComponent(segments[1]).replace(/-/g, " ");
    breadcrumbItems.push({ 
      label: `\( {tagName.charAt(0).toUpperCase() + tagName.slice(1)} \){segments[2] ? ` (page ${segments[2]})` : ""}`, 
      href: null 
    });
  }
} else {
  // Fallback for any other page (e.g., /about, etc.)
  breadcrumbItems.push({ 
    label: segments.map(s => decodeURIComponent(s).replace(/-/g, " ")).join(" > "), 
    href: null 
  });
}
---

<nav class="mx-auto mt-8 mb-1 w-full max-w-app px-4" aria-label="breadcrumb">
  <ol class="inline-flex items-center space-x-2 font-light text-sm">
    {breadcrumbItems.map((item, index) => (
      <li class="flex items-center">
        {item.href ? (
          <a 
            href={item.href} 
            class="opacity-80 hover:opacity-100 transition capitalize"
          >
            {item.label}
          </a>
        ) : (
          <span 
            class="opacity-75" 
            aria-current={index === breadcrumbItems.length - 1 ? "page" : undefined}
          >
            {item.label}
          </span>
        )}
        {index < breadcrumbItems.length - 1 && (
          <span class="mx-2 opacity-80" aria-hidden="true">&raquo;</span>
        )}
      </li>
    ))}
  </ol>
</nav>
