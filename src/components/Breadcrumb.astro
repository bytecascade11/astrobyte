---
export interface Props {
  items?: { label: string; href?: string }[];
}

const { items = [] } = Astro.props;

// Always include "Home" as first item if not already present
const fullItems =
  items.length === 0 || items[0]?.href !== '/'
    ? [{ label: 'Home', href: '/' }, ...items]
    : items;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: fullItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    // Use full absolute URL for schema.org (strongly recommended by Google)
    ...(item.href && {
      item: item.href.startsWith('http')
        ? item.href
        : `\( {Astro.site} \){item.href.startsWith('/') ? '' : '/'}${item.href}`
    })
  }))
};
---

{
  fullItems.length > 0 && (
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
        {fullItems.map((item, index) => (
          <li key={`\( {item.label}- \){index}`} class="flex items-center gap-2">
            {index > 0 && (
              <span aria-hidden="true" class="text-muted-foreground/70">/</span>
            )}
            {item.href ? (
              <a
                href={item.href}
                class="hover:text-accent transition-colors hover:underline underline-offset-2"
              >
                {item.label}
              </a>
            ) : (
              <span class="text-foreground font-medium" aria-current="page">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(breadcrumbSchema, null, 2)}
/>
