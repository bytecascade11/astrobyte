---
const { posts } = Astro.props;

interface PostType {
  id: string;
  data: {
    title: string;
    coverImage?: string;
    coverImageAlt?: string;
  };
}

// Take first 5–8 posts (more = smoother loop)
const breakingPosts = posts.slice(0, 8);
---

<section class="w-full max-w-xl mx-auto my-4 overflow-hidden" aria-label="Breaking news ticker">
  <swiper-container
    id="breaking-slider"
    class="mySwiper"
    init="false" <!-- manual initialization -->
  ></swiper-container>
</section>

<script is:inline type="module">
  import 'swiper/css';
  import 'swiper/css/pagination';
  import { register } from 'swiper/element/bundle';

  register();

  // Safe Astro injection
  const posts = JSON.parse(${JSON.stringify(breakingPosts)});

  const swiperEl = document.querySelector('#breaking-slider');

  if (swiperEl && posts.length > 0) {
    // Create slides
    posts.forEach(post => {
      const slide = document.createElement('swiper-slide');
      slide.className = 'ticker-slide';
      slide.innerHTML = `
        <a href="/posts/${post.id}" 
           class="inline-block px-6 py-2 bg-gray-800 text-white text-sm font-medium whitespace-nowrap">
          ${post.data.title}&nbsp;&nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;
        </a>`;
      swiperEl.appendChild(slide);
    });

    // Duplicate slides for seamless loop
    posts.forEach(post => {
      const slide = document.createElement('swiper-slide');
      slide.className = 'ticker-slide';
      slide.innerHTML = `
        <a href="/posts/${post.id}" 
           class="inline-block px-6 py-2 bg-gray-800 text-white text-sm font-medium whitespace-nowrap">
          ${post.data.title}&nbsp;&nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;
        </a>`;
      swiperEl.appendChild(slide);
    });

    // Swiper ticker configuration
    Object.assign(swiperEl, {
      slidesPerView: 'auto',
      spaceBetween: 0,
      loop: true,
      freeMode: true,
      allowTouchMove: false,
      speed: 12000, // adjust for ticker speed
      autoplay: {
        delay: 0,
        disableOnInteraction: false
      },
      navigation: false
    });

    // Initialize Swiper
    swiperEl.initialize();
  }
</script>

<style>
  swiper-container {
    --swiper-pagination-color: #f97316;
    height: 40px;
    line-height: 40px; /* prevents vertical misalignment */
    width: 100%;
  }

  swiper-container::part(wrapper) {
    transition-timing-function: linear !important; /* critical for smooth ticker */
  }

  .ticker-slide {
    width: auto !important;        /* slide width = content width */
    height: 40px;
    display: flex;
    align-items: center;
  }

  .ticker-slide a:hover {
    text-decoration: underline;
    background-color: #4b5563;
  }

  .swiper-pagination-bullet-active {
    background: #f97316;
  }
</style>
