---
// src/components/PostSlider.astro

import { Swiper, SwiperSlide } from 'astro-swiper';
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const { posts } = Astro.props;

interface PostType {
  id: string;
  data: {
    title: string;
    description?: string;
    coverImage?: string;
    coverImageAlt?: string;
    pubDatetime: Date;
    tags?: string[];
    draft?: boolean;
  };
}
---

<section class="relative w-full">
  <Swiper
    navigation
    pagination={{ clickable: true }}
    autoplay={{ delay: 4000, disableOnInteraction: false }}
    loop
    slidesPerView={1}
    spaceBetween={0}
    class="mySwiper"
  >
    {posts.map((post: PostType) => (
      <SwiperSlide key={post.id}>
        <a href={`/posts/${post.id}`} class="relative block">
          {post.data.coverImage && (
            <img
              src={post.data.coverImage}
              alt={post.data.coverImageAlt || post.data.title}
              class="w-full h-[380px] object-cover rounded-2xl"
              loading="eager"
            />
          )}
          <div class="absolute bottom-0 left-0 right-0 bg-black/60 text-white p-6 rounded-b-2xl">
            <h2 class="text-xl md:text-2xl font-bold">{post.data.title}</h2>
            {post.data.description && (
              <p class="mt-2 text-sm line-clamp-2">{post.data.description}</p>
            )}
          </div>
        </a>
      </SwiperSlide>
    ))}
  </Swiper>
</section>

<style>
  /* Optional: customize navigation arrows & pagination */
  .swiper-button-next,
  .swiper-button-prev {
    color: #f97316; /* your accent color */
  }
  .swiper-pagination-bullet {
    background: #f97316;
  }
  .swiper-pagination-bullet-active {
    background: #f97316;
  }
</style>
