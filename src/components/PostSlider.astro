---
// PostSlider.astro – Web Components version (no astro-swiper needed)
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';
import { register } from 'swiper/element/bundle';

const { posts } = Astro.props;

// We register once (safe to call multiple times)
register();
---

<section class="relative w-full">
  <swiper-container
    navigation="true"
    pagination='{"clickable": true}'
    autoplay='{"delay": 4000, "disableOnInteraction": false}'
    loop="true"
    slides-per-view="1"
    class="mySwiper"
  >
    {posts.map(post => (
      <swiper-slide key={post.id}>
        <a href={`/posts/${post.id}`} class="relative block">
          {post.data.coverImage && (
            <img
              src={post.data.coverImage}
              alt={post.data.coverImageAlt || post.data.title}
              class="w-full h-[380px] object-cover rounded-2xl"
              loading="eager"
            />
          )}
          <div class="absolute bottom-0 left-0 right-0 bg-black/60 text-white p-6 rounded-b-2xl">
            <h2 class="text-xl md:text-2xl font-bold">{post.data.title}</h2>
            {post.data.description && (
              <p class="mt-2 text-sm line-clamp-2">{post.data.description}</p>
            )}
          </div>
        </a>
      </swiper-slide>
    ))}
  </swiper-container>
</section>

<script>
  // Optional: more fine-grained control if needed
  document.addEventListener('astro:page-load', () => {
    const swiper = document.querySelector('swiper-container.mySwiper');
    if (swiper) swiper.initialize?.();
  });
</script>

<style>
  .swiper-button-next, .swiper-button-prev { color: #f97316; }
  .swiper-pagination-bullet { background: #f97316; }
</style>
