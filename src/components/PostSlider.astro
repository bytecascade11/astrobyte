---
const { posts } = Astro.props;

interface PostType {
  id: string;
  data: {
    title: string;
    description?: string;
    coverImage?: string;
    coverImageAlt?: string;
    pubDatetime: Date;
    tags?: string[];
    draft?: boolean;
  };
}
---

<section class="relative overflow-hidden rounded-2xl shadow-xl mb-12">
  <div class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar">
    {posts.map((post: PostType) => (
      <a href={`/posts/${post.id}`} class="min-w-full snap-start relative block">
        {post.data.coverImage && (
          <img
            src={post.data.coverImage}
            alt={post.data.coverImageAlt || post.data.title}
            class="w-full h-[380px] object-cover"
            loading="eager"
          />
        )}
        <div class="absolute bottom-0 left-0 right-0 bg-black/60 text-white p-6">
          <h2 class="text-xl md:text-2xl font-bold">{post.data.title}</h2>
          {post.data.description && (
            <p class="mt-2 text-sm line-clamp-2">{post.data.description}</p>
          )}
        </div>
      </a>
    ))}
  </div>
</section>

<style>
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
</style>
