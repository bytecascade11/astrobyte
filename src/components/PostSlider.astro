---
const { posts } = Astro.props;

interface PostType {
  id: string;
  data: {
    title: string;
    coverImage?: string;
    coverImageAlt?: string;
  };
}

// Only take first 5 posts for breaking slider
const breakingPosts = posts.slice(0, 5);
---

<section class="w-full max-w-xl mx-auto my-4">
  <swiper-container id="breaking-slider" class="mySwiper"></swiper-container>
</section>

<!-- Pass posts to client via JSON -->
<script id="breaking-posts-data" type="application/json">
  {JSON.stringify(breakingPosts)}
</script>

<script is:inline type="module">
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';
  import { register } from 'swiper/element/bundle';

  register();

  const swiperEl = document.querySelector('#breaking-slider');
  const dataEl = document.querySelector('#breaking-posts-data');
  const posts = dataEl ? JSON.parse(dataEl.textContent) : [];

  if (swiperEl && posts.length > 0) {
    posts.forEach((post) => {
      const slide = document.createElement('swiper-slide');

      slide.innerHTML = `
        <a href="/posts/${post.id}" class="block px-4 py-2 bg-gray-800 text-white rounded-md text-sm truncate">
          ${post.data.title}
        </a>
      `;

      swiperEl.appendChild(slide);
    });

    // JS properties for slider
    swiperEl.slidesPerView = 1;
    swiperEl.loop = true;
    swiperEl.autoplay = { delay: 2500, disableOnInteraction: false };
    swiperEl.navigation = false; // optional
    swiperEl.pagination = { clickable: true }; // optional
  }
</script>

<style>
  /* Small horizontal slider styling */
  swiper-container {
    display: block;
    height: 40px;
  }

  swiper-slide a {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: 40px;
  }

  .swiper-pagination-bullet,
  .swiper-pagination-bullet-active {
    background: #f97316;
  }
</style>
