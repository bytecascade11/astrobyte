---
/**
 * AdsterraAd.astro
 * A reusable component for your 320x50 Adsterra banner.
 * You can add props later if you want multiple ad units.
 */
---

<div class="adsterra-ad-container my-8 text-center overflow-hidden">
  {@html `
    <script type="text/javascript">
      atOptions = {
        'key' : '2b0c33ae294502978b9bfb23cc9b43f0',
        'format' : 'iframe',
        'height' : 50,
        'width' : 320,
        'params' : {}
      };
    </script>
    <script type="text/javascript" src="https://www.highperformanceformat.com/2b0c33ae294502978b9bfb23cc9b43f0/invoke.js"></script>
  `}
</div>

<style>
  .adsterra-ad-container {
    margin: 2rem auto;
    max-width: 100%;
    line-height: 0; /* Removes unwanted space below iframe */
  }
  
  /* Optional: Add a subtle label if you want transparency */
