---
// MilestoneBadge.astro
// Floating 121 Days Milestone Badge for ReviByte
// Place this component inside your 121 days post's .md or in PostDetails.astro conditionally
---

<div class="milestone-wrap" id="milestoneBadge">
  <!-- Confetti particles -->
  <div class="confetti-container" id="confettiContainer"></div>

  <div class="badge-card">
    <button class="close-btn" id="closeBadge" aria-label="Close milestone badge">✕</button>

    <div class="badge-inner">
      <div class="badge-icon">🎉</div>
      <div class="badge-number">121</div>
      <div class="badge-label">DAYS</div>
      <div class="badge-sub">of ReviByte</div>
      <div class="badge-dates">Dec 15, 2025 → Apr 15, 2026</div>
      <a href="/posts/first-post-revibyte-live/" class="badge-link">See where it started →</a>
    </div>

    <!-- Animated ring -->
    <svg class="ring" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
      <circle class="ring-track" cx="60" cy="60" r="54"/>
      <circle class="ring-fill" cx="60" cy="60" r="54"/>
    </svg>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;700&display=swap');

  .milestone-wrap {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 9999;
    animation: slideUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(60px) scale(0.85); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .badge-card {
    position: relative;
    width: 160px;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default;
    filter: drop-shadow(0 8px 32px rgba(255, 140, 0, 0.35));
    transition: filter 0.3s ease;
  }

  .badge-card:hover {
    filter: drop-shadow(0 12px 40px rgba(255, 140, 0, 0.55));
  }

  .badge-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 120px;
    height: 120px;
    background: radial-gradient(circle at 40% 30%, #1a1a2e, #0d0d0d);
    border-radius: 50%;
    text-align: center;
    padding: 8px;
  }

  .badge-icon {
    font-size: 14px;
    line-height: 1;
    margin-bottom: 1px;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  .badge-number {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 42px;
    line-height: 1;
    color: #ff8c00;
    letter-spacing: 1px;
    text-shadow: 0 0 20px rgba(255, 140, 0, 0.6);
  }

  .badge-label {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 13px;
    letter-spacing: 4px;
    color: #fff;
    line-height: 1;
    margin-top: -2px;
  }

  .badge-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: 8px;
    color: rgba(255,255,255,0.55);
    letter-spacing: 1px;
    margin-top: 3px;
    text-transform: uppercase;
  }

  .badge-dates {
    font-family: 'DM Sans', sans-serif;
    font-size: 6.5px;
    color: rgba(255, 140, 0, 0.7);
    margin-top: 3px;
    letter-spacing: 0.3px;
  }

  .badge-link {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 6px;
    color: #fff;
    text-decoration: none;
    margin-top: 4px;
    padding: 2px 6px;
    background: rgba(255,140,0,0.15);
    border-radius: 10px;
    border: 1px solid rgba(255,140,0,0.3);
    transition: background 0.2s;
  }

  .badge-link:hover {
    background: rgba(255,140,0,0.3);
  }

  /* Spinning ring SVG */
  .ring {
    position: absolute;
    top: 0; left: 0;
    width: 160px;
    height: 160px;
    z-index: 1;
  }

  .ring-track {
    fill: none;
    stroke: rgba(255,140,0,0.1);
    stroke-width: 2;
  }

  .ring-fill {
    fill: none;
    stroke: #ff8c00;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 339.3;
    stroke-dashoffset: 339.3;
    transform-origin: center;
    transform: rotate(-90deg);
    animation: ringFill 2s ease forwards 0.4s, ringSpin 8s linear infinite 2.5s;
  }

  @keyframes ringFill {
    to { stroke-dashoffset: 0; }
  }

  @keyframes ringSpin {
    to { transform: rotate(270deg); }
  }

  /* Close button */
  .close-btn {
    position: absolute;
    top: 6px;
    right: 2px;
    z-index: 10;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.2);
    background: rgba(0,0,0,0.6);
    color: rgba(255,255,255,0.7);
    font-size: 9px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s;
    line-height: 1;
    padding: 0;
  }

  .close-btn:hover {
    background: #ff8c00;
    color: #000;
    border-color: #ff8c00;
  }

  /* Confetti */
  .confetti-container {
    position: fixed;
    top: 0; left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9998;
    overflow: hidden;
  }

  .confetti-piece {
    position: absolute;
    width: 8px;
    height: 8px;
    opacity: 0;
    animation: confettiFall linear forwards;
  }

  @keyframes confettiFall {
    0%   { opacity: 1; transform: translateY(-20px) rotate(0deg); }
    100% { opacity: 0; transform: translateY(100vh) rotate(720deg); }
  }

  /* Hide when dismissed */
  .milestone-wrap.hidden {
    animation: slideDown 0.4s cubic-bezier(0.4, 0, 1, 1) forwards;
  }

  @keyframes slideDown {
    to { opacity: 0; transform: translateY(60px) scale(0.85); }
  }
</style>

<script>
  // Close badge
  const badge = document.getElementById('milestoneBadge');
  const closeBtn = document.getElementById('closeBadge');

  closeBtn?.addEventListener('click', () => {
    badge?.classList.add('hidden');
    setTimeout(() => badge?.remove(), 400);
    // Remember dismissal in session
    sessionStorage.setItem('milestone121Closed', 'true');
  });

  // Don't show again if already closed this session
  if (sessionStorage.getItem('milestone121Closed') === 'true') {
    badge?.remove();
  }

  // Confetti burst on load
  const container = document.getElementById('confettiContainer');
  const colors = ['#ff8c00', '#fff', '#ffd700', '#ff4500', '#00cfff'];
  const shapes = ['border-radius:50%', 'border-radius:2px', 'border-radius:0'];

  function launchConfetti() {
    for (let i = 0; i < 60; i++) {
      setTimeout(() => {
        const piece = document.createElement('div');
        piece.className = 'confetti-piece';
        piece.style.cssText = `
          left: ${Math.random() * 100}vw;
          top: -10px;
          background: ${colors[Math.floor(Math.random() * colors.length)]};
          width: ${4 + Math.random() * 8}px;
          height: ${4 + Math.random() * 8}px;
          ${shapes[Math.floor(Math.random() * shapes.length)]};
          animation-duration: ${2 + Math.random() * 3}s;
          animation-delay: ${Math.random() * 0.5}s;
        `;
        container?.appendChild(piece);
        setTimeout(() => piece.remove(), 5500);
      }, i * 30);
    }
  }

  // Launch confetti after badge appears
  setTimeout(launchConfetti, 800);
</script>
