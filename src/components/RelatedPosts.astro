--- 
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro'; // Or whatever card component AstroPaper uses for post previews

const { post } = Astro.props; // You'll pass the current post to this component

const allPosts = await getCollection('blog');

// Find related: same tags, exclude current post, limit to 3-5
const related = allPosts
  .filter(p => p.id !== post.id)
  .filter(p => p.data.tags?.some(tag => post.data.tags?.includes(tag)))
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf())
  .slice(0, 5); // Show up to 5 related
---

{related.length > 0 && (
  <section class="mt-12 border-t pt-8">
    <h2 class="text-2xl font-bold mb-6">Related Posts</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {related.map(relatedPost => (
        <PostCard post={relatedPost} /> {/* Reuse your existing post preview card */}
      ))}
    </div>
  </section>
)}
