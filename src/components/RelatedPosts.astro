---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";

type Props = {
  currentPost: CollectionEntry<"blog">;
  allPosts: CollectionEntry<"blog">[];
  limit?: number;
};

const { currentPost, allPosts, limit = 3 } = Astro.props;

// Get related posts based on shared tags
const currentTags = currentPost.data.tags.map(tag => slugifyStr(tag));

const relatedPosts = allPosts
  .filter(post => post.id !== currentPost.id && !post.data.draft)
  .map(post => {
    const postTags = post.data.tags.map(tag => slugifyStr(tag));
    const sharedTags = currentTags.filter(tag => postTags.includes(tag));
    return { post, sharedTagCount: sharedTags.length };
  })
  .filter(({ sharedTagCount }) => sharedTagCount > 0)
  .sort((a, b) => {
    // Sort by shared tags, then by date
    if (b.sharedTagCount !== a.sharedTagCount) {
      return b.sharedTagCount - a.sharedTagCount;
    }
    return b.post.data.pubDatetime.valueOf() - a.post.data.pubDatetime.valueOf();
  })
  .slice(0, limit)
  .map(({ post }) => post);
---

{relatedPosts.length > 0 && (
  <section class="mt-12">
    <h2 class="text-2xl font-bold mb-6">Related Posts</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {relatedPosts.map((post) => (
        <article class="overflow-hidden rounded-xl shadow-lg bg-card hover:shadow-xl transition-shadow duration-300">
          {post.data.coverImage && (
            <a href={getPath(post.id, post.filePath)}>
              <img
                src={post.data.coverImage}
                alt={post.data.coverImageAlt || post.data.title}
                class="w-full object-cover aspect-video"
                loading="lazy"
                width="400"
                height="225"
              />
            </a>
          )}
          <div class="p-4">
            <h3 class="text-lg font-semibold mb-2 line-clamp-2">
              <a
                href={getPath(post.id, post.filePath)}
                class="hover:text-accent transition-colors"
              >
                {post.data.title}
              </a>
            </h3>
            <time class="text-sm text-muted-foreground">
              {post.data.pubDatetime.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          </div>
        </article>
      ))}
    </div>
  </section>
)}
