--- 
import { getCollection } from 'astro:content';
import BlogPostPreview from './BlogPostPreview.astro'; // Correct component name and path (same folder level usually)

const { post } = Astro.props;

const allPosts = await getCollection('blog');

// Find related posts: share at least one tag, exclude current, newest first, limit to 5
const related = allPosts
  .filter(p => p.id !== post.id)
  .filter(p => p.data.tags?.some(tag => post.data.tags?.includes(tag)))
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf())
  .slice(0, 5);
---

{related.length > 0 && (
  <section class="mt-12 border-t pt-8">
    <h2 class="text-2xl font-bold mb-6">Related Posts</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {related.map(relatedPost => (
        <BlogPostPreview post={relatedPost} />
      ))}
    </div>
  </section>
)}
