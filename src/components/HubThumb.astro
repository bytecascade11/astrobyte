---
// src/components/HubThumb.astro
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}
const { src, alt, width = 240, height = 144 } = Astro.props;

const optimizedSrc = `/_vercel/image?url=${encodeURIComponent(src)}&w=${width}&q=75`;
---
<img
  src={optimizedSrc}
  alt={alt}
  width={width}
  height={height}
  loading="lazy"
  class="hub-thumb"
/>
