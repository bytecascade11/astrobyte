---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div class="py-6 sm:py-8 px-4 max-w-4xl mx-auto">
    <!-- Social Icons -->
    <div class="flex justify-center mb-8">
      <Socials centered />
    </div>

    <!-- Custom Newsletter Subscription Form -->
    <section class="max-w-md mx-auto mb-12 text-center">
      <h3 class="text-lg font-semibold mb-2">Get new posts by email</h3>
      <p class="text-sm opacity-80 mb-6">Stay updated with the latest tech reviews, guides, and opinions — delivered straight to your inbox.</p>

      <form 
        action="https://api.follow.it/subscription-form/YOUR_FOLLOW_IT_ENDPOINT_HERE" 
        method="post" 
        target="_blank"
        class="flex flex-col sm:flex-row gap-3"
      >
        <!-- Replace YOUR_FOLLOW_IT_ENDPOINT_HERE with your actual follow.it form action URL -->
        <input
          type="email"
          name="email"
          placeholder="Enter your email"
          required
          class="flex-1 px-5 py-3 rounded-lg bg-background/80 border border-border focus:border-accent focus:outline-none transition-colors"
          aria-label="Email address"
        />
        <button
          type="submit"
          class="px-8 py-3 bg-accent text-foreground font-medium rounded-lg hover:bg-accent/90 transition shadow-md"
        >
          Subscribe
        </button>
      </form>

      <p class="text-xs opacity-60 mt-4">No spam ever. Unsubscribe anytime.</p>
    </section>

    <!-- Footer Navigation Links -->
    <nav class="text-center mb-8">
      <ul class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm text-gray-600 dark:text-gray-400">
        <li><a href="/about" class="hover:underline">About the Editor</a></li>
        <li><a href="/contact" class="hover:underline">Contact Us</a></li>
        <li><a href="/privacy-policy" class="hover:underline">Privacy Policy</a></li>
        <li><a href="/terms-and-conditions" class="hover:underline">Terms & Conditions</a></li>
        <li><a href="/disclaimer" class="hover:underline">Disclaimer</a></li>
        <li><a href="/sitemap" class="hover:underline">Sitemap</a></li>
      </ul>
    </nav>

    <!-- Copyright -->
    <div class="text-center text-sm text-gray-600 dark:text-gray-400">
      <span>Copyright © {currentYear} ReviByte</span>
      <span class="hidden sm:inline mx-2">|</span>
      <span>All rights reserved.</span>
    </div>
  </div>
</footer>
