---
import Socials from "./Socials.astro";
import IconRss from "@/assets/icons/IconRss.svg";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <div class="footer-wrapper">

    <!-- Top accent line -->
    <div class="footer-glow-line"></div>

    <div class="footer-inner">

      <!-- Brand + Tagline -->
      <div class="footer-brand">
        <div class="footer-logo-mark">RB</div>
        <div>
          <div class="footer-site-name">ReviByte</div>
          <div class="footer-tagline">Technology Opinions & Reviews</div>
        </div>
      </div>

      <!-- Divider -->
      <div class="footer-divider"></div>

      <!-- Email form script — deferred to prevent blocking -->
      <script defer src="https://eomail5.com/form/a0ff8318-6b29-11f1-985b-f32f81b6eef6.js" data-form="a0ff8318-6b29-11f1-985b-f32f81b6eef6"></script>
      <form
        action="https://api.follow.it/subscription-form/bWZOckxmelNNL2wyVVpERE50M0MxMWVhRC9ON2dBQnBKTEJzTlZJTGNIencrSFYrZVFpQ3FPY211M0dGVVJvZkxoWkcxUjd0TThLYmpMMnJuV1dMN3kzaC9uSkorZXlCYWdEZURrTmkxYW9aRGIxKzBJVW1pQXBVbDNBbGxjM098UDVxajlvNmc3NHYyc2ZJRFp4T1pDRncwNS9hMTBmajBaUlU0L1VrbW9XWT0=/8"
        method="post"
        target="_blank"
        class="footer-form"
      >
        <input
          type="email"
          name="email"
          placeholder="your@email.com"
          required
          class="footer-input"
          aria-label="Email address"
        />
        <button type="submit" class="footer-btn">
          <span>Subscribe</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </form>
      <p class="footer-disclaimer">No spam ever. Unsubscribe anytime.</p>

      <!-- Divider -->
      <div class="footer-divider"></div>

      <!-- Bottom Row -->
      <div class="footer-bottom">

        <!-- Socials + RSS -->
        <div class="footer-socials">
          <Socials centered />
          <a href="/rss.xml" aria-label="RSS Feed" title="RSS Feed" class="footer-rss">
            <IconRss class="h-5 w-5" />
          </a>
        </div>

        <!-- Divider -->
        <div class="footer-divider"></div>

        <!-- Links + Devices + Game Guides side by side -->
        <div class="footer-columns">
          <div class="footer-col">
            <div class="footer-col-label">Links</div>
            <nav class="footer-nav">
              <a href="/about">About the Editor</a>
              <a href="/work-with-us">Work With Us</a>
              <a href="/privacy-policy">Privacy Policy</a>
              <a href="/contact">Contact Us</a>
              <a href="/terms-and-conditions">Terms and Conditions</a>
              <a href="/disclaimer">Disclaimer</a>
              <a href="/sitemap">Sitemap</a>
            </nav>
          </div>

          <div class="footer-col">
            <div class="footer-col-label">Devices</div>
            <nav class="footer-nav">
              <a href="/tecno/">Tecno</a>
              <a href="/samsung/">Samsung</a>
              <a href="/xiaomi/">Xiaomi</a>
              <a href="/motorola/">Motorola</a>
              <a href="/huawei/">Huawei</a>
            </nav>
          </div>

          <div class="footer-col">
            <div class="footer-col-label">Game Guides</div>
            <nav class="footer-nav">
              <a href="/codm/">COD Mobile</a>
              <a href="/efootball/">eFootball</a>
              <a href="/pubgmobile/">PUBG Mobile</a>
              <a href="/mlbb/">Mobile Legends</a>
            </nav>
          </div>
        </div>

        <!-- Divider -->
        <div class="footer-divider"></div>

        <!-- Microsoft Store Badge -->
        <div class="footer-store">
          <a
            href="https://apps.microsoft.com/detail/9P24DH9BH6SH"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Download ReviByte on Microsoft Store"
            class="footer-store-badge"
          >
            <img
              src="https://get.microsoft.com/images/en-us%20dark.svg"
              alt="Get it from Microsoft"
              width="140"
              height="46"
            />
          </a>
        </div>

        <!-- Theme Promo Card -->
        <div class="footer-theme-card">
          <div class="footer-theme-badge">New</div>
          <h4 class="footer-theme-title">Download My Free Astro Theme</h4>
          <p class="footer-theme-desc">
            A modern, minimal Astro blog template built by iSamuel — solo contributor.
            Dark mode, PWA, SEO ready, live search and more. Fork it and make it yours.
          </p>
          <div class="footer-theme-actions">
            <a
              href="https://isamueldev.vercel.app"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-theme-demo"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              View Demo
            </a>
            <a
              href="https://github.com/bytecascade11/isamueldev"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-theme-repo"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              Fork on GitHub
            </a>
          </div>
        </div>

        <!-- Copyright -->
        <div class="footer-copy">
          <span class="footer-copy-dot">◈</span>
          Copyright © {currentYear} ReviByte — All rights reserved.
        </div>

      </div>
    </div>
  </div>
</footer>

<style>
  /* ── Wrapper — own black background, full-bleed edge to edge ── */
  /* full-bleed trick: breaks out of any parent max-width/padding container */
  .footer-wrapper {
    position: relative;
    background: #000;
    color: #fff;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  /* ── Accent top line ── */
  .footer-glow-line {
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0.9;
  }

  /* ── Inner container ── */
  .footer-inner {
    max-width: 56rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 1.75rem;
  }

  /* ── Brand ── */
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 1.75rem;
  }

  .footer-logo-mark {
    width: 40px;
    height: 40px;
    background: var(--color-accent);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
    color: white;
    letter-spacing: -0.5px;
    flex-shrink: 0;
  }

  .footer-site-name {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.3px;
    color: #fff;
  }

  .footer-tagline {
    font-size: 0.72rem;
    color: #fff;
    opacity: 0.5;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* ── Divider ── */
  .footer-divider {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.14);
    margin: 1.5rem 0;
  }

  /* ── Newsletter form ── */
  .footer-form {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    max-width: 28rem;
    margin: 0 auto;
  }

  @media (min-width: 480px) {
    .footer-form {
      flex-direction: row;
    }
  }

  .footer-input {
    flex: 1;
    padding: 0.65rem 1rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.05);
    font-size: 0.875rem;
    outline: none;
    color: #fff;
    transition: border-color 0.2s;
  }

  .footer-input:focus {
    border-color: var(--color-accent);
  }

  .footer-input::placeholder {
    opacity: 0.4;
    color: #fff;
  }

  .footer-btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.1rem;
    background: var(--color-accent);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
    white-space: nowrap;
  }

  .footer-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .footer-disclaimer {
    text-align: center;
    font-size: 0.68rem;
    color: #fff;
    opacity: 0.45;
    margin-top: 0.65rem;
  }

  /* ── Bottom row ── */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* ── Socials ── */
  .footer-socials {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .footer-rss {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    color: #fff;
    opacity: 0.6;
    transition: opacity 0.2s, color 0.2s;
  }

  .footer-rss:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  /* ── Links + Devices + Game Guides side-by-side columns (Punch-style) ── */
  .footer-columns {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 2.5rem;
    width: 100%;
    padding: 0.5rem 0 1rem;
    flex-wrap: wrap;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
    max-width: 12rem;
    min-width: 8rem;
  }

  .footer-col-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    opacity: 0.85;
    margin-bottom: 1rem;
  }

  @media (max-width: 480px) {
    .footer-columns {
      gap: 1.25rem;
      justify-content: flex-start;
    }
    .footer-col {
      max-width: none;
      min-width: 0;
      flex: 1 1 40%;
    }
    .footer-col-label {
      font-size: 0.58rem;
    }
  }

  /* ── Nav — plain bold list, used inside each column ── */
  .footer-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    width: 100%;
  }

  .footer-nav a {
    font-size: 0.95rem;
    font-weight: 500;
    color: #fff;
    opacity: 0.92;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 0.2s, opacity 0.2s;
  }

  .footer-nav a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  /* ── Microsoft Store Badge ── */
  .footer-store {
    display: flex;
    justify-content: center;
  }

  .footer-store-badge {
    display: inline-flex;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .footer-store-badge:hover {
    opacity: 1;
  }

  /* ── Theme promo card ── */
  .footer-theme-card {
    width: 100%;
    max-width: 26rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 1.1rem 1.25rem;
    text-align: center;
  }

  .footer-theme-badge {
    display: inline-block;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 2px 8px;
    border-radius: 999px;
    margin-bottom: 0.5rem;
    opacity: 0.9;
  }

  .footer-theme-title {
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: #fff;
    letter-spacing: -0.15px;
  }

  .footer-theme-desc {
    font-size: 0.75rem;
    color: #fff;
    opacity: 0.65;
    line-height: 1.6;
    margin-bottom: 0.85rem;
  }

  .footer-theme-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .footer-theme-demo {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.42rem 0.9rem;
    background: var(--color-accent);
    color: white;
    border-radius: 7px;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .footer-theme-demo:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .footer-theme-repo {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.42rem 0.9rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    border-radius: 7px;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    opacity: 0.8;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }

  .footer-theme-repo:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    opacity: 1;
    transform: translateY(-1px);
  }

  /* ── Copyright ── */
  .footer-copy {
    font-size: 0.7rem;
    color: #fff;
    opacity: 0.45;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    letter-spacing: 0.02em;
    padding-bottom: 0.5rem;
  }

  .footer-copy-dot {
    color: var(--color-accent);
    opacity: 0.7;
    font-size: 0.55rem;
  }
</style>
