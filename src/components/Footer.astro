---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import IconRss from "@/assets/icons/IconRss.svg";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <div class="footer-wrapper">

    <!-- Glowing top border -->
    <div class="footer-glow-line"></div>

    <div class="footer-inner">

      <!-- Brand + Tagline -->
      <div class="footer-brand">
        <div class="footer-logo-mark">RB</div>
        <div>
          <div class="footer-site-name">ReviByte</div>
          <div class="footer-tagline">Technology Opinions & Reviews</div>
        </div>
      </div>

      <!-- Divider -->
      <div class="footer-divider"></div>

      <!-- Newsletter -->
      <section class="footer-newsletter">
        <div class="footer-newsletter-label">
          <span class="footer-pill">Newsletter</span>
        </div>
        <h3 class="footer-newsletter-heading">Get new posts by email</h3>
        <p class="footer-newsletter-sub">
          Stay updated with the latest tech reviews, guides, and opinions — delivered straight to your inbox.
        </p>
        <form
          action="https://api.follow.it/subscription-form/bWZOckxmelNNL2wyVVpERE50M0MxMWVhRC9ON2dBQnBKTEJzTlZJTGNIencrSFYrZVFpQ3FPY211M0dGVVJvZkxoWkcxUjd0TThLYmpMMnJuV1dMN3kzaC9uSkorZXlCYWdEZURrTmkxYW9aRGIxKzBJVW1pQXBVbDNBbGxjM098UDVxajlvNmc3NHYyc2ZJRFp4T1pDRncwNS9hMTBmajBaUlU0L1VrbW9XWT0=/8"
          method="post"
          target="_blank"
          class="footer-form"
        >
          <input
            type="email"
            name="email"
            placeholder="your@email.com"
            required
            class="footer-input"
            aria-label="Email address"
          />
          <button type="submit" class="footer-btn">
            <span>Subscribe</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </form>
        <p class="footer-disclaimer">No spam ever. Unsubscribe anytime.</p>
      </section>

      <!-- Divider -->
      <div class="footer-divider"></div>

      <!-- Bottom Row -->
      <div class="footer-bottom">

        <!-- Socials + RSS -->
        <div class="footer-socials">
          <Socials centered />
          <a href="/rss.xml" aria-label="RSS Feed" title="RSS Feed" class="footer-rss">
            <IconRss class="h-5 w-5" />
          </a>
        </div>

        <!-- Nav Links -->
        <nav class="footer-nav">
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/privacy-policy">Privacy</a>
          <a href="/terms-and-conditions">Terms</a>
          <a href="/disclaimer">Disclaimer</a>
          <a href="/sitemap">Sitemap</a>
        </nav>

        <!-- Microsoft Store Badge + Theme Promo -->
        <div class="footer-store">
          <a
            href="https://apps.microsoft.com/detail/9P24DH9BH6SH"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Download ReviByte on Microsoft Store"
            class="footer-store-badge"
          >
            <img
              src="https://get.microsoft.com/images/en-us%20dark.svg"
              alt="Get it from Microsoft"
              width="160"
              height="52"
            />
          </a>
        </div>

        <!-- Theme Promo Card -->
        <div class="footer-theme-card">
          <div class="footer-theme-badge">New</div>
          <h4 class="footer-theme-title">Download My Free Astro Theme</h4>
          <p class="footer-theme-desc">
            A modern, minimal Astro blog template built by iSamuel — solo contributor. 
            Dark mode, PWA, SEO ready, live search and more. Fork it and make it yours.
          </p>
          <div class="footer-theme-actions">
            <a
              href="https://isamueldev.vercel.app"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-theme-demo"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              View Demo
            </a>
            <a
              href="https://github.com/bytecascade11/isamueldev"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-theme-repo"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              Fork on GitHub
            </a>
          </div>
        </div>

        <!-- Copyright -->
        <div class="footer-copy">
          <span class="footer-copy-dot">◈</span>
          Copyright © {currentYear} ReviByte — All rights reserved.
        </div>

      </div>

    </div>

    <!-- Bottom grid decoration -->
    <div class="footer-grid-bg" aria-hidden="true"></div>

  </div>
</footer>

<style>
/* Theme Promo Card */
  .footer-theme-card {
    width: 100%;
    max-width: 28rem;
    background: rgba(99, 102, 241, 0.05);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  [data-theme="dark"] .footer-theme-card {
    background: rgba(99, 102, 241, 0.08);
    border-color: rgba(99, 102, 241, 0.3);
  }

  .footer-theme-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, #6366f1, transparent);
    opacity: 0.6;
  }

  .footer-theme-badge {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6366f1;
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.3);
    padding: 2px 8px;
    border-radius: 999px;
    margin-bottom: 0.6rem;
  }

  .footer-theme-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: -0.2px;
  }

  .footer-theme-desc {
    font-size: 0.78rem;
    opacity: 0.6;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .footer-theme-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .footer-theme-demo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: linear-gradient(135deg, #6366f1, #818cf8);
    color: white;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
  }

  .footer-theme-demo:hover {
    opacity: 0.9;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(99, 102, 241, 0.4);
  }

  .footer-theme-repo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid rgba(99, 102, 241, 0.3);
    color: #6366f1;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .footer-theme-repo:hover {
    background: rgba(99, 102, 241, 0.1);
    border-color: #6366f1;
    transform: translateY(-1px);
  }
  .footer-wrapper {
    position: relative;
    background: linear-gradient(180deg, transparent 0%, rgba(15, 23, 42, 0.06) 100%);
    overflow: hidden;
  }

  [data-theme="dark"] .footer-wrapper {
    background: linear-gradient(180deg, transparent 0%, rgba(15, 23, 42, 0.8) 100%);
  }

  /* Glowing top line */
  .footer-glow-line {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, #6366f1 30%, #818cf8 50%, #6366f1 70%, transparent 100%);
    opacity: 0.6;
  }

  [data-theme="dark"] .footer-glow-line {
    opacity: 1;
    box-shadow: 0 0 20px rgba(99, 102, 241, 0.5);
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    max-width: 56rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
  }

  /* Brand */
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .footer-logo-mark {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #6366f1, #818cf8);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 800;
    color: white;
    letter-spacing: -0.5px;
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.3);
    flex-shrink: 0;
  }

  .footer-site-name {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.3px;
    color: var(--color-text-base, #0f172a);
  }

  [data-theme="dark"] .footer-site-name {
    color: #f1f5f9;
  }

  .footer-tagline {
    font-size: 0.75rem;
    opacity: 0.5;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* Divider */
  .footer-divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(99,102,241,0.2), transparent);
    margin: 1.5rem 0;
  }

  /* Newsletter */
  .footer-newsletter {
    text-align: center;
    padding: 1rem 0;
  }

  .footer-newsletter-label {
    margin-bottom: 0.75rem;
  }

  .footer-pill {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6366f1;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.25);
    padding: 3px 10px;
    border-radius: 999px;
  }

  .footer-newsletter-heading {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: -0.3px;
  }

  .footer-newsletter-sub {
    font-size: 0.875rem;
    opacity: 0.6;
    margin-bottom: 1.25rem;
    max-width: 32rem;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .footer-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 28rem;
    margin: 0 auto;
  }

  @media (min-width: 480px) {
    .footer-form {
      flex-direction: row;
    }
  }

  .footer-input {
    flex: 1;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    border: 1px solid rgba(99, 102, 241, 0.2);
    background: rgba(99, 102, 241, 0.04);
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    color: inherit;
  }

  .footer-input:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
  }

  .footer-input::placeholder {
    opacity: 0.4;
  }

  .footer-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: linear-gradient(135deg, #6366f1, #818cf8);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
    white-space: nowrap;
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
  }

  .footer-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.45);
  }

  .footer-disclaimer {
    font-size: 0.7rem;
    opacity: 0.4;
    margin-top: 0.75rem;
  }

  /* Bottom row */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-rss {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid rgba(99, 102, 241, 0.2);
    color: #6366f1;
    transition: background 0.2s, border-color 0.2s;
  }

  .footer-rss:hover {
    background: rgba(99, 102, 241, 0.1);
    border-color: #6366f1;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.1rem;
  }

  .footer-nav a {
    font-size: 0.75rem;
    opacity: 0.55;
    padding: 4px 10px;
    border-radius: 6px;
    text-decoration: none;
    transition: opacity 0.2s, background 0.2s;
    letter-spacing: 0.01em;
  }

  .footer-nav a:hover {
    opacity: 1;
    background: rgba(99, 102, 241, 0.08);
    color: #6366f1;
  }

  /* Microsoft Store Badge */
  .footer-store {
    display: flex;
    justify-content: center;
  }

  .footer-store-badge {
    display: inline-flex;
    opacity: 0.85;
    transition: opacity 0.2s;
  }

  .footer-store-badge:hover {
    opacity: 1;
  }

  .footer-copy {
    font-size: 0.72rem;
    opacity: 0.4;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    letter-spacing: 0.02em;
  }

  .footer-copy-dot {
    color: #6366f1;
    opacity: 1;
    font-size: 0.6rem;
  }

  /* Grid background decoration */
  .footer-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(99,102,241,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99,102,241,0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.3) 50%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.3) 50%, transparent 100%);
  }
.footer-theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #6366f1;
    text-decoration: none;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .footer-theme-btn:hover {
    background: rgba(99, 102, 241, 0.15);
    border-color: #6366f1;
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.2);
  }
</style>
