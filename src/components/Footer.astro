---
import Socials from "./Socials.astro";
import IconRss from "@/assets/icons/IconRss.svg";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <div class="footer-wrapper">

    <!-- Top accent line -->
    <div class="footer-glow-line"></div>

    <div class="footer-inner">

      <!-- Brand + Tagline -->
      <div class="footer-brand">
        <div class="footer-logo-mark">RB</div>
        <div>
          <div class="footer-site-name">ReviByte</div>
          <div class="footer-tagline">Technology Opinions & Reviews</div>
        </div>
      </div>

      <!-- Divider -->
      <div class="footer-divider"></div>

      <!-- Newsletter -->
      <section class="footer-newsletter">
        <div class="footer-newsletter-label">
          <span class="footer-pill">Newsletter</span>
        </div>
        <h3 class="footer-newsletter-heading">Get new posts by email</h3>
        <p class="footer-newsletter-sub">
          Stay updated with the latest tech reviews, guides, and opinions — delivered straight to your inbox.
        </p>
        <div class="footer-form">
  <script async src="https://eomail5.com/form/a0ff8318-6b29-11f1-985b-f32f81b6eef6.js" data-form="a0ff8318-6b29-11f1-985b-f32f81b6eef6"></script>
</div>
        <p class="footer-disclaimer">No spam ever. Unsubscribe anytime.</p>
      </section>

      <!-- Divider -->
      <div class="footer-divider"></div>

      <!-- Bottom Row -->
      <div class="footer-bottom">

        <!-- Socials + RSS -->
        <div class="footer-socials">
          <Socials centered />
          <a href="/rss.xml" aria-label="RSS Feed" title="RSS Feed" class="footer-rss">
            <IconRss class="h-5 w-5" />
          </a>
        </div>

        <!-- Divider -->
        <div class="footer-divider"></div>

        <!-- Nav Links — bold vertical list -->
        <nav class="footer-nav">
  <a href="/about">About the Editor</a>
  <a href="/privacy-policy">Privacy Policy</a>
  <a href="/contact">Contact Us</a>
  <a href="/terms-and-conditions">Terms and Conditions</a>
  <a href="/disclaimer">Disclaimer</a>
  <a href="/sitemap">Sitemap</a>
</nav>

<div class="footer-divider"></div>

<div class="footer-hubs">
  <div class="footer-hubs-label">Game Guides</div>
  <div class="footer-hubs-links">
    <a href="/codm/">COD Mobile</a>
    <a href="/efootball/">eFootball</a>
    <a href="/pubgmobile/">PUBG Mobile</a>
    <a href="/mlbb/">Mobile Legends</a>
  </div>
</div>

        <!-- Divider -->
        <div class="footer-divider"></div>

        <!-- Microsoft Store Badge -->
        <div class="footer-store">
          <a
            href="https://apps.microsoft.com/detail/9P24DH9BH6SH"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Download ReviByte on Microsoft Store"
            class="footer-store-badge"
          >
            <img
              src="https://get.microsoft.com/images/en-us%20dark.svg"
              alt="Get it from Microsoft"
              width="140"
              height="46"
            />
          </a>
        </div>

        <!-- Theme Promo Card -->
        <div class="footer-theme-card">
          <div class="footer-theme-badge">New</div>
          <h4 class="footer-theme-title">Download My Free Astro Theme</h4>
          <p class="footer-theme-desc">
            A modern, minimal Astro blog template built by iSamuel — solo contributor.
            Dark mode, PWA, SEO ready, live search and more. Fork it and make it yours.
          </p>
          <div class="footer-theme-actions">
            <a
              href="https://isamueldev.vercel.app"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-theme-demo"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              View Demo
            </a>
            <a
              href="https://github.com/bytecascade11/isamueldev"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-theme-repo"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              Fork on GitHub
            </a>
          </div>
        </div>

        <!-- Copyright -->
        <div class="footer-copy">
          <span class="footer-copy-dot">◈</span>
          Copyright © {currentYear} ReviByte — All rights reserved.
        </div>

      </div>
    </div>
  </div>
</footer>

<style>
/* ── Game Hubs ── */
  .footer-hubs {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .footer-hubs-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    opacity: 0.75;
    margin-bottom: 0.65rem;
  }

  .footer-hubs-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1rem;
  }

  .footer-hubs-links a {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-foreground);
    text-decoration: none;
    opacity: 0.7;
    transition: color 0.2s, opacity 0.2s;
  }

  .footer-hubs-links a:hover {
    color: var(--color-accent);
    opacity: 1;
  }
  /* ── Wrapper ── */
  .footer-wrapper {
    position: relative;
    border-top: 1px solid var(--color-border);
    background: var(--color-card, transparent);
  }

  /* ── Accent top line ── */
  .footer-glow-line {
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0.5;
  }

  /* ── Inner container ── */
  .footer-inner {
    max-width: 56rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 1.75rem;
  }

  /* ── Brand ── */
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 1.75rem;
  }

  .footer-logo-mark {
    width: 40px;
    height: 40px;
    background: var(--color-accent);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
    color: white;
    letter-spacing: -0.5px;
    flex-shrink: 0;
  }

  .footer-site-name {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.3px;
    color: var(--color-foreground);
  }

  .footer-tagline {
    font-size: 0.72rem;
    color: var(--color-foreground);
    opacity: 0.45;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* ── Divider ── */
  .footer-divider {
    width: 100%;
    height: 1px;
    background: var(--color-border);
    margin: 1.5rem 0;
  }

  /* ── Newsletter ── */
  .footer-newsletter {
    text-align: center;
    padding: 0.5rem 0;
  }

  .footer-newsletter-label {
    margin-bottom: 0.65rem;
  }

  .footer-pill {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: transparent;
    border: 1px solid var(--color-accent);
    padding: 2px 10px;
    border-radius: 999px;
    opacity: 0.75;
  }

  .footer-newsletter-heading {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: var(--color-foreground);
    letter-spacing: -0.2px;
  }

  .footer-newsletter-sub {
    font-size: 0.85rem;
    color: var(--color-foreground);
    opacity: 0.6;
    margin-bottom: 1.1rem;
    max-width: 32rem;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .footer-form {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    max-width: 28rem;
    margin: 0 auto;
  }

  @media (min-width: 480px) {
    .footer-form {
      flex-direction: row;
    }
  }

  .footer-input {
    flex: 1;
    padding: 0.65rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: transparent;
    font-size: 0.875rem;
    outline: none;
    color: var(--color-foreground);
    transition: border-color 0.2s;
  }

  .footer-input:focus {
    border-color: var(--color-accent);
  }

  .footer-input::placeholder {
    opacity: 0.35;
    color: var(--color-foreground);
  }

  .footer-btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.1rem;
    background: var(--color-accent);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
    white-space: nowrap;
  }

  .footer-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .footer-disclaimer {
    font-size: 0.68rem;
    color: var(--color-foreground);
    opacity: 0.4;
    margin-top: 0.65rem;
  }

  /* ── Bottom row ── */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* ── Socials ── */
  .footer-socials {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .footer-rss {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    color: var(--color-foreground);
    opacity: 0.5;
    transition: opacity 0.2s, color 0.2s;
  }

  .footer-rss:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  /* ── Nav — bold vertical list ── */
  .footer-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.5rem;
  }

  .footer-nav a {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-foreground);
    opacity: 1;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: var(--color-accent);
  }

  /* ── Microsoft Store Badge ── */
  .footer-store {
    display: flex;
    justify-content: center;
  }

  .footer-store-badge {
    display: inline-flex;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .footer-store-badge:hover {
    opacity: 1;
  }

  /* ── Theme promo card ── */
  .footer-theme-card {
    width: 100%;
    max-width: 26rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.1rem 1.25rem;
    text-align: center;
  }

  .footer-theme-badge {
    display: inline-block;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    padding: 2px 8px;
    border-radius: 999px;
    margin-bottom: 0.5rem;
    opacity: 0.8;
  }

  .footer-theme-title {
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: var(--color-foreground);
    letter-spacing: -0.15px;
  }

  .footer-theme-desc {
    font-size: 0.75rem;
    color: var(--color-foreground);
    opacity: 0.6;
    line-height: 1.6;
    margin-bottom: 0.85rem;
  }

  .footer-theme-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .footer-theme-demo {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.42rem 0.9rem;
    background: var(--color-accent);
    color: white;
    border-radius: 7px;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .footer-theme-demo:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .footer-theme-repo {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.42rem 0.9rem;
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-foreground);
    border-radius: 7px;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    opacity: 0.75;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }

  .footer-theme-repo:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    opacity: 1;
    transform: translateY(-1px);
  }

  /* ── Copyright ── */
  .footer-copy {
    font-size: 0.7rem;
    color: var(--color-foreground);
    opacity: 0.4;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    letter-spacing: 0.02em;
    padding-bottom: 0.5rem;
  }

  .footer-copy-dot {
    color: var(--color-accent);
    opacity: 0.7;
    font-size: 0.55rem;
  }
</style>
