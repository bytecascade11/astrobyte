---
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
}

const {
  src,
  alt,
  width = 800,
  height = 450,
  class: className,
  loading = "lazy",
  fetchpriority,
  sizes = "(min-width: 768px) 768px, 100vw",
} = Astro.props;

const isRemote = src.startsWith("http");

const buildUrl = (w: number) =>
  `/_vercel/image?url=${encodeURIComponent(src)}&w=${w}&q=75`;

// Candidate widths capped at 2x the requested width, deduped + sorted
const BREAKPOINTS = [400, 640, 750, 828, 1080, 1200, 1920];
const candidateWidths = isRemote
  ? []
  : [...new Set([...BREAKPOINTS.filter((w) => w <= width * 2), width])].sort(
      (a, b) => a - b
    );

const optimizedSrc = isRemote ? src : buildUrl(width);

const srcset = isRemote
  ? undefined
  : candidateWidths.map((w) => `${buildUrl(w)} ${w}w`).join(", ");
---

<img
  src={optimizedSrc}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
/>
