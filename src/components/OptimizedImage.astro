---
import imageManifest from '@/data/image-manifest.json';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
  class?: string;
  sizes?: string;
}

const { 
  src, 
  alt, 
  width = 800, 
  height = 450, 
  loading = 'lazy',
  class: className = '',
  sizes = '(max-width: 800px) 100vw, 800px'
} = Astro.props;

// Normalize src to manifest key
const normalize = (s: string) => s
  .replace(/^@\/assets\//, '')
  .replace(/^\/images\//, '')
  .replace(/^\/assets\//, '')
  .replace(/^\//, '');

const key = normalize(src);
const entry = imageManifest[key];
const webp = entry?.optimized;

const fallback = src.startsWith('@/') ? src.replace('@/', '/src/') : src;
---

{webp ? (
  <img 
    src={webp[800] || webp[480] || fallback}
    srcset={`${webp[480]} 480w, ${webp[800]} 800w, ${webp[1200]} 1200w`}
    sizes={sizes}
    loading={loading}
    alt={alt}
    width={width}
    height={height}
    class={className}
    decoding="async"
  />
) : (
  <img 
    src={fallback} 
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    class={className}
    decoding="async"
  />
)}
