---
import { slugifyStr } from "@/utils/slugify";
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

export interface Props extends CollectionEntry<"blog"> {
  variant?: "h2" | "h3";
}

const { variant = "h2", data, id, filePath } = Astro.props;

const { title, description, pubDatetime, modDatetime, timezone, tags = [], coverImage } = data;

const postPath = getPath(id, filePath);

const headerProps = {
  style: { viewTransitionName: slugifyStr(title) },
  class: "card-title",
};
---

<li class="card-wrapper">
  <a href={postPath} class="card-link" tabindex="-1" aria-hidden="true">
    {coverImage && (
      <div class="card-image-wrap">
        <img
          src={coverImage}
          alt={title}
          class="card-image"
          loading="lazy"
        />
        <div class="card-image-overlay"></div>
      </div>
    )}
  </a>

  <div class="card-body">
    <!-- Top row: date + tag -->
    <div class="card-meta">
      <Datetime {pubDatetime} {modDatetime} {timezone} />
      {tags[0] && (
        <span class="card-tag">{tags[0]}</span>
      )}
    </div>

    <!-- Title -->
    <a href={postPath} class="card-title-link">
      {variant === "h2" ? (
        <h2 {...headerProps}>{title}</h2>
      ) : (
        <h3 {...headerProps}>{title}</h3>
      )}
    </a>

    <!-- Description -->
    <p class="card-desc">{description}</p>

    <!-- Read more -->
    <a href={postPath} class="card-read-more">
      <span>Read more</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>

  <!-- Glow border effect on hover -->
  <div class="card-glow" aria-hidden="true"></div>
</li>

<style>
  .card-wrapper {
    position: relative;
    list-style: none;
    margin: 1.25rem 0;
    border-radius: 16px;
    border: 1px solid rgba(99, 102, 241, 0.1);
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(8px);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  [data-theme="dark"] .card-wrapper {
    background: rgba(15, 23, 42, 0.6);
    border-color: rgba(99, 102, 241, 0.15);
  }

  .card-wrapper:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(99, 102, 241, 0.15);
    border-color: rgba(99, 102, 241, 0.35);
  }

  [data-theme="dark"] .card-wrapper:hover {
    box-shadow: 0 12px 40px rgba(99, 102, 241, 0.25);
  }

  /* Cover image */
  .card-link {
    display: block;
    text-decoration: none;
  }

  .card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card-wrapper:hover .card-image {
    transform: scale(1.03);
  }

  .card-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(15,23,42,0.4) 100%);
  }

  /* Body */
  .card-body {
    padding: 1.1rem 1.25rem 1.25rem;
  }

  /* Meta row */
  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }

  .card-tag {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6366f1;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.2);
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }

  /* Title */
  .card-title-link {
    text-decoration: none;
    display: block;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.2px;
    color: var(--color-text-base, #0f172a);
    margin-bottom: 0.5rem;
    transition: color 0.2s;
  }

  [data-theme="dark"] .card-title {
    color: #f1f5f9;
  }

  .card-wrapper:hover .card-title {
    color: #6366f1;
  }

  /* Description */
  .card-desc {
    font-size: 0.85rem;
    line-height: 1.65;
    opacity: 0.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Read more */
  .card-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #6366f1;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: gap 0.2s ease;
  }

  .card-read-more:hover {
    gap: 0.65rem;
  }

  /* Glow effect */
  .card-glow {
    position: absolute;
    inset: -1px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(99,102,241,0.15), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .card-wrapper:hover .card-glow {
    opacity: 1;
  }
</style>
