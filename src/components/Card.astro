---
// src/components/Card.astro
import type { CollectionEntry } from "astro:content";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";
import HubThumb from "./HubThumb.astro";

interface Props {
  id: string;
  data: CollectionEntry<"blog">["data"];
  hubPath?: string;
}

const { id, data, hubPath = "posts" } = Astro.props;
const href = `/${hubPath}/${id}/`;
---

<li class="my-6">
  <a href={href} class="inline-block text-lg font-medium text-skin-base decoration-dashed hover:text-skin-accent hover:underline">
    <div class="flex gap-4">
      {data.coverImage && (
        <HubThumb
          src={data.coverImage}
          alt={data.coverImageAlt ?? data.title}
          width={160}
          height={100}
        />
      )}
      <div class="min-w-0 flex-1">
        <h2 class="text-lg font-medium decoration-dashed line-clamp-2">
          {data.title}
        </h2>
      </div>
    </div>
  </a>
  {data.description && (
    <p class="mt-1 line-clamp-2 opacity-80">{data.description}</p>
  )}
  <Datetime
    pubDatetime={data.pubDatetime}
    modDatetime={data.modDatetime}
    timezone={data.timezone}
    size="sm"
    class="my-1"
  />
  {data.tags && data.tags.length > 0 && (
    <ul class="flex flex-wrap gap-1">
      {data.tags.slice(0, 3).map(tag => <Tag tag={tag} tagName={tag} size="sm" />)}
    </ul>
  )}
</li>
