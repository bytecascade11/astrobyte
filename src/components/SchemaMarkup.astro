---
/**
 * SchemaMarkup Component
 * 
 * This component adds structured data (Schema.org JSON-LD) to your pages.
 * It helps Google understand your site structure and display rich results like:
 * - Sitelinks (navigation links under your site in search)
 * - Search box in search results
 * - Article metadata (author, publish date)
 * - Breadcrumbs in search results
 * 
 * Usage:
 * - Homepage: <SchemaMarkup /> (defaults to website schema)
 * - Blog posts: <SchemaMarkup title="..." breadcrumbs={[...]} datePublished={post.date} />
 */

import { SITE } from "@/config";

interface Props {
  type?: 'website' | 'article' | 'breadcrumb';
  title?: string;
  description?: string;
  url?: string;
  image?: string;
  datePublished?: Date;
  dateModified?: Date | null;
  breadcrumbs?: Array<{name: string, url: string}>;
}

const { 
  type = 'website',
  title,
  description,
  url,
  image,
  datePublished,
  dateModified,
  breadcrumbs 
} = Astro.props;

/* WEBSITE SCHEMA */
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE.title,
  "url": SITE.website,
  "description": SITE.desc,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${SITE.website}search/?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};

/* ORGANIZATION SCHEMA */
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "ReviByte",
  "url": SITE.website,
  "logo": `\( {SITE.website} \){SITE.ogImage}`,
  "sameAs": [
    SITE.profile
  ]
};

/* ARTICLE SCHEMA – safe date handling */
const articleSchema = title ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description || SITE.desc,
  "image": image || `\( {SITE.website} \){SITE.ogImage}`,
  "url": url || SITE.website,
  ...(datePublished instanceof Date && {
    datePublished: datePublished.toISOString()
  }),
  ...(dateModified instanceof Date 
    ? { dateModified: dateModified.toISOString() }
    : (datePublished instanceof Date && { dateModified: datePublished.toISOString() })
  ),
  "author": {
    "@type": "Person",
    "name": SITE.author,
    "url": SITE.profile
  },
  "publisher": {
    "@type": "Organization",
    "name": "ReviByte",
    "logo": {
      "@type": "ImageObject",
      "url": `\( {SITE.website} \){SITE.ogImage}`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": url || SITE.website
  }
} : null;

/* BREADCRUMB SCHEMA */
const breadcrumbSchema = breadcrumbs ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, index) => {
    const isLastItem = index === breadcrumbs.length - 1;
    
    const item: any = {
      "@type": "ListItem",
      "position": index + 1,
      "name": crumb.name
    };
    
    if (!isLastItem) {
      item.item = crumb.url;
    }
    
    return item;
  })
} : null;
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

{articleSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}

{breadcrumbSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
