---
// src/components/InstallBanner.astro
---
<div id="install-banner" class="install-banner" hidden>
  <span class="install-banner__text">Get the ReviByte app — faster access, offline reading</span>
  <div class="install-banner__actions">
    <button id="install-banner__download" class="install-banner__download">Download</button>
    <button id="install-banner__close" class="install-banner__close" aria-label="Close">✕</button>
  </div>
</div>

<style>
  .install-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.9rem;
    background: #0f5da8;
    color: #fff;
    font-size: 0.85rem;
  }
  .install-banner[hidden] { display: none; }
  .install-banner__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .install-banner__download {
    background: #fff;
    color: #0f5da8;
    border: none;
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    font-weight: 600;
    font-size: 0.8rem;
  }
  .install-banner__close {
    background: transparent;
    border: none;
    color: #fff;
    font-size: 1rem;
    line-height: 1;
    padding: 0.2rem 0.3rem;
  }
</style>
<script>
  const INSTALLED_KEY = 'pwaInstalled';

  let deferredPrompt: any = null;
  const banner = document.getElementById('install-banner') as HTMLElement;
  const downloadBtn = document.getElementById('install-banner__download') as HTMLButtonElement;
  const closeBtn = document.getElementById('install-banner__close') as HTMLButtonElement;

  function isStandalone() {
    return window.matchMedia('(display-mode: standalone)').matches
      || (navigator as any).standalone === true;
  }

  function isInstalled() {
    return isStandalone() || localStorage.getItem(INSTALLED_KEY) === 'true';
  }

  // If already installed (e.g. opened in standalone mode), lock it in
  // so future checks don't depend on display-mode alone.
  if (isStandalone()) {
    localStorage.setItem(INSTALLED_KEY, 'true');
  }

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    if (!isInstalled()) {
      banner.hidden = false;
    }
  });

  downloadBtn?.addEventListener('click', async () => {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    const { outcome } = await deferredPrompt.userChoice;
    deferredPrompt = null;
    banner.hidden = true;
    if (outcome === 'accepted') {
      localStorage.setItem(INSTALLED_KEY, 'true');
    }
    // if 'dismissed' from the native prompt, don't store anything —
    // banner can come back on next reload
  });

  closeBtn?.addEventListener('click', () => {
    banner.hidden = true;
    // no localStorage write here — this is what makes it reappear on reload
  });

  window.addEventListener('appinstalled', () => {
    banner.hidden = true;
    localStorage.setItem(INSTALLED_KEY, 'true');
  });
</script>
