---
import { SITE } from "@/config";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import HeliaraAI from '../components/HeliaraAI.astro';
import OptimizedCoverImage from '@/components/OptimizedCoverImage.astro';
import Sidebar from "@/components/Sidebar.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";
import GoogleSubscribe from '../components/GoogleSubscribe.astro';
import InstallBanner from '../components/InstallBanner.astro';
const { PUBLIC_GOOGLE_SITE_VERIFICATION } = import.meta.env;

type Props = {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  coverImage?: string;
  coverImageAlt?: string;
  review?: {
    productName: string;
    brand: string;
    ratingValue: number;
    bestRating?: number;
  };
};

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.desc,
  ogImage = "/og.png",
  canonicalURL: propCanonical,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  coverImage,
  coverImageAlt = "",
  review,
} = Astro.props;

const siteBase = SITE.website || "https://www.revibyte.blog/";

let canonicalURL = new URL(Astro.url.pathname, siteBase);
if (canonicalURL.pathname.endsWith("/index.html")) {
  canonicalURL.pathname = canonicalURL.pathname.replace("/index.html", "/");
}
let canonical = canonicalURL.toString();
if (propCanonical) {
  canonical = new URL(propCanonical, siteBase).toString();
}

const socialImageURL = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, siteBase).toString();

const ogType = pubDatetime ? "article" : "website";

// Declared BEFORE schemaType, which depends on isHomepage.
const currentPath = Astro.url.pathname;
const isHomepage = currentPath === "/";

// Tells SchemaMarkup which schemas to emit:
//   homepage            -> WebSite (+ Organization)
//   post (has pubDate)  -> BlogPosting (+ Organization)
//   anything else       -> Organization only
const schemaType = isHomepage ? "website" : pubDatetime ? "article" : "page";

// SoftwareApplication schema is for the homepage ONLY (Microsoft Store PWA listing).
// Removed aggregateRating: a self-reported 5.0 from 1 rating is self-serving review
// markup and a spam-policy risk. Add it back only with real, verifiable ratings.
const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ReviByte",
  operatingSystem: "Windows",
  applicationCategory: "NewsApplication",
  url: "https://apps.microsoft.com/detail/9p24dh9bh6sh",
  author: {
    "@type": "Person",
    name: "Oke Sunday Samuel",
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<!doctype html>
<html dir={SITE.dir} lang={SITE.lang ?? "en"} class={scrollSmooth ? "scroll-smooth" : undefined}>
  <head>

    <meta charset="UTF-8" />

    <!-- box-sizing reset — must be first to prevent flash -->
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html, body { width: 100%; max-width: 100%; margin: 0; padding: 0; overflow-x: hidden; }
    </style>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ReviByte" />

    <!-- Preconnect to Google Fonts (if you use them) and other third-parties -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- REMOVED: coverImage preload from here.
         It was preloading the RAW image while OptimizedCoverImage serves a
         Vercel-optimized URL, causing a double-download. Pages that need LCP
         preloading (like CODM guides) should handle it in their own file. -->

    <!-- Theme Handling — critical, must stay blocking to prevent flash -->
    <script is:inline>
      const primaryColorScheme = "";
      function getPreferTheme() {
        const currentTheme = localStorage.getItem("theme");
        if (currentTheme) return currentTheme;
        if (primaryColorScheme) return primaryColorScheme;
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      let themeValue = getPreferTheme();
      function setPreference() { localStorage.setItem("theme", themeValue); reflectPreference(); }
      function reflectPreference() {
        document.documentElement.setAttribute("data-theme", themeValue);
      }
      function togglePWATheme() { themeValue = themeValue === 'dark' ? 'light' : 'dark'; setPreference(); }
      reflectPreference();
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", ({ matches }) => {
        themeValue = matches ? "dark" : "light";
        setPreference();
      });
    </script>

    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content="ReviByte" />
    <meta property="og:locale" content="en_US" />

    {pubDatetime instanceof Date && (
      <meta property="article:published_time" content={pubDatetime.toISOString()} />
    )}
    {modDatetime instanceof Date && (
      <meta property="article:modified_time" content={modDatetime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Structured data. `type` controls which schemas SchemaMarkup emits.
         The `author` prop was removed: SchemaMarkup uses SITE.author internally. -->
    <SchemaMarkup
      type={schemaType}
      title={title}
      description={description}
      url={canonical}
      image={socialImageURL}
      datePublished={pubDatetime}
      dateModified={modDatetime}
      review={review}
    />

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${siteBase}rss.xml`} />

    {PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}

    {SITE.analytics?.googleAnalyticsId && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics.googleAnalyticsId}`}></script>
    )}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>

    <!-- SoftwareApplication schema: HOMEPAGE ONLY -->
    {isHomepage && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(softwareAppSchema)}
      />
    )}

    <!-- REMOVED: Microsoft Clarity from here — it was render-blocking LCP.
         It has been moved to the idle-loaded script group below. -->

    <!-- Newor Media (Waldo) header script — placed in <head> as their dashboard instructs -->
    <script is:inline async type="text/javascript" src="//cdn.thisiswaldo.com/static/js/55542.js"></script>

  </head>

  <body>
     <InstallBanner />
     <HeliaraAI />
     <GoogleSubscribe />
     <slot name="header" />
     <slot name="top-nav" />

    
    {coverImage && (
      <div class="cover-ad-wrapper">
        <!-- Newor Media: TOP, above the cover image (script is in <head>) -->
          <script async type="text/javascript" src="//cdn.thisiswaldo.com/static/js/55542.js"></script>

        </div>

        <!-- Cover Image -->
        <OptimizedCoverImage
          src={coverImage}
          alt={coverImageAlt || title}
          width={1200}
          height={630}
          loading="eager"
          sizes="100vw"
        />

        <!-- Adsterra: BOTTOM of cover image (script loads idle-triggered below) -->
        <div class="ad-slot ad-slot--bottom">
          <div id="container-100c0408033e7aba877563ba9293a45d"></div>
        </div>

      </div>
    )}

    <slot />

    <!-- ================= IDLE-LOADED SCRIPTS (After LCP / content) ================= -->

    {SITE.analytics?.googleAnalyticsId && (
      <script is:inline define:vars={{ gaId: SITE.analytics.googleAnalyticsId }}>
        gtag('config', gaId);
      </script>
    )}

    <script is:inline>
      (function () {
        let loaded = false;

        function loadDeferredAds() {
          if (loaded) return;
          loaded = true;

          // AdSense
          var ads = document.createElement('script');
          ads.async = true;
          ads.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4896561037705299";
          ads.crossOrigin = "anonymous";
          ads.onload = function () {
            try {
              (window.adsbygoogle = window.adsbygoogle || []).push({});
            } catch (e) { /* no unfilled AdSense slot on this page */ }
          };
          document.body.appendChild(ads);

          // Adsterra
          var adsterra = document.createElement('script');
          adsterra.async = true;
          adsterra.setAttribute('data-cfasync', 'false');
          adsterra.src = "https://pl28410703.effectivecpmnetwork.com/100c0408033e7aba877563ba9293a45d/invoke.js";
          document.body.appendChild(adsterra);

        }

        window.addEventListener('scroll', loadDeferredAds, { once: true, passive: true });
        window.addEventListener('touchstart', loadDeferredAds, { once: true, passive: true });
        setTimeout(loadDeferredAds, 5000);
      })();
    </script>

    <!-- OneSignal -->
    <script is:inline>
      (function() {
        function loadOneSignal() {
          if (window.__oneSignalLoaded) return;
          window.__oneSignalLoaded = true;
          var s = document.createElement('script');
          s.src = 'https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js';
          s.defer = true;
          s.onload = function() {
            window.OneSignalDeferred = window.OneSignalDeferred || [];
            OneSignalDeferred.push(async function (OneSignal) {
              try {
                await OneSignal.init({
                  appId: "bbd38552-99d1-4cda-96f9-5c0cacfba192",
                  notifyButton: { enable: false },
                  allowLocalhostAsSecureOrigin: true,
                  autoResubscribe: true,
                  promptOptions: {
                    slidedown: {
                      prompts: [{
                        type: "push",
                        autoPrompt: true,
                        text: {
                          actionMessage: "⚡ Stay Ahead in Tech",
                          acceptButtonText: "Allow 🔔",
                          cancelButtonText: "Not Now",
                          confirmMessage: "Hit Allow to get instant updates on new posts, phone comparisons, and buying guides that actually help."
                        },
                        // Was 3s. Delayed so new visitors (esp. from Discover) can read first.
                        delay: { pageViews: 0, timeDelay: 20 }
                      }]
                    }
                  }
                });
              } catch (e) { console.error("OneSignal init error:", e); }
            });
          };
          document.body.appendChild(s);
        }
        window.addEventListener('scroll', loadOneSignal, { once: true, passive: true });
        setTimeout(loadOneSignal, 5000);
      })();
    </script>

    <!-- PWA Analytics Event -->
    <script is:inline>
      window.addEventListener('load', function() {
        setTimeout(function() {
          if (window.matchMedia('(display-mode: standalone)').matches) {
            if (typeof gtag !== 'undefined') {
              gtag('event', 'pwa_visit', { 'event_category': 'PWA', 'event_label': 'standalone_mode' });
            }
          }
        }, 2000);
      });
    </script>

    <Footer />
    <!-- SIDEBAR — rendered LAST so it's on top of everything -->
    <Sidebar />

    <style>
      .cover-ad-wrapper {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 100%;
      }

      .ad-slot {
        display: block;
        width: 100%;
        max-width: 768px;
        margin-left: auto;
        margin-right: auto;
        contain: layout;
      }

      .ad-slot--bottom {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
        min-height: 250px;
      }

      .ad-slot--newor {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
        min-height: 250px;
      }

      .cover-ad-wrapper :global(img),
      .cover-ad-wrapper :global(picture) {
        display: block;
        width: 100%;
        height: auto;
        margin: 0;
      }
    </style>
  </body>
</html>
