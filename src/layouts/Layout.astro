---
import { SITE } from "@/config";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import HeliaraAI from '../components/HeliaraAI.astro';
import "@/styles/global.css";

const { PUBLIC_GOOGLE_SITE_VERIFICATION } = import.meta.env;

type Props = {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  coverImage?: string; // ← NEW: absolute URL for LCP preload
};

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.desc,
  ogImage = "/og.png",
  canonicalURL: propCanonical,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  coverImage, // ← NEW
} = Astro.props;

const siteBase = SITE.website || "https://www.revibyte.blog/";

let canonicalURL = new URL(Astro.url.pathname, siteBase);

if (canonicalURL.pathname.endsWith("/index.html")) {
  canonicalURL.pathname = canonicalURL.pathname.replace("/index.html", "/");
}

let canonical = canonicalURL.toString();

if (propCanonical) {
  canonical = new URL(propCanonical, siteBase).toString();
}

const socialImageURL = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, siteBase).toString();

const ogType = pubDatetime ? "article" : "website";
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html dir={SITE.dir} lang={SITE.lang ?? "en"} class={scrollSmooth ? "scroll-smooth" : undefined}>
  <head>
    <meta charset="UTF-8" />

    <!-- PWA header hide — must be first to prevent flash -->
    <style>
      @media (display-mode: standalone) {
        header { display: none !important; visibility: hidden !important; height: 0 !important; overflow: hidden !important; pointer-events: none !important; }
      }
    </style>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- PWA Manifest -->
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ReviByte" />

    <!-- ↓ LCP cover image preload — fires immediately with first HTML byte -->
    {coverImage && (
      <link rel="preload" as="image" href={coverImage} fetchpriority="high" />
    )}

    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html, body {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }

      /* ── OneSignal Slidedown Custom Dark Theme ── */
      #onesignal-slidedown-container,
      .onesignal-slidedown-container {
        --onesignal-bg: #0f172a !important;
        --onesignal-text: #ffffff !important;
        --onesignal-subtext: rgba(255,255,255,0.6) !important;
        --onesignal-accent: #6366f1 !important;
        --onesignal-btn-allow-bg: linear-gradient(135deg, #6366f1 0%, #a855f7 100%) !important;
        --onesignal-btn-allow-text: #ffffff !important;
        --onesignal-btn-cancel-bg: rgba(255,255,255,0.08) !important;
        --onesignal-btn-cancel-text: rgba(255,255,255,0.5) !important;
        --onesignal-btn-cancel-border: rgba(255,255,255,0.12) !important;
        --onesignal-icon-bg: linear-gradient(135deg, #6366f1 0%, #a855f7 100%) !important;
      }

      #onesignal-slidedown-container .slidedown-body,
      .onesignal-slidedown-container .slidedown-body {
        border-radius: 24px 24px 0 0 !important;
        box-shadow: 0 -8px 40px rgba(0,0,0,0.5) !important;
      }

      /* ── PWA Top Bar ── */
      .pwa-topbar { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 56px; background: #0f172a; color: white; align-items: center; justify-content: space-between; padding: 0 16px; z-index: 9990; box-shadow: 0 2px 12px rgba(0,0,0,0.3); }
      .pwa-topbar-title { font-size: 18px; font-weight: 700; color: white; text-decoration: none; letter-spacing: -0.3px; }
      .pwa-topbar-actions { display: flex; align-items: center; gap: 8px; }
      .pwa-topbar-btn { background: rgba(255,255,255,0.1); border: none; color: white; width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none; transition: background 0.2s; }
      .pwa-topbar-btn:hover { background: rgba(255,255,255,0.2); }
      .pwa-topbar-btn svg { width: 20px; height: 20px; stroke: white; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

      /* ── Bottom Nav ── */
      .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: #0f172a; display: none; justify-content: space-around; align-items: center; height: 64px; z-index: 9990; border-top: 1px solid rgba(255,255,255,0.08); box-shadow: 0 -4px 20px rgba(0,0,0,0.3); }
      .bottom-nav a { display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:rgba(255,255,255,0.5);text-decoration:none;font-size:10px;font-weight:500;flex:1;height:100%;transition:color 0.2s; }
      .bottom-nav a:hover, .bottom-nav a.active { color: #6366f1; }
      .bottom-nav a svg { width: 22px; height: 22px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .bottom-nav a.active svg { fill: rgba(99,102,241,0.15); }

      /* ── More Menu ── */
      .more-menu { position: fixed; bottom: 64px; left: 0; width: 100%; background: #0f172a; border-top: 1px solid rgba(255,255,255,0.08); z-index: 9989; display: none; flex-direction: column; box-shadow: 0 -4px 20px rgba(0,0,0,0.3); }
      .more-menu.open { display: flex; }
      .more-menu a { display: flex; align-items: center; gap: 14px; padding: 16px 24px; color: rgba(255,255,255,0.8); text-decoration: none; font-size: 15px; font-weight: 500; border-bottom: 1px solid rgba(255,255,255,0.05); transition: background 0.2s; }
      .more-menu a:hover { background: rgba(255,255,255,0.05); color: #6366f1; }
      .more-menu a svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; opacity: 0.7; }

      /* ── PWA Mode ── */
      body.is-pwa .bottom-nav, body.is-pwa .pwa-topbar { display: flex; }
      body.is-pwa { padding-top: 56px; padding-bottom: 64px; }
      body.is-pwa header { display: none !important; visibility: hidden !important; height: 0 !important; overflow: hidden !important; pointer-events: none !important; }

      /* ── Desktop ── */
      @media (min-width: 768px) {
        .bottom-nav, .more-menu, .pwa-topbar { display: none !important; }
        body.is-pwa { padding-top: 0 !important; padding-bottom: 0 !important; }
        body.is-pwa header { display: block !important; visibility: visible !important; height: auto !important; overflow: visible !important; pointer-events: auto !important; }
      }
    </style>

    <!-- Theme Handling — must stay blocking to prevent flash -->
    <script is:inline>
      const primaryColorScheme = "";
      function getPreferTheme() {
        const currentTheme = localStorage.getItem("theme");
        if (currentTheme) return currentTheme;
        if (primaryColorScheme) return primaryColorScheme;
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      let themeValue = getPreferTheme();
      function setPreference() { localStorage.setItem("theme", themeValue); reflectPreference(); }
      function reflectPreference() {
        document.documentElement.setAttribute("data-theme", themeValue);
        if (document.readyState !== "loading") {
          updateThemeIcon();
        }
      }
      function updateThemeIcon() {
        const icon = document.getElementById('pwa-theme-icon');
        if (!icon) return;
        if (themeValue === 'dark') {
          icon.innerHTML = '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';
        } else {
          icon.innerHTML = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
        }
      }
      function togglePWATheme() { themeValue = themeValue === 'dark' ? 'light' : 'dark'; setPreference(); }
      reflectPreference();
      document.addEventListener('DOMContentLoaded', function() { updateThemeIcon(); });
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", ({ matches }) => {
        themeValue = matches ? "dark" : "light";
        setPreference();
      });
    </script>

    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content="ReviByte" />
    <meta property="og:locale" content="en_US" />

    {pubDatetime instanceof Date && (
      <meta property="article:published_time" content={pubDatetime.toISOString()} />
    )}
    {modDatetime instanceof Date && (
      <meta property="article:modified_time" content={modDatetime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={socialImageURL} />

    <SchemaMarkup
      title={title}
      description={description}
      url={canonical}
      image={socialImageURL}
      datePublished={pubDatetime}
      dateModified={modDatetime}
    />

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${siteBase}rss.xml`} />

    {PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </noscript>

    <!-- Google AdSense -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4896561037705299" crossorigin="anonymous"></script>

    <!-- Google Analytics -->
    {SITE.analytics?.googleAnalyticsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics.googleAnalyticsId}`}></script>
        <script is:inline define:vars={{ gaId: SITE.analytics.googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>

        <!-- PWA Detection -->
        <script is:inline>
          window.addEventListener('load', function() {
            setTimeout(function() {
              if (window.matchMedia('(display-mode: standalone)').matches) {
                if (typeof gtag !== 'undefined') {
                  gtag('event', 'pwa_visit', {
                    'event_category': 'PWA',
                    'event_label': 'standalone_mode'
                  });
                } else {
                  console.log('gtag not found');
                }
              } else {
                console.log('not standalone mode');
              }
            }, 2000);
          });
        </script>
      </>
    )}

    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ReviByte",
      "operatingSystem": "Windows",
      "applicationCategory": "NewsApplication",
      "url": "https://apps.microsoft.com/detail/9p24dh9bh6sh",
      "author": {
        "@type": "Person",
        "name": "iSamuel"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "ratingCount": "1"
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
    </script>
  </head>
  <body>
    <HeliaraAI />

    <!-- OneSignal SDK — defer is safe with OneSignalDeferred queue -->
    <script is:inline defer src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js"></script>

    <!-- PWA Top Bar -->
    <div class="pwa-topbar" id="pwaTopbar">
      <a href="/" class="pwa-topbar-title">{SITE.title}</a>
      <div class="pwa-topbar-actions">
        <a href="/search" class="pwa-topbar-btn" aria-label="Search">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </a>
        <button class="pwa-topbar-btn" id="pwa-theme-btn" aria-label="Toggle theme" onclick="togglePWATheme()">
          <svg viewBox="0 0 24 24" id="pwa-theme-icon" style="width:20px;height:20px;stroke:white;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- More Menu -->
    <div class="more-menu" id="moreMenu">
      <a href="/tags/games">
        <svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 12h4M8 10v4M15 12h2M17 10v4"/></svg>
        Games
      </a>
      <a href="/tags/ai">
        <svg viewBox="0 0 24 24"><path d="M12 2a4 4 0 0 1 4 4v1h1a3 3 0 0 1 0 6h-1v1a4 4 0 0 1-8 0v-1H7a3 3 0 0 1 0-6h1V6a4 4 0 0 1 4-4z"/></svg>
        AI
      </a>
      <a href="/tags/opinions">
        <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Opinions
      </a>
      <a href="/tags/news">
        <svg viewBox="0 0 24 24"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8M18 18h-8M18 10h-8"/></svg>
        News
      </a>
    </div>

    <!-- Bottom Navigation Bar -->
    <nav class="bottom-nav">
      <a href="/" class={currentPath === "/" ? "active" : ""}>
        <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Home
      </a>
      <a href="/tags/samsung" class={currentPath.startsWith("/tags/samsung") ? "active" : ""}>
        <svg viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><circle cx="12" cy="18" r="1"/></svg>
        Samsung
      </a>
      <a href="/tags/apple" class={currentPath.startsWith("/tags/apple") ? "active" : ""}>
        <svg viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2z"/><path d="M14.5 6.5c.5-1 .3-2.5-1-3-.5 1.5-.2 2.5 1 3z"/><path d="M16 9.5c-1.5 0-2.5.8-3 .8s-1.5-.8-3-.8C8 9.5 6 11 6 14c0 3 2 7 4 7 .8 0 1.5-.5 2-.5s1.2.5 2 .5c2 0 4-4 4-7 0-1-.5-2-1.5-2.5-.5-.3-1-.5-1.5-.5z"/></svg>
        Apple
      </a>
      <a href="/tags/android" class={currentPath.startsWith("/tags/android") ? "active" : ""}>
        <svg viewBox="0 0 24 24"><circle cx="12" cy="10" r="3"/><path d="M7 20.662V19a5 5 0 0 1 10 0v1.662"/><path d="M4 7l1.5 1.5M20 7l-1.5 1.5M12 3V1"/></svg>
        Android
      </a>
      <button
        onclick="document.getElementById('moreMenu').classList.toggle('open')"
        style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:rgba(255,255,255,0.5);background:none;border:none;font-size:10px;font-weight:500;flex:1;height:100%;cursor:pointer;transition:color 0.2s;"
      >
        <svg viewBox="0 0 24 24" style="width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;">
          <circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>
        </svg>
        More
      </button>
    </nav>
<!-- PWA Install Banner -->
    <div id="installBanner" style="display:none; position:fixed; bottom:74px; left:50%; transform:translateX(-50%); background:#0f172a; color:white; padding:12px 24px; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,0.3); z-index:9998; align-items:center; gap:12px;">
      <span>📱 Install ReviByte for a better experience!</span>
      <button onclick="installApp()" style="background:#6366f1; color:white; border:none; padding:8px 16px; border-radius:8px; cursor:pointer; font-weight:600;">Install</button>
      <button onclick="document.getElementById('installBanner').style.display='none'" style="background:transparent; color:white; border:none; cursor:pointer; font-size:18px;">✕</button>
    </div>

    <!-- PWA Install Logic -->
<script is:inline>
  let deferredPrompt;

  window.addEventListener('beforeinstallprompt', function(e) {
    e.preventDefault();
    deferredPrompt = e;
    var isPWA = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    if (!isPWA) {
      document.getElementById('installBanner').style.display = 'flex';
    }
  });

  function installApp() {
    if (!deferredPrompt) {
      console.log('Install prompt not available');
      return;
    }
    deferredPrompt.prompt();
    deferredPrompt.userChoice.then(function(choiceResult) {
      if (choiceResult.outcome === 'accepted') {
        console.log('User accepted install');
      } else {
        console.log('User dismissed install');
      }
      deferredPrompt = null;
      document.getElementById('installBanner').style.display = 'none';
    });
  }

  window.addEventListener('appinstalled', function() {
    document.getElementById('installBanner').style.display = 'none';
    deferredPrompt = null;
    if (typeof umami !== 'undefined') {
      umami.track('pwa-install');
    }
  });
</script>

    <!-- PWA Detection -->
    <script is:inline>
      function checkPWA() {
        var isPWA = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
        if (isPWA) {
          document.body.classList.add('is-pwa');
          var header = document.querySelector('header');
          if (header) header.style.cssText = 'display:none!important;visibility:hidden!important;height:0!important;overflow:hidden!important;pointer-events:none!important;';
          if (typeof updateThemeIcon === 'function') updateThemeIcon();
        } else {
          document.body.classList.remove('is-pwa');
          var header = document.querySelector('header');
          if (header) header.style.cssText = '';
        }
      }
      checkPWA();
      document.addEventListener('astro:after-swap', checkPWA);
    </script>

    <!-- Close More Menu when clicking outside -->
    <script is:inline>
      document.addEventListener('click', function(e) {
        var menu = document.getElementById('moreMenu');
        var moreBtn = document.querySelector('.bottom-nav button');
        if (menu && moreBtn && !menu.contains(e.target) && !moreBtn.contains(e.target)) {
          menu.classList.remove('open');
        }
      });
    </script>

    <!-- OneSignal Init -->
    <script is:inline>
      window.OneSignalDeferred = window.OneSignalDeferred || [];

      OneSignalDeferred.push(async function (OneSignal) {
        try {
          await OneSignal.init({
            appId: "bbd38552-99d1-4cda-96f9-5c0cacfba192",
            notifyButton: { enable: false },
            allowLocalhostAsSecureOrigin: true,
            autoResubscribe: true,
            promptOptions: {
              slidedown: {
                prompts: [
                  {
                    type: "push",
                    autoPrompt: true,
                    text: {
                      actionMessage: "⚡ Stay Ahead in Tech",
                      acceptButtonText: "Allow 🔔",
                      cancelButtonText: "Not Now",
                      confirmMessage: "Hit Allow to get instant updates on new posts, phone comparisons, and buying guides that actually help."
                    },
                    delay: {
                      pageViews: 0,
                      timeDelay: 3
                    }
                  }
                ]
              }
            }
          });

          console.log("OneSignal initialized successfully");
        } catch (e) {
          console.error("OneSignal init error:", e);
        }
      });
    </script>
<script is:inline data-cfasync="false" src="https://cmp.gatekeeperconsent.com/min.js"></script>
<script is:inline data-cfasync="false" src="https://the.gatekeeperconsent.com/cmp.min.js"></script>

<script is:inline async src="//www.ezojs.com/ezoic/sa.min.js"></script>

<script is:inline>
  window.ezstandalone = window.ezstandalone || {};
  window.ezstandalone.cmd = window.ezstandalone.cmd || [];
</script>

<script is:inline src="//ezoicanalytics.com/analytics.js"></script>
<script async src="https://cloud.umami.is/script.js" data-website-id="5a7a4a29-83ee-40a8-8b0d-d5afae7d11e5"></script>
    <slot />
  </body>
</html>
