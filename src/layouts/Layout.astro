---
import type { CollectionEntry } from "astro:content";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";

export interface Props {
  title: string;
  author: string;
  description: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  canonicalURL: string;
  ogImage: string;
  scrollSmooth?: boolean;
  post?: CollectionEntry<"blog">;
  posts?: CollectionEntry<"blog">[];
}

const {
  title,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth = true,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <script>
      if ({scrollSmooth}) document.documentElement.style.scrollBehavior = "smooth";
    </script>
  </head>

  <body class="bg-background text-foreground antialiased">
    <Header />

    <main class="min-h-screen mx-auto max-w-app px-4 py-8">
      <slot />
    </main>

    <BackToTopButton class="fixed bottom-4 right-4 rounded-full p-3 shadow-lg bg-background/90 z-50" />

    <Footer />
  </body>
</html>
