---
import { SITE } from "@/config";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import HeliaraAI from '../components/HeliaraAI.astro';
import OptimizedCoverImage from '@/components/OptimizedCoverImage.astro';
import Sidebar from "@/components/Sidebar.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";
import GoogleSubscribe from '../components/GoogleSubscribe.astro';
import InstallBanner from '../components/InstallBanner.astro';
const { PUBLIC_GOOGLE_SITE_VERIFICATION } = import.meta.env;

type Props = {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  coverImage?: string;
  coverImageAlt?: string;
};

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.desc,
  ogImage = "/og.png",
  canonicalURL: propCanonical,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  coverImage,
  coverImageAlt = "",
} = Astro.props;

const siteBase = SITE.website || "https://www.revibyte.blog/";

let canonicalURL = new URL(Astro.url.pathname, siteBase);
if (canonicalURL.pathname.endsWith("/index.html")) {
  canonicalURL.pathname = canonicalURL.pathname.replace("/index.html", "/");
}
let canonical = canonicalURL.toString();
if (propCanonical) {
  canonical = new URL(propCanonical, siteBase).toString();
}

const socialImageURL = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, siteBase).toString();

const ogType = pubDatetime ? "article" : "website";
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html dir={SITE.dir} lang={SITE.lang ?? "en"} class={scrollSmooth ? "scroll-smooth" : undefined}>
  <head>

    <meta charset="UTF-8" />

    <!-- box-sizing reset — must be first to prevent flash -->
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html, body { width: 100%; max-width: 100%; margin: 0; padding: 0; overflow-x: hidden; }
    </style>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ReviByte" />

    <!-- Preconnect to Google Fonts (if you use them) and other third-parties -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- REMOVED: coverImage preload from here.
         It was preloading the RAW image while OptimizedCoverImage serves a
         Vercel-optimized URL, causing a double-download. Pages that need LCP
         preloading (like CODM guides) should handle it in their own file. -->

    <!-- Theme Handling — critical, must stay blocking to prevent flash -->
    <script is:inline>
      const primaryColorScheme = "";
      function getPreferTheme() {
        const currentTheme = localStorage.getItem("theme");
        if (currentTheme) return currentTheme;
        if (primaryColorScheme) return primaryColorScheme;
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      let themeValue = getPreferTheme();
      function setPreference() { localStorage.setItem("theme", themeValue); reflectPreference(); }
      function reflectPreference() {
        document.documentElement.setAttribute("data-theme", themeValue);
      }
      function togglePWATheme() { themeValue = themeValue === 'dark' ? 'light' : 'dark'; setPreference(); }
      reflectPreference();
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", ({ matches }) => {
        themeValue = matches ? "dark" : "light";
        setPreference();
      });
    </script>

    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="sitemap" href="/sitemap-index.xml" />
   
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content="ReviByte" />
    <meta property="og:locale" content="en_US" />

    {pubDatetime instanceof Date && (
      <meta property="article:published_time" content={pubDatetime.toISOString()} />
    )}
    {modDatetime instanceof Date && (
      <meta property="article:modified_time" content={modDatetime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={socialImageURL} />

    <SchemaMarkup
      title={title}
      description={description}
      url={canonical}
      image={socialImageURL}
      datePublished={pubDatetime}
      dateModified={modDatetime}
    />

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${siteBase}rss.xml`} />

    {PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}

    {SITE.analytics?.googleAnalyticsId && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics.googleAnalyticsId}`}></script>
    )}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>

    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ReviByte",
      "operatingSystem": "Windows",
      "applicationCategory": "NewsApplication",
      "url": "https://apps.microsoft.com/detail/9p24dh9bh6sh",
      "author": {
        "@type": "Person",
        "name": "iSamuel"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "ratingCount": "1"
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
    </script>

    <!-- REMOVED: Microsoft Clarity from here — it was render-blocking LCP.
         It has been moved to the idle-loaded script group below. -->

  </head>

  <body>
     <InstallBanner />
     <HeliaraAI />
     <GoogleSubscribe />
     <slot name="header" />
     <slot name="top-nav" />

    <!-- ========== COVER IMAGE + AD PLACEHOLDERS (scripts moved below, after content) ========== -->

    {coverImage && (
      <div class="cover-ad-wrapper">
        <!-- AdSense placeholder: TOP of cover image (script loads after content, idle-triggered below) -->
        <div class="ad-slot ad-slot--top">
          <ins class="adsbygoogle"
               style="display:block"
               data-ad-format="fluid"
               data-ad-layout-key="-gf-2b-2i-8t+14w"
               data-ad-client="ca-pub-4896561037705299"
               data-ad-slot="2743091672"></ins>
        </div>

        <!-- Cover Image -->
        <OptimizedCoverImage
          src={coverImage}
          alt={coverImageAlt || title}
          width={1200}
          height={630}
          loading="eager"
          sizes="100vw"
        />

        <!-- Adsterra placeholder: BOTTOM of cover image (script loads after content, idle-triggered below) -->
        <div class="ad-slot ad-slot--bottom">
          <div id="container-100c0408033e7aba877563ba9293a45d"></div>
        </div>
      </div>
    )}

    <slot />

    <!-- ================= IDLE-LOADED SCRIPTS (After LCP / content) ================= -->

    {SITE.analytics?.googleAnalyticsId && (
      <script is:inline define:vars={{ gaId: SITE.analytics.googleAnalyticsId }}>
        gtag('config', gaId);
      </script>
    )}

    <!--
      INP FIX — single deferred loader for every non-essential third-party script.

      Previously AdSense, Adsterra, and Microsoft Clarity all fired eagerly on
      page load (competing with each other and with any early user tap for
      main-thread time). They now share the same "wait for idle, scroll, or a
      5s timeout" trigger already used for OneSignal below, so a visitor who
      starts scrolling or tapping immediately never has these scripts running
      underneath their interaction.

      REMOVED ENTIRELY — the obfuscated Clickadu script and the
      bartererfaxtingling.com/bn.js banner. That script ran synchronous
      WASM instantiation and URL-rewriting logic on every page load, which
      was almost certainly the dominant cause of the >200ms INP: it blocks
      the main thread regardless of when it runs, idle-deferred or not.
      Ad networks that ship obfuscated redirect/WASM payloads like this are
      also the profile Safe Browsing and Google's ad-quality review flag —
      the same risk category that got the old /save/ downloader hub pulled.
      If you want it back, get an unobfuscated snippet directly from the
      network's dashboard first; don't re-add this exact payload.
    -->
    <script is:inline>
      (function () {
        let loaded = false;

        function loadDeferredAds() {
          if (loaded) return;
          loaded = true;

          // AdSense
          var ads = document.createElement('script');
          ads.async = true;
          ads.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4896561037705299";
          ads.crossOrigin = "anonymous";
          ads.onload = function () {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          };
          document.body.appendChild(ads);

          // Adsterra
          var adsterra = document.createElement('script');
          adsterra.async = true;
          adsterra.setAttribute('data-cfasync', 'false');
          adsterra.src = "https://pl28410703.effectivecpmnetwork.com/100c0408033e7aba877563ba9293a45d/invoke.js";
          document.body.appendChild(adsterra);

          // Microsoft Clarity
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
            t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, "clarity", "script", "xjz9wkvh5l");
        }

        // Fire on first real user interaction/scroll (native "requestIdleCallback"
        // isn't reliable enough on its own for this — a fast scroller shouldn't
        // wait for idle), or after 5s if the visitor never interacts.
        window.addEventListener('scroll', loadDeferredAds, { once: true, passive: true });
        window.addEventListener('touchstart', loadDeferredAds, { once: true, passive: true });
        setTimeout(loadDeferredAds, 5000);
      })();
    </script>

    <!-- OneSignal -->
    <script is:inline>
      (function() {
        function loadOneSignal() {
          if (window.__oneSignalLoaded) return;
          window.__oneSignalLoaded = true;
          var s = document.createElement('script');
          s.src = 'https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js';
          s.defer = true;
          s.onload = function() {
            window.OneSignalDeferred = window.OneSignalDeferred || [];
            OneSignalDeferred.push(async function (OneSignal) {
              try {
                await OneSignal.init({
                  appId: "bbd38552-99d1-4cda-96f9-5c0cacfba192",
                  notifyButton: { enable: false },
                  allowLocalhostAsSecureOrigin: true,
                  autoResubscribe: true,
                  promptOptions: {
                    slidedown: {
                      prompts: [{
                        type: "push",
                        autoPrompt: true,
                        text: {
                          actionMessage: "⚡ Stay Ahead in Tech",
                          acceptButtonText: "Allow 🔔",
                          cancelButtonText: "Not Now",
                          confirmMessage: "Hit Allow to get instant updates on new posts, phone comparisons, and buying guides that actually help."
                        },
                        delay: { pageViews: 0, timeDelay: 3 }
                      }]
                    }
                  }
                });
              } catch (e) { console.error("OneSignal init error:", e); }
            });
          };
          document.body.appendChild(s);
        }
        window.addEventListener('scroll', loadOneSignal, { once: true, passive: true });
        setTimeout(loadOneSignal, 5000);
      })();
    </script>

    <!-- PWA Analytics Event -->
    <script is:inline>
      window.addEventListener('load', function() {
        setTimeout(function() {
          if (window.matchMedia('(display-mode: standalone)').matches) {
            if (typeof gtag !== 'undefined') {
              gtag('event', 'pwa_visit', { 'event_category': 'PWA', 'event_label': 'standalone_mode' });
            }
          }
        }, 2000);
      });
    </script>

    <div style="max-width:768px;margin:1.5rem auto;padding:0 1rem;text-align:center;">
      <p style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.5;margin:0 0 .5rem;">Advertisement</p>
      <div style="min-height:100px;display:flex;justify-content:center;align-items:center;overflow:hidden;">
        <div data-cl-spot="2147401"></div>
      </div>
    </div>

    <Footer />
    <!-- SIDEBAR — rendered LAST so it's on top of everything -->
    <Sidebar />

    <style>
      .cover-ad-wrapper {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 100%;
      }

      .ad-slot {
        display: block;
        width: 100%;
        max-width: 768px;
        margin-left: auto;
        margin-right: auto;
        contain: layout;
      }

      .ad-slot--top {
        margin-bottom: 0.5rem;
        min-height: 280px;
      }

      .ad-slot--bottom {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
        min-height: 250px;
      }

      .cover-ad-wrapper :global(img),
      .cover-ad-wrapper :global(picture) {
        display: block;
        width: 100%;
        height: auto;
        margin: 0;
      }
    </style>
  </body>
</html>
