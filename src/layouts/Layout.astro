---
import { SITE } from "@/config";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import HeliaraAI from '../components/HeliaraAI.astro';
import OptimizedCoverImage from '@/components/OptimizedCoverImage.astro';
import "@/styles/global.css";
const { PUBLIC_GOOGLE_SITE_VERIFICATION } = import.meta.env;

type Props = {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  coverImage?: string;
  coverImageAlt?: string;
};

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.desc,
  ogImage = "/og.png",
  canonicalURL: propCanonical,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  coverImage,
  coverImageAlt = "",
} = Astro.props;

const siteBase = SITE.website || "https://www.revibyte.blog/";

let canonicalURL = new URL(Astro.url.pathname, siteBase);
if (canonicalURL.pathname.endsWith("/index.html")) {
  canonicalURL.pathname = canonicalURL.pathname.replace("/index.html", "/");
}
let canonical = canonicalURL.toString();
if (propCanonical) {
  canonical = new URL(propCanonical, siteBase).toString();
}

const socialImageURL = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, siteBase).toString();

const ogType = pubDatetime ? "article" : "website";
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html dir={SITE.dir} lang={SITE.lang ?? "en"} class={scrollSmooth ? "scroll-smooth" : undefined}>
  <head>
    <meta charset="UTF-8" />

    <!-- box-sizing reset — must be first to prevent flash -->
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html, body { width: 100%; max-width: 100%; margin: 0; padding: 0; overflow-x: hidden; }
    </style>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ReviByte" />

    <!-- LCP cover image preload — highest priority -->
    {coverImage && (
      <link rel="preload" as="image" href={coverImage} fetchpriority="high" />
    )}

    <!-- FIXED: Removed unused Google Fonts preconnects. 
         Source Code Pro is now self-hosted via @font-face in global.css.
         If you need the font file, download from Google Fonts and put in /public/fonts/ -->

    <!-- Theme Handling — critical, must stay blocking to prevent flash -->
    <script is:inline>
      const primaryColorScheme = "";
      function getPreferTheme() {
        const currentTheme = localStorage.getItem("theme");
        if (currentTheme) return currentTheme;
        if (primaryColorScheme) return primaryColorScheme;
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      let themeValue = getPreferTheme();
      function setPreference() { localStorage.setItem("theme", themeValue); reflectPreference(); }
      function reflectPreference() {
        document.documentElement.setAttribute("data-theme", themeValue);
      }
      function togglePWATheme() { themeValue = themeValue === 'dark' ? 'light' : 'dark'; setPreference(); }
      reflectPreference();
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", ({ matches }) => {
        themeValue = matches ? "dark" : "light";
        setPreference();
      });
    </script>

    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content="ReviByte" />
    <meta property="og:locale" content="en_US" />

    {pubDatetime instanceof Date && (
      <meta property="article:published_time" content={pubDatetime.toISOString()} />
    )}
    {modDatetime instanceof Date && (
      <meta property="article:modified_time" content={modDatetime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={socialImageURL} />

    <SchemaMarkup
      title={title}
      description={description}
      url={canonical}
      image={socialImageURL}
      datePublished={pubDatetime}
      dateModified={modDatetime}
    />

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${siteBase}rss.xml`} />

    {PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}

    <!-- FIXED: Removed Google Fonts <link> entirely. 
         Add @font-face for Source Code Pro to your global.css instead (see below) -->

    <!-- FIXED: Moved Google Analytics to bottom of body with idle loading.
         Only the minimal gtag stub stays here, async. -->
    {SITE.analytics?.googleAnalyticsId && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics.googleAnalyticsId}`}></script>
    )}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>

    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ReviByte",
      "operatingSystem": "Windows",
      "applicationCategory": "NewsApplication",
      "url": "https://apps.microsoft.com/detail/9p24dh9bh6sh",
      "author": {
        "@type": "Person",
        "name": "iSamuel"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "ratingCount": "1"
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
    </script>
<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xjz9wkvh5l");
</script>
  </head>

  <body>
    <HeliaraAI />

    <!-- FIXED: Moved Adsterra banner AFTER main content (slot), not before.
         It was blocking LCP by being the first thing in <body>. -->
    
    <slot name="header" />
    <slot name="top-nav" />

    {coverImage && (
      <OptimizedCoverImage 
        src={coverImage}
        alt={coverImageAlt || title}
        width={1200}
        height={630}
        loading="eager"
        sizes="100vw"
      />
    )}

    <slot />

    <!-- ================= ADS & THIRD-PARTY (After all content) ================= -->

    <!-- Adsterra Anchor Banner — moved after content to prevent blocking LCP -->
    <div id="rb-anchor-ad" style="position:fixed; bottom:0; left:0; width:100%; z-index:9995; background:#0f172a; box-shadow:0 -2px 12px rgba(0,0,0,0.3); transition:height 0.25s ease;">
      <div id="rb-anchor-collapsed" onclick="toggleAnchorAd()" style="display:flex; align-items:center; justify-content:center; gap:6px; height:22px; cursor:pointer; color:rgba(255,255,255,0.6); font-size:10px; font-weight:600; letter-spacing:0.05em; text-transform:uppercase;">
        <span>▲ Ad</span>
      </div>
      <div id="rb-anchor-expanded" style="display:none; position:relative; min-height:50px; align-items:center; justify-content:center;">
        <button onclick="toggleAnchorAd()" aria-label="Close ad" style="position:absolute; right:4px; top:4px; background:none; border:none; color:#fff; font-size:14px; cursor:pointer; padding:4px 8px; z-index:1;">✕</button>
        <div style="display:flex; align-items:center; justify-content:center; min-height:50px;">
          <script is:inline>
            atOptions = {
              'key' : '2b0c33ae294502978b9bfb23cc9b43f0',
              'format' : 'iframe',
              'height' : 50,
              'width' : 320,
              'params' : {}
            };
          </script>
          <script is:inline src="https://www.highperformanceformat.com/2b0c33ae294502978b9bfb23cc9b43f0/invoke.js"></script>
        </div>
      </div>
    </div>

    <script is:inline>
      function toggleAnchorAd() {
        var collapsed = document.getElementById('rb-anchor-collapsed');
        var expanded = document.getElementById('rb-anchor-expanded');
        if (expanded.style.display === 'none') {
          collapsed.style.display = 'none';
          expanded.style.display = 'flex';
        } else {
          expanded.style.display = 'none';
          collapsed.style.display = 'flex';
        }
      }
    </script>

    <!-- PWA Install Banner -->
    <div id="installBanner" style="display:none; position:fixed; bottom:24px; left:50%; transform:translateX(-50%); background:#0f172a; color:white; padding:12px 24px; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,0.3); z-index:9998; align-items:center; gap:12px;">
      <span>📱 Install ReviByte for a better experience!</span>
      <button onclick="installApp()" style="background:#6366f1; color:white; border:none; padding:8px 16px; border-radius:8px; cursor:pointer; font-weight:600;">Install</button>
      <button onclick="dismissInstallBanner()" style="background:transparent; color:white; border:none; cursor:pointer; font-size:18px;">✕</button>
    </div>

    <!-- ================= IDLE-LOADED SCRIPTS (After LCP) ================= -->

    <!-- Google AdSense — loaded after user interaction or 3s timeout -->
    <script is:inline>
      (function() {
        function loadScript(src, attrs) {
          var s = document.createElement('script');
          s.src = src;
          for (var k in attrs) s.setAttribute(k, attrs[k]);
          document.body.appendChild(s);
        }
        function loadAds() {
          if (window.__adsLoaded) return;
          window.__adsLoaded = true;
          loadScript('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4896561037705299', {
            crossorigin: 'anonymous',
            async: 'true'
          });
        }
        window.addEventListener('scroll', loadAds, { once: true, passive: true });
        window.addEventListener('click', loadAds, { once: true });
        window.addEventListener('touchstart', loadAds, { once: true, passive: true });
        setTimeout(loadAds, 3000);
      })();
    </script>

    <!-- GA config — deferred to after content -->
    {SITE.analytics?.googleAnalyticsId && (
      <script is:inline define:vars={{ gaId: SITE.analytics.googleAnalyticsId }}>
        gtag('config', gaId);
      </script>
    )}

    <!-- FIXED: OneSignal now loads only after user interaction or 5s idle -->
    <script is:inline>
      (function() {
        function loadOneSignal() {
          if (window.__oneSignalLoaded) return;
          window.__oneSignalLoaded = true;
          var s = document.createElement('script');
          s.src = 'https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js';
          s.defer = true;
          s.onload = function() {
            window.OneSignalDeferred = window.OneSignalDeferred || [];
            OneSignalDeferred.push(async function (OneSignal) {
              try {
                await OneSignal.init({
                  appId: "bbd38552-99d1-4cda-96f9-5c0cacfba192",
                  notifyButton: { enable: false },
                  allowLocalhostAsSecureOrigin: true,
                  autoResubscribe: true,
                  promptOptions: {
                    slidedown: {
                      prompts: [{
                        type: "push",
                        autoPrompt: true,
                        text: {
                          actionMessage: "⚡ Stay Ahead in Tech",
                          acceptButtonText: "Allow 🔔",
                          cancelButtonText: "Not Now",
                          confirmMessage: "Hit Allow to get instant updates on new posts, phone comparisons, and buying guides that actually help."
                        },
                        delay: { pageViews: 0, timeDelay: 3 }
                      }]
                    }
                  }
                });
              } catch (e) { console.error("OneSignal init error:", e); }
            });
          };
          document.body.appendChild(s);
        }
        window.addEventListener('scroll', loadOneSignal, { once: true, passive: true });
        setTimeout(loadOneSignal, 5000);
      })();
    </script>

    <!-- PWA Install Logic -->
    <script is:inline>
      let deferredPrompt;
      window.addEventListener('beforeinstallprompt', function(e) {
        e.preventDefault();
        deferredPrompt = e;
        var isPWA = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
        var dismissed = localStorage.getItem('pwaBannerDismissed');
        if (!isPWA && !dismissed) {
          document.getElementById('installBanner').style.display = 'flex';
        }
      });
      function installApp() {
        if (!deferredPrompt) { console.log('Install prompt not available'); return; }
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then(function(choiceResult) {
          if (choiceResult.outcome === 'accepted') console.log('User accepted install');
          else console.log('User dismissed install');
          deferredPrompt = null;
          document.getElementById('installBanner').style.display = 'none';
        });
      }
      function dismissInstallBanner() {
        document.getElementById('installBanner').style.display = 'none';
        localStorage.setItem('pwaBannerDismissed', 'true');
      }
      window.addEventListener('appinstalled', function() {
        document.getElementById('installBanner').style.display = 'none';
        deferredPrompt = null;
        localStorage.setItem('pwaBannerDismissed', 'true');
        if (typeof umami !== 'undefined') umami.track('pwa-install');
      });
    </script>

    <!-- PWA Analytics Event -->
    <script is:inline>
      window.addEventListener('load', function() {
        setTimeout(function() {
          if (window.matchMedia('(display-mode: standalone)').matches) {
            if (typeof gtag !== 'undefined') {
              gtag('event', 'pwa_visit', { 'event_category': 'PWA', 'event_label': 'standalone_mode' });
            }
          }
        }, 2000);
      });
    </script>
  </body>
</html>
