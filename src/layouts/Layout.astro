---
import { SITE } from "@/config";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import "@/styles/global.css";

const { PUBLIC_GOOGLE_SITE_VERIFICATION } = import.meta.env;

type Props = {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
};

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.desc,
  ogImage = "/og.png",
  canonicalURL: propCanonical,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
} = Astro.props;

/* --------------------------------------------------
   SAFE CANONICAL GENERATION
-------------------------------------------------- */
const siteBase = SITE.website || "https://www.revibyte.blog/";

let canonicalURL = new URL(Astro.url.pathname, siteBase);

if (canonicalURL.pathname.endsWith("/index.html")) {
  canonicalURL.pathname = canonicalURL.pathname.replace("/index.html", "/");
}

let canonical = canonicalURL.toString();

if (propCanonical) {
  canonical = new URL(propCanonical, siteBase).toString();
}

/* --------------------------------------------------
   SOCIAL IMAGE (ALWAYS ABSOLUTE)
-------------------------------------------------- */
const socialImageURL = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, siteBase).toString();

/* --------------------------------------------------
   OG TYPE
-------------------------------------------------- */
const ogType = pubDatetime ? "article" : "website";

/* --------------------------------------------------
   CURRENT PATH FOR ACTIVE NAV HIGHLIGHT
-------------------------------------------------- */
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html dir={SITE.dir} lang={SITE.lang ?? "en"} class={scrollSmooth ? "scroll-smooth" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fix full-width layout -->
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }
      html, body {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }

      /* Bottom Nav Styles */
      .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: #0f172a;
        display: none;
        justify-content: space-around;
        align-items: center;
        height: 64px;
        z-index: 9990;
        border-top: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 -4px 20px rgba(0,0,0,0.3);
      }

      /* Only show bottom nav in PWA mode via JS */
      body.is-pwa .bottom-nav {
        display: flex;
      }

      body.is-pwa {
        padding-bottom: 64px;
      }

      .bottom-nav a {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        color: rgba(255,255,255,0.5);
        text-decoration: none;
        font-size: 10px;
        font-weight: 500;
        flex: 1;
        height: 100%;
        transition: color 0.2s;
      }

      .bottom-nav a:hover {
        color: #6366f1;
      }

      .bottom-nav a.active {
        color: #6366f1;
      }

      .bottom-nav a svg {
        width: 22px;
        height: 22px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .bottom-nav a.active svg {
        fill: rgba(99,102,241,0.15);
      }

      /* More Menu */
      .more-menu {
        position: fixed;
        bottom: 64px;
        left: 0;
        width: 100%;
        background: #0f172a;
        border-top: 1px solid rgba(255,255,255,0.08);
        z-index: 9989;
        display: none;
        flex-direction: column;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.3);
      }

      .more-menu.open {
        display: flex;
      }

      .more-menu a {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 24px;
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        transition: background 0.2s;
      }

      .more-menu a:hover {
        background: rgba(255,255,255,0.05);
        color: #6366f1;
      }

      .more-menu a svg {
        width: 20px;
        height: 20px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.7;
      }

      /* Always hide bottom nav on desktop */
      @media (min-width: 768px) {
        .bottom-nav,
        .more-menu {
          display: none !important;
        }
        body {
          padding-bottom: 0 !important;
        }
      }
    </style>

    <!-- PWA Manifest and Theme Color -->
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f172a" />

    <!-- Apple PWA Meta Tags -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ReviByte" />

    <!-- OneSignal Push Notifications -->
    <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
    <script>
      window.OneSignalDeferred = window.OneSignalDeferred || [];
      window.OneSignalDeferred.push(async function(OneSignal: any) {
        await OneSignal.init({
          appId: "bbd38552-99d1-4cda-96f9-5c0cacfba192",
          notifyButton: { enable: true }
        });
        OneSignal.showNativePrompt();
      });
    </script>

    <!-- PWA Install Prompt -->
    <script>
      let deferredPrompt: BeforeInstallPromptEvent | null = null;

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e as BeforeInstallPromptEvent;

        const banner = document.getElementById('installBanner');
        if (banner) {
          banner.style.display = 'flex';
        }
      });

      async function installApp() {
        if (deferredPrompt) {
          deferredPrompt.prompt();
          const { outcome } = await deferredPrompt.userChoice;
          console.log(`User response: ${outcome}`);
          deferredPrompt = null;

          const banner = document.getElementById('installBanner');
          if (banner) {
            banner.style.display = 'none';
          }
        }
      }

      (window as any).installApp = installApp;
    </script>

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Basic SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article dates -->
    {pubDatetime instanceof Date && (
      <meta property="article:published_time" content={pubDatetime.toISOString()} />
    )}
    {modDatetime instanceof Date && (
      <meta property="article:modified_time" content={modDatetime.toISOString()} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Schema Markup -->
    <SchemaMarkup
      title={title}
      description={description}
      url={canonical}
      image={socialImageURL}
      datePublished={pubDatetime}
      dateModified={modDatetime}
    />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={`${siteBase}rss.xml`}
    />

    <!-- Google Site Verification -->
    {PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta
        name="google-site-verification"
        content={PUBLIC_GOOGLE_SITE_VERIFICATION}
      />
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Theme Handling -->
    <script is:inline>
      const primaryColorScheme = "";
      function getPreferTheme() {
        const currentTheme = localStorage.getItem("theme");
        if (currentTheme) return currentTheme;
        if (primaryColorScheme) return primaryColorScheme;
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      let themeValue = getPreferTheme();
      function setPreference() {
        localStorage.setItem("theme", themeValue);
        reflectPreference();
      }
      function reflectPreference() {
        document.documentElement.setAttribute("data-theme", themeValue);
      }
      reflectPreference();
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", ({ matches }) => {
        themeValue = matches ? "dark" : "light";
        setPreference();
      });
    </script>

    <!-- Google AdSense -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4896561037705299" crossorigin="anonymous"></script>

    <!-- Google Analytics -->
    {SITE.analytics?.googleAnalyticsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics.googleAnalyticsId}`}></script>
        <script is:inline define:vars={{ gaId: SITE.analytics.googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>

  <body>
    <slot />

    <!-- More Menu -->
    <div class="more-menu" id="moreMenu">
      <a href="/tags/games">
        <svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 12h4M8 10v4M15 12h2M17 10v4"/></svg>
        Games
      </a>
      <a href="/tags/ai">
        <svg viewBox="0 0 24 24"><path d="M12 2a4 4 0 0 1 4 4v1h1a3 3 0 0 1 0 6h-1v1a4 4 0 0 1-8 0v-1H7a3 3 0 0 1 0-6h1V6a4 4 0 0 1 4-4z"/></svg>
        AI
      </a>
      <a href="/tags/opinions">
        <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Opinions
      </a>
      <a href="/search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        Search
      </a>
    </div>

    <!-- Bottom Navigation Bar -->
    <nav class="bottom-nav">
      <a href="/" class={currentPath === "/" ? "active" : ""}>
        <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Home
      </a>
      <a href="/tags/samsung" class={currentPath.startsWith("/tags/samsung") ? "active" : ""}>
        <svg viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><circle cx="12" cy="18" r="1"/></svg>
        Samsung
      </a>
      <a href="/tags/apple" class={currentPath.startsWith("/tags/apple") ? "active" : ""}>
        <svg viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2z"/><path d="M14.5 6.5c.5-1 .3-2.5-1-3-.5 1.5-.2 2.5 1 3z"/><path d="M16 9.5c-1.5 0-2.5.8-3 .8s-1.5-.8-3-.8C8 9.5 6 11 6 14c0 3 2 7 4 7 .8 0 1.5-.5 2-.5s1.2.5 2 .5c2 0 4-4 4-7 0-1-.5-2-1.5-2.5-.5-.3-1-.5-1.5-.5z"/></svg>
        Apple
      </a>
      <a href="/tags/android" class={currentPath.startsWith("/tags/android") ? "active" : ""}>
        <svg viewBox="0 0 24 24"><circle cx="12" cy="10" r="3"/><path d="M7 20.662V19a5 5 0 0 1 10 0v1.662"/><path d="M4 7l1.5 1.5M20 7l-1.5 1.5M12 3V1"/></svg>
        Android
      </a>
      <button
        onclick="document.getElementById('moreMenu').classList.toggle('open')"
        style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:rgba(255,255,255,0.5);background:none;border:none;font-size:10px;font-weight:500;flex:1;height:100%;cursor:pointer;transition:color 0.2s;"
      >
        <svg viewBox="0 0 24 24" style="width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;">
          <circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>
        </svg>
        More
      </button>
    </nav>

    <!-- PWA Detection - Hide header and show bottom nav -->
    <script is:inline>
  function checkPWA() {
    const isPWA = window.matchMedia('(display-mode: standalone)').matches
      || window.navigator.standalone === true;

        if (isPWA) {
          document.body.classList.add('is-pwa');
          const header = document.querySelector('header');
          if (header) header.style.display = 'none';
        } else {
          document.body.classList.remove('is-pwa');
          const header = document.querySelector('header');
          if (header) header.style.display = '';
        }
      }

      checkPWA();
      document.addEventListener('astro:after-swap', checkPWA);
    </script>

    <!-- Close More Menu when clicking outside -->
    <script>
      document.addEventListener('click', (e) => {
        const menu = document.getElementById('moreMenu');
        const moreBtn = document.querySelector('.bottom-nav button');
        if (menu && moreBtn && !menu.contains(e.target as Node) && !moreBtn.contains(e.target as Node)) {
          menu.classList.remove('open');
        }
      });
    </script>

    <!-- PWA Install Banner -->
    <div id="installBanner" style="display:none; position:fixed; bottom:74px; left:50%; transform:translateX(-50%); background:#0f172a; color:white; padding:12px 24px; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,0.3); z-index:9998; align-items:center; gap:12px;">
      <span>📱 Install ReviByte for a better experience!</span>
      <button id="installApp" onclick="installApp()" style="background:#6366f1; color:white; border:none; padding:8px 16px; border-radius:8px; cursor:pointer; font-weight:600;">
        Install
      </button>
      <button onclick="document.getElementById('installBanner').style.display='none'" style="background:transparent; color:white; border:none; cursor:pointer; font-size:18px;">
        ✕
      </button>
    </div>

    <!-- Service Worker Registration -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then(reg => console.log('Service Worker registered'))
            .catch(err => console.log('Service Worker failed', err));
        });
      }
    </script>
  </body>
</html>
