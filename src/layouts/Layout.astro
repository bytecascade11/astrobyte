---
import { SITE } from "@/config";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import HeliaraAI from '../components/HeliaraAI.astro';
import OptimizedCoverImage from '@/components/OptimizedCoverImage.astro';
import Sidebar from "@/components/Sidebar.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";
import GoogleSubscribe from '../components/GoogleSubscribe.astro';
import InstallBanner from '../components/InstallBanner.astro';
const { PUBLIC_GOOGLE_SITE_VERIFICATION } = import.meta.env;

type Props = {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  coverImage?: string;
  coverImageAlt?: string;
  review?: {
    productName: string;
    brand: string;
    ratingValue: number;
    bestRating?: number;
  };
};

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.desc,
  ogImage = "/og.png",
  canonicalURL: propCanonical,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  coverImage,
  coverImageAlt = "",
  review,
} = Astro.props;

const siteBase = SITE.website || "https://www.revibyte.blog/";

let canonicalURL = new URL(Astro.url.pathname, siteBase);
if (canonicalURL.pathname.endsWith("/index.html")) {
  canonicalURL.pathname = canonicalURL.pathname.replace("/index.html", "/");
}
let canonical = canonicalURL.toString();
if (propCanonical) {
  canonical = new URL(propCanonical, siteBase).toString();
}

const socialImageURL = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, siteBase).toString();

const ogType = pubDatetime ? "article" : "website";

// Declared BEFORE schemaType, which depends on isHomepage.
const currentPath = Astro.url.pathname;
const isHomepage = currentPath === "/";

// Tells SchemaMarkup which schemas to emit:
//   homepage            -> WebSite (+ Organization)
//   post (has pubDate)  -> BlogPosting (+ Organization)
//   anything else       -> Organization only
const schemaType = isHomepage ? "website" : pubDatetime ? "article" : "page";

const gaId = SITE.analytics?.googleAnalyticsId ?? "";

// SoftwareApplication schema is for the homepage ONLY (Microsoft Store PWA listing).
const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ReviByte",
  operatingSystem: "Windows",
  applicationCategory: "NewsApplication",
  url: "https://apps.microsoft.com/detail/9p24dh9bh6sh",
  author: {
    "@type": "Person",
    name: "Oke Sunday Samuel",
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<!doctype html>
<html dir={SITE.dir} lang={SITE.lang ?? "en"} class={scrollSmooth ? "scroll-smooth" : undefined}>
  <head>

    <meta charset="UTF-8" />

    <!-- box-sizing reset — must be first to prevent flash -->
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html, body { width: 100%; max-width: 100%; margin: 0; padding: 0; overflow-x: hidden; }
    </style>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ReviByte" />

    <!-- Preconnect to Google Fonts (if you use them) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Theme Handling — critical, must stay blocking to prevent flash -->
    <script is:inline>
      const primaryColorScheme = "";
      function getPreferTheme() {
        const currentTheme = localStorage.getItem("theme");
        if (currentTheme) return currentTheme;
        if (primaryColorScheme) return primaryColorScheme;
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      let themeValue = getPreferTheme();
      function setPreference() { localStorage.setItem("theme", themeValue); reflectPreference(); }
      function reflectPreference() {
        document.documentElement.setAttribute("data-theme", themeValue);
      }
      function togglePWATheme() { themeValue = themeValue === 'dark' ? 'light' : 'dark'; setPreference(); }
      reflectPreference();
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", ({ matches }) => {
        themeValue = matches ? "dark" : "light";
        setPreference();
      });
    </script>

    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content="ReviByte" />
    <meta property="og:locale" content="en_US" />

    {pubDatetime instanceof Date && (
      <meta property="article:published_time" content={pubDatetime.toISOString()} />
    )}
    {modDatetime instanceof Date && (
      <meta property="article:modified_time" content={modDatetime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={socialImageURL} />

    <SchemaMarkup
      type={schemaType}
      title={title}
      description={description}
      url={canonical}
      image={socialImageURL}
      datePublished={pubDatetime}
      dateModified={modDatetime}
      review={review}
    />

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${siteBase}rss.xml`} />

    {PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}

    <!-- gtag stub only. The real gtag.js is loaded late by the idle loader at
         the bottom of <body>. Calls made before it loads are queued in
         dataLayer, so nothing is lost. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>

    <!-- SoftwareApplication schema: HOMEPAGE ONLY -->
    {isHomepage && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(softwareAppSchema)}
      />
    )}

    <!-- Newor Media (Waldo) header script — placed in <head> as their dashboard instructs.
         NOTE: confirm this src is the full URL from your Newor dashboard. -->
    <script is:inline async type="text/javascript" src="https://thisiswaldo.com"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        if (window.wk && typeof window.wk.init === 'function') {
          window.wk.init();
        }
      });
    </script>

  </head>

  <body>
     <InstallBanner />
     <HeliaraAI />
     <GoogleSubscribe />
     <slot name="header" />
     <slot name="top-nav" />

    <!-- ========== COVER IMAGE + AD ========== -->
    {coverImage && (
      <div class="cover-ad-wrapper">
        <OptimizedCoverImage
          src={coverImage}
          alt={coverImageAlt || title}
          width={1200}
          height={630}
          loading="eager"
          sizes="100vw"
        />

        <!-- Adsterra slot (script is loaded by the idle loader below) -->
        <div class="ad-slot ad-slot--bottom">
          <div id="container-100c0408033e7aba877563ba9293a45d"></div>
        </div>

      </div>
    )}

    <slot />

    <!--
      INP FIX — one idle loader for every non-essential third-party script.

      Why this differs from the old version:
      1. It does NOT listen for scroll/touchstart. Those are the start of a
         user interaction, so loading ads then makes the first tap slow.
      2. It waits for window "load", then requestIdleCallback, so the main
         thread is free.
      3. Scripts are staggered ~1s apart instead of all landing at once,
         so no single long task blocks a tap.
    -->
    <script is:inline define:vars={{ gaId }}>
      (function () {
        var started = false;

        function addScript(src, attrs) {
          var s = document.createElement('script');
          s.async = true;
          s.src = src;
          if (attrs) {
            for (var k in attrs) s.setAttribute(k, attrs[k]);
          }
          document.body.appendChild(s);
          return s;
        }

        function loadAnalytics() {
          if (!gaId) return;
          gtag('config', gaId);
          addScript('https://www.googletagmanager.com/gtag/js?id=' + gaId);
        }

        function loadAdSense() {
          // Auto ads: loading the script is enough, no push({}) needed.
          addScript(
            'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4896561037705299',
            { crossorigin: 'anonymous' }
          );
        }

        function loadAdsterra() {
          // Only load if the slot exists on this page.
          if (!document.getElementById('container-100c0408033e7aba877563ba9293a45d')) return;
          addScript(
            'https://pl28410703.effectivecpmnetwork.com/100c0408033e7aba877563ba9293a45d/invoke.js',
            { 'data-cfasync': 'false' }
          );
        }

        function loadOneSignal() {
          if (window.__oneSignalLoaded) return;
          window.__oneSignalLoaded = true;
          var s = addScript('https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js');
          s.async = false;
          s.defer = true;
          s.onload = function () {
            window.OneSignalDeferred = window.OneSignalDeferred || [];
            OneSignalDeferred.push(async function (OneSignal) {
              try {
                await OneSignal.init({
                  appId: "bbd38552-99d1-4cda-96f9-5c0cacfba192",
                  notifyButton: { enable: false },
                  allowLocalhostAsSecureOrigin: true,
                  autoResubscribe: true,
                  promptOptions: {
                    slidedown: {
                      prompts: [{
                        type: "push",
                        autoPrompt: true,
                        text: {
                          actionMessage: "⚡ Stay Ahead in Tech",
                          acceptButtonText: "Allow 🔔",
                          cancelButtonText: "Not Now",
                          confirmMessage: "Hit Allow to get instant updates on new posts, phone comparisons, and buying guides that actually help."
                        },
                        delay: { pageViews: 0, timeDelay: 20 }
                      }]
                    }
                  }
                });
              } catch (e) { console.error("OneSignal init error:", e); }
            });
          };
        }

        function start() {
          if (started) return;
          started = true;
          loadAnalytics();                 // t + 0s
          setTimeout(loadAdSense, 1000);   // t + 1s
          setTimeout(loadAdsterra, 2000);  // t + 2s
          setTimeout(loadOneSignal, 4000); // t + 4s
        }

        function schedule() {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(start, { timeout: 3000 });
          } else {
            setTimeout(start, 2000);
          }
        }

        if (document.readyState === 'complete') {
          schedule();
        } else {
          window.addEventListener('load', schedule, { once: true });
        }
      })();
    </script>

    <!-- PWA Analytics Event -->
    <script is:inline>
      window.addEventListener('load', function() {
        setTimeout(function() {
          if (window.matchMedia('(display-mode: standalone)').matches) {
            if (typeof gtag !== 'undefined') {
              gtag('event', 'pwa_visit', { 'event_category': 'PWA', 'event_label': 'standalone_mode' });
            }
          }
        }, 2000);
      });
    </script>

    <Footer />
    <!-- SIDEBAR — rendered LAST so it's on top of everything -->
    <Sidebar />

    <!-- Sticky Footer (Newor Media) 728x90/320x50 -->
    <div id="waldo-tag-55828"></div>

    <style>
      .cover-ad-wrapper {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 100%;
      }

      .ad-slot {
        display: block;
        width: 100%;
        max-width: 768px;
        margin-left: auto;
        margin-right: auto;
        contain: layout;
      }

      .ad-slot--bottom {
        margin-top: 1rem;
        margin-bottom: 1rem;
        min-height: 250px;
      }

      .cover-ad-wrapper :global(img),
      .cover-ad-wrapper :global(picture) {
        display: block;
        width: 100%;
        height: auto;
        margin: 0;
      }
    </style>
  </body>
</html>
