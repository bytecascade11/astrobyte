---
import { SITE } from "@/config";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

export interface Props {
  title: string;
  description?: string;
  author?: string;
  canonicalURL?: string;
  ogImage?: string;
  scrollSmooth?: boolean;
}

const {
  title,
  description = SITE.desc || "Tech reviews, opinions, and news.",
  author = SITE.author,
  canonicalURL = Astro.url.href,
  ogImage,
  scrollSmooth = true,
} = Astro.props;
---

<html lang="en" class:list={[{ "scroll-smooth": scrollSmooth }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Recommended: prevent zoom on mobile -->
    <meta name="format-detection" content="telephone=no" />

    <!-- Title with site name fallback -->
    <title>{title}</title>

    <!-- Description (very important for SEO & social previews) -->
    <meta name="description" content={description} />

    <!-- Author (good for attribution) -->
    {author && <meta name="author" content={author} />}

    <!-- Canonical URL (prevents duplicate content issues) -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph basics (Facebook, LinkedIn, etc.) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:alt" content={title} />
        <!-- Recommended sizes for better previews -->
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}

    <!-- Twitter Cards (X.com) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Favicon (add your own later) -->
    <link rel="icon" href="/favicon.ico" />
    <!-- Add more: apple-touch-icon, manifest, etc. if needed -->

    <!-- Performance & security headers (optional but recommended) -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />

    <!-- You can add Google Fonts, Tailwind, analytics, etc. here -->
  </head>

  <body class="bg-background text-foreground antialiased">
    <Header />
    <slot />           <!-- ← page content goes here -->
    <Footer />
  </body>
</html>
