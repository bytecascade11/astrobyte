---
// src/layouts/BaseLayout.astro – final fixed version
import { SITE } from "@/config";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

export interface Props {
  title: string;
  description?: string;
  author?: string;
  canonicalURL?: string;
  ogImage?: string;
  scrollSmooth?: boolean;
}

const {
  title,
  description = SITE.desc || "Tech reviews, opinions, and news.",
  author = SITE.author,
  canonicalURL = Astro.url.href,
  ogImage,
  scrollSmooth = true,
} = Astro.props;
---

<html lang="en" class:list={[{ "scroll-smooth": scrollSmooth }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {author && <meta name="author" content={author} />}
    <link rel="canonical" href={canonicalURL} />
    <!-- OG/Twitter tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>

  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only">Skip to main content</a>

    <Header />

    <main id="main-content" class="flex-1">
      <div class="wrapper max-w-app mx-auto px-4">
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>
