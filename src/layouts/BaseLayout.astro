---
// src/layouts/BaseLayout.astro – this version guarantees centering
import { SITE } from "@/config";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE.title || "ReviByte",
  description = SITE.desc || "Tech reviews, opinions, and news.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <!-- This div is what makes the site look good again: centering + padding -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>
