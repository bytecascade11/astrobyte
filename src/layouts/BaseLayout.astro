---
// src/layouts/BaseLayout.astro – final version
import { SITE } from "@/config";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

export interface Props {
  title: string;
  description?: string;
  author?: string;
  canonicalURL?: string;
  ogImage?: string;
  scrollSmooth?: boolean;
}

const {
  title,
  description = SITE.desc || "Tech reviews, opinions, and news.",
  author = SITE.author,
  canonicalURL = Astro.url.href,
  ogImage,
  scrollSmooth = true,
} = Astro.props;
---

<html lang="en" class:list={[{ "scroll-smooth": scrollSmooth }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {author && <meta name="author" content={author} />}
    <link rel="canonical" href={canonicalURL} />

    <!-- OG / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:alt" content={title} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />

    <meta name="color-scheme" content="light dark" />
  </head>

  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col">
    <!-- Accessibility skip link -->
    <a href="#main-content" class="sr-only focus:not-sr-only">
      Skip to main content
    </a>

    <Header />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
