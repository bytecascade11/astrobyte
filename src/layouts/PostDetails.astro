---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import Comments from "@/components/Comments.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";

import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;
const {
  title,
  author,
  description,
  ogImage: initOgImage,
  pubDatetime,
  modDatetime,
  timezone,
  tags = [],
  hideEditPost,
  coverImage,
  coverImageAlt
} = post.data;

const { Content } = await render(post);

// Full post URL with trailing slash – FIXED HERE
const postUrl = `\( {SITE.website} \){getPath(post.id, post.filePath)}/`;

// Dynamic OG Image
let ogImageUrl: string | undefined;
if (coverImage) {
  ogImageUrl = coverImage;
} else if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
} else {
  ogImageUrl = undefined;
}
const ogImage = ogImageUrl ? new URL(ogImageUrl, Astro.url.origin).href : undefined;

// Layout properties
const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL: postUrl,
  ogImage,
  scrollSmooth: true,
};

// Previous / Next post
const allPosts = posts.map(({ data: { title }, id, filePath }) => ({ id, title, filePath }));
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

// Breadcrumbs for Schema
const breadcrumbs = [
  { name: "Home", url: SITE.website },
  { name: "Posts", url: `${SITE.website}posts/` },
  { name: title, url: postUrl }
];
---

<Layout {...layoutProps}>

  <!-- BlogPosting structured data schema -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": "{title}",
      "description": "{description || ''}",
      "image": {
        "@type": "ImageObject",
        "url": "{coverImage ? new URL(coverImage, Astro.url.origin).href : ''}",
        "width": 1200,
        "height": 630
      },
      "url": "{postUrl}",
      "datePublished": "{pubDatetime.toISOString()}",
      "dateModified": "{modDatetime ? modDatetime.toISOString() : pubDatetime.toISOString()}",
      "author": {
        "@type": "Person",
        "name": "iSamuel"
      },
      "publisher": {
        "@type": "Organization",
        "name": "{SITE.title}",
        "url": "{SITE.website}"
      },
      "keywords": "{tags.join(', ')}"
    }
  </script>

  <SchemaMarkup 
    type="article"
    title={title}
    description={description}
    url={postUrl}
    image={ogImage}
    datePublished={pubDatetime.toISOString()}
    dateModified={modDatetime?.toISOString()}
    breadcrumbs={breadcrumbs}
  />

  <Header />

  <Breadcrumbs
    items={[
      { label: "Home", href: "/" },
      { label: "Posts", href: "/posts/" },
      { label: title }
    ]}
  />

  {coverImage && <BackButton />}

  <main
    id="main-content"
    class:list={[
      "app-layout pb-12 mx-auto max-w-app px-4",
      { "mt-8": !coverImage }
    ]}
    data-pagefind-body
  >
    {coverImage && (
      <img
        src={coverImage}
        alt={coverImageAlt || title}
        class="w-full object-cover aspect-video md:aspect-[21/9] rounded-2xl mb-8"
        loading="eager"
        width="1200"
        height="630"
      />
    )}

    <!-- ... rest of your page unchanged: h1, metadata, article, tags, author bio, etc. ... -->

  </main>

  <Footer />
</Layout>
