---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import OptimizedImage from "@/components/OptimizedImage.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import Comments from "@/components/Comments.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";

import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  pubDatetime,
  modDatetime,
  timezone,
  tags = [],
  coverImage,
  coverImageAlt
} = post.data;

const { Content } = await render(post);

const postPath = getPath(post.id, post.filePath);

const websiteBase = SITE.website.endsWith("/")
  ? SITE.website
  : `${SITE.website}/`;

const postUrl = new URL(postPath.startsWith("/") ? postPath.slice(1) : postPath, websiteBase).toString();

let ogImageUrl: string | undefined;

if (coverImage && typeof coverImage === "string" && coverImage.trim() !== "") {
  const cleanPath = coverImage.startsWith("/") ? coverImage.slice(1) : coverImage;
  ogImageUrl = new URL(cleanPath, websiteBase).toString();
} else if (typeof initOgImage === "string" && initOgImage.trim() !== "") {
  const cleanPath = initOgImage.startsWith("/") ? initOgImage.slice(1) : initOgImage;
  ogImageUrl = new URL(cleanPath, websiteBase).toString();
} else if (initOgImage && typeof initOgImage === "object" && "src" in initOgImage) {
  const rawSrc = initOgImage.src;
  const cleanPath = rawSrc.startsWith("/") ? rawSrc.slice(1) : rawSrc;
  ogImageUrl = new URL(cleanPath, websiteBase).toString();
}

const ogImage = ogImageUrl ?? undefined;

const coverImageAbsoluteSrc = coverImage
  ? new URL(
      (coverImage as string).startsWith("/")
        ? (coverImage as string).slice(1)
        : (coverImage as string),
      websiteBase
    ).toString()
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL: postUrl,
  ogImage,
  scrollSmooth: true,
};

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath
}));

const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description || "",
  image: ogImage || "",
  primaryImageOfPage: ogImage
    ? {
        "@type": "ImageObject",
        url: ogImage,
        width: 1200,
        height: 630,
      }
    : undefined,
  url: postUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  datePublished: pubDatetime.toISOString(),
  dateModified: modDatetime
    ? modDatetime.toISOString()
    : pubDatetime.toISOString(),
  author: { "@type": "Person", name: author || SITE.author },
  publisher: {
    "@type": "Organization",
    name: SITE.title,
    url: SITE.website,
    logo: {
      "@type": "ImageObject",
      url: new URL("favicon.svg", websiteBase).toString(),
    },
  },
  keywords: tags.join(", "),
};

const postSlug = post.id;
---

<Layout {...layoutProps}>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(blogPostingSchema)}
  />

  <SchemaMarkup
    type="breadcrumb"
    breadcrumbs={[
      { name: "Home", url: SITE.website },
      { name: "Posts", url: `${websiteBase}posts/` },
      { name: title, url: postUrl },
    ]}
  />
<!-- Progress Bar -->
  <div
    id="progress-bar"
    style="position:fixed;top:0;left:0;z-index:9999;height:2px;width:0%;background:linear-gradient(90deg,#6366f1,#818cf8);transition:width 0.1s linear;"
  ></div>
  <Header />

  <main
    id="main-content"
    class="pb-12 mx-auto w-full max-w-3xl px-4 mt-8"
  >

    <!-- Top nav -->
    <div class="post-top-nav">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Posts", href: "/posts/" },
          { label: title }
        ]}
      />
      <BackButton />
    </div>

    <!-- Cover image -->
    {coverImageAbsoluteSrc && (
      <OptimizedImage
  src={coverImage as string}
  alt={coverImageAlt || title}
  class="post-cover-image"
  loading="eager"
  fetchpriority="high"
  width={1200}
  height={630}
/>
    )}

    
    <!-- Post header -->
    <div class="post-header">
      <h1
        transition:name={slugifyStr(title.replaceAll(".", "-"))}
        class="inline-block text-2xl font-bold text-accent sm:text-3xl md:text-4xl"
      >
        {title}
      </h1>

      <div class="post-meta">
        <div class="post-meta-left">
          <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
          <span class="view-count-badge">
            👁 <span id="view-count">—</span> views
          </span>
        </div>
        <div class="post-share-inline">
          <ShareLinks />
        </div>
      </div>
    </div>

    <!-- Article body -->
    <article class="app-prose mt-4 w-full max-w-none">
      <Content />
    </article>

    <!-- Tags -->
    {tags.length > 0 && (
      <ul class="mt-8 mb-6 flex flex-wrap gap-3">
        {tags.map((tag) => (
          <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
        ))}
      </ul>
    )}

    <BackToTopButton />

    <!-- Author card -->
    <div class="author-card">
      <div class="author-avatar">
        {(SITE.author || "iSamuel").charAt(0).toUpperCase()}
      </div>
      <div class="author-info">
        <p class="author-name">{SITE.author || "iSamuel"}</p>
        <p class="author-bio">
          Founder and lead technology analyst behind ReviByte Opinions.
          Writes practical tech analysis for everyday users in Nigeria and beyond —
          focusing on honest real-world explanations of phones, gadgets, AI and
          how technology works in daily life.
        </p>
        <a href="/about" class="author-link">
          Learn more about iSamuel and ReviByte →
        </a>
      </div>
    </div>

    <!-- AdSense: Before Related Posts (Ad Unit 3) -->
    <ins class="adsbygoogle"
      style="display:block; margin: 1.5rem 0;"
      data-ad-client="ca-pub-4896561037705299"
      data-ad-slot="4282672192"
      data-ad-format="auto"
      data-full-width-responsive="true">
    </ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>

    <!-- Prev / Next -->
    {(prevPost || nextPost) && (
      <nav class="prevnext-nav">
        {prevPost && (
          <a href={getPath(prevPost.id, prevPost.filePath)} class="prevnext-btn">
            <span class="prevnext-label">← Previous</span>
            <span class="prevnext-title">{prevPost.title}</span>
          </a>
        )}
        {nextPost && (
          <a href={getPath(nextPost.id, nextPost.filePath)} class="prevnext-btn prevnext-next">
            <span class="prevnext-label">Next →</span>
            <span class="prevnext-title">{nextPost.title}</span>
          </a>
        )}
      </nav>
    )}

    <RelatedPosts currentPost={post} allPosts={posts} limit={3} />

    <Comments />

  </main>

  <Footer />
</Layout>
<script is:inline>
  const bar = document.getElementById("progress-bar");

  window.addEventListener("scroll", () => {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    if (bar) bar.style.width = progress + "%";
  });
</script>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Popup Banner Demo</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #111;
    font-family: 'DM Sans', sans-serif;
    color: #ccc;
    padding: 24px 16px;
    line-height: 1.7;
  }

  /* fake article content for demo */
  .article {
    max-width: 680px;
    margin: 0 auto;
  }

  .article h1 {
    font-family: 'Syne', sans-serif;
    font-size: 28px;
    color: #fff;
    margin-bottom: 16px;
  }

  .article p {
    color: #888;
    margin-bottom: 16px;
    font-size: 15px;
  }

  /* ── OVERLAY ── */
  .popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .popup-overlay.active {
    opacity: 1;
    pointer-events: all;
  }

  /* ── POPUP ── */
  .popup {
    position: fixed;
    bottom: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 32px);
    max-width: 480px;
    background: #0d0d0d;
    border: 1px solid #1e1e1e;
    border-top: 2px solid #1428A0;
    border-radius: 16px 16px 0 0;
    z-index: 999;
    padding: 20px;
    transition: bottom 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
  }

  .popup.active {
    bottom: 0;
  }

  /* animated top glow */
  .popup::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 60%;
    height: 2px;
    background: linear-gradient(90deg, transparent, #4e6ef2, transparent);
    animation: scanline 2.5s linear infinite;
  }

  @keyframes scanline {
    0% { left: -60%; }
    100% { left: 160%; }
  }

  .popup-close {
    position: absolute;
    top: 12px;
    right: 14px;
    width: 28px;
    height: 28px;
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 50%;
    color: #666;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s;
    line-height: 1;
  }

  .popup-close:hover {
    background: #222;
    color: #fff;
  }

  .popup-sponsored {
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #1428A0;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .popup-body {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .popup-icon {
    font-size: 52px;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 16px rgba(20,40,160,0.4));
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  .popup-info { flex: 1; }

  .popup-title {
    font-family: 'Syne', sans-serif;
    font-size: 16px;
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .popup-specs {
    font-size: 11px;
    color: #555;
    margin-bottom: 10px;
  }

  .popup-specs span { color: #4e6ef2; }

  .popup-btn {
    display: inline-block;
    background: linear-gradient(135deg, #1428A0, #4e6ef2);
    color: #fff;
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    letter-spacing: 0.5px;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .popup-btn:hover { opacity: 0.85; }

  .popup-dismiss {
    text-align: center;
    margin-top: 12px;
    font-size: 10px;
    color: #333;
    cursor: pointer;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .popup-dismiss:hover { color: #555; }

  /* demo note */
  .demo-note {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    background: #1428A0;
    color: #fff;
    font-size: 11px;
    padding: 6px 16px;
    border-radius: 20px;
    white-space: nowrap;
    letter-spacing: 0.5px;
    z-index: 1000;
  }
</style>
</head>
<body>

<div class="demo-note">↓ Scroll down to trigger the popup</div>

<!-- Fake article content for demo -->
<div class="article">
  <h1>Best Budget Android Phones in 2026</h1>
  <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</p>
