---
// src/layouts/PostDetails.astro

import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";

import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[]; // All published posts for prev/next navigation
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags = [],
  hideEditPost,
  coverImage,
  coverImageAlt,
} = post.data;

// Render the Markdown/MDX content
const { Content } = await render(post);

// Resolve OG image URL
let ogImage: string | undefined;

if (typeof initOgImage === "string") {
  ogImage = initOgImage;
} else if (initOgImage?.src) {
  ogImage = initOgImage.src;
}

// Fallback dynamic OG image (if enabled in config)
if (!ogImage && SITE.dynamicOgImage) {
  ogImage = `${getPath(post.id, post.filePath, true)}/open-graph.png`;
}

const ogImageUrl = ogImage ? new URL(ogImage, Astro.url.origin).href : undefined;

// Layout metadata
const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogImageUrl,
  scrollSmooth: true,
};

/* ========== Prev/Next Posts ========== */
const sortedPosts = posts.sort((a, b) => 
  (b.data.modDatetime ?? b.data.pubDatetime).getTime() - 
  (a.data.modDatetime ?? a.data.pubDatetime).getTime()
);

const currentIndex = sortedPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const nextPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

/* ========== Breadcrumbs ========== */
const isBlogRoute = Astro.url.pathname.startsWith("/posts/") || Astro.url.pathname.startsWith("/blog/");
const breadcrumbItems = [
  { name: "Home", url: "/" },
  ...(isBlogRoute ? [{ name: "Blog", url: "/posts/" }] : []),
  { name: title, url: Astro.url.pathname },
];
---

<Layout {...layoutProps}>
  <Header />
  {SITE.showBackButton && <BackButton />}

  <!-- Breadcrumbs -->
  {isBlogRoute && (
    <nav class="mx-auto mt-8 mb-6 w-full max-w-app px-4" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-sm font-light opacity-90">
        {breadcrumbItems.map((item, index) => {
          const isLast = index === breadcrumbItems.length - 1;
          return (
            <>
              <li>
                {isLast ? (
                  <span class="font-medium opacity-75" aria-current="page">
                    {item.name}
                  </span>
                ) : (
                  <a href={item.url} class="hover:opacity-100 opacity-80 transition">
                    {item.name}
                  </a>
                )}
              </li>
              {!isLast && (
                <li>
                  <span class="opacity-60" aria-hidden="true">›</span>
                </li>
              )}
            </>
          );
        })}
      </ol>
    </nav>
  )}

  <!-- Breadcrumb Structured Data (JSON-LD) -->
  {isBlogRoute && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: new URL(item.url, Astro.url.origin).href,
      })),
    })} />
  )}

  <!-- Floating Controls -->
  <div class="fixed top-20 right-4 z-50 flex flex-col gap-4 md:top-24">
    <BackToTopButton class="rounded-full bg-background/90 backdrop-blur-sm p-3 shadow-lg" />
    
    <div class="flex flex-col gap-3 rounded-lg bg-background/90 backdrop-blur-sm p-4 shadow-lg border border-border">
      <span class="text-sm font-medium opacity-80">Share</span>
      <ShareLinks title={title} url={Astro.url.href} />
    </div>
  </div>

  <main
    id="main-content"
    class="mx-auto w-full max-w-app px-4 pb-12 mt-8"
    data-pagefind-body
  >
    <h1
      transition:name={slugifyStr(title)}
      class="text-2xl sm:text-3xl font-bold text-accent inline-block"
    >
      {title}
    </h1>

    <div class="my-2 flex flex-wrap items-center gap-3 text-sm">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      
      {SITE.editPost?.enabled && !hideEditPost && (
        <>
          <span class="max-sm:hidden opacity-60" aria-hidden="true">|</span>
          <EditPost {post} class="max-sm:hidden" />
        </>
      )}
    </div>

    <!-- Cover Image -->
    {coverImage && (
      <figure class="mt-10 mb-12 overflow-hidden rounded-xl shadow-xl">
        <img
          src={typeof coverImage === "string" ? coverImage : coverImage.src}
          alt={coverImageAlt || title}
          class="w-full object-cover aspect-video md:aspect-[21/9]"
          loading="eager"
          width="1200"
          height="630"
        />
        {coverImageAlt && <figcaption class="text-center text-sm opacity-70 mt-2">{coverImageAlt}</figcaption>}
      </figure>
    )}

    <!-- Article Content -->
    <article
      id="article"
      class="app-prose mx-auto mt-12 prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>

    <hr class="my-12 border-dashed border-border/50" />

    <!-- Mobile Edit Link -->
    {SITE.editPost?.enabled && !hideEditPost && <EditPost class="sm:hidden mb-8" {post} />}

    <!-- Tags -->
    {tags.length > 0 && (
      <ul class="mt-4 mb-8 flex flex-wrap gap-3">
        {tags.map((tag) => (
          <li>
            <Tag tag={slugifyStr(tag)} tagName={tag} size="md" />
          </li>
        ))}
      </ul>
    )}

    <hr class="my-12 border-dashed border-border/50" />

    <!-- Comments -->
    <section aria-label="Comments" class="mt-16">
      <h2 class="text-2xl font-bold mb-8">Comments</h2>
      <div class="giscus"></div>
    </section>

    <hr class="my-12 border-dashed border-border/50" />

    <!-- Prev/Next Navigation -->
    <nav class="grid grid-cols-1 sm:grid-cols-2 gap-8" aria-label="Post navigation">
      {prevPost && (
        <a
          href={getPath(prevPost.id, prevPost.filePath)}
          class="flex items-center gap-3 hover:opacity-75 transition"
        >
          <IconChevronLeft class="w-6 h-6 flex-none rtl:rotate-180" />
          <div>
            <div class="text-sm opacity-70">Previous</div>
            <div class="font-medium">{prevPost.data.title}</div>
          </div>
        </a>
      )}

      {nextPost && (
        <a
          href={getPath(nextPost.id, nextPost.filePath)}
          class="flex items-center justify-end gap-3 text-right hover:opacity-75 transition sm:col-start-2"
        >
          <div>
            <div class="text-sm opacity-70">Next</div>
            <div class="font-medium">{nextPost.data.title}</div>
          </div>
          <IconChevronRight class="w-6 h-6 flex-none rtl:rotate-180" />
        </a>
      )}
    </nav>
  </main>

  <Footer />

  <!-- Client-side Enhancements -->
  <script is:inline data-astro-rerun>
    // Reading progress bar
    const progressBar = document.createElement("div");
    progressBar.id = "reading-progress";
    progressBar.className = "fixed top-0 left-0 h-1 bg-accent z-50 transition-all duration-150";
    document.body.prepend(progressBar);

    const updateProgress = () => {
      const { scrollTop, scrollHeight } = document.documentElement;
      const height = scrollHeight - window.innerHeight;
      const progress = (scrollTop / height) * 100;
      progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    };

    window.addEventListener("scroll", updateProgress);
    document.addEventListener("astro:page-load", updateProgress);

    // Anchor links on headings
    document.querySelectorAll("h2[id], h3[id], h4[id]").forEach(heading => {
      heading.classList.add("group", "relative");
      const link = document.createElement("a");
      link.href = `#${heading.id}`;
      link.className = "absolute -left-6 opacity-0 group-hover:opacity-100 transition opacity-75 pr-2";
      link.innerHTML = "#";
      link.setAttribute("aria-label", `Permalink to ${heading.textContent}`);
      heading.prepend(link);
    });

    // Copy buttons for code blocks
    document.querySelectorAll("pre").forEach(pre => {
      const button = document.createElement("button");
      button.className = "copy-btn absolute top-2 right-2 px-3 py-1 text-xs bg-muted border rounded opacity-80 hover:opacity-100";
      button.textContent = "Copy";
      button.onclick = async () => {
        const code = pre.querySelector("code")?.innerText || "";
        await navigator.clipboard.writeText(code);
        button.textContent = "Copied!";
        setTimeout(() => button.textContent = "Copy", 2000);
      };
      pre.style.position = "relative";
      pre.appendChild(button);
    });

    // Scroll to top after view transition
    document.addEventListener("astro:after-swap", () => {
      window.scrollTo(0, 0);
    });
  </script>
</Layout>
