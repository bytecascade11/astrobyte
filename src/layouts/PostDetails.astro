    width: 100%;
    object-fit: cover;
    aspect-ratio: 16/9;
    display: block;
    border-radius: 16px;
    margin-bottom: 1.75rem;
  }

  @media (min-width: 768px) {
    .post-cover-image {
      aspect-ratio: 21/9;
    }
  }

  /* ── Post header ── */
  .post-header {
    margin-bottom: 1.5rem;
  }

