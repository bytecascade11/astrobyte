---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import ShareLinks from "@/components/ShareLinks.astro";

import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;
const {
  title,
  author,
  description,
  ogImage: initOgImage,
  pubDatetime,
  modDatetime,
  timezone,
  tags = [],
  hideEditPost,
  coverImage,
  coverImageAlt,
} = post.data;

const { Content } = await render(post);

// OG image
let ogImage: string | undefined;
if (typeof initOgImage === "string") ogImage = initOgImage;
else if (initOgImage?.src) ogImage = initOgImage.src;
if (!ogImage && coverImage) ogImage = coverImage;
if (!ogImage) ogImage = "/astropaper-og.jpg";

const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.url.origin).href
  : undefined;

// Canonical
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Prev / Next
const sortedPosts = [...posts].sort(
  (a, b) =>
    (b.data.modDatetime ?? b.data.pubDatetime).getTime() -
    (a.data.modDatetime ?? a.data.pubDatetime).getTime()
);
const currentIndex = sortedPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const nextPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
---

<Layout
  title={`${title} | ${SITE.title}`}
  author={author}
  description={description}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  canonicalURL={canonicalUrl}
  ogImage={ogImageUrl}
>
  <Header />

  <!-- Floating Share + Back-to-Top buttons (JS-only for normal browsers) -->
  <div class="js-only fixed top-20 right-4 z-50 flex flex-col gap-4">
    <BackToTopButton class="rounded-full p-3 shadow-lg bg-background/90" />
    <div class="rounded-lg p-4 shadow-lg bg-background/90">
      <span class="text-sm opacity-80">Share</span>
      <ShareLinks title={title} url={Astro.url.href} />
    </div>
  </div>

  <!-- Fallback for Opera Mini / no-JS -->
  <noscript>
    <p class="text-sm opacity-70 mt-4">
      Use your browser’s share feature to share this post.
    </p>
  </noscript>

  <main class="mx-auto max-w-app px-4 pb-12 mt-8" data-pagefind-body>
    <h1 class="text-3xl font-bold">{title}</h1>

    <div class="my-4 text-sm">
      <Datetime pubDatetime={pubDatetime} modDatetime={modDatetime} timezone={timezone} />
    </div>

    {coverImage && (
      <figure class="my-12">
        <img
          src={coverImage}
          alt={coverImageAlt || title}
          width="1200"
          height="630"
          loading="lazy"
        />
        {coverImageAlt && (
          <figcaption class="mt-2 text-sm opacity-70">
            {coverImageAlt}
          </figcaption>
        )}
      </figure>
    )}

    <!-- MAIN CONTENT -->
    <article class="app-prose mx-auto mt-10">
      <Content />
    </article>

    {tags.length > 0 && (
      <section class="my-10">
        <ul class="flex flex-wrap gap-2">
          {tags.map(tag => (
            <li>
              <Tag tag={slugifyStr(tag)} tagName={tag} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- COMMENTS -->
    <section class="my-16">
      <h2 class="text-xl font-bold mb-4">Comments</h2>

      <noscript>
        <p>
          Comments are disabled on low-data browsers like Opera Mini.
          Please open this page in Chrome or Firefox to comment.
        </p>
      </noscript>

      <div class="js-only">
        <script
          src="https://giscus.app/client.js"
          data-repo="bytecascade11/astrobyte"
          data-repo-id="R_kgDOQobjBQ"
          data-category="Announcements"
          data-category-id="DIC_kwDOQobjBc4C0Dd4"
          data-mapping="pathname"
          data-reactions-enabled="1"
          data-theme="preferred_color_scheme"
          async>
        </script>
      </div>
    </section>

    <RelatedPosts post={post} />

    <section class="my-16">
      <h2 class="text-xl font-bold mb-8">Continue Reading</h2>

      <div class="flex flex-col md:flex-row gap-8">
        {prevPost && (
          <a href={getPath(prevPost.id, prevPost.filePath)}>
            <IconChevronLeft class="inline w-4 h-4" />
            {prevPost.data.title}
          </a>
        )}

        {nextPost && (
          <a href={getPath(nextPost.id, nextPost.filePath)}>
            {nextPost.data.title}
            <IconChevronRight class="inline w-4 h-4" />
          </a>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
