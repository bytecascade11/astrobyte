---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import Comments from "@/components/Comments.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";

import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;
const {
  title,
  author,
  description,
  ogImage: initOgImage,
  pubDatetime,
  modDatetime,
  timezone,
  tags = [],
  hideEditPost,
  coverImage,
  coverImageAlt
} = post.data;

const { Content } = await render(post);

// Full post URL with trailing slash (canonical + OG)
const postUrl = `${SITE.website}${getPath(post.id, post.filePath)}/`;

// Dynamic OG Image
let ogImageUrl: string | undefined;
if (coverImage) {
  ogImageUrl = coverImage;
} else if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
} else {
  ogImageUrl = undefined; // No fallback to homepage image
}
const ogImage = ogImageUrl ? new URL(ogImageUrl, Astro.url.origin).href : undefined;

// Layout properties
const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL: postUrl, // Trailing slash enforced
  ogImage,
  scrollSmooth: true,
};

// Previous / Next post navigation
const allPosts = posts.map(({ data: { title }, id, filePath }) => ({ id, title, filePath }));
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

// Breadcrumbs for Schema
const breadcrumbs = [
  { name: "Home", url: SITE.website },
  { name: "Posts", url: `${SITE.website}posts/` },
  { name: title, url: postUrl }
];
---

<Layout {...layoutProps}>
  <!-- Schema / JSON-LD -->
  <SchemaMarkup 
    type="article"
    title={title}
    description={description}
    url={postUrl}
    image={ogImage}
    datePublished={pubDatetime.toISOString()}
    dateModified={modDatetime?.toISOString()}
    breadcrumbs={breadcrumbs}
  />

  <Header />

  <Breadcrumbs
    items={[
      { label: "Home", href: "/" },
      { label: "Posts", href: "/posts/" },
      { label: title }
    ]}
  />

  {coverImage && <BackButton />}

  <main
    id="main-content"
    class:list={[
      "app-layout pb-12 mx-auto max-w-app px-4",
      { "mt-8": !coverImage }
    ]}
    data-pagefind-body
  >
    {coverImage && (
      <img
        src={coverImage}
        alt={coverImageAlt || title}
        class="w-full object-cover aspect-video md:aspect-[21/9] rounded-2xl mb-8"
        loading="eager"
        width="1200"
        height="630"
      />
    )}

    <h1
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="inline-block text-2xl font-bold text-accent sm:text-3xl md:text-4xl"
    >
      {title}
    </h1>

    <div class="mt-3 mb-8 flex flex-wrap items-center gap-3 text-sm">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      {!hideEditPost && SITE.editPost?.enabled && (
        <>
          <span aria-hidden="true" class="max-sm:hidden text-muted-foreground">•</span>
          <EditPost {hideEditPost} {post} class="max-sm:hidden" />
        </>
      )}
    </div>

    <article
      id="article"
      class="app-prose mt-2 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>

    <hr class="my-10 border-dashed" />

    <EditPost class="sm:hidden mb-8" {hideEditPost} {post} />

    {tags.length > 0 && (
      <ul class="mb-10 flex flex-wrap gap-3">
        {tags.map((tag) => (
          <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
        ))}
      </ul>
    )}

    <BackToTopButton />
    <ShareLinks />

    <hr class="my-10 border-dashed" />

    {(prevPost || nextPost) && (
      <nav
        aria-label="Post navigation"
        class="grid grid-cols-1 gap-6 sm:grid-cols-2 mb-12"
        data-pagefind-ignore
      >
        {prevPost && (
          <a href={getPath(prevPost.id, prevPost.filePath)} class="group flex items-center gap-3 hover:opacity-90 transition">
            <IconChevronLeft class="flex-none w-5 h-5 rtl:rotate-180" />
            <div>
              <div class="text-sm text-muted-foreground">Previous</div>
              <div class="font-medium text-accent group-hover:underline">{prevPost.title}</div>
            </div>
          </a>
        )}

        {nextPost && (
          <a href={getPath(nextPost.id, nextPost.filePath)} class="group flex items-center justify-end gap-3 text-right hover:opacity-90 transition sm:col-start-2">
            <div>
              <div class="text-sm text-muted-foreground">Next</div>
              <div class="font-medium text-accent group-hover:underline">{nextPost.title}</div>
            </div>
            <IconChevronRight class="flex-none w-5 h-5 rtl:rotate-180" />
          </a>
        )}
      </nav>
    )}

    <RelatedPosts currentPost={post} allPosts={posts} limit={3} />
    <hr class="my-10 border-dashed" />
    <Comments />
  </main>

  <Footer />
</Layout>
