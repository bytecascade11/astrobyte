---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import Comments from "@/components/Comments.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";

import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  pubDatetime,
  modDatetime,
  timezone,
  tags = [],
  coverImage,
  coverImageAlt
} = post.data;

const { Content } = await render(post);

const postPath = getPath(post.id, post.filePath);

// ── Ensure website base always has a trailing slash for safe URL joining ──
const websiteBase = SITE.website.endsWith("/")
  ? SITE.website
  : `${SITE.website}/`;

const postUrl = new URL(postPath.startsWith("/") ? postPath.slice(1) : postPath, websiteBase).toString();

// ── Resolve ogImage to a full absolute URL ──
let ogImageUrl: string | undefined;

if (coverImage && typeof coverImage === "string" && coverImage.trim() !== "") {
  const cleanPath = coverImage.startsWith("/") ? coverImage.slice(1) : coverImage;
  ogImageUrl = new URL(cleanPath, websiteBase).toString();
} else if (typeof initOgImage === "string" && initOgImage.trim() !== "") {
  const cleanPath = initOgImage.startsWith("/") ? initOgImage.slice(1) : initOgImage;
  ogImageUrl = new URL(cleanPath, websiteBase).toString();
} else if (initOgImage && typeof initOgImage === "object" && "src" in initOgImage) {
  const rawSrc = initOgImage.src;
  const cleanPath = rawSrc.startsWith("/") ? rawSrc.slice(1) : rawSrc;
  ogImageUrl = new URL(cleanPath, websiteBase).toString();
}

const ogImage = ogImageUrl ?? undefined;

// ── Absolute cover image src for the <img> tag ──
const coverImageAbsoluteSrc = coverImage
  ? new URL(
      (coverImage as string).startsWith("/")
        ? (coverImage as string).slice(1)
        : (coverImage as string),
      websiteBase
    ).toString()
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL: postUrl,
  ogImage,
  scrollSmooth: true,
};

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath
}));

const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

// ── Schema: BlogPosting with primaryImageOfPage for Google Images ──
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description || "",
  image: ogImage || "",
  primaryImageOfPage: ogImage
    ? {
        "@type": "ImageObject",
        url: ogImage,
        width: 1200,
        height: 630,
      }
    : undefined,
  url: postUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  datePublished: pubDatetime.toISOString(),
  dateModified: modDatetime
    ? modDatetime.toISOString()
    : pubDatetime.toISOString(),
  author: { "@type": "Person", name: author || SITE.author },
  publisher: {
    "@type": "Organization",
    name: SITE.title,
    url: SITE.website,
    logo: {
      "@type": "ImageObject",
      url: new URL("favicon.svg", websiteBase).toString(),
    },
  },
  keywords: tags.join(", "),
};

const postSlug = post.id;
---

<Layout {...layoutProps}>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(blogPostingSchema)}
  />

  <!-- ── BreadcrumbList schema for GSC Enhancements ── -->
  <SchemaMarkup
    type="breadcrumb"
    breadcrumbs={[
      { name: "Home", url: SITE.website },
      { name: "Posts", url: `${websiteBase}posts/` },
      { name: title, url: postUrl },
    ]}
  />

  <Header />

  <main
    id="main-content"
    class:list={[
      "pb-12 mx-auto w-full max-w-5xl px-4",
      { "mt-8": !coverImage }
    ]}
  >

    <!-- ── Article Glass Card ── -->
    <div class="article-card">

      <!-- Breadcrumbs + Back Button INSIDE the card so they share the white bg -->
      <div class="card-top-nav">
        <Breadcrumbs
          items={[
            { label: "Home", href: "/" },
            { label: "Posts", href: "/posts/" },
            { label: title }
          ]}
        />
        <BackButton />
      </div>

     {coverImageAbsoluteSrc && (
  <img
    src={coverImageAbsoluteSrc}
    alt={coverImageAlt || title}
    class="post-cover-image"
    loading="eager"
    fetchpriority="high"
    width="1200"
    height="630"
  />
)}

{post.id === "revibyte-121-days-later" && <MilestoneBadge />}

      <!-- Post header: title, date, views + Share right here -->
      <div class="post-header">
        <h1
          transition:name={slugifyStr(title.replaceAll(".", "-"))}
          class="inline-block text-2xl font-bold text-accent sm:text-3xl md:text-4xl"
        >
          {title}
        </h1>

        <div class="post-meta">
          <div class="post-meta-left">
            <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
            <span class="view-count-badge">
              👁 <span id="view-count">—</span> views
            </span>
          </div>
          <div class="post-share-inline">
            <ShareLinks />
          </div>
        </div>
      </div>

      <article class="app-prose mt-2 w-full max-w-none">
        <Content />
      </article>

      <hr class="article-hr" />

      <!-- Tags -->
      {tags.length > 0 && (
        <ul class="mb-6 flex flex-wrap gap-3">
          {tags.map((tag) => (
            <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
          ))}
        </ul>
      )}

      <BackToTopButton />

    </div>
    <!-- ── End Article Glass Card ── -->

    <!-- About Author -->
    <div class="author-card">
      <div class="author-avatar">
        {(SITE.author || "iSamuel").charAt(0).toUpperCase()}
      </div>
      <div class="author-info">
        <p class="author-name">{SITE.author || "iSamuel"}</p>
        <p class="author-bio">
          Founder and lead technology analyst behind ReviByte Opinions.
          Writes practical tech analysis for everyday users in Nigeria and beyond —
          focusing on honest real-world explanations of phones, gadgets, AI and
          how technology works in daily life.
        </p>
        <a href="/about" class="author-link">
          Learn more about iSamuel and ReviByte →
        </a>
      </div>
    </div>

    <!-- Prev / Next -->
    {(prevPost || nextPost) && (
      <nav class="prevnext-nav">
        {prevPost && (
          <a href={getPath(prevPost.id, prevPost.filePath)} class="prevnext-btn">
            <span class="prevnext-label">← Previous</span>
            <span class="prevnext-title">{prevPost.title}</span>
          </a>
        )}
        {nextPost && (
          <a href={getPath(nextPost.id, nextPost.filePath)} class="prevnext-btn prevnext-next">
            <span class="prevnext-label">Next →</span>
            <span class="prevnext-title">{nextPost.title}</span>
          </a>
        )}
      </nav>
    )}

    <RelatedPosts currentPost={post} allPosts={posts} limit={3} />

    <hr class="article-hr mt-10" />
    <Comments />

  </main>

  <Footer />
</Layout>

<style>
  /* ── Article Glass Card ── */
  .article-card {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(99, 102, 241, 0.12);
    border-radius: 20px;
    padding: 0;
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.06),
      0 1px 0 rgba(255,255,255,0.8) inset;
    margin-bottom: 1.5rem;
    overflow: hidden;
  }

  [data-theme="dark"] .article-card {
    background: rgba(15, 23, 42, 0.75);
    border-color: rgba(99, 102, 241, 0.18);
    box-shadow:
      0 4px 32px rgba(0, 0, 0, 0.3),
      0 1px 0 rgba(255,255,255,0.04) inset;
  }

  /* ── Top nav (breadcrumbs + back button) inside card ── */
  .card-top-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem 0.75rem;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(99, 102, 241, 0.08);
  }

  @media (max-width: 640px) {
    .card-top-nav {
      padding: 1rem 1rem 0.65rem;
    }
  }

  /* ── Cover image flush inside card ── */
  .post-cover-image {
    width: 100%;
    object-fit: cover;
    aspect-ratio: 16/9;
    display: block;
  }

  @media (min-width: 768px) {
    .post-cover-image {
      aspect-ratio: 21/9;
    }
  }

  /* ── Post header section ── */
  .post-header {
    padding: 2rem 2.5rem 0;
  }

  @media (max-width: 640px) {
    .post-header {
      padding: 1.25rem 1rem 0;
    }
  }

  /* ── Meta row ── */
  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .post-meta-left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .view-count-badge {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    opacity: 0.65;
  }

  .post-share-inline {
    display: flex;
    align-items: center;
  }

  /* Article body padding */
  .article-card article {
    padding: 0 2.5rem 0.5rem;
  }

  @media (max-width: 640px) {
    .article-card article {
      padding: 0 1rem 0.5rem;
    }
  }

  /* Tags + BackToTop padding */
  .article-card > ul,
  .article-card > :global(.back-to-top) {
    padding-left: 2.5rem;
    padding-right: 2.5rem;
  }

  @media (max-width: 640px) {
    .article-card > ul,
    .article-card > :global(.back-to-top) {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }

  /* HR inside card */
  .article-hr {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(99,102,241,0.25), transparent);
    margin: 2rem 2.5rem;
  }

  @media (max-width: 640px) {
    .article-hr {
      margin: 1.5rem 1rem;
    }
  }

  /* ── Table horizontal scroll fix ── */
  .article-card :global(table) {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    white-space: nowrap;
    max-width: 100%;
  }

  /* ── Author Card ── */
  .author-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(99, 102, 241, 0.12);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 2px 16px rgba(0,0,0,0.05);
  }

  [data-theme="dark"] .author-card {
    background: rgba(15, 23, 42, 0.65);
    border-color: rgba(99, 102, 241, 0.18);
    box-shadow: 0 2px 16px rgba(0,0,0,0.2);
  }

  .author-avatar {
    width: 52px;
    height: 52px;
    min-width: 52px;
    border-radius: 14px;
    background: linear-gradient(135deg, #6366f1, #818cf8);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    font-weight: 800;
    color: white;
    box-shadow: 0 4px 12px rgba(99,102,241,0.3);
  }

  .author-info {
    flex: 1;
  }

  .author-name {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }

  .author-bio {
    font-size: 0.85rem;
    line-height: 1.65;
    opacity: 0.7;
    margin-bottom: 0.75rem;
  }

  .author-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: #6366f1;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .author-link:hover {
    opacity: 0.75;
  }

  /* ── Prev / Next ── */
  .prevnext-nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 640px) {
    .prevnext-nav {
      grid-template-columns: 1fr 1fr;
    }
  }

  .prevnext-btn {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.25rem;
    background: rgba(255,255,255,0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(99,102,241,0.12);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  [data-theme="dark"] .prevnext-btn {
    background: rgba(15,23,42,0.6);
    border-color: rgba(99,102,241,0.18);
  }

  .prevnext-btn:hover {
    border-color: #6366f1;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(99,102,241,0.15);
  }

  .prevnext-next {
    text-align: right;
  }

  .prevnext-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6366f1;
  }

  .prevnext-title {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    opacity: 0.85;
  }
</style>

<script is:inline define:vars={{ postSlug }}>
  const SUPABASE_URL = "https://tfkrjruxqiqpaoeckfoh.supabase.co";
  const SUPABASE_KEY = "sb_publishable_fHguT58pKc7MsxhSvNpb6w_T2Xg_U_G";

  async function getAndIncrementViews(slug) {
    try {
      await fetch(`${SUPABASE_URL}/rest/v1/rpc/increment_views`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "apikey": SUPABASE_KEY,
          "Authorization": `Bearer ${SUPABASE_KEY}`,
        },
        body: JSON.stringify({ post_slug: slug }),
      });

      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/post_views?slug=eq.${encodeURIComponent(slug)}&select=views`,
        {
          headers: {
            "apikey": SUPABASE_KEY,
            "Authorization": `Bearer ${SUPABASE_KEY}`,
          },
        }
      );

      const data = await res.json();
      const views = data?.[0]?.views ?? 0;
      const el = document.getElementById("view-count");
      if (el) el.textContent = views.toLocaleString();
    } catch {
      const el = document.getElementById("view-count");
      if (el) el.textContent = "—";
    }
  }

  getAndIncrementViews(postSlug);
</script>
