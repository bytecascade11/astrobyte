---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";
import AffiliateCarousel from "@/components/AffiliateCarousel.astro";
import Comments from "@/components/Comments.astro";

import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  pubDatetime,
  modDatetime,
  timezone,
  tags = [],
  coverImage,
  coverImageAlt
} = post.data;

const { Content } = await render(post);

const postPath = getPath(post.id, post.filePath);

const websiteBase = SITE.website.endsWith("/")
  ? SITE.website
  : `${SITE.website}/`;

const postUrl = new URL(postPath.startsWith("/") ? postPath.slice(1) : postPath, websiteBase).toString();

let ogImageUrl: string | undefined;

if (coverImage && typeof coverImage === "string" && coverImage.trim() !== "") {
  const cleanPath = coverImage.startsWith("/") ? coverImage.slice(1) : coverImage;
  ogImageUrl = new URL(cleanPath, websiteBase).toString();
} else if (typeof initOgImage === "string" && initOgImage.trim() !== "") {
  const cleanPath = initOgImage.startsWith("/") ? initOgImage.slice(1) : initOgImage;
  ogImageUrl = new URL(cleanPath, websiteBase).toString();
} else if (initOgImage && typeof initOgImage === "object" && "src" in initOgImage) {
  const rawSrc = initOgImage.src;
  const cleanPath = rawSrc.startsWith("/") ? rawSrc.slice(1) : rawSrc;
  ogImageUrl = new URL(cleanPath, websiteBase).toString();
}

const ogImage = ogImageUrl ?? undefined;

const coverImageAbsoluteSrc = coverImage
  ? new URL(
      (coverImage as string).startsWith("/")
        ? (coverImage as string).slice(1)
        : (coverImage as string),
      websiteBase
    ).toString()
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL: postUrl,
  ogImage,
  scrollSmooth: true,
  coverImage: coverImageAbsoluteSrc,
  coverImageAlt: coverImageAlt || title,
};

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath
}));

const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description || "",
  image: ogImage || "",
  primaryImageOfPage: ogImage
    ? {
        "@type": "ImageObject",
        url: ogImage,
        width: 1200,
        height: 630,
      }
    : undefined,
  url: postUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  datePublished: pubDatetime.toISOString(),
  dateModified: modDatetime
    ? modDatetime.toISOString()
    : pubDatetime.toISOString(),
  author: { "@type": "Person", name: author || SITE.author },
  publisher: {
    "@type": "Organization",
    name: SITE.title,
    url: SITE.website,
    logo: {
      "@type": "ImageObject",
      url: new URL("favicon.svg", websiteBase).toString(),
    },
  },
  keywords: tags.join(", "),
};

const postSlug = post.id;
---

<Layout {...layoutProps}>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(blogPostingSchema)}
  />

  <SchemaMarkup
    type="breadcrumb"
    breadcrumbs={[
      { name: "Home", url: SITE.website },
      { name: "Posts", url: `${websiteBase}posts/` },
      { name: title, url: postUrl },
    ]}
  />

  <!-- Progress Bar -->
  <div
    id="progress-bar"
    style="position:fixed;top:0;left:0;z-index:9999;height:2px;width:0%;background:linear-gradient(90deg,#6366f1,#818cf8);transition:width 0.1s linear;"
  ></div>

  <Header slot="header" />

  <div class="post-top-nav mx-auto w-full max-w-3xl px-4 mt-8" slot="top-nav">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Posts", href: "/posts/" },
        { label: title }
      ]}
    />
    <BackButton />
  </div>

  <main
    id="main-content"
    class="pb-12 mx-auto w-full max-w-3xl px-4 mt-8"
  >

    <!-- Post header -->
    <div class="post-header">
      <h1
        transition:name={slugifyStr(title.replaceAll(".", "-"))}
        class="inline-block text-2xl font-bold text-accent sm:text-3xl md:text-4xl"
      >
        {title}
      </h1>

      <div class="post-meta">
        <div class="post-meta-left">
          <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
          
        </div>
        <div class="post-share-inline">
          <ShareLinks />
        </div>
      </div>
    </div>

    <!-- Article body -->
    <article class="app-prose mt-4 w-full max-w-none">
      <Content />
    </article>

    <!-- Tags -->
    {tags.length > 0 && (
      <ul class="mt-8 mb-6 flex flex-wrap gap-3">
        {tags.map((tag) => (
          <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
        ))}
      </ul>
    )}

    <BackToTopButton />

    <!-- Author card -->
    <div class="author-card">
      <img src="/assets/isamuel.jpg" alt={SITE.author || "iSamuel"} class="author-avatar" />
      <div class="author-info">
        <p class="author-name">{SITE.author || "iSamuel"}</p>
        <p class="author-bio">
          Founder and lead technology analyst behind ReviByte Opinions.
          Writes practical tech analysis for everyday users in Nigeria and beyond —
          focusing on honest real-world explanations of phones, gadgets, AI and
          how technology works in daily life.
        </p>
        <a href="/about" class="author-link">
          Learn more about iSamuel and ReviByte →
        </a>
      </div>
    </div>

    <!-- AdSense: Before Related Posts -->
    <div style="margin: 1.5rem 0; min-height: 300px; contain: layout;">
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4896561037705299"
     crossorigin="anonymous"></script>
<ins class="adsbygoogle"
     style="display:block"
     data-ad-format="fluid"
     data-ad-layout-key="-gj-29-23-9s+140"
     data-ad-client="ca-pub-4896561037705299"
     data-ad-slot="4900787080"></ins>
<script is:inline>
           (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
      
    </div>

    <!-- Prev / Next -->
    {(prevPost || nextPost) && (
      <nav class="prevnext-nav">
        {prevPost && (
          <a href={getPath(prevPost.id, prevPost.filePath)} class="prevnext-btn">
            <span class="prevnext-label">← Previous</span>
            <span class="prevnext-title">{prevPost.title}</span>
          </a>
        )}
        {nextPost && (
          <a href={getPath(nextPost.id, nextPost.filePath)} class="prevnext-btn prevnext-next">
            <span class="prevnext-label">Next →</span>
            <span class="prevnext-title">{nextPost.title}</span>
          </a>
        )}
      </nav>
    )}

    <RelatedPosts currentPost={post} allPosts={posts} limit={3} />
<AffiliateCarousel />

    <!-- Adsterra: Above Comments -->
    <div style="margin: 1.5rem 0; min-height: 50px; display:flex; justify-content:center; contain: layout;">
      <script is:inline>
        atOptions = {
          'key' : '2b0c33ae294502978b9bfb23cc9b43f0',
          'format' : 'iframe',
          'height' : 50,
          'width' : 320,
          'params' : {}
        };
      </script>

    </div>

<script>
(function(zayesp){
var d = document,
    s = d.createElement('script'),
    l = d.scripts[d.scripts.length - 1];
s.settings = zayesp || {};
s.src = "\/\/unfoldedtrade.com\/b.XmVMsvdTGqlm0FYxWBcB\/Jejmd9uumZ\/UzljkIPATuY\/4wMkzEM\/0tNJjrE-t_NsjqgdzUMoz\/Qx2wN\/Qq";
s.async = true;
s.referrerPolicy = 'no-referrer-when-downgrade';
l.parentNode.insertBefore(s, l);
})({})
</script>

    <Comments slug={post.id} />
  </main>

  <Footer />

<!-- WhatsApp Channel Side Banner -->
  <div id="rb-side-banner" style="position:fixed;right:12px;bottom:80px;z-index:990;width:160px;background:#0d0d0d;border:1px solid #1e1e1e;border-top:2px solid #25D366;border-radius:12px;padding:12px;box-shadow:0 4px 20px rgba(0,0,0,0.4);">
    <button onclick="document.getElementById('rb-side-banner').style.display='none'" style="position:absolute;top:6px;right:8px;background:none;border:none;color:#fff;font-size:12px;cursor:pointer;">✕</button>
    <div style="font-size:8px;letter-spacing:1.5px;text-transform:uppercase;color:#fff;font-weight:600;margin-bottom:8px;">Join Us</div>
    <div style="font-size:13px;font-weight:800;color:#fff;margin-bottom:4px;">ReviByte on WhatsApp</div>
    <div style="font-size:10px;color:#888;margin-bottom:10px;">Daily gaming & tech updates</div>
    <a href="https://whatsapp.com/channel/0029VbBCXzRKAwEdcyip8841" target="_blank" rel="noopener" style="display:block;background:linear-gradient(135deg,#075E54,#25D366);color:#fff;font-size:10px;font-weight:700;padding:8px;border-radius:6px;text-decoration:none;text-align:center;">Join Channel →</a>
  </div>

  <!-- Progress Bar script only -->
  <script is:inline>
    (function () {
      const bar = document.getElementById("progress-bar");
      function updateBar() {
        const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (bar && docHeight > 0) bar.style.width = ((scrollY / docHeight) * 100) + "%";
      }
      window.addEventListener('scroll', updateBar, { passive: true });
    })();
  </script>
</Layout>



<style>
  /* ── Top nav ── */
  .post-top-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  /* ── Post header ── */
  .post-header {
    margin-bottom: 1.5rem;
  }

  /* ── Meta row ── */
  .post-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 0.85rem;
    margin-bottom: 0.5rem;
  }

  .post-meta-left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .post-share-inline {
    display: flex;
    align-items: center;
  }

  /* ── Author Card ── */
  .author-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1.5rem;
    color: var(--foreground);
  }

  .author-avatar {
  width: 52px;
  height: 52px;
  min-width: 52px;
  border-radius: 14px;
  object-fit: cover;
  box-shadow: 0 4px 12px rgba(99,102,241,0.3);
}

  .author-info { flex: 1; }

  .author-name {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.35rem;
    color: var(--foreground);
  }

  .author-bio {
    font-size: 0.85rem;
    line-height: 1.65;
    opacity: 0.7;
    margin-bottom: 0.75rem;
    color: var(--foreground);
  }

  .author-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: #6366f1;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  :global([data-theme="dark"]) .author-link {
    color: var(--accent);
  }

  .author-link:hover { opacity: 0.75; }

  /* ── Prev / Next ── */
  .prevnext-nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 640px) {
    .prevnext-nav {
      grid-template-columns: 1fr 1fr;
    }
  }

  .prevnext-btn {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
    color: var(--foreground);
  }

  .prevnext-btn:hover {
    border-color: #6366f1;
    transform: translateY(-2px);
  }

  .prevnext-next { text-align: right; }

  .prevnext-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6366f1;
  }

  .prevnext-title {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    opacity: 0.85;
    color: var(--foreground);
  }

  /* ── Popup glow animation ── */
  @keyframes rb-scan {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(200%); }
  }
</style>
