  }

  .prevnext-btn:hover {
    border-color: #6366f1;
    transform: translateY(-2px);
  }

  .prevnext-next { text-align: right; }

  .prevnext-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
