---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import Comments from "@/components/Comments.astro";

import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[]; // all posts for prev/next & related
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags = [],
  hideEditPost,
  coverImage,
  coverImageAlt,
} = post.data;

const { Content } = await render(post);

let ogImageUrl: string | undefined;

// Priority order for OG image
if (coverImage) {
  ogImageUrl = coverImage;
} else if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
} else if (SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

/* ── Prev / Next Posts ─────────────────────────────────────────────── */
const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentIndex = allPosts.findIndex((p) => p.id === post.id);

const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost =
  currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
---

<Layout {...layoutProps}>
  <Header />

  <!-- Breadcrumbs: Home → Posts → Current Post Title -->
  <Breadcrumbs
    items={[
      { label: "Home", href: "/" },
      { label: "Posts", href: "/posts/" },
      { label: title }
    ]}
  />

  <!-- Show back button only when cover image exists -->
  {coverImage && <BackButton />}

  <!-- 
    Main content:
    - Add mt-8 when no cover image (better spacing without cover + no back button)
  -->
  <main
    id="main-content"
    class:list={[
      "app-layout pb-12 mx-auto max-w-app px-4",
      { "mt-8": !coverImage }
    ]}
    data-pagefind-body
  >
    <!-- Cover Image -->
    {coverImage && (
      <img
        src={coverImage}
        alt={coverImageAlt || title}
        class="w-full object-cover aspect-video md:aspect-[21/9] rounded-2xl mb-8"
        loading="eager"
        width="1200"
        height="630"
      />
    )}

    <h1
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="inline-block text-2xl font-bold text-accent sm:text-3xl md:text-4xl"
    >
      {title}
    </h1>

    <div class="mt-3 mb-8 flex flex-wrap items-center gap-3 text-sm">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      {
        !hideEditPost && SITE.editPost?.enabled && (
          <>
            <span aria-hidden="true" class="max-sm:hidden text-muted-foreground">•</span>
            <EditPost {hideEditPost} {post} class="max-sm:hidden" />
          </>
        )
      }
    </div>

    <article
      id="article"
      class="app-prose mt-2 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>

    <hr class="my-10 border-dashed" />

    <EditPost class="sm:hidden mb-8" {hideEditPost} {post} />

    <!-- Tags -->
    {tags.length > 0 && (
      <ul class="mb-10 flex flex-wrap gap-3">
        {tags.map((tag) => (
          <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
        ))}
      </ul>
    )}

    <BackToTopButton />

    <ShareLinks />

    <hr class="my-10 border-dashed" />

    <!-- Prev / Next Navigation -->
    {(prevPost || nextPost) && (
      <nav
        aria-label="Post navigation"
        class="grid grid-cols-1 gap-6 sm:grid-cols-2 mb-12"
        data-pagefind-ignore
      >
        {prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="group flex items-center gap-3 hover:opacity-90 transition"
          >
            <IconChevronLeft class="flex-none w-5 h-5 rtl:rotate-180" />
            <div>
              <div class="text-sm text-muted-foreground">Previous</div>
              <div class="font-medium text-accent group-hover:underline">
                {prevPost.title}
              </div>
            </div>
          </a>
        )}

        {nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class="group flex items-center justify-end gap-3 text-right hover:opacity-90 transition sm:col-start-2"
          >
            <div>
              <div class="text-sm text-muted-foreground">Next</div>
              <div class="font-medium text-accent group-hover:underline">
                {nextPost.title}
              </div>
            </div>
            <IconChevronRight class="flex-none w-5 h-5 rtl:rotate-180" />
          </a>
        )}
      </nav>
    )}

    <!-- Related Posts -->
    <RelatedPosts currentPost={post} allPosts={posts} limit={3} />

    <hr class="my-10 border-dashed" />

    <!-- Comments -->
    <Comments />
  </main>

  <Footer />
</Layout>

<!-- Client-side enhancements -->
<script is:inline>
  // Progress bar
  function createProgressBar() {
    const container = document.createElement("div");
    container.className = "progress-container fixed top-0 left-0 z-[999] h-1 w-full bg-background";

    const bar = document.createElement("div");
    bar.className = "progress-bar h-full w-0 bg-accent transition-all duration-150";
    bar.id = "scroll-progress";

    container.appendChild(bar);
    document.body.appendChild(container);

    function update() {
      const scroll = window.scrollY;
      const height = document.documentElement.scrollHeight - window.innerHeight;
      const percent = height > 0 ? (scroll / height) * 100 : 0;
      bar.style.width = `${percent}%`;
    }

    update();
    window.addEventListener("scroll", update, { passive: true });
  }
  createProgressBar();

  // Heading anchor links
  document.querySelectorAll("h2, h3, h4, h5, h6").forEach((h) => {
    if (!h.id) return;
    h.classList.add("group", "relative");
    const a = document.createElement("a");
    a.href = `#${h.id}`;
    a.className =
      "absolute -left-6 top-0 bottom-0 flex items-center opacity-0 group-hover:opacity-70 group-focus-within:opacity-70 transition md:-left-8";
    a.innerHTML = '<span class="text-muted-foreground text-xl">#</span>';
    h.prepend(a);
  });

  // Code copy buttons
  document.querySelectorAll("pre").forEach((pre) => {
    const wrapper = document.createElement("div");
    wrapper.className = "relative";
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const btn = document.createElement("button");
    btn.className =
      "absolute top-2 right-2 rounded bg-muted px-2.5 py-1 text-xs font-medium text-foreground border border-muted hover:bg-muted/80 transition";
    btn.textContent = "Copy";
    pre.appendChild(btn);

    btn.onclick = async () => {
      const code = pre.querySelector("code")?.innerText ?? "";
      await navigator.clipboard.writeText(code);
      btn.textContent = "Copied!";
      setTimeout(() => (btn.textContent = "Copy"), 1400);
    };
  });

  // Reset scroll on astro page transition
  document.addEventListener("astro:after-swap", () => {
    window.scrollTo({ top: 0, left: 0, behavior: "instant" });
  });
</script>
