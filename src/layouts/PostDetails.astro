---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import Comments from "@/components/Comments.astro";
import SchemaMarkup from "@/components/SchemaMarkup.astro";

import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  pubDatetime,
  modDatetime,
  timezone,
  tags = [],
  hideEditPost,
  coverImage,
  coverImageAlt
} = post.data;

const { Content } = await render(post);

/* SAFE POST URL (absolute + SEO-safe) */
const postPath = getPath(post.id, post.filePath);
const postUrl = new URL(postPath, SITE.website).toString();

/* SAFE OG IMAGE */
let ogImageUrl: string | undefined;

if (coverImage) {
  ogImageUrl = coverImage;
} else if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, SITE.website).toString()
  : undefined;

/* LAYOUT PROPS */
const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL: postUrl,
  ogImage,
  scrollSmooth: true,
};

/* PREV / NEXT POSTS */
const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath
}));

const currentIndex = allPosts.findIndex((p) => p.id === post.id);

const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost =
  currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

/* BREADCRUMBS */
const breadcrumbs = [
  { name: "Home", url: SITE.website },
  { name: "Posts", url: new URL("/posts/", SITE.website).toString() },
  { name: title, url: postUrl }
];

/* BLOGPOSTING JSON-LD */
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description || "",
  image: ogImage || "",
  url: postUrl,
  datePublished: pubDatetime.toISOString(),
  dateModified: modDatetime
    ? modDatetime.toISOString()
    : pubDatetime.toISOString(),
  author: {
    "@type": "Person",
    "name": author || SITE.author
  },
  publisher: {
    "@type": "Organization",
    "name": SITE.title,
    "url": SITE.website
  },
  keywords: tags.join(", ")
};

/* POST SLUG for view counter */
const postSlug = post.id;
---

<Layout {...layoutProps}>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(blogPostingSchema)}
  />

  <SchemaMarkup
    type="article"
    title={title}
    description={description}
    url={postUrl}
    image={ogImage}
    datePublished={pubDatetime}
    dateModified={modDatetime}
    breadcrumbs={breadcrumbs}
  />

  <Header />

  <Breadcrumbs
    items={[
      { label: "Home", href: "/" },
      { label: "Posts", href: "/posts/" },
      { label: title }
    ]}
  />

  {coverImage && <BackButton />}

  <main
    id="main-content"
    class:list={[
      "pb-12 mx-auto w-full max-w-3xl px-4",
      { "mt-8": !coverImage }
    ]}
  >
    {coverImage && (
      <img
        src={coverImage}
        alt={coverImageAlt || title}
        class="w-full object-cover aspect-video md:aspect-[21/9] rounded-2xl mb-8"
        loading="eager"
        width="1200"
        height="630"
      />
    )}

    <h1
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="inline-block text-2xl font-bold text-accent sm:text-3xl md:text-4xl"
    >
      {title}
    </h1>

    <div class="mt-3 mb-8 flex flex-wrap items-center gap-3 text-sm">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <!-- 👁 View Counter -->
      <span class="flex items-center gap-1 opacity-70">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
        <span id="view-count">—</span> views
      </span>
    </div>

    <article class="prose prose-sm sm:prose lg:prose-lg mt-2 w-full max-w-none">
      <Content />
    </article>

    <!-- About the Author -->
    <section class="mt-12 mb-10 p-6 bg-base-200 rounded-2xl border border-base-300">
      <h2 class="text-xl font-bold mb-4">About the Author</h2>
      <div class="flex flex-col sm:flex-row items-start gap-6">
        <div>
          <p class="font-semibold text-lg">{SITE.author || "iSamuel"}</p>
          <p class="text-base-content/90 mt-2 leading-relaxed">
            iSamuel is the founder and lead technology analyst behind ReviByte Opinions. With a background in Physics & Electronics, he writes practical, expert tech analysis and insights for everyday users in Nigeria and beyond â€" focusing on honest, real-world explanations of phones, gadgets, AI, and how technology works in everyday life. His work is driven by clarity, curiosity, and a commitment to useful, human-centered content.
          </p>
          <p class="mt-4 text-sm">
            <a href="/about" class="text-accent hover:underline font-medium">Learn more about iSamuel and ReviByte â†'</a>
          </p>
        </div>
      </div>
    </section>

    <hr class="my-10 border-dashed" />

    {tags.length > 0 && (
      <ul class="mb-10 flex flex-wrap gap-3">
        {tags.map((tag) => (
          <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
        ))}
      </ul>
    )}

    <BackToTopButton />
    <ShareLinks />

    <hr class="my-10 border-dashed" />

    {(prevPost || nextPost) && (
      <nav class="grid grid-cols-1 gap-6 sm:grid-cols-2 mb-12">
        {prevPost && (
          <a href={getPath(prevPost.id, prevPost.filePath)} class="flex items-center gap-2 hover:text-accent transition-colors">
            â† {prevPost.title}
          </a>
        )}
        {nextPost && (
          <a href={getPath(nextPost.id, nextPost.filePath)} class="flex items-center gap-2 hover:text-accent transition-colors sm:text-right sm:justify-end">
            {nextPost.title} â†'
          </a>
        )}
      </nav>
    )}

    <RelatedPosts currentPost={post} allPosts={posts} limit={3} />
    <hr class="my-10 border-dashed" />
    <Comments />
  </main>

  <Footer />
</Layout>

<!-- View Counter Script -->
<script define:vars={{ postSlug }}>
  const SUPABASE_URL = "https://tfkrjruxqiqpaoeckfoh.supabase.co";
  const SUPABASE_KEY = "sb_publishable_fHguT58pKc7MsxhSvNpb6w_T2Xg_U_G";

  async function getAndIncrementViews(slug) {
    try {
      // Increment view count using upsert
      await fetch(`${SUPABASE_URL}/rest/v1/rpc/increment_views`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "apikey": SUPABASE_KEY,
          "Authorization": `Bearer ${SUPABASE_KEY}`,
        },
        body: JSON.stringify({ post_slug: slug }),
      });

      // Fetch updated count
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/post_views?slug=eq.${encodeURIComponent(slug)}&select=views`,
        {
          headers: {
            "apikey": SUPABASE_KEY,
            "Authorization": `Bearer ${SUPABASE_KEY}`,
          },
        }
      );

      const data = await res.json();
      const views = data?.[0]?.views ?? 0;
      const el = document.getElementById("view-count");
      if (el) el.textContent = views.toLocaleString();
    } catch (e) {
      const el = document.getElementById("view-count");
      if (el) el.textContent = "—";
    }
  }

  getAndIncrementViews(postSlug);
</script>
