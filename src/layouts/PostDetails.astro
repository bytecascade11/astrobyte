---
// src/layouts/PostDetails.astro

import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";

// NEW: Import RelatedPosts component
import RelatedPosts from "@/components/RelatedPosts.astro";

import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[]; // All published posts for prev/next
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags = [],
  hideEditPost,
  coverImage,
  coverImageAlt,
} = post.data;

// Render content
const { Content } = await render(post);

// Resolve OG image
let ogImage: string | undefined;

if (typeof initOgImage === "string") {
  ogImage = initOgImage;
} else if (initOgImage?.src) {
  ogImage = initOgImage.src;
}

if (!ogImage && SITE.dynamicOgImage) {
  ogImage = `${getPath(post.id, post.filePath, true)}/open-graph.png`;
}

const ogImageUrl = ogImage ? new URL(ogImage, Astro.url.origin).href : undefined;

// Layout props
const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogImageUrl,
  scrollSmooth: true,
};

/* Prev/Next Posts */
const sortedPosts = posts.sort((a, b) =>
  (b.data.modDatetime ?? b.data.pubDatetime).getTime() -
  (a.data.modDatetime ?? a.data.pubDatetime).getTime()
);

const currentIndex = sortedPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const nextPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

/* Breadcrumbs */
const isBlogRoute = Astro.url.pathname.startsWith("/posts/") || Astro.url.pathname.startsWith("/blog/");
const breadcrumbItems = [
  { name: "Home", url: "/" },
  ...(isBlogRoute ? [{ name: "Blog", url: "/posts/" }] : []),
  { name: title, url: Astro.url.pathname },
];
---

<Layout {...layoutProps}>
  <Header />
  {SITE.showBackButton && <BackButton />}

  <!-- Breadcrumbs -->
  {isBlogRoute && (
    <nav class="mx-auto mt-8 mb-6 w-full max-w-app px-4" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-sm font-light opacity-90">
        {breadcrumbItems.map((item, index) => {
          const isLast = index === breadcrumbItems.length - 1;
          return (
            <>
              <li>
                {isLast ? (
                  <span class="font-medium opacity-75" aria-current="page">
                    {item.name}
                  </span>
                ) : (
                  <a href={item.url} class="hover:opacity-100 opacity-80 transition">
                    {item.name}
                  </a>
                )}
              </li>
              {!isLast && (
                <li>
                  <span class="opacity-60" aria-hidden="true">›</span>
                </li>
              )}
            </>
          );
        })}
      </ol>
    </nav>
  )}

  <!-- JSON-LD Breadcrumb -->
  {isBlogRoute && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: new URL(item.url, Astro.url.origin).href,
      })),
    })} />
  )}

  <!-- Floating Controls -->
  <div class="fixed top-20 right-4 z-50 flex flex-col gap-4 md:top-24">
    <BackToTopButton class="rounded-full bg-background/90 backdrop-blur-sm p-3 shadow-lg" />
    <div class="flex flex-col gap-3 rounded-lg bg-background/90 backdrop-blur-sm p-4 shadow-lg border border-border">
      <span class="text-sm font-medium opacity-80">Share</span>
      <ShareLinks title={title} url={Astro.url.href} />
    </div>
  </div>

  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-12 mt-8" data-pagefind-body>
    <h1 transition:name={slugifyStr(title)} class="text-2xl sm:text-3xl font-bold text-accent">
      {title}
    </h1>

    <div class="my-4 flex flex-wrap items-center gap-4 text-sm">
      <Datetime pubDatetime={pubDatetime} modDatetime={modDatetime} timezone={timezone} size="lg" />
      
      {SITE.editPost?.enabled && !hideEditPost && (
        <>
          <span class="max-sm:hidden opacity-60" aria-hidden="true">|</span>
          <EditPost post={post} class="max-sm:hidden" />
        </>
      )}
    </div>

    <!-- Cover Image -->
{coverImage && (
  <figure class="mt-12 mb-16 overflow-hidden rounded-2xl shadow-2xl">
    <img
      src={coverImage}
      alt={coverImageAlt || title}
      class="w-full object-cover aspect-video md:aspect-[21/9]"
      loading="eager"
      width="1200"
      height="630"
    />
    {coverImageAlt && (
      <figcaption class="text-center text-sm opacity-70 mt-3 italic">
        {coverImageAlt}
      </figcaption>
    )}
  </figure>
)}
    <!-- Article Content -->
    <article id="article" class="app-prose mx-auto mt-16">
      <Content />
    </article>

    <hr class="my-16 border-dashed border-border/40" />

    <!-- Mobile Edit Link -->
    {SITE.editPost?.enabled && !hideEditPost && (
      <EditPost post={post} cla{coverImage && (
  <figure class="mt-12 mb-16 overflow-hidden rounded-2xl shadow-2xl">
    <img
      src={coverImage}
      alt={coverImageAlt || title}
      class="w-full object-cover aspect-video md:aspect-[21/9]"
      loading="eager"
      width="1200"
      height="630"
    />
    {coverImageAlt && (
      <figcaption class="text-center text-sm opacity-70 mt-3 italic">
        {coverImageAlt}
      </figcaption>
    )}
  </figure>
)}ss="sm:hidden mb-8" />
    )}

    <!-- Tags -->
    {tags.length > 0 && (
      <section aria-label="Tags" class="my-12">
        <ul class="flex flex-wrap gap-3">
          {tags.map((tag) => (
            <li>
              <Tag tag={slugifyStr(tag)} tagName={tag} size="md" />
            </li>
          ))}
        </ul>
      </section>
    )}

    <hr class="my-16 border-dashed border-border/40" />

    <!-- Comments -->
    <section aria-label="Comments" class="my-20">
      <h2 class="text-2xl font-bold mb-10">Comments</h2>
      <div class="giscus"></div>
    </section>

    <hr class="my-16 border-dashed border-border/40" />

    <!-- NEW: Related Posts (tag-based) -->
    <RelatedPosts post={post} />

    <hr class="my-16 border-dashed border-border/40" />

    <!-- Prev/Next Navigation – Card Style -->
    <section aria-label="Continue reading" class="my-20">
      <h2 class="text-2xl font-bold mb-12 text-center">Continue Reading</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-5xl mx-auto">
        {prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="group block rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all bg-card/80 backdrop-blur"
          >
            <div class="p-8 flex flex-col h-full">
              <div class="flex items-center gap-3 text-sm opacity-70 mb-4">
                <IconChevronLeft class="w-5 h-5 group-hover:-translate-x-1 transition" />
                <span class="font-medium">Previous Post</span>
              </div>
              <h3 class="text-xl font-semibold line-clamp-2 mb-4">
                {prevPost.data.title}
              </h3>
              {prevPost.data.description && (
                <p class="text-sm opacity-80 line-clamp-3 flex-1">
                  {prevPost.data.description}
                </p>
              )}
              <time class="mt-6 text-sm opacity-60">
                {prevPost.data.pubDatetime.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            </div>
          </a>
        )}

        {nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class="group block rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all bg-card/80 backdrop-blur md:col-start-2"
          >
            <div class="p-8 flex flex-col h-full text-right">
              <div class="flex items-center justify-end gap-3 text-sm opacity-70 mb-4">
                <span class="font-medium">Next Post</span>
                <IconChevronRight class="w-5 h-5 group-hover:translate-x-1 transition" />
              </div>
              <h3 class="text-xl font-semibold line-clamp-2 mb-4">
                {nextPost.data.title}
              </h3>
              {nextPost.data.description && (
                <p class="text-sm opacity-80 line-clamp-3 flex-1">
                  {nextPost.data.description}
                </p>
              )}
              <time class="mt-6 text-sm opacity-60">
                {nextPost.data.pubDatetime.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            </div>
          </a>
        )}
      </div>

      {!prevPost && !nextPost && (
        <p class="text-center py-12 opacity-70">No more posts to explore.</p>
      )}
    </section>
  </main>

  <Footer />

  <!-- Client Scripts -->
  <script is:inline data-astro-rerun>
    // Reading progress bar
    const progressBar = document.createElement("div");
    progressBar.id = "reading-progress";
    progressBar.className = "fixed top-0 left-0 h-1 bg-accent z-50 transition-all duration-150";
    document.body.prepend(progressBar);

    const updateProgress = () => {
      const { scrollTop, scrollHeight } = document.documentElement;
      const height = scrollHeight - window.innerHeight;
      const progress = height > 0 ? (scrollTop / height) * 100 : 0;
      progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    };

    window.addEventListener("scroll", updateProgress);
    document.addEventListener("astro:page-load", updateProgress);
    updateProgress();

    // Heading permalinks
    document.querySelectorAll("h2[id], h3[id], h4[id]").forEach(heading => {
      heading.classList.add("group", "relative");
      const link = document.createElement("a");
      link.href = `#${heading.id}`;
      link.className = "absolute -left-6 opacity-0 group-hover:opacity-100 transition pr-2 text-accent";
      link.innerHTML = "#";
      link.setAttribute("aria-label", `Permalink to ${heading.textContent?.trim() || "section"}`);
      heading.prepend(link);
    });

    // Code block copy buttons
    document.querySelectorAll("pre").forEach(pre => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "absolute top-3 right-3 px-3 py-1.5 text-xs font-medium bg-muted/90 border border-border rounded opacity-80 hover:opacity-100 transition";
      button.textContent = "Copy";
      button.setAttribute("aria-label", "Copy code to clipboard");

      button.onclick = async () => {
        const code = pre.querySelector("code")?.innerText || "";
        await navigator.clipboard.writeText(code);
        button.textContent = "Copied!";
        setTimeout(() => (button.textContent = "Copy"), 2000);
      };

      pre.style.position = "relative";
      pre.appendChild(button);
    });

    // Reset scroll on view transitions
    document.addEventListener("astro:after-swap", () => window.scrollTo(0, 0));
  </script>
</Layout>
