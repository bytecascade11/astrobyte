---
import type { CollectionEntry } from "astro:content";
import { render, getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";

import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import Footer from "@/components/Footer.astro";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";

import { SITE } from "@/config";

export interface Props {
  post: CollectionEntry<"blog">;
  // posts is optional now – we fetch fresh data inside for better consistency
  posts?: CollectionEntry<"blog">[];
}

const { post } = Astro.props;

// Frontmatter
const {
  title,
  author = SITE.author,
  description,
  ogImage: initOgImage,
  pubDatetime,
  modDatetime,
  timezone,
  tags = [],
  hideEditPost = false,
  coverImage,
  coverImageAlt,
} = post.data;

// Render markdown content
const { Content } = await render(post);

// Meta description fallback
let metaDescription = description?.trim() || "";
if (!metaDescription && post.body) {
  metaDescription = post.body
    .replace(/\n+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 160);
}
metaDescription ||= SITE.desc || "Tech reviews, opinions, and news.";

// OG image handling (safe for both string and imported image object)
let ogImage: string | undefined;
if (typeof initOgImage === "string") ogImage = initOgImage;
else if (initOgImage?.src) ogImage = initOgImage.src;
if (!ogImage && coverImage) ogImage = coverImage;
if (!ogImage && SITE.dynamicOgImage)
  ogImage = `${getPath(post.id, post.filePath, true)}/open-graph.png`;
ogImage ||= "/astropaper-og.jpg";

const ogImageUrl = new URL(
  ogImage.startsWith("http") ? ogImage : ogImage,
  Astro.url.origin
).href;

// Canonical URL
let canonicalPath = Astro.url.pathname;
if (canonicalPath !== "/" && canonicalPath.endsWith("/")) {
  canonicalPath = canonicalPath.slice(0, -1);
}
const canonicalUrl = new URL(canonicalPath, Astro.site).href;

// Prev / Next – using fresh collection fetch for reliability
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = [...allPosts].sort(
  (a, b) =>
    (b.data.modDatetime ?? b.data.pubDatetime).getTime() -
    (a.data.modDatetime ?? a.data.pubDatetime).getTime()
);
const currentIndex = sortedPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const nextPost =
  currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

// Breadcrumbs
const isBlogRoute =
  Astro.url.pathname.startsWith("/posts/") ||
  Astro.url.pathname.startsWith("/blog/");

const breadcrumbItems = [
  { name: "Home", url: "/" },
  ...(isBlogRoute ? [{ name: "Blog", url: "/posts/" }] : []),
  { name: title, url: canonicalPath },
];

// Related posts
const related = allPosts
  .filter((p) => p.id !== post.id)
  .filter((p) => p.data.tags?.some((t) => tags.includes(t)))
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf())
  .slice(0, 5);
---

<BaseLayout
  title={`${title} | ${SITE.title}`}
  description={metaDescription}
  author={author}
  canonicalURL={canonicalUrl}
  ogImage={ogImageUrl}
  scrollSmooth={true}
>
  {SITE.showBackButton && <BackButton />}

  {isBlogRoute && (
    <nav class="mx-auto mt-8 mb-6 max-w-app px-4" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-sm opacity-90">
        {breadcrumbItems.map((item, index) => {
          const isLast = index === breadcrumbItems.length - 1;
          return (
            <li class="flex items-center gap-2">
              {isLast ? (
                <span aria-current="page" class="font-medium opacity-75">
                  {item.name}
                </span>
              ) : (
                <a href={item.url} class="opacity-80 hover:opacity-100">
                  {item.name}
                </a>
              )}
              {!isLast && <span aria-hidden="true">›</span>}
            </li>
          );
        })}
      </ol>
    </nav>
  )}

  <div class="fixed top-20 right-4 z-50 flex flex-col gap-4">
    <BackToTopButton class="rounded-full p-3 shadow-lg bg-background/90" />
    <div class="rounded-lg p-4 shadow-lg bg-background/90">
      <span class="text-sm opacity-80">Share</span>
      <ShareLinks title={title} url={Astro.url.href} />
    </div>
  </div>

  <main
    class="mx-auto max-w-app px-4 pb-12 mt-8"
    data-pagefind-body
    id="main-content"
  >
    <h1 class="text-3xl font-bold text-accent">{title}</h1>

    <div class="my-4 flex items-center gap-4 text-sm">
      <Datetime
        pubDatetime={pubDatetime}
        modDatetime={modDatetime}
        timezone={timezone}
      />
      {SITE.editPost?.enabled && !hideEditPost && (
        <EditPost post={post} class="hidden sm:inline" />
      )}
    </div>

    {coverImage && (
      <figure class="mt-12 mb-16 overflow-hidden rounded-2xl shadow-2xl">
        <img
          src={coverImage}
          alt={coverImageAlt || title}
          class="w-full aspect-video object-cover"
          width="1200"
          height="630"
          loading="eager"
        />
        {coverImageAlt && (
          <figcaption class="mt-3 text-center text-sm opacity-70 italic">
            {coverImageAlt}
          </figcaption>
        )}
      </figure>
    )}

    <article class="app-prose mx-auto mt-16 prose-headings:text-accent">
      <Content />
    </article>

    {tags.length > 0 && (
      <section class="my-12">
        <ul class="flex flex-wrap gap-3">
          {tags.map((tag) => (
            <li>
              <Tag tag={slugifyStr(tag)} tagName={tag} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-20">
        <h2 class="text-2xl font-bold mb-8">Related Posts</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {related.map((relatedPost) => {
            const link = getPath(relatedPost.id, relatedPost.filePath);
            const {
              title,
              description = "",
              pubDatetime,
            } = relatedPost.data;

            return (
              <article class="p-6 rounded-2xl bg-card/80 shadow-lg hover:shadow-xl transition-all">
                <a
                  href={link}
                  class="font-semibold text-lg hover:text-accent"
                >
                  {title}
                </a>
                <time class="block text-sm text-muted-foreground mt-1">
                  {new Date(pubDatetime).toLocaleDateString()}
                </time>
                {description && (
                  <p class="mt-2 text-muted-foreground line-clamp-3">
                    {description}
                  </p>
                )}
              </article>
            );
          })}
        </div>
      </section>
    )}

    <section class="my-20 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Comments</h2>
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo="bytecascade11/astrobyte"
        data-repo-id="R_kgDOQobjBQ"
        data-category="Announcements"
        data-category-id="DIC_kwDOQobjBc4C0Dd4"
        data-mapping="pathname"
        data-theme="preferred-color-scheme"
        data-lang="en"
        crossorigin="anonymous"
        async
      ></script>
    </section>

    <section class="my-20">
      <h2 class="text-2xl font-bold text-center mb-12">
        Continue Reading
      </h2>
      <div class="grid md:grid-cols-2 gap-10 max-w-5xl mx-auto">
        {prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="rounded-2xl p-8 shadow-lg"
          >
            <IconChevronLeft class="inline w-5 h-5" /> Previous
            <h3 class="mt-3 font-semibold">
              {prevPost.data.title}
            </h3>
          </a>
        )}
        {nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class="rounded-2xl p-8 shadow-lg text-right"
          >
            Next <IconChevronRight class="inline w-5 h-5" />
            <h3 class="mt-3 font-semibold">
              {nextPost.data.title}
            </h3>
          </a>
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
