{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revibyte",                    // ← change this to your actual project name if different
  "compatibility_date": "2026-11-02",
  "main": "./dist/_worker.js/index.js",  // Astro Cloudflare worker entry
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Optional but useful if you use KV sessions (you had a warning about SESSION)
  // "kv_namespaces": [
  //   {
  //     "binding": "SESSION",
  //     "id": "your-kv-namespace-id"
  //   }
  // ]
}
